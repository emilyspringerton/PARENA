;; stdlib/ringo.prn — depends on array, sdl2. Design: STDLIB.md "ringo"
;; section, the matplotlib equivalent. Named by the founder directly:
;; "apparently parena is a beetle" -> "so give it a qute beetle name
;; maybe RINGO." figure/show real (thin sdl2 wrapper, same pattern as
;; every other sdl2-hosted package); plot/scatter/bar/hist real at the
;; data-validation level (shape checks), actual pixel-space layout
;; (axis scaling, tick placement, label rendering) is genuinely
;; deferred real rendering work, same honest limitation STDLIB.md
;; states for this package.

(module ringo)
(import array)
(import sdl2)
(export figure plot scatter bar hist set-title set-labels show save)

(defstruct Figure
  (window : Window @ Region)
  (title  : String @ Region)
  (x-label : String @ Region)
  (y-label : String @ Region))

(defn figure [(w : I32) (h : I32) (dest : Arena @ Region)]
  : Figure @ Region
  (match (sdl2/create-window "ringo" w h dest)
    ((Ok win) {:window win :title "" :x-label "" :y-label ""})
    ((Err e) (panic "sdl2 window creation failed"))))

(defn same-length? [(x : &NDArray) (y : &NDArray)]
  : Bool
  (= (vec/len &(get-field x :data)) (vec/len &(get-field y :data))))

(defn plot [(!fig : &mut Figure) (x : &NDArray) (y : &NDArray)]
  : (Result Unit ShapeError)
  (if (not (same-length? x y))
    (Err (ShapeError "x and y must have the same length"))
    (do (draw-line-series !fig x y) (Ok unit))))

(defn scatter [(!fig : &mut Figure) (x : &NDArray) (y : &NDArray)]
  : (Result Unit ShapeError)
  (if (not (same-length? x y))
    (Err (ShapeError "x and y must have the same length"))
    (do (draw-point-series !fig x y) (Ok unit))))

(defn bar [(!fig : &mut Figure) (labels : &(Vec String)) (values : &NDArray)]
  : (Result Unit ShapeError)
  (if (not (= (vec/len labels) (vec/len &(get-field values :data))))
    (Err (ShapeError "labels and values must have the same length"))
    (do (draw-bars !fig labels values) (Ok unit))))

;; hist — real bucketing (a genuinely short, real reduction), the actual
;; bar rendering it hands off to is the same draw-bars primitive above.
(defn hist [(!fig : &mut Figure) (data : &NDArray) (bins : I32)]
  : Unit
  (let [lo (unwrap (stats/min data)) hi (unwrap (stats/max data))
        width (/ (- hi lo) (to-f64 bins))
        counts (vec/new (current-arena))]
    (loop [b 0] (when (< b bins) (vec/push! &counts 0.0) (recur (+ b 1))))
    (loop [i 0]
      (when (< i (vec/len &(get-field data :data)))
        (let [v (deref (vec/get &(get-field data :data) i))
              bucket (min-i32 (- bins 1) (to-i32 (/ (- v lo) width)))]
          (vec-incr! &counts bucket))
        (recur (+ i 1))))
    (draw-bars !fig (bucket-labels lo width bins (current-arena)) (array/from-vec counts [bins] (current-arena)))))

(defn set-title [(!fig : &mut Figure) (title : String @ Region)]
  : Unit
  (set! (get-field !fig :title) title))

(defn set-labels [(!fig : &mut Figure) (x-label : String @ Region) (y-label : String @ Region)]
  : Unit
  (do (set! (get-field !fig :x-label) x-label) (set! (get-field !fig :y-label) y-label)))

;; show — real event loop, same shape as PITVIPER's own poll-event loop.
(defn show [(!fig : &Figure)]
  : Unit
  (loop []
    (match (sdl2/poll-event)
      ((Some (Event/Quit)) unit)
      (_ (do (redraw-figure !fig) (sdl2/delay 16) (recur))))))

(defn save [(fig : &Figure) (path : String @ :region/scratch)]
  : (Result Unit IoError)
  #target
  {:c (inline-c "ringo_save_png(fig, path)")})   ;; real PNG encode via media/codec, deferred there
