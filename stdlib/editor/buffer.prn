;; stdlib/editor/buffer.prn — depends on string. Design: STDLIB.md
;; "editor/buffer" section, NORTHSTAR.md's own module table.
;;
;; Rewritten 2026-08-26, founder real-time: "continue working on parena
;; editor" -- the shell-specific undecided-ness this file's own original
;; header comment flagged ("FFI into whatever the chosen shell owns")
;; is resolved now: the shell IS SDL2 (stdlib/sdl2.prn's own real window/
;; renderer/text-rendering work shipped earlier the same day), and this
;; is the real, first, in-PARENA text buffer it edits.
;;
;; Real design departure from the original sketch, forced by two real,
;; confirmed VS0 emitter limits (not guessed at -- both hit live trying
;; the original shape): (1) no struct field mutation exists yet (no
;; `set-field!` or equivalent anywhere in this compiler) -- so a Buffer
;; is NOT mutated in place; insert/delete-range/insert-at-cursor/
;; backspace-at-cursor all return a real, NEW Buffer value via Result,
;; and the caller rebinds its own local (`(let [buf2 (insert-at-cursor
;; buf ch dest)] ...)`), the honest, buildable-today shape rather than a
;; mutable one. (2) tuple return types aren't supported (confirmed live:
;; a real "unsupported return type form" error) -- the original
;; `selection : (Option (I32 I32))` can't compile as written; dropped
;; entirely for v0 rather than worked around, since nothing in this pass
;; needs a selection concept yet (no selection UI exists) -- real,
;; separate, deferred work once something actually needs it, matching
;; this whole stdlib's "expand the API only when a new feature needs it"
;; pattern, not silently designed around blind.
;;
;; cursor-tracking replaces the original's own more abstract `selection`
;; entry point for this same reason -- a single I32 cursor position is
;; the real, minimal, useful thing a keyboard-driven single-line edit
;; loop needs (insert-at-cursor/backspace-at-cursor), not a speculative
;; richer model nothing calls yet.

;; selection-anchor -- real text SELECTION (2026-08-26, founder:
;; "continue working on parena editor"). Same real design departure as
;; the original `selection : (Option (I32 I32))` sketch this file's own
;; header comment already documents dropping (no tuple return types) --
;; a second I32 field instead of an Option-of-tuple: -1 means "no
;; active selection," any value >= 0 is the real anchor position, and
;; the selection spans [min(anchor,cursor), max(anchor,cursor)) --
;; cursor is always one real end of the selection, matching how every
;; real text editor's own Shift+Arrow behaves (the cursor is the moving
;; end, the anchor is where Shift was first held down). EVERY mutating
;; function (insert/delete-range/insert-at-cursor/backspace-at-cursor/
;; delete-forward-at-cursor) and every PLAIN (non-extending) cursor
;; move clears it to -1 -- a stale selection range after an edit would
;; point at shifted byte offsets, and a plain arrow key collapsing the
;; selection is standard real editor UX.

(module editor/buffer)
(import string)
(export new from-text active-text cursor-pos insert delete-range
        insert-at-cursor backspace-at-cursor delete-forward-at-cursor
        move-cursor-left move-cursor-right move-cursor-up move-cursor-down
        move-cursor-home move-cursor-end
        has-selection? selection-start selection-end
        extend-selection-left extend-selection-right
        extend-selection-up extend-selection-down delete-selection
        set-cursor set-selection
        Buffer BufferError)

(defstruct Buffer
  (text             : String @ Region)
  (cursor           : I32)
  (selection-anchor : I32))

(defenum BufferError
  (OutOfRange))

(defn new [(dest : Arena @ Region)] : Buffer @ Region
  {:text "" :cursor 0 :selection-anchor -1})

;; from-text -- real constructor for loading an existing string into a
;; Buffer (2026-08-26, the real save/load path an actual editor needs).
;; Cursor starts at the real end of the loaded text, matching how a
;; real editor drops you at the end of whatever you just opened.
(defn from-text [(text : String @ Region)] : Buffer @ Region
  {:text text :cursor (string/length text) :selection-anchor -1})

(defn active-text [(!buf : &Buffer)]
  : String @ Region
  (get-field !buf :text))

(defn cursor-pos [(!buf : &Buffer)]
  : I32
  (get-field !buf :cursor))

;; insert -- NORTHSTAR.md's own documented entry point, real value-
;; semantics shape (see this file's own header comment for why). Cursor
;; position is left unchanged -- callers editing at an arbitrary offset
;; are responsible for their own cursor bookkeeping; insert-at-cursor
;; below is the real convenience path a keyboard loop actually wants.
(defn insert [(!buf : &Buffer) (pos : I32) (text : String @ Region) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [cur (get-field !buf :text)
        len (string/length cur)]
    (if (or (< pos 0) (> pos len))
      (Err OutOfRange)
      (let [before (string/substring cur 0 pos dest)
            after (string/substring cur pos len dest)
            combined (string/concat (string/concat before text dest) after dest)]
        (Ok {:text combined :cursor (get-field !buf :cursor) :selection-anchor -1})))))

(defn delete-range [(!buf : &Buffer) (start : I32) (end : I32) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [cur (get-field !buf :text)
        len (string/length cur)]
    (if (or (< start 0) (> end len) (> start end))
      (Err OutOfRange)
      (let [before (string/substring cur 0 start dest)
            after (string/substring cur end len dest)]
        (Ok {:text (string/concat before after dest) :cursor (get-field !buf :cursor) :selection-anchor -1})))))

;; insert-at-cursor / backspace-at-cursor -- the real, minimal pair a
;; keyboard-driven single-line edit loop needs (SDL_TEXTINPUT ->
;; insert-at-cursor, backspace keydown -> backspace-at-cursor). Cursor
;; genuinely advances/retreats, unlike plain insert/delete-range above.
(defn insert-at-cursor [(!buf : &Buffer) (text : String @ Region) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [pos (get-field !buf :cursor)
        cur (get-field !buf :text)
        len (string/length cur)]
    (if (or (< pos 0) (> pos len))
      (Err OutOfRange)
      (let [before (string/substring cur 0 pos dest)
            after (string/substring cur pos len dest)
            combined (string/concat (string/concat before text dest) after dest)
            advance (string/length text)]
        (Ok {:text combined :cursor (+ pos advance) :selection-anchor -1})))))

(defn backspace-at-cursor [(!buf : &Buffer) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [pos (get-field !buf :cursor)]
    (if (<= pos 0)
      (Err OutOfRange)
      (let [cur (get-field !buf :text)
            len (string/length cur)
            before (string/substring cur 0 (- pos 1) dest)
            after (string/substring cur pos len dest)]
        (Ok {:text (string/concat before after dest) :cursor (- pos 1) :selection-anchor -1})))))

;; move-cursor-left / move-cursor-right -- real Left/Right arrow-key
;; support (sdl2/key-left, sdl2/key-right were added alongside
;; key-backspace/key-return but never actually wired into a real edit
;; loop until now). Clamps at the buffer's own edges rather than
;; erroring -- a real editor's own arrow key just stops doing anything
;; at the start/end of the line, that's not a failure case worth a
;; Result here the way an out-of-range insert/delete genuinely is.
(defn move-cursor-left [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)]
    (if (<= pos 0)
      {:text text :cursor 0 :selection-anchor -1}
      {:text text :cursor (- pos 1) :selection-anchor -1})))

(defn move-cursor-right [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)
        len (string/length text)]
    (if (>= pos len)
      {:text text :cursor len :selection-anchor -1}
      {:text text :cursor (+ pos 1) :selection-anchor -1})))

;; move-cursor-home / move-cursor-end -- real Home/End key support
;; (2026-08-26, the next real keys a single-line edit loop needs once
;; Left/Right exist). Always succeeds -- jumping to a position the
;; cursor is already at is a real, harmless no-op, not an error.
;;
;; Real, corrected 2026-08-26 (same day, after real multi-line editing
;; shipped): originally jumped to the start/end of the WHOLE buffer --
;; correct for a single-line buffer (where "start of buffer" and "start
;; of line" are the same position), but genuinely wrong real editor UX
;; once multi-line text exists (real editors' own plain Home/End mean
;; "start/end of the CURRENT line," not the document -- Ctrl+Home/
;; Ctrl+End is the usual whole-document shortcut, and this stdlib has no
;; modifier-key detection yet to offer that separately). Made real and
;; line-aware here instead of leaving the old, now-misleading
;; whole-buffer behavior under the same name.
(defn move-cursor-home [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)]
    {:text text :cursor (line-start-before text pos) :selection-anchor -1}))

(defn move-cursor-end [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)]
    {:text text :cursor (line-end-after text pos (string/length text)) :selection-anchor -1}))

;; move-cursor-up / move-cursor-down -- real Up/Down arrow-key support
;; (2026-08-27, founder real-time actually using the editor: "left and
;; right arrow work in the editor but up down doesnt work with arrow
;; keys" -- neither key had ever been wired up before this). Real "same
;; COLUMN" behavior every real editor's own Up/Down uses -- moves to
;; the same column on the adjacent line, clamped to that line's own
;; real length if it's shorter (not "same byte offset back/forward a
;; line's worth," which would drift onto the wrong column the moment
;; two adjacent lines have different lengths). Real, honest clamp at
;; the very first/last line -- no previous/next line to move onto, so
;; the cursor stays exactly where it is, same real "clamped movement is
;; fine" behavior move-cursor-left/right already establish at the
;; buffer's own edges.
(defn move-cursor-up [(!buf : &Buffer)] : Buffer
  (let [text (get-field !buf :text)
        cursor (get-field !buf :cursor)
        cur-line-start (line-start-before text cursor)
        column (- cursor cur-line-start)]
    (if (<= cur-line-start 0)
      {:text text :cursor cursor :selection-anchor -1}
      (let [prev-line-end (- cur-line-start 1)
            prev-line-start (line-start-before text prev-line-end)
            prev-line-len (- prev-line-end prev-line-start)
            target-col (if (< column prev-line-len) column prev-line-len)]
        {:text text :cursor (+ prev-line-start target-col) :selection-anchor -1}))))

(defn move-cursor-down [(!buf : &Buffer)] : Buffer
  (let [text (get-field !buf :text)
        cursor (get-field !buf :cursor)
        len (string/length text)
        cur-line-start (line-start-before text cursor)
        column (- cursor cur-line-start)
        cur-line-end (line-end-after text cursor len)]
    (if (>= cur-line-end len)
      {:text text :cursor cursor :selection-anchor -1}
      (let [next-line-start (+ cur-line-end 1)
            next-line-end (line-end-after text next-line-start len)
            next-line-len (- next-line-end next-line-start)
            target-col (if (< column next-line-len) column next-line-len)]
        {:text text :cursor (+ next-line-start target-col) :selection-anchor -1}))))

;; line-start-before / line-end-after -- real, minimal backward/forward
;; scans for the nearest real newline (ASCII 10) around `pos`, the
;; actual boundary of the CURRENT line. Real, honest, simple linear
;; scan -- no line-index cache, matching this buffer's own already-
;; established "real, simple, not optimized" tradeoff (render-text's
;; own fresh-surface-per-call design carries the identical judgment).
(defn line-start-before [(text : String @ Region) (pos : I32)] : I32
  (if (<= pos 0)
    0
    (if (= (string/char-at text (- pos 1)) 10)
      pos
      (line-start-before text (- pos 1)))))

(defn line-end-after [(text : String @ Region) (pos : I32) (len : I32)] : I32
  (if (>= pos len)
    len
    (if (= (string/char-at text pos) 10)
      pos
      (line-end-after text (+ pos 1) len))))

;; delete-forward-at-cursor -- the real Delete key: removes the
;; character AHEAD of the cursor (Backspace/backspace-at-cursor already
;; covers the one behind it). Real, honest OutOfRange when the cursor is
;; already at the real end of the text -- nothing ahead of it to delete,
;; same "clamped movement is fine, deleting nothing is an error" split
;; backspace-at-cursor's own header comment already establishes.
(defn delete-forward-at-cursor [(!buf : &Buffer) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [pos (get-field !buf :cursor)
        cur (get-field !buf :text)
        len (string/length cur)]
    (if (>= pos len)
      (Err OutOfRange)
      (let [before (string/substring cur 0 pos dest)
            after (string/substring cur (+ pos 1) len dest)]
        (Ok {:text (string/concat before after dest) :cursor pos :selection-anchor -1})))))

;; has-selection? / selection-start / selection-end -- real text
;; SELECTION query API. selection-start/selection-end are only
;; meaningful when has-selection? is true (an active selection spans
;; [selection-start, selection-end)) -- callers check has-selection?
;; first, same real precondition-checking discipline as this file's own
;; Result-returning functions already establish elsewhere (e.g.
;; move-cursor-* always succeeds and clamps; these three are the
;; equivalent "always succeeds" query trio for selection, cursor is
;; always one real end, selection-anchor the other, ordered here so
;; callers never have to know which end is which).
(defn has-selection? [(!buf : &Buffer)] : Bool
  (>= (get-field !buf :selection-anchor) 0))

(defn selection-start [(!buf : &Buffer)] : I32
  (let [a (get-field !buf :selection-anchor)
        c (get-field !buf :cursor)]
    (if (< a c) a c)))

(defn selection-end [(!buf : &Buffer)] : I32
  (let [a (get-field !buf :selection-anchor)
        c (get-field !buf :cursor)]
    (if (> a c) a c)))

;; extend-selection-left / extend-selection-right -- real Shift+Left/
;; Shift+Right. If no selection is active yet, the anchor is set to the
;; CURRENT cursor position first (where Shift was first held down),
;; then the cursor moves the same real clamped way move-cursor-left/
;; move-cursor-right already do -- the anchor itself never moves once
;; set, matching every real editor's own Shift+Arrow behavior.
(defn extend-selection-left [(!buf : &Buffer)] : Buffer
  (let [text (get-field !buf :text)
        cursor (get-field !buf :cursor)
        anchor (get-field !buf :selection-anchor)
        real-anchor (if (< anchor 0) cursor anchor)
        new-cursor (if (<= cursor 0) 0 (- cursor 1))]
    {:text text :cursor new-cursor :selection-anchor real-anchor}))

(defn extend-selection-right [(!buf : &Buffer)] : Buffer
  (let [text (get-field !buf :text)
        cursor (get-field !buf :cursor)
        len (string/length text)
        anchor (get-field !buf :selection-anchor)
        real-anchor (if (< anchor 0) cursor anchor)
        new-cursor (if (>= cursor len) len (+ cursor 1))]
    {:text text :cursor new-cursor :selection-anchor real-anchor}))

;; extend-selection-up / extend-selection-down -- real Shift+Up/
;; Shift+Down (2026-08-27, the natural complement to move-cursor-up/
;; move-cursor-down above, same real column-clamped logic, but
;; preserving/setting the anchor the way extend-selection-left/right do
;; instead of clearing it).
(defn extend-selection-up [(!buf : &Buffer)] : Buffer
  (let [text (get-field !buf :text)
        cursor (get-field !buf :cursor)
        anchor (get-field !buf :selection-anchor)
        real-anchor (if (< anchor 0) cursor anchor)
        cur-line-start (line-start-before text cursor)
        column (- cursor cur-line-start)]
    (if (<= cur-line-start 0)
      {:text text :cursor cursor :selection-anchor real-anchor}
      (let [prev-line-end (- cur-line-start 1)
            prev-line-start (line-start-before text prev-line-end)
            prev-line-len (- prev-line-end prev-line-start)
            target-col (if (< column prev-line-len) column prev-line-len)]
        {:text text :cursor (+ prev-line-start target-col) :selection-anchor real-anchor}))))

(defn extend-selection-down [(!buf : &Buffer)] : Buffer
  (let [text (get-field !buf :text)
        cursor (get-field !buf :cursor)
        len (string/length text)
        anchor (get-field !buf :selection-anchor)
        real-anchor (if (< anchor 0) cursor anchor)
        cur-line-start (line-start-before text cursor)
        column (- cursor cur-line-start)
        cur-line-end (line-end-after text cursor len)]
    (if (>= cur-line-end len)
      {:text text :cursor cursor :selection-anchor real-anchor}
      (let [next-line-start (+ cur-line-end 1)
            next-line-end (line-end-after text next-line-start len)
            next-line-len (- next-line-end next-line-start)
            target-col (if (< column next-line-len) column next-line-len)]
        {:text text :cursor (+ next-line-start target-col) :selection-anchor real-anchor}))))

;; delete-selection -- removes the real selected range [selection-start,
;; selection-end), places the cursor at the real start of where the
;; selection was, and clears the selection. Real, honest OutOfRange when
;; there's no active selection to delete -- callers (a real Backspace/
;; Delete/typed-replacement in an event loop) check has-selection? first
;; and fall back to backspace-at-cursor/delete-forward-at-cursor/
;; insert-at-cursor instead, the same real "check the precondition, pick
;; the right op" shape this whole file already establishes.
(defn delete-selection [(!buf : &Buffer) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (if (has-selection? !buf)
    (let [start (selection-start !buf)
          end (selection-end !buf)
          text (get-field !buf :text)
          len (string/length text)
          before (string/substring text 0 start dest)
          after (string/substring text end len dest)]
      (Ok {:text (string/concat before after dest) :cursor start :selection-anchor -1}))
    (Err OutOfRange)))

;; set-cursor / set-selection -- real mouse-driven cursor positioning
;; and selection (2026-08-27, the last real gap on this editor's own
;; "still not done" list besides redo-coalescing/glyph-atlas/macOS-
;; dylib-bundling -- keyboard Shift+Arrow had been the only selection
;; method until now). Both clamp every position to the real valid
;; range [0, length] -- a real mouse click can report a screen position
;; past the real end of the text (an empty line, clicking below the
;; last line), and this is real, host-driver-computed input, not
;; something a Result/OutOfRange error is useful for.
;;
;; set-cursor is the real mouse-CLICK case: positions the cursor,
;; clears any active selection -- same real "positioning the cursor
;; collapses selection" behavior every plain (non-extending) cursor
;; move already establishes.
(defn set-cursor [(!buf : &Buffer) (pos : I32)] : Buffer
  (let [text (get-field !buf :text)
        len (string/length text)
        clamped (if (< pos 0) 0 (if (> pos len) len pos))]
    {:text text :cursor clamped :selection-anchor -1}))

;; set-selection is the real mouse-DRAG case: explicitly sets BOTH the
;; anchor (where the drag started) and the cursor (where the mouse
;; currently is) to arbitrary positions -- the real, minimal complement
;; to extend-selection-*, which can only move the cursor by ONE unit
;; at a time from wherever it already is; a real mouse drag needs to
;; jump the cursor straight to wherever the pointer now is.
(defn set-selection [(!buf : &Buffer) (anchor : I32) (cursor : I32)] : Buffer
  (let [text (get-field !buf :text)
        len (string/length text)
        clamped-anchor (if (< anchor 0) 0 (if (> anchor len) len anchor))
        clamped-cursor (if (< cursor 0) 0 (if (> cursor len) len cursor))]
    {:text text :cursor clamped-cursor :selection-anchor clamped-anchor}))
