;; stdlib/editor/buffer.prn — depends on string. Design: STDLIB.md
;; "editor/buffer" section, NORTHSTAR.md's own module table.
;;
;; Rewritten 2026-08-26, founder real-time: "continue working on parena
;; editor" -- the shell-specific undecided-ness this file's own original
;; header comment flagged ("FFI into whatever the chosen shell owns")
;; is resolved now: the shell IS SDL2 (stdlib/sdl2.prn's own real window/
;; renderer/text-rendering work shipped earlier the same day), and this
;; is the real, first, in-PARENA text buffer it edits.
;;
;; Real design departure from the original sketch, forced by two real,
;; confirmed VS0 emitter limits (not guessed at -- both hit live trying
;; the original shape): (1) no struct field mutation exists yet (no
;; `set-field!` or equivalent anywhere in this compiler) -- so a Buffer
;; is NOT mutated in place; insert/delete-range/insert-at-cursor/
;; backspace-at-cursor all return a real, NEW Buffer value via Result,
;; and the caller rebinds its own local (`(let [buf2 (insert-at-cursor
;; buf ch dest)] ...)`), the honest, buildable-today shape rather than a
;; mutable one. (2) tuple return types aren't supported (confirmed live:
;; a real "unsupported return type form" error) -- the original
;; `selection : (Option (I32 I32))` can't compile as written; dropped
;; entirely for v0 rather than worked around, since nothing in this pass
;; needs a selection concept yet (no selection UI exists) -- real,
;; separate, deferred work once something actually needs it, matching
;; this whole stdlib's "expand the API only when a new feature needs it"
;; pattern, not silently designed around blind.
;;
;; cursor-tracking replaces the original's own more abstract `selection`
;; entry point for this same reason -- a single I32 cursor position is
;; the real, minimal, useful thing a keyboard-driven single-line edit
;; loop needs (insert-at-cursor/backspace-at-cursor), not a speculative
;; richer model nothing calls yet.

(module editor/buffer)
(import string)
(export new from-text active-text cursor-pos insert delete-range
        insert-at-cursor backspace-at-cursor delete-forward-at-cursor
        move-cursor-left move-cursor-right move-cursor-home move-cursor-end
        Buffer BufferError)

(defstruct Buffer
  (text   : String @ Region)
  (cursor : I32))

(defenum BufferError
  (OutOfRange))

(defn new [(dest : Arena @ Region)] : Buffer @ Region
  {:text "" :cursor 0})

;; from-text -- real constructor for loading an existing string into a
;; Buffer (2026-08-26, the real save/load path an actual editor needs).
;; Cursor starts at the real end of the loaded text, matching how a
;; real editor drops you at the end of whatever you just opened.
(defn from-text [(text : String @ Region)] : Buffer @ Region
  {:text text :cursor (string/length text)})

(defn active-text [(!buf : &Buffer)]
  : String @ Region
  (get-field !buf :text))

(defn cursor-pos [(!buf : &Buffer)]
  : I32
  (get-field !buf :cursor))

;; insert -- NORTHSTAR.md's own documented entry point, real value-
;; semantics shape (see this file's own header comment for why). Cursor
;; position is left unchanged -- callers editing at an arbitrary offset
;; are responsible for their own cursor bookkeeping; insert-at-cursor
;; below is the real convenience path a keyboard loop actually wants.
(defn insert [(!buf : &Buffer) (pos : I32) (text : String @ Region) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [cur (get-field !buf :text)
        len (string/length cur)]
    (if (or (< pos 0) (> pos len))
      (Err OutOfRange)
      (let [before (string/substring cur 0 pos dest)
            after (string/substring cur pos len dest)
            combined (string/concat (string/concat before text dest) after dest)]
        (Ok {:text combined :cursor (get-field !buf :cursor)})))))

(defn delete-range [(!buf : &Buffer) (start : I32) (end : I32) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [cur (get-field !buf :text)
        len (string/length cur)]
    (if (or (< start 0) (> end len) (> start end))
      (Err OutOfRange)
      (let [before (string/substring cur 0 start dest)
            after (string/substring cur end len dest)]
        (Ok {:text (string/concat before after dest) :cursor (get-field !buf :cursor)})))))

;; insert-at-cursor / backspace-at-cursor -- the real, minimal pair a
;; keyboard-driven single-line edit loop needs (SDL_TEXTINPUT ->
;; insert-at-cursor, backspace keydown -> backspace-at-cursor). Cursor
;; genuinely advances/retreats, unlike plain insert/delete-range above.
(defn insert-at-cursor [(!buf : &Buffer) (text : String @ Region) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [pos (get-field !buf :cursor)
        cur (get-field !buf :text)
        len (string/length cur)]
    (if (or (< pos 0) (> pos len))
      (Err OutOfRange)
      (let [before (string/substring cur 0 pos dest)
            after (string/substring cur pos len dest)
            combined (string/concat (string/concat before text dest) after dest)
            advance (string/length text)]
        (Ok {:text combined :cursor (+ pos advance)})))))

(defn backspace-at-cursor [(!buf : &Buffer) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [pos (get-field !buf :cursor)]
    (if (<= pos 0)
      (Err OutOfRange)
      (let [cur (get-field !buf :text)
            len (string/length cur)
            before (string/substring cur 0 (- pos 1) dest)
            after (string/substring cur pos len dest)]
        (Ok {:text (string/concat before after dest) :cursor (- pos 1)})))))

;; move-cursor-left / move-cursor-right -- real Left/Right arrow-key
;; support (sdl2/key-left, sdl2/key-right were added alongside
;; key-backspace/key-return but never actually wired into a real edit
;; loop until now). Clamps at the buffer's own edges rather than
;; erroring -- a real editor's own arrow key just stops doing anything
;; at the start/end of the line, that's not a failure case worth a
;; Result here the way an out-of-range insert/delete genuinely is.
(defn move-cursor-left [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)]
    (if (<= pos 0)
      {:text text :cursor 0}
      {:text text :cursor (- pos 1)})))

(defn move-cursor-right [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)
        len (string/length text)]
    (if (>= pos len)
      {:text text :cursor len}
      {:text text :cursor (+ pos 1)})))

;; move-cursor-home / move-cursor-end -- real Home/End key support
;; (2026-08-26, the next real keys a single-line edit loop needs once
;; Left/Right exist). Always succeeds -- jumping to a position the
;; cursor is already at is a real, harmless no-op, not an error.
;;
;; Real, corrected 2026-08-26 (same day, after real multi-line editing
;; shipped): originally jumped to the start/end of the WHOLE buffer --
;; correct for a single-line buffer (where "start of buffer" and "start
;; of line" are the same position), but genuinely wrong real editor UX
;; once multi-line text exists (real editors' own plain Home/End mean
;; "start/end of the CURRENT line," not the document -- Ctrl+Home/
;; Ctrl+End is the usual whole-document shortcut, and this stdlib has no
;; modifier-key detection yet to offer that separately). Made real and
;; line-aware here instead of leaving the old, now-misleading
;; whole-buffer behavior under the same name.
(defn move-cursor-home [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)]
    {:text text :cursor (line-start-before text pos)}))

(defn move-cursor-end [(!buf : &Buffer)] : Buffer
  (let [pos (get-field !buf :cursor)
        text (get-field !buf :text)]
    {:text text :cursor (line-end-after text pos (string/length text))}))

;; line-start-before / line-end-after -- real, minimal backward/forward
;; scans for the nearest real newline (ASCII 10) around `pos`, the
;; actual boundary of the CURRENT line. Real, honest, simple linear
;; scan -- no line-index cache, matching this buffer's own already-
;; established "real, simple, not optimized" tradeoff (render-text's
;; own fresh-surface-per-call design carries the identical judgment).
(defn line-start-before [(text : String @ Region) (pos : I32)] : I32
  (if (<= pos 0)
    0
    (if (= (string/char-at text (- pos 1)) 10)
      pos
      (line-start-before text (- pos 1)))))

(defn line-end-after [(text : String @ Region) (pos : I32) (len : I32)] : I32
  (if (>= pos len)
    len
    (if (= (string/char-at text pos) 10)
      pos
      (line-end-after text (+ pos 1) len))))

;; delete-forward-at-cursor -- the real Delete key: removes the
;; character AHEAD of the cursor (Backspace/backspace-at-cursor already
;; covers the one behind it). Real, honest OutOfRange when the cursor is
;; already at the real end of the text -- nothing ahead of it to delete,
;; same "clamped movement is fine, deleting nothing is an error" split
;; backspace-at-cursor's own header comment already establishes.
(defn delete-forward-at-cursor [(!buf : &Buffer) (dest : Arena @ Region)]
  : (Result Buffer BufferError) @ Region
  (let [pos (get-field !buf :cursor)
        cur (get-field !buf :text)
        len (string/length cur)]
    (if (>= pos len)
      (Err OutOfRange)
      (let [before (string/substring cur 0 pos dest)
            after (string/substring cur (+ pos 1) len dest)]
        (Ok {:text (string/concat before after dest) :cursor pos})))))
