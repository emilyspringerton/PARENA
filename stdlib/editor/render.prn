;; stdlib/editor/render.prn — depends on string, sdl2, editor/textmate,
;; editor/theme. Ties everything shipped this session together for
;; real: tokenize a real line with a real grammar, color each token with
;; a real theme, draw it through the real SDL2 renderer/font -- the
;; concrete "see real syntax-highlighted PARENA source on screen" moment
;; founder real-time "start adding all of the features of textmate" ->
;; "ALL THE FEATURES" was aiming at.

(module editor/render)
(import string)
(import regex/syntax)
(import regex/pcre)
(import editor/textmate)
(import editor/theme)
(export render-highlighted-line render-highlighted-text)

;; render-highlighted-line -- tokenizes `line` with `rules`, draws each
;; token in its own theme color at (x, y), advancing x by each token's
;; own real measured pixel width so tokens sit flush against each other
;; (no per-glyph atlas/kerning cache yet -- editor/textmate.prn's own
;; render-text is already a real, honest "fresh surface per call" v0;
;; this composes on top of that same tradeoff, not a new one). An
;; untokenized (empty-scope) span still gets drawn, in the theme's own
;; real default color -- real whitespace/punctuation between real
;; tokens needs to occupy real screen space too, not be silently
;; skipped, or every token after the first would visually collide.
(defn render-highlighted-line [(!ren : &Renderer) (!f : &Font) (rules : &(Vec TmRule))
                                (line : String @ Region) (x : I32) (y : I32) (dest : Arena @ Region)]
  : (Result Unit Sdl2Error) @ Region
  (let [tokens (editor/textmate/tokenize-line rules line dest)]
    (render-tokens !ren !f line &tokens 0 x y dest)))

(defn render-tokens [(!ren : &Renderer) (!f : &Font) (line : String @ Region) (tokens : &(Vec Token))
                      (i : I32) (x : I32) (y : I32) (dest : Arena @ Region)]
  : (Result Unit Sdl2Error) @ Region
  (if (>= i (vec/len tokens))
    (Ok unit)
    (let [tok (vec/get tokens i)
          span (string/substring line (get-field tok :start) (get-field tok :end) dest)]
      (if (string/str-eq? span " ")
        (render-tokens !ren !f line tokens (+ i 1) (+ x (sdl2/measure-text-width !f " ")) y dest)
        (let [color (editor/theme/color-for-scope (get-field tok :scope))]
          (match (sdl2/render-text !ren !f span x y (get-field color :r) (get-field color :g) (get-field color :b) dest)
            ((Err e) (Err e))
            ((Ok u)
              (render-tokens !ren !f line tokens (+ i 1) (+ x (sdl2/measure-text-width !f span)) y dest))))))))

;; render-highlighted-text -- real multi-line support (2026-08-26): splits
;; `text` on real newline characters (string/split, single-char
;; delimiter, already real and working) and draws each real line via
;; render-highlighted-line above, at increasing Y (line-height apart).
;; Buffer.text itself needed no change to support this -- it's already
;; a plain String, and a String can already hold embedded '\n' bytes;
;; only rendering (and, on the host-driver side, cursor row/column
;; tracking) needed real multi-line awareness, not the buffer's own
;; core representation.
;; render-highlighted-text -- real, confirmed-live crash fixed here
;; (2026-08-27, founder real-time: opening a real ~2MB/57k-line file
;; "crashes... we need to open it streaming or whatever"). This used
;; to walk every line via a real, plain SELF-RECURSIVE FUNCTION CALL
;; (render-lines calling itself once per line, not a real loop/recur),
;; one real C stack frame per line -- for a real 57,524-line file,
;; that's 57,524 levels of C call-stack depth. gcc's own tail-call
;; optimization isn't guaranteed for this shape (the call sits inside
;; a match arm, itself inside a let, itself inside an if -- not a
;; textually bare tail call gcc is certain to fold even at -O2), and
;; the confirmed-live symptom (a real, reproducible crash opening a
;; real 2.7MB/57,524-line PARENA_CONSTRUCT.txt, with a default 8MB
;; stack -- ulimit -s 8192) matches a real stack overflow exactly.
;; Rewritten as a real loop/recur -- the same real, proven, genuinely
;; iterative (no growing C call stack) construct every other line-at-
;; a-time walk in this stdlib already uses -- so file size no longer
;; bounds this function's own real stack depth at all.
(defn render-highlighted-text [(!ren : &Renderer) (!f : &Font) (rules : &(Vec TmRule))
                                (text : String @ Region) (x : I32) (y : I32) (line-height : I32)
                                (dest : Arena @ Region)]
  : (Result Unit Sdl2Error) @ Region
  (let [lines (string/split text "\n" dest)]
    (loop [i 0]
      (if (>= i (vec/len &lines))
        (Ok unit)
        (let [line (vec/get &lines i)]
          (match (render-highlighted-line !ren !f rules line x (+ y (* i line-height)) dest)
            ((Err e) (Err e))
            ((Ok u) (recur (+ i 1)))))))))
