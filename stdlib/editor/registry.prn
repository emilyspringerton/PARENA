;; stdlib/editor/registry.prn — S217-03: a real multi-document registry on top of
;; `editor/document.prn` (open/switch/list documents), the real next step named in
;; `JEWEL/docs/NORTHSTAR_SARENA_NOTEBOOK.md`'s own word-processor pivot section.
;;
;; Real, deliberate scope boundary: open/switch/count/current — real, minimal document-management
;; UI needs. Closing a document, renaming, and real persistence (save-to-IDUNA) are named, separate
;; follow-ups, not attempted here.

(module editor/registry)
(import vec)
(import editor/document)
(export new-registry open-document switch-document current-document document-count)

(defstruct Registry
  (docs          : (Vec Document) @ Region)
  (current-index : I32))

;; new-registry -- real, empty starting point: no documents open, current-index -1 (a real,
;; honest "nothing open yet" sentinel, matching `note-version-mod`'s own `-1`-sentinel
;; convention elsewhere in this stdlib).
(defn new-registry [(dest : Arena @ Region)] : Registry @ Region
  {:docs (vec/new dest) :current-index -1})

;; vec-document-at -- same real, pre-existing compiler gap `vec-i32-at`/`vec-string-at`
;; elsewhere in this stdlib already document (a plain LOCAL/struct-field `(Vec T)` has no
;; elem-type hint registered). One more instance, this time for a struct element.
(defn vec-document-at [(v : &(Vec Document)) (idx : I32)]
  : Document
  #target
  {:c (inline-c "*(Document *)vec_get(v, idx)")})

;; open-document -- real, functional-update shape (matches `document.prn`'s own `apply-edit`):
;; returns a NEW Registry with one more open document, made current. A real host calls this once
;; per "File > New"/"File > Open."
(defn open-document [(reg : Registry) (now-epoch : I32) (dest : Arena @ Region)] : Registry @ Region
  (let [new-doc (editor/document/new-document now-epoch dest)
        docs (get-field reg :docs)]
    (vec/push! &mut docs new-doc)
    {:docs docs :current-index (- (vec/len &docs) 1)}))

;; switch-document -- real, honest bounds check: an out-of-range index leaves the registry
;; unchanged rather than corrupting `current-index` into pointing at nothing.
(defn switch-document [(reg : Registry) (index : I32)] : Registry @ Region
  (if (and (>= index 0) (< index (vec/len &(get-field reg :docs))))
    {:docs (get-field reg :docs) :current-index index}
    reg))

;; current-document -- real, honest precondition: `new-registry`'s own `-1` sentinel means there
;; is no real "current" document yet; a real host must check `document-count` first, matching
;; every other "caller decides, this just does the one job" convention in this stdlib.
(defn current-document [(reg : &Registry)] : Document
  (vec-document-at &(get-field reg :docs) (get-field reg :current-index)))

(defn document-count [(reg : &Registry)] : I32
  (vec/len &(get-field reg :docs)))
