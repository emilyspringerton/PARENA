;; stdlib/tyler/voice_mod.prn -- MODE_TYLER voice-line fit decisions, real PARENA mod.
;; Founder real-time (2026-10-01): "dive into the TTS stuff with parena some kind of edge tts
;; model" -> "in terms of SHANKPIT TYLER mode". Real finding that motivated this mod: rendering
;; VH01's eight beats with Piper (local ONNX TTS, TYLER/tts/render_vh01.py) showed 4 of 8 clips
;; overrun their beat's hold_ms in SHANKPIT/packages/simulation/tyler_coldopen.c (beat 0 packs
;; two spoken lines into a 3000ms hold; beat 4's line is ~5.9s against 3000ms). This mod owns the
;; DECISION (does the clip fit; speed it up or stretch the beat), the host owns clocks and audio.
;; Same "mods first" split as cutscene_mod.prn. All times integer ms; speed in permille.
;; Wired into SHANKPIT (2026-10-01): packages/simulation/tyler_voice_mod.c is this file's `parena build`
;; output (scripts/gen_tyler_voice_mod.sh there). The first five functions size beat holds around the
;; clips; the last four (line-state, seek, duck target, duck step) are the playback decisions the host's
;; coordinator (tyler_coldopen.c) and audio callback (packages/audio/vo_mix.h) call -- the host owns
;; clocks, files and the mixer, this mod owns every decision. The Piper clips themselves are a
;; LABELED STOPGAP; these decisions are independent of how the audio was produced.

(module tyler/voice-mod)
(export on-tyler-voice-required-hold-ms)
(export on-tyler-voice-clip-fits)
(export on-tyler-voice-speedup-permille)
(export on-tyler-voice-plan)
(export on-tyler-voice-stretched-hold-ms)
(export on-tyler-voice-line-state)
(export on-tyler-voice-seek-ms)
(export on-tyler-duck-target-permille)
(export on-tyler-duck-step-permille)

;; Plan codes (host switches on these).
(defn voice-plan-as-is [] : I32 0)
(defn voice-plan-speed-up [] : I32 1)
(defn voice-plan-stretch-hold [] : I32 2)

;; Beat must cover lead-in silence + clip + tail pause before the next beat's first line.
(defn on-tyler-voice-required-hold-ms [(clip-ms : I32) (lead-ms : I32) (tail-ms : I32)] : I32
  (+ (+ clip-ms lead-ms) tail-ms))

(defn on-tyler-voice-clip-fits [(clip-ms : I32) (hold-ms : I32)] : Bool
  (<= clip-ms hold-ms))

;; Speed multiplier (permille, 1000 = unchanged) needed to squeeze clip-ms into hold-ms.
(defn on-tyler-voice-speedup-permille [(clip-ms : I32) (hold-ms : I32)] : I32
  (if (<= clip-ms hold-ms)
    1000
    (/ (* clip-ms 1000) hold-ms)))

;; Fits -> as-is; needs <= max-speedup-permille (speech stays intelligible, e.g. 1250) -> speed up
;; (Piper --length-scale = 1/speed); otherwise -> stretch the beat's hold instead.
(defn on-tyler-voice-plan [(clip-ms : I32) (hold-ms : I32) (max-speedup-permille : I32)] : I32
  (if (<= clip-ms hold-ms)
    (voice-plan-as-is)
    (if (<= (on-tyler-voice-speedup-permille clip-ms hold-ms) max-speedup-permille)
      (voice-plan-speed-up)
      (voice-plan-stretch-hold))))

;; New hold for the stretch plan: clip + pad, never shorter than the authored hold.
(defn on-tyler-voice-stretched-hold-ms [(clip-ms : I32) (hold-ms : I32) (pad-ms : I32)] : I32
  (if (> (+ clip-ms pad-ms) hold-ms)
    (+ clip-ms pad-ms)
    hold-ms))

;; ---- playback decisions (MODE_TYLER voice) ----------------------------------------------------------
;; Per-line scheduling decision. The host calls this every frame for each line of the current beat
;; (elapsed-ms = time since the beat started; offset-ms = where the line starts inside the beat).
;;   0 = pending  (the line's offset has not been reached yet)
;;   1 = playing  (elapsed is inside [offset, offset + dur): start it now, or keep it going)
;;   2 = over     (elapsed is past offset + dur: a late joiner must NOT start it)
(defn on-tyler-voice-line-state [(elapsed-ms : I32) (offset-ms : I32) (dur-ms : I32)] : I32
  (if (< elapsed-ms offset-ms)
    0
    (if (>= elapsed-ms (+ offset-ms dur-ms)) 2 1)))

;; Seek (ms into the clip) for a line first seen at elapsed-ms: 0 for an on-time start, > 0 for a late
;; joiner or a lost-packet recovery so the voice lines up with the actors again.
(defn on-tyler-voice-seek-ms [(elapsed-ms : I32) (offset-ms : I32)] : I32
  (if (> elapsed-ms offset-ms) (- elapsed-ms offset-ms) 0))

;; Ducking target for the non-voice (SFX) bus, permille (1000 = unity): duck while any voice is active
;; (the host extends "active" by a hold so the 300 ms gap between two lines in one beat does not pump).
(defn on-tyler-duck-target-permille [(voices-active : I32) (duck-permille : I32)] : I32
  (if (> voices-active 0) duck-permille 1000))

;; One linear-ramp smoothing step of the duck gain, called from the audio callback with the callback's
;; own dt. Rates are permille per ms: down (attack) when target < cur, up (release) otherwise. Never
;; overshoots the target.
(defn on-tyler-duck-step-permille [(cur : I32) (target : I32) (dt-ms : I32) (attack-ms : I32) (release-ms : I32)] : I32
  (if (> cur target)
    (let [step (/ (* dt-ms 1000) attack-ms)]
      (if (< (- cur target) step) target (- cur step)))
    (if (< cur target)
      (let [step (/ (* dt-ms 1000) release-ms)]
        (if (< (- target cur) step) target (+ cur step)))
      cur)))
