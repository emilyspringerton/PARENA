;; stdlib/shankpit460/sp_mem.prn -- shankpit-460 web engine: linear-memory map, accessors, math.
;;
;; Founder real-time 2026-10-16: "ADD SHANKPIT 460 as a first class citizen to WOTAN ... THE GAME IS PORTED
;; TO WASM AND TYPESCRIPT VIA PARENA, SAME THING WE JUST DID FOR BRAWLPIT WEB". Same shape as BRAWLPIT web:
;; the whole game -- simulation, bots, 3D software renderer, menus, the matchmaking wire protocol -- is PARENA
;; compiled to wasm32 (scripts/build_shankpit460_wasm.sh: parena build -> opt -> llc -> wasm-ld, no
;; Emscripten). The page host (sp_host.prn, PARENA -> TypeScript) only does what a browser alone can do.
;;
;; NO MALLOC: no allocator, no imports, memory never grows. Every record has a fixed address below.
;;
;; Memory map (byte addresses; module linked with 8 MB, fixed):
;;   0x020000 CTL      input: key table, mouse, pad slots               (sp_input.prn)
;;   0x021000 G        global state words                               (g-* below)
;;   0x022000 PLAYERS  10 x 512 bytes, 128 words each                   (sp_fields.prn)
;;   0x024000 PROJ     64 x 64 bytes                                    (storm-sniper projectiles)
;;   0x025000 TRACERS  32 x 64 bytes                                    (hitscan tracer lines)
;;   0x026000 PARTS    128 x 64 bytes                                   (impact sparks)
;;   0x028000 MAP      64 boxes x 32 bytes, then 16 spawns x 16 bytes   (sp_map.prn)
;;   0x02A000 NAMES    10 x 32 bytes, NUL-terminated ASCII
;;   0x02B000 NETIN    8 KB   messages from the matchmaking server      (sp_net.prn)
;;   0x02D000 NETOUT   8 KB   messages for the server
;;   0x02F000 TOKEN    2 KB   the IDUNA bearer token, written by the page
;;   0x030000 FONT     255 glyphs x 16 rows
;;   0x031000 FEED     8 kill-feed lines x 64 bytes
;;   0x032000 BOARD    scoreboard rows built for the end screen
;;   0x100000 FB       640 x 360 RGBA framebuffer
;;   0x200000 ZB       640 x 360 F32 depth buffer
;;   0x300000 SND      sound event ring (page plays them)

(module shankpit460/engine)

;; ---- region bases -----------------------------------------------------------------------
(defn ctl-base [] : I32 131072)
(defn g-base [] : I32 135168)
(defn players-base [] : I32 139264)
(defn proj-base [] : I32 147456)
(defn tracer-base [] : I32 151552)
(defn part-base [] : I32 155648)
(defn map-base [] : I32 163840)
(defn spawn-base [] : I32 165888)
(defn names-base [] : I32 172032)
(defn netin-base [] : I32 176128)
(defn netout-base [] : I32 184320)
(defn token-base [] : I32 192512)
(defn font-base [] : I32 196608)
(defn feed-base [] : I32 200704)
(defn board-base [] : I32 204800)
(defn snd-base [] : I32 3145728)
(defn fb-base [] : I32 1048576)
(defn zb-base [] : I32 2097152)

(defn fb-w [] : I32 640)
(defn fb-h [] : I32 360)

(defn max-players [] : I32 10)
(defn max-proj [] : I32 64)
(defn max-tracers [] : I32 32)
(defn max-parts [] : I32 128)

(defn pl-base [(p : I32)] : I32 (+ (players-base) (* p 512)))
(defn pj-base [(q : I32)] : I32 (+ (proj-base) (* q 64)))
(defn tr-base [(t : I32)] : I32 (+ (tracer-base) (* t 64)))
(defn pa-base [(f : I32)] : I32 (+ (part-base) (* f 64)))
(defn name-addr [(p : I32)] : I32 (+ (names-base) (* (clamp-i p 0 9) 32)))

;; generic by-index word access (for helpers that take a field index)
(defn pi [(p : I32) (k : I32)] : I32 (load32 (+ (pl-base p) (shl k 2))))
(defn pi! [(p : I32) (k : I32) (v : I32)] : Unit (store32! (+ (pl-base p) (shl k 2)) v))

;; ---- global state words ------------------------------------------------------------------
(defn gi [(k : I32)] : I32 (load32 (+ (g-base) (shl k 2))))
(defn gi! [(k : I32) (v : I32)] : Unit (store32! (+ (g-base) (shl k 2)) v))
(defn gf [(k : I32)] : F32 (loadf32 (+ (g-base) (shl k 2))))
(defn gf! [(k : I32) (v : F32)] : Unit (storef32! (+ (g-base) (shl k 2)) v))

;; simulation
(defn g-tick [] : I32 0)           ; server_tick: sim ticks since match start
(defn g-rng [] : I32 1)
(defn g-me [] : I32 2)             ; the local human's slot
(defn g-mode [] : I32 3)           ; 0 bot match (local sim authority), 1 human FFA (server authority)
(defn g-match-left [] : I32 4)     ; ticks of match time left
(defn g-match-total [] : I32 5)
(defn g-kill-limit [] : I32 6)
(defn g-winner [] : I32 7)         ; slot, or -1
(defn g-end-reason [] : I32 8)     ; 1 kills, 2 time, 3 abandoned
(defn g-bot-level [] : I32 9)      ; 1 easy, 2 normal, 3 hard
(defn g-match-no [] : I32 10)      ; matches started this session
(defn g-countdown [] : I32 11)     ; ticks of READY/3/2/1 before the sim runs
(defn g-sim-frozen [] : I32 12)
;; session / screens
(defn g-phase [] : I32 16)         ; 0 title, 1 playing, 2 match end, 3 match found (interstitial)
(defn g-frame [] : I32 17)
(defn g-clock-acc [] : I32 18)     ; F32 ms owed to the fixed-step sim
(defn g-ticker [] : I32 19)        ; wall-clock ms as I32 (animation only, never sim)
(defn g-locked [] : I32 20)        ; 1 = pointer is captured by the canvas
(defn g-paused [] : I32 21)
(defn g-ui-t [] : I32 22)          ; frames in the current screen
(defn g-hover [] : I32 23)
(defn g-last-input [] : I32 24)
(defn g-notice-t [] : I32 25)
(defn g-notice-id [] : I32 26)
(defn g-score-open [] : I32 27)    ; TAB held
(defn g-hitmark [] : I32 28)       ; ticks of hit marker left (+ head flag in bit 8)
(defn g-dmg-flash [] : I32 29)     ; ticks of screen damage tint
(defn g-dmg-dir [] : I32 30)       ; F32 bits unused; direction stored in g-dmg-yaw
(defn g-dmg-yaw [] : I32 31)       ; F32: world yaw the last hit came from
(defn g-death-cam [] : I32 32)
(defn g-shake [] : I32 33)
(defn g-streak [] : I32 34)
(defn g-banner-t [] : I32 35)      ; ticks of the big center banner
(defn g-banner-id [] : I32 36)
(defn g-stat-first [] : I32 37)
(defn g-kill-msg-t [] : I32 38)
(defn g-kill-msg-victim [] : I32 39)
(defn g-tab-prev [] : I32 40)
(defn g-nav-prev [] : I32 41)
(defn g-click-prev [] : I32 42)
(defn g-last-kill-tick [] : I32 43)
(defn g-multi [] : I32 44)
;; camera and view
(defn g-cam-yaw [] : I32 48)       ; F32 degrees
(defn g-cam-pitch [] : I32 49)     ; F32
(defn g-fov [] : I32 50)           ; F32 current vertical-ish fov degrees
(defn g-zoom [] : I32 51)          ; right mouse held
(defn g-was-jump [] : I32 52)
(defn g-bob [] : I32 53)           ; F32
(defn g-cam-x [] : I32 54)         ; F32 view origin (set per frame)
(defn g-cam-y [] : I32 55)
(defn g-cam-z [] : I32 56)
(defn g-cam-sy [] : I32 57)        ; F32 sin/cos of view yaw / pitch (per frame)
(defn g-cam-cy [] : I32 58)
(defn g-cam-sp [] : I32 59)
(defn g-cam-cp [] : I32 60)
(defn g-proj-scale [] : I32 61)    ; F32 pixels per unit at z=1
(defn g-sens [] : I32 62)          ; F32 mouse sensitivity multiplier (page setting)
(defn g-view-slot [] : I32 63)     ; whose eyes we are looking through (self, or the killer while dead)
;; net
(defn g-net-state [] : I32 64)     ; 0 off, 1 connecting, 2 open, 3 failed/closed
(defn g-q-state [] : I32 65)       ; 0 idle, 1 searching, 2 match found, 3 in a human match
(defn g-q-count [] : I32 66)       ; humans searching, as the server reports it
(defn g-q-elapsed [] : I32 67)     ; seconds spent searching
(defn g-q-online [] : I32 68)      ; humans online
(defn g-token-len [] : I32 69)
(defn g-name-len [] : I32 70)
(defn g-signed-in [] : I32 71)
(defn g-in-len [] : I32 72)
(defn g-out-len [] : I32 73)
(defn g-net-seq [] : I32 74)
(defn g-net-room [] : I32 75)
(defn g-net-hello [] : I32 76)     ; 1 once the hello went out
(defn g-want-queue [] : I32 77)    ; 1 = the player wants to be searching
(defn g-net-clock [] : I32 78)     ; server ms of the last snapshot
(defn g-net-offset [] : I32 79)    ; local ticker - server ms
