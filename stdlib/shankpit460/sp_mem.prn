(defn g-send-acc [] : I32 81)
(defn g-roster-n [] : I32 82)
(defn g-match-start-ms [] : I32 83)
(defn g-ping-ms [] : I32 84)
(defn g-ping-sent [] : I32 85)
(defn g-net-err [] : I32 86)       ; last server error code
(defn g-found-t [] : I32 87)       ; ticks left in the MATCH FOUND interstitial
(defn g-late-join [] : I32 88)
(defn g-snd-head [] : I32 90)
(defn g-snd-seen [] : I32 91)
(defn g-end-t [] : I32 92)         ; frames on the end screen
(defn g-end-mode [] : I32 93)      ; the mode of the match that just ended
(defn g-end-n [] : I32 94)         ; scoreboard rows
(defn g-end-me [] : I32 95)
(defn g-end-requeue [] : I32 96)
(defn g-feed-head [] : I32 97)
(defn g-online-ok [] : I32 98)     ; the page says matchmaking is reachable (set on socket open)
(defn g-cmd-fwd [] : I32 100)       ; F32: the local player's command for the next tick
(defn g-cmd-str [] : I32 101)       ; F32
(defn g-cmd-jump [] : I32 102)
(defn g-cmd-fire [] : I32 103)
(defn g-cmd-crouch [] : I32 104)
(defn g-cmd-reload [] : I32 105)
(defn g-cmd-ability [] : I32 106)
(defn g-cmd-weapon [] : I32 107)    ; -1 = no change
(defn g-tmp0 [] : I32 120)
(defn g-tmp1 [] : I32 121)
(defn g-tmp2 [] : I32 122)
(defn g-hit-x [] : I32 123)        ; F32 scratch: last ray-hit point
(defn g-hit-y [] : I32 124)
(defn g-hit-z [] : I32 125)
(defn g-hit-t [] : I32 126)        ; F32 scratch: last ray-hit distance
(defn g-box-n [] : I32 127)        ; map box count
(defn g-spawn-n [] : I32 128)
(defn g-crown-x [] : I32 129)
(defn g-crown-y [] : I32 130)
(defn g-crown-z [] : I32 131)

;; ---- tiny integer / float helpers ---------------------------------------------------------
(defn b2i [(c : Bool)] : I32 (if c 1 0))
(defn min-i [(a : I32) (b : I32)] : I32 (if (< a b) a b))
(defn max-i [(a : I32) (b : I32)] : I32 (if (> a b) a b))
(defn clamp-i [(x : I32) (lo : I32) (hi : I32)] : I32 (max-i lo (min-i x hi)))
(defn abs-i [(x : I32)] : I32 (if (< x 0) (- 0 x) x))
(defn fmax2 [(a : F32) (b : F32)] : F32 (if (> a b) a b))
(defn fmin2 [(a : F32) (b : F32)] : F32 (if (< a b) a b))
(defn clamp-f [(x : F32) (lo : F32) (hi : F32)] : F32 (fmax2 lo (fmin2 x hi)))
(defn sq [(x : F32)] : F32 (* x x))
(defn lerp [(a : F32) (b : F32) (t : F32)] : F32 (+ a (* (- b a) t)))

;; ---- PRNG: glibc TYPE_0 LCG, output bits 16..30 (what rand() % 1000 would see) --------------
(defn sp-seed! [(s : I32)] : Unit (gi! (g-rng) s))
(defn sp-rand [] : I32
  (let [s (+ (* (gi (g-rng)) 1103515245) 12345)]
    (gi! (g-rng) s)
    (bit-and (ushr s 16) 32767)))
(defn rnd [(n : I32)] : I32 (mod (sp-rand) (max-i n 1)))
(defn chance [(pct : I32)] : Bool (< (rnd 100) pct))
;; phys_rand_f(): ((float)(rand()%1000)/500.0f) - 1.0f
(defn phys-rand-f [] : F32 (- (/ (f32 (mod (sp-rand) 1000)) 500.0) 1.0))
(defn rand-unit [] : F32 (/ (f32 (mod (sp-rand) 10000)) 10000.0))
;; cosmetics (sparks, sound pitch, camera jitter) draw from their OWN generator, so what the player sees and
;; hears can never change what the simulation rolls
(defn g-rng2 [] : I32 134)
(defn fx-rand [] : I32
  (let [s (+ (* (gi (g-rng2)) 1103515245) 12345)]
    (gi! (g-rng2) s)
    (bit-and (ushr s 16) 32767)))
(defn fx-rnd [(n : I32)] : I32 (mod (fx-rand) (max-i n 1)))
(defn fx-rand-f [] : F32 (- (/ (f32 (mod (fx-rand) 1000)) 500.0) 1.0))
(defn fx-rand-unit [] : F32 (/ (f32 (mod (fx-rand) 10000)) 10000.0))

;; ---- math without libm ---------------------------------------------------------------------
;; sin/cos are evaluated in F64 (range reduction + a Taylor series good to ~1e-10) and rounded to F32,
;; so the result is the correctly rounded float in all but the rarest cases -- the same value glibc's
;; sinf gives -- and the C engine's trig matches to the last bit almost everywhere.
(defn pi-f64 [] : F64 3.141592653589793)
(defn sin64 [(x : F64)] : F64
  (let [(k : F64) (floor (+ (/ x 6.283185307179586) 0.5))
        (r0 : F64) (- x (* k 6.283185307179586))
        (r : F64) (cond (> r0 1.5707963267948966) (- 3.141592653589793 r0)
                        (< r0 -1.5707963267948966) (- -3.141592653589793 r0)
                        :else r0)
        (r2 : F64) (* r r)]
    (* r (+ 1.0 (* r2 (+ -0.16666666666666666
                         (* r2 (+ 0.008333333333333333
                                  (* r2 (+ -0.0001984126984126984
                                           (* r2 (+ 0.0000027557319223985893
                                                    (* r2 (+ -0.00000002505210838544172
                                                             (* r2 0.00000000016059043836821613)))))))))))))))
(defn sinf [(x : F32)] : F32 (f32 (sin64 (f64 x))))
(defn cosf [(x : F32)] : F32 (f32 (sin64 (+ (f64 x) 1.5707963267948966))))

;; atan2 (radians) via the F64 series on the reduced octant; only the bots and the HUD use it
(defn atan64 [(z : F64)] : F64
  ;; |z| <= 1: minimax-quality odd polynomial
  (let [(z2 : F64) (* z z)]
    (* z (+ 0.9998660 (* z2 (+ -0.3302995 (* z2 (+ 0.1801410 (* z2 (+ -0.0851330 (* z2 0.0208351)))))))))))
(defn atan2f [(y : F32) (x : F32)] : F32
  (let [(ay : F64) (f64 (fabs y))
        (ax : F64) (f64 (fabs x))
        (a : F64) (if (and (< ax 0.0000001) (< ay 0.0000001))
                      0.0
                      (if (>= ax ay)
                          (atan64 (/ ay ax))
                          (- 1.5707963267948966 (atan64 (/ ax ay)))))
        (b : F64) (if (< x 0.0) (- 3.141592653589793 a) a)]
    (f32 (if (< y 0.0) (- 0.0 b) b))))

(defn deg2rad [] : F32 0.0174533)           ; the literal physics.h writes inline
(defn rad2deg [] : F32 57.29578)

;; vector length helpers
(defn len2 [(x : F32) (z : F32)] : F32 (sqrt (+ (* x x) (* z z))))
(defn len3 [(x : F32) (y : F32) (z : F32)] : F32 (sqrt (+ (+ (* x x) (* y y)) (* z z))))

;; angle_diff(a, b): a - b wrapped to [-180, 180]
(defn angle-diff [(a : F32) (b : F32)] : F32
  (let [(d : F32) (- a b)]
    (loop [(v : F32) d g 0]
      (cond (and (< v -180.0) (< g 8)) (recur (+ v 360.0) (+ g 1))
            (and (> v 180.0) (< g 8)) (recur (- v 360.0) (+ g 1))
            :else v))))

;; norm_yaw_deg / clamp_pitch_deg (physics.h)
(defn norm-yaw [(yaw : F32)] : F32
  (loop [(v : F32) yaw g 0]
    (cond (and (>= v 360.0) (< g 16)) (recur (- v 360.0) (+ g 1))
          (and (< v 0.0) (< g 16)) (recur (+ v 360.0) (+ g 1))
          :else v)))
(defn clamp-pitch [(p : F32)] : F32
  (cond (> p 89.0) 89.0 (< p -89.0) -89.0 :else p))
