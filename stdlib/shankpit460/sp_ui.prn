;; stdlib/shankpit460/sp_ui.prn -- the screens (title, play, end) and the frame loop.
;;
;; The flow founder asked for, 2026-10-16: press PLAY and you are in a bot match straight away with
;; SEARCHING FOR MATCH on screen; if another human is searching you are both moved into a free-for-all;
;; a human match is first to 16 or six minutes; then an end screen with the score and a requeue button.

(defn tick-ms [] : F32 16.0)

;; ---- buttons ----------------------------------------------------------------------------------------------
(defn in-rect? [(x : I32) (y : I32) (w : I32) (h : I32)] : Bool
  (and (and (>= (pointer-x) x) (< (pointer-x) (+ x w))) (and (>= (pointer-y) y) (< (pointer-y) (+ y h)))))

(defn button [(x : I32) (y : I32) (w : I32) (h : I32) (label : String) (primary : Bool) (hot : Bool)] : Unit
  (let [hover (or hot (in-rect? x y w h))]
    (card x y w h (if primary (rgb 232 190 112) (slate)) (if primary (if hover 245 215) (if hover 200 140))
          (if primary (rgb 255 244 214) (rgb 255 250 240)) (if hover 150 70))
    (draw-text-c label (+ x (/ w 2)) (+ y (/ (- h (if primary 32 16)) 2)) (if primary 2 1) (if primary (rgb 54 44 30) (ink)))))

;; title layout
(defn play-x [] : I32 250) (defn play-y [] : I32 188) (defn play-w [] : I32 140) (defn play-h [] : I32 32)
(defn chip-x [(i : I32)] : I32 (+ 232 (* i 62)))
(defn chip-y [] : I32 250)
;; end layout
(defn rq-x [] : I32 240) (defn rq-y [] : I32 246) (defn rq-w [] : I32 160) (defn rq-h [] : I32 30)

;; ---- starting a session -----------------------------------------------------------------------------------------
(defn start-bot-match! [] : Unit
  (do
    (setup-bot-match! (gi (g-bot-level)))
    (gi! (g-phase) 1)
    (gi! (g-ui-t) 0)
    (gi! (g-paused) 0)
    (gi! (g-q-state) (if (!= (gi (g-want-queue)) 0) 1 0))
    (gi! (want-weapon) 1)
    (snd-ui! 15)))

;; PLAY: a bot match now, and into the queue for a human one
(defn begin-session! [] : Unit
  (do
    (gi! (g-want-queue) 1)
    (net-want-queue!)
    (start-bot-match!)))

;; REQUEUE from the end screen
(defn requeue! [] : Unit
  (do
    (net-leave-room!)
    (gi! (g-want-queue) 1)
    (net-want-queue!)
    (start-bot-match!)))

(defn go-title! [] : Unit
  (do (net-leave-room!) (gi! (g-want-queue) 0) (gi! (g-phase) 0) (gi! (g-ui-t) 0) (snd-ui! 15)))

;; a click on the canvas (host calls this synchronously so it can request pointer lock in the same gesture)
(defn ui-click! [] : Unit
  (let [ph (gi (g-phase))]
    (cond
      (= ph 0)
        (cond
          (in-rect? (play-x) (play-y) (play-w) (play-h)) (begin-session!)
          (in-rect? (chip-x 0) (chip-y) 58 18) (do (gi! (g-bot-level) 1) (snd-ui! 15))
          (in-rect? (chip-x 1) (chip-y) 58 18) (do (gi! (g-bot-level) 2) (snd-ui! 15))
          (in-rect? (chip-x 2) (chip-y) 58 18) (do (gi! (g-bot-level) 3) (snd-ui! 15))
          :else unit)
      (= ph 2)
        (when (and (> (gi (g-end-t)) 20) (in-rect? (rq-x) (rq-y) (rq-w) (rq-h))) (requeue!))
      :else unit)))

;; keyboard on the menus
(defn ui-keys! [] : Unit
  (let [ph (gi (g-phase))
        go (or (key-hit? (kc-enter)) (or (key-hit? (kc-space)) (any-pad-hit? (pb-a))))]
    (cond
      (= ph 0) (cond go (begin-session!)
                     (key-hit? (kc-left)) (gi! (g-bot-level) (max-i 1 (- (gi (g-bot-level)) 1)))
                     (key-hit? (kc-right)) (gi! (g-bot-level) (min-i 3 (+ (gi (g-bot-level)) 1)))
                     :else unit)
      (= ph 2) (cond (and go (> (gi (g-end-t)) 20)) (requeue!)
                     (key-hit? (kc-esc)) (go-title!)
                     :else unit)
      :else unit)))

;; ---- cameras -----------------------------------------------------------------------------------------------------------
(defn setup-fog! [] : Unit
  (do (gi! (g-fog) (sky-horizon)) (gf! (g-fog-near) 90.0) (gf! (g-fog-far) 560.0) (gf! (g-fog-inv) (/ 1.0 470.0)) (gf! (g-pe) 0.45)))

(defn game-camera! [(alpha : F32)] : Unit
  (let [me (gi (g-me))
        (x : F32) (lerp-pos me 0 alpha)
        (y : F32) (lerp-pos me 1 alpha)
        (z : F32) (lerp-pos me 2 alpha)
        (eye : F32) (- (c-eye-height) (if (!= (p-crouching me) 0) 1.0 0.0))
        (sh : F32) (* (f32 (gi (g-shake))) 0.012)
        (target : F32) (if (and (!= (gi (g-zoom)) 0) (alive? me)) 20.0 75.0)]
    (gf! (g-fov) (+ (gf (g-fov)) (* (- target (gf (g-fov))) 0.2)))
    (if (alive? me)
        (set-camera! x (+ y eye) z (+ (gf (g-cam-yaw)) (* sh (fx-rand-f))) (+ (gf (g-cam-pitch)) (* sh (fx-rand-f))) (gf (g-fov)))
        ;; dead: stay put, low, and turn slowly toward whoever did it
        (let [k (p-last-damager me)]
          (when (>= k 0)
            (let [(dx : F32) (- (p-x k) (p-x me))
                  (dz : F32) (- (p-z k) (p-z me))
                  (dy : F32) (- (+ (p-y k) 2.6) (+ (p-y me) 1.4))
                  (want-yaw : F32) (norm-yaw (- 0.0 (* (atan2f dx (- 0.0 dz)) (rad2deg))))
                  (want-pitch : F32) (* (atan2f dy (len2 dx dz)) (rad2deg))]
              (gf! (g-cam-yaw) (norm-yaw (+ (gf (g-cam-yaw)) (* (angle-diff want-yaw (gf (g-cam-yaw))) 0.06))))
              (gf! (g-cam-pitch) (+ (gf (g-cam-pitch)) (* (- want-pitch (gf (g-cam-pitch))) 0.06)))))
          (set-camera! x (+ y 1.4) z (gf (g-cam-yaw)) (gf (g-cam-pitch)) 75.0)))))

(defn orbit-camera! [] : Unit
  (let [(t : F32) (* (f32 (gi (g-ticker))) 0.00012)
        (px : F32) (* (sinf t) 170.0)
        (pz : F32) (* (cosf t) 170.0)
        (yaw : F32) (norm-yaw (- 0.0 (* (atan2f (- 0.0 px) (- 0.0 (- 0.0 pz))) (rad2deg))))]
    (set-camera! px 46.0 pz yaw -13.0 70.0)))

;; ---- the 3D scene ---------------------------------------------------------------------------------------------------------
(defn draw-tags! [] : Unit
  (let [me (gi (g-me))]
    (dotimes [i (max-players)]
      (when (and (alive? i) (!= i me))
        (let [(z : F32) (project-point (p-x i) (+ (p-y i) 4.3) (p-z i))]
          (when (and (> z (near-plane)) (< z 100.0))
            (when (line-clear? (gf (g-cam-x)) (gf (g-cam-y)) (gf (g-cam-z)) (p-x i) (+ (p-y i) 2.6) (p-z i))
              ;; the plate floats ABOVE the head: bar just over it, name over the bar, so it never covers the body.
              ;; it is fully visible up close, thins out with distance and is gone by 100 units.
              (let [sx (i32 (gf (g-sx))) sy (i32 (gf (g-sy)))
                    a (- 255 (i32 (* (fmax2 0.0 (- z 30.0)) 3.6)))
                    w (text-width-at (name-addr i) 1)]
                (when (> a 0)
                  (do
                    (draw-text-at (name-addr i) (+ (- sx (/ w 2)) 1) (- sy 21) 1 (ink-shadow))
                    (draw-text-at (name-addr i) (- sx (/ w 2)) (- sy 22) 1 (mix (rgb 120 120 130) (player-hue (p-color i)) (max-i 0 a)))
                    (bar (- sx 14) (- sy 4) 28 2 (/ (f32 (p-health i)) 100.0) (health-color (p-health i)))))))))))))

(defn render-world! [(alpha : F32)] : Unit
  (do
    (setup-fog!)
    (draw-sky!)
    (clear-zbuf!)
    (gi! (g-cs) 0)
    (gi! (g-pa) 255)
    (draw-arena!)
    (draw-players! alpha)
    (draw-projectiles!)
    (draw-particles!)
    (draw-tracers!)))

(defn render-play! [(alpha : F32)] : Unit
  (let [me (gi (g-me))]
    (game-camera! alpha)
    (render-world! alpha)
    (draw-tags!)
    (when (and (alive? me) (not (and (= (p-weapon me) 4) (!= (gi (g-zoom)) 0))))
      (draw-viewmodel! me))
    (draw-hud! me)
    ;; not locked: the game is waiting for a click
    (when (= (gi (g-locked)) 0)
      (fill-rect-a 0 0 640 360 (rgb 24 22 30) 120)
      (panel 188 112 264 128)
      (draw-text-c "CLICK TO PLAY" 320 124 2 (ink))
      (draw-text-c "WASD move   mouse aim   click fire" 320 154 1 (ink-dim))
      (draw-text-c "1-6 weapons   R reload   E ability" 320 170 1 (ink-dim))
      (draw-text-c "Space jump   Ctrl / C crouch   Tab scores" 320 186 1 (ink-dim))
      (draw-text-c (if (= (gi (g-mode)) 1) "the match keeps running while you are away" "paused") 320 212 1 (ink-faint)))))

;; ---- title -----------------------------------------------------------------------------------------------------------------------
(defn render-title! [] : Unit
  (do
    (orbit-camera!)
    (render-world! 1.0)
    (fill-rect-a 0 0 640 360 (rgb 38 40 58) 128)
    (draw-text-c "shankpit-460" 320 70 4 (ink))
    (draw-text-c "a small, quick arena shooter" 320 146 1 (ink-dim))
    (button (play-x) (play-y) (play-w) (play-h) "PLAY" true false)
    (draw-text-c "BOTS" 320 230 1 (ink-faint))
    (dotimes [i 3]
      (let [on (= (+ i 1) (gi (g-bot-level)))]
        (card (chip-x i) (chip-y) 58 18 (if on (rgb 232 190 112) (slate)) (if on 220 130) (rgb 255 250 240) (if (in-rect? (chip-x i) (chip-y) 58 18) 140 56))
        (draw-text-c (case i 0 "EASY" 1 "NORMAL" "HARD") (+ (chip-x i) 29) (+ (chip-y) 1) 1 (if on (rgb 54 44 30) (ink)))))
    (if (and (!= (gi (g-signed-in)) 0) (> (gi (g-name-len)) 0))
        (let [w (+ (+ (* 12 7) 7) (text-width-at (name-buf) 1))
              x0 (- 320 (/ w 2))]
          (draw-text "signed in as" x0 284 1 (ink-faint))
          (draw-text-at (name-buf) (+ x0 (+ (* 12 7) 7)) 284 1 (ink)))
        (draw-text-c "playing as a guest" 320 284 1 (ink-faint)))
    (draw-text-c "WASD  mouse  click to fire  1-6 weapons  Tab scores" 320 328 1 (ink-faint))))

;; ---- end -----------------------------------------------------------------------------------------------------------------------------
(defn end-headline [] : String
  (cond (= (gi (g-end-reason)) 3) "MATCH CLOSED"
        (= (gi (g-winner)) (gi (g-me))) "VICTORY"
        (< (gi (g-winner)) 0) "A DRAW"
        :else "MATCH OVER"))

(defn render-end! [(alpha : F32)] : Unit
  (let [me (gi (g-me))
        w (gi (g-winner))]
    (game-camera! alpha)
    (render-world! alpha)
    (fill-rect-a 0 0 640 360 (rgb 24 22 32) 150)
    (panel 150 26 340 308)
    (draw-text-c (end-headline) 320 34 2 (if (= w me) (amber) (ink)))
    (cond
      (>= w 0)
        (let [who (name-addr w)
              tail (if (= (gi (g-end-reason)) 1) "reached the kill limit" "led when time ran out")
              total (+ (text-width-at who 1) (+ 8 (text-width tail 1)))
              x0 (- 320 (/ total 2))]
          (draw-text-at who x0 76 1 (player-hue (p-color w)))
          (draw-text tail (+ x0 (+ (text-width-at who 1) 8)) 76 1 (ink-faint)))
      (= (gi (g-end-reason)) 3) (draw-text-c "the other players left" 320 76 1 (ink-faint))
      :else (draw-text-c "time ran out with nobody ahead" 320 76 1 (ink-faint)))
    (draw-board! me 166 100 308)
    (button (rq-x) (rq-y) (rq-w) (rq-h) "REQUEUE" true (> (gi (g-end-t)) 20))
    (draw-text-c "Enter to requeue   Esc for the title" 320 (+ (rq-y) 36) 1 (ink-faint))
    (when (!= (gi (g-want-queue)) 0)
      (draw-text-c "still searching for a human match" 320 (+ (rq-y) 52) 1 (ink-faint)))))

;; ---- frame --------------------------------------------------------------------------------------------------------------------------
(defn alpha-now [] : F32 (clamp-f (/ (gf (g-clock-acc)) (tick-ms)) 0.0 1.0))

(defn ui-render! [] : Unit
  (let [ph (gi (g-phase))]
    (cond
      (= ph 0) (render-title!)
      (= ph 1) (render-play! (if (!= (gi (g-paused)) 0) 1.0 (alpha-now)))
      :else (render-end! 1.0))))
