# stdlib/shankpit460/level.manifest -- shankpit-460 as a SHANKPIT level (T0, SHANKPIT/docs/T0_LEVEL_WASM_CONTRACT.md),
# so the SHANKPHONE plays it on SHANKPIT's own wasm3 host (EMILY/BACKLOG.md S635-4). Format: stdlib/brawlpit/level.manifest.
# Build: scripts/build_level_wasm.sh stdlib/shankpit460/level.manifest <out.wasm>

name shankpit460_level
entry stdlib/shankpit460/sp_level.prn

src stdlib/shankpit460/sp_mem.prn
src stdlib/shankpit460/sp_fields.prn
src stdlib/shankpit460/sp_map.prn
src stdlib/shankpit460/sp_map_data.prn
src stdlib/shankpit460/sp_map_w77.prn
src stdlib/shankpit460/sp_map_dust.prn
src stdlib/shankpit460/sp_phys.prn
src stdlib/shankpit460/sp_fx.prn
src stdlib/shankpit460/sp_net.prn
src stdlib/shankpit460/sp_ai.prn
src stdlib/shankpit460/sp_gfx.prn
src stdlib/shankpit460/sp_3d.prn
src stdlib/shankpit460/sp_view.prn
src stdlib/shankpit460/sp_input.prn
src stdlib/shankpit460/sp_hud.prn
src stdlib/shankpit460/sp_sim.prn
src stdlib/shankpit460/sp_rules.prn
src stdlib/shankpit460/sp_ui.prn
src stdlib/shankpit460/sp_main.prn
src stdlib/gfd/term_font.prn
src stdlib/reflux/reflux.prn
src stdlib/reflux/cursor.prn
src stdlib/shankpit460/sp_level.prn

export level_api i()
export level_enter i()
export level_poll i(i)
export level_tick v()
export level_render v()
export level_exit v()
export level_seed v(i)
export level_key v(ii)
export level_pointer v(iii)
export level_blur v()
export level_fb_addr i()
export level_fb_w i()
export level_fb_h i()
export level_asset_addr i(i)
export level_asset_set v(ii)
export level_lost_rows i()
import env.reflux_host_total_dispatched i()
import env.reflux_host_index_for_abs i(i)
import env.reflux_host_oldest_abs i()
import env.reflux_host_action_type_at i(i)
import env.reflux_host_action_a_at i(i)
import env.reflux_host_action_b_at i(i)
import env.reflux_host_action_c_at i(i)
