;; stdlib/firefly/gomega.prn — depends on firefly. Design: STDLIB.md
;; "firefly/gomega" section. Real matcher-chain shape (Expect(x).To
;; (Equal(y))), not a flat assert-eq-only surface -- Gomega's own real
;; value is exactly this composable matcher design.

(module firefly/gomega)
(import firefly)
(export expect to equal be-true be-nil)

(defstruct Expectation
  (actual : &Any)
  (t      : &mut T))

(defn expect [(actual : &Any) (!t : &mut T)]
  : Expectation
  {:actual actual :t !t})

(defn to [(exp : &Expectation) (matcher : (Fn [&Any] Bool))]
  : Unit
  (when (not (matcher (get-field exp :actual)))
    (firefly/errorf (get-field exp :t) "expectation failed")))

(defn equal [(expected : &Any)]
  : (Fn [&Any] Bool)
  (fn [actual] (deep-eq? actual expected)))

(defn be-true []
  : (Fn [&Any] Bool)
  (fn [actual] (= actual true)))

(defn be-nil []
  : (Fn [&Any] Bool)
  (fn [actual] (is-none? actual)))
