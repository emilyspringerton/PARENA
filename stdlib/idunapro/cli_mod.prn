;; stdlib/idunapro/cli_mod.prn — the real first slice of "the CLI for Emily for Business and
;; IDUNA_PRO" (kanban priority-queue card 1199's own literal framing: "iterate on project
;; burrow we need to get that ready to write the cli for emily for business and iduna pro";
;; card 9988: "emily for business CLI written in GO with BURROW"). Compiled via BURROW's own
;; native Go emission target (`burrow build ... -o *.go`), not `parena-c` — `idunapro`'s own
;; host is a real Go binary, the same real reason DUNG's own PARENA mods use the Go target too.
;;
;; Real, deliberate "mods first everything" split, matching every other real PARENA integration
;; in this monorepo: the Go host (cmd/idunapro/main.go, IDUNA_PRO repo) owns everything VS0's Go
;; target genuinely can't do yet -- os.Args parsing, the real HTTP GET to a customer's own
;; IDUNA_PRO instance, stdout/stderr, process exit codes. This mod owns the real DECISION: given
;; a health-check response already fetched by the host, decide what the CLI should actually
;; print and whether the call counts as a real success.
;;
;; Real, honest v0 scope: one real subcommand's worth of decision logic (`idunapro health
;; <base-url>`), not a full CLI framework -- growing this to more subcommands is real, separate,
;; later work, the same "narrowest real slice first" discipline this session's own bstree.prn/
;; explosion_mod.prn additions already established.
;;
;; Real, third-pass upgrade (2026-09-03, cruise-queue card 9988's own next-named prerequisite,
;; closed the same day it was named): BURROW's Go target just shipped real `match`-on-a-user-
;; defenum support. This REPLACES the prior Result/HealthError design (interpret-health-response
;; returning `(Result String HealthError)`, with the host reading HealthError's own exported
;; `.Tag` field directly since match couldn't reach it) with a real `HealthStatus` enum
;; classify-health decides ONCE, then TWO real matches (health-message, health-exit-code) both
;; consume directly -- no Go-side Tag-reading workaround left anywhere. The host is now a pure
;; "fetch bytes, print what PARENA decided" shell, the real end state this whole thread's own
;; "PARENA decides WHAT happened, the host decides HOW to present it" framing was always aiming
;; at -- presentation itself has moved into PARENA too, since match now makes that expressible.

(module idunapro/cli-mod)
(export classify-health health-message health-exit-code)

;; HealthStatus — real, minimal 3-variant enum. Healthy is a real variant here (unlike the prior
;; HealthError design, which only ever modeled the two FAILURE cases and let Result's own Ok arm
;; carry success) -- classify-health returns a bare HealthStatus, not a Result, since the real
;; decision itself ("what state is this response in") is naturally a 3-way choice, not a
;; success/failure split with a nested failure reason.
(defenum HealthStatus
  (Healthy)
  (BadStatus)
  (NotOk))

;; classify-health — real decision: given the real HTTP status code and whether the response
;; body's own "ok" field was true (the host already parsed the real JSON; VS0's Go target has no
;; real JSON/String-manipulation story yet, so that stays host-owned), decide which of the three
;; real states this response is in. Every other function in this file matches on a direct call
;; to this one -- BURROW's own real v0 boundary for match requires the scrutinee to be a direct
;; defn call, not a `let`-bound or parameter-bound value, so classify-health is called fresh at
;; each real match site rather than computed once and threaded through.
(defn classify-health [(status-code : I32) (body-ok : Bool)] : HealthStatus
  (if (not (= status-code 200))
    BadStatus
    (if (not body-ok)
      NotOk
      Healthy)))

;; health-message — the real, final presentation string for a health-check outcome, decided
;; entirely in PARENA now (previously split: Ok's own message lived here, but a real Err's own
;; message was picked host-side by reading HealthError.Tag directly -- see this file's own
;; header comment for the real history).
(defn health-message [(status-code : I32) (body-ok : Bool)] : String
  (match (classify-health status-code body-ok)
    ((Healthy) "IDUNA_PRO instance is healthy")
    ((BadStatus) "unexpected HTTP status (real endpoint responded, but not with 200)")
    ((NotOk) "endpoint responded 200 but its own body reported not-ok")))

;; health-exit-code — the real exit code for a health-check outcome. Both real failure variants
;; (BadStatus/NotOk) map to 1 -- two real, separate match clauses naming the same body rather
;; than a wildcard, since match's own v0 boundary requires exactly one clause per real variant,
;; no fallthrough/wildcard pattern exists yet.
(defn health-exit-code [(status-code : I32) (body-ok : Bool)] : I32
  (match (classify-health status-code body-ok)
    ((Healthy) 0)
    ((BadStatus) 1)
    ((NotOk) 1)))
