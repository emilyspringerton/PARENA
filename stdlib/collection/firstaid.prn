;; stdlib/collection/firstaid.prn -- MacroSync's universal FirstAid macro (founder, 2026-11-14: "i need you to make a
;; universal first aid macro intelligent"). A REFLUX-free rules module; runtime/wow/macrosync.lua makes the client calls.
;;
;; One macro, FirstAid, for every class and every character. It is an ACCOUNT macro (the warrior set already fills all 18
;; character slots), and MacroSync rewrites it for whoever is logged in, whenever what they carry or can do changes:
;;
;;   press        the best bandage you HAVE and are skilled enough to USE -- on your mouseover friend, else your friendly
;;                target, else yourself
;;   shift-press  the best healing potion you have and are high enough level to drink
;;   no bandage   the potion on a plain press
;;   neither      opens First Aid, so you can make some
;;   bandaged     while you are Recently Bandaged (out of combat, when the macro can change): a press still bandages a
;;                friend you mouse over or target, and on yourself drinks the potion instead of being refused
;;
;; "Best" is the most healing. A bandage you carry but cannot use yet (First Aid too low) is skipped, never written --
;; the client would refuse it mid-fight. The macro names items by id (item:1251), so it is the same in every locale.
;; The body carries a marker line, #MacroSync first aid, which is how MacroSync tells its FirstAid from a player's own
;; macro of that name (a # line is not executed).
;;
;; Tables: classic-era bandages and potions -- id, the First Aid skill or character level needed, and the healing.
;; Forever's item ids are not confirmed; they are the classic ones.

(module collection/firstaid)
(export fa-recent-spell fa-macro-name fa-marker fa-bandage-count fa-bandage-id fa-bandage-skill fa-bandage-heal fa-potion-count
        fa-potion-id fa-potion-level fa-potion-heal fa-best-bandage fa-best-potion fa-body fa-ours)

(defn fa-macro-name [] : String "FirstAid")
;; the Recently Bandaged debuff's spell id (classic)
(defn fa-recent-spell [] : I32 11196)
(defn fa-marker [] : String "#MacroSync first aid")

;; ---- bandages: 0 Linen .. 9 Heavy Runecloth -----------------------------------------------------------------------------
(defn fa-bandage-count [] : I32 10)
(defn fa-bandage-id [(i : I32)] : I32
  (cond ((= i 0) 1251) ((= i 1) 2581) ((= i 2) 3530) ((= i 3) 3531) ((= i 4) 6450)
        ((= i 5) 6451) ((= i 6) 8544) ((= i 7) 8545) ((= i 8) 14529) ((= i 9) 14530) (true 0)))
;; the First Aid skill each needs
(defn fa-bandage-skill [(i : I32)] : I32
  (cond ((= i 0) 1) ((= i 1) 40) ((= i 2) 80) ((= i 3) 115) ((= i 4) 150)
        ((= i 5) 180) ((= i 6) 210) ((= i 7) 240) ((= i 8) 260) ((= i 9) 290) (true 9999)))
;; the healing over the 8-second channel
(defn fa-bandage-heal [(i : I32)] : I32
  (cond ((= i 0) 66) ((= i 1) 114) ((= i 2) 161) ((= i 3) 301) ((= i 4) 400)
        ((= i 5) 640) ((= i 6) 800) ((= i 7) 1104) ((= i 8) 1360) ((= i 9) 2000) (true 0)))

;; ---- healing potions: 0 Minor .. 5 Major ----------------------------------------------------------------------------------
(defn fa-potion-count [] : I32 6)
(defn fa-potion-id [(i : I32)] : I32
  (cond ((= i 0) 118) ((= i 1) 858) ((= i 2) 929) ((= i 3) 1710) ((= i 4) 3928) ((= i 5) 13446) (true 0)))
;; the character level each needs
(defn fa-potion-level [(i : I32)] : I32
  (cond ((= i 0) 1) ((= i 1) 3) ((= i 2) 12) ((= i 3) 21) ((= i 4) 35) ((= i 5) 45) (true 9999)))
;; the middle of each potion's healing range
;; ranges (classic): Minor 70-90, Lesser 140-180, Healing 280-360, Greater 455-585, Superior 700-900, Major 1050-1750
(defn fa-potion-heal [(i : I32)] : I32
  (cond ((= i 0) 80) ((= i 1) 160) ((= i 2) 320) ((= i 3) 520) ((= i 4) 800) ((= i 5) 1400) (true 0)))

;; ---- choosing -------------------------------------------------------------------------------------------------------------
;; counts: a Lua array, counts[i + 1] = how many of table row i the character carries.
(defn fa-count-of [(counts : Any) (i : I32)] : I32
  (let [c (lua/aget counts (+ i 1))] (if (lua/nil? c) 0 c)))

;; The usable row with the most healing, walking from the top of the table down (the tables are in healing order).
;; skill < 0 means the client would not say: then every bandage carried counts as usable. -1 = none.
(defn fa-bandage-walk [(counts : Any) (skill : I32) (i : I32)] : I32
  (if (< i 0) -1
    (if (and (> (fa-count-of counts i) 0) (or (< skill 0) (>= skill (fa-bandage-skill i)))) i
      (fa-bandage-walk counts skill (- i 1)))))
(defn fa-best-bandage [(counts : Any) (skill : I32)] : I32
  (fa-bandage-walk counts skill (- (fa-bandage-count) 1)))

(defn fa-potion-walk [(counts : Any) (level : I32) (i : I32)] : I32
  (if (< i 0) -1
    (if (and (> (fa-count-of counts i) 0) (>= level (fa-potion-level i))) i
      (fa-potion-walk counts level (- i 1)))))
(defn fa-best-potion [(counts : Any) (level : I32)] : I32
  (fa-potion-walk counts level (- (fa-potion-count) 1)))

;; ---- the macro --------------------------------------------------------------------------------------------------------------
;; b, p: the rows chosen (-1 none); first-aid: the client's name for the First Aid spell (it opens the profession window);
;; recent: 1 while the player is Recently Bandaged (a minute after any bandage; the game refuses another on YOU, not on a
;; friend). Then a plain press still bandages a friend under the mouse or targeted, and on yourself drinks the potion.
(defn fa-on-friend [] : String "[@mouseover,help,nodead][help,nodead][@player]")
(defn fa-friend-only [] : String "[@mouseover,help,nodead][help,nodead]")

(defn fa-body [(b : I32) (p : I32) (first-aid : String) (recent : I32)] : String
  (let [head (str "#showtooltip\n" (fa-marker) "\n")]
    (if (>= b 0)
      (if (>= p 0)
        (if (= recent 1)
          (str head "/use [mod:shift] item:" (fa-potion-id p) "; " (fa-friend-only) " item:" (fa-bandage-id b)
               "; item:" (fa-potion-id p))
          (str head "/use [mod:shift] item:" (fa-potion-id p) "; " (fa-on-friend) " item:" (fa-bandage-id b)))
        (str head "/use " (fa-on-friend) " item:" (fa-bandage-id b)))
      (if (>= p 0)
        (str head "/use item:" (fa-potion-id p))
        (str head "/cast " first-aid)))))

;; Is this body MacroSync's FirstAid (it carries the marker on its second line)? 1/0. Anything else is the player's.
(defn fa-ours [(body : Any)] : I32
  (if (lua/nil? body) 0
    (if (lua/nil? (lua/call-fn (lua/global "string.find") body (fa-marker) 1 true)) 0 1)))
