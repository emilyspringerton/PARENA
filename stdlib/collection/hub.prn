;; stdlib/collection/hub.prn -- the Collection hub: the settings and status window over every addon in the package
;; (founder, 2026-11-14: "give like some interfaces to see the settings for the different components"). The host
;; glue (runtime/wow/collection_hub.lua) draws it; what it reports is decided here.

(module collection/hub)
(export hub-size hub-state hub-action-mode hub-gold-parts hub-xp-pct hub-roster hub-char-before)

;; Top-level entries of a table, by walking next.
(defn hub-count-walk [(t : Any) (k : Any) (n : I32)] : I32
  (let [nk (lua/call-fn (lua/global "next") t k)]
    (if (lua/nil? nk) n (hub-count-walk t nk (+ n 1)))))

;; How much an addon has saved: -1 = nothing yet. A journal-shaped table (nextSeq / firstSeq) counts the rows it
;; holds; anything else counts its top-level entries. The host passes a table or nil, never another value
;; (`type` is a reserved word for the Luau-safe emitter, so the check lives in the glue).
(defn hub-size [(db : Any)] : I32
  (if (lua/nil? db) -1
    (if (lua/nil? (lua/get db "nextSeq")) (hub-count-walk db (lua/nil) 0)
      (- (lua/get db "nextSeq") (lua/get db "firstSeq")))))

;; An addon's state for its row: 0 not loaded, 1 loaded with nothing saved yet, 2 loaded and holding data.
(defn hub-state [(loaded : I32) (size : I32)] : I32
  (if (= loaded 0) 0 (if (> size 0) 2 1)))

;; What one of an addon's command buttons does: 0 nothing (the addon is not loaded, so the button is hidden),
;; 1 run the command now, 2 put it in the chat box for the player to finish -- it needs an argument (`<...>`) only
;; they can type, such as a name or a riddle. Optional arguments (`[...]`) run with their defaults.
(defn hub-action-mode [(loaded : I32) (needs-input : I32)] : I32
  (if (= loaded 0) 0 (if (= needs-input 0) 1 2)))

;; ---- The character screen (founder, 2026-11-14: "i want to see the inv and levels and equip of the chars,
;; including monies -- ideally all from one in game screen"). It reads the Character Board's snapshots and Fafnir's
;; Bed's holdings, both account-wide, so every character shows, not just the one logged in.

;; Copper as {gold, silver, copper}.
(defn hub-gold-parts [(copper : I32)] : Any
  (lua/array (/ copper 10000) (- (/ copper 100) (* (/ copper 10000) 100)) (- copper (* (/ copper 100) 100))))

;; Experience into the level, 0..100. 0 when the client did not say how much the level needs.
(defn hub-xp-pct [(xp : I32) (xpmax : I32)] : I32 (if (<= xpmax 0) 0 (/ (* xp 100) xpmax)))

;; Every character either table knows: {[character] = 1}. Either table may be nil (its addon not installed).
(defn hub-roster-add [(chars : Any) (k : Any) (out : Any)] : Any
  (let [nk (lua/call-fn (lua/global "next") chars k)]
    (if (lua/nil? nk) out (do (lua/aset! out nk 1) (hub-roster-add chars nk out)))))
(defn hub-roster-from [(db : Any) (out : Any)] : Any
  (if (lua/nil? db) out (if (lua/nil? (lua/get db "chars")) out (hub-roster-add (lua/get db "chars") (lua/nil) out))))
(defn hub-roster [(board : Any) (fafnir : Any)] : Any
  (hub-roster-from fafnir (hub-roster-from board (lua/obj))))

;; The list's order: highest level first, then by name. 1 when a comes before b.
(defn hub-char-before [(alevel : I32) (aname : String) (blevel : I32) (bname : String)] : I32
  (if (> alevel blevel) 1 (if (< alevel blevel) 0 (if (< aname bname) 1 0))))
