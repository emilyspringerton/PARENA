;; stdlib/collection/macrosync.prn -- MacroSync (the spec's own addon, outside the numbered 100): "load stored macros
;; into the WoW macro list. Sync is command-only via /ascend; /ascend prunes removed managed macros. Fantasy: the
;; Flame from The 100; chat lines and errors print as haiku." A REFLUX mod.
;;
;; The spec's toolchain is LO -> PARENA -> Lua. LO's grammar is still a spec "Confirm", so macro sets are written in
;; PARENA directly for now (stdlib/collection/macros_<class>.prn); the PARENA -> Lua half is the real one. The macro
;; zip layout is also a "Confirm", so nothing here reads zips: the sets are compiled into the addon.
;;
;; What /ascend decides (the host does only the client calls):
;;   * MANAGED macros are the ones MacroSync created, remembered per character in db.managed[name] = 1. A macro
;;     the player made is never edited or deleted, even when it has the same name (that is a COLLISION, reported).
;;   * Each macro in the set is LOADED (created or brought up to date) when every spell line resolved, or DORMANT
;;     when the character does not know a spell it needs yet -- then it is not loaded, and an old managed copy is
;;     pruned, so no macro ever casts nothing.
;;   * PRUNED: a managed macro no longer in the set, or now dormant, is deleted.
;;   * Slots: the client's own MAX_CHARACTER_MACROS is the limit (never assumed); creates that would not fit are
;;     refused and reported, never forced.
;; db = { managed = {[name] = 1}, ascends, v }
;;
;; MacroSync's REFLUX types sit just above the Collection's 2000-2999 block (ids.prn), at 3000-3009:
;;   3000 ascended   a = macros loaded, b = macros pruned, c = macros dormant
;;   3001 refused    a = reason (1 in combat, 2 no macro API, 3 slots full), b = macros it could not place, c = 0

(module collection/macrosync)
(export ms-init ms-first-type ms-managed ms-adopt! ms-forget! ms-prune-list ms-fits ms-ascended! ms-refused!
        ms-haiku-count ms-haiku ms-bar-order ms-bar-slot-ok ms-bar-plan)

(defn ms-first-type [] : I32 3000)

(defn ms-init [(db : Any)] : Any
  (do (if (lua/nil? (lua/get db "managed")) (lua/set! db "managed" (lua/obj)) 0)
      (if (lua/nil? (lua/get db "ascends")) (lua/set! db "ascends" 0) 0)
      (lua/set! db "v" 1)
      db))

(defn ms-managed [(db : Any) (name : String)] : I32 (if (lua/nil? (lua/aget (lua/get db "managed") name)) 0 1))
(defn ms-adopt! [(db : Any) (name : String)] : I32 (do (lua/aset! (lua/get db "managed") name 1) 1))
(defn ms-forget! [(db : Any) (name : String)] : I32 (do (lua/aset! (lua/get db "managed") name (lua/nil)) 1))

;; Managed names that are not in `keep` ({[name] = 1}): the macros /ascend deletes. An array, sorted.
(defn ms-prune-walk [(managed : Any) (keep : Any) (k : Any) (out : Any)] : Any
  (let [nk (lua/call-fn (lua/global "next") managed k)]
    (if (lua/nil? nk) out
      (do (if (lua/nil? (lua/aget keep nk)) (lua/aset! out (+ (lua/call-fn (lua/global "table.getn") out) 1) nk) 0)
          (ms-prune-walk managed keep nk out)))))

(defn ms-prune-list [(db : Any) (keep : Any)] : Any
  (let [out (ms-prune-walk (lua/get db "managed") keep (lua/nil) (lua/array))]
    (do (lua/call-fn (lua/global "table.sort") out) out)))

;; Can `want` more macros be created when `used` of `max` slots are taken? 1/0. max < 0 = the client did not say.
(defn ms-fits [(used : I32) (max : I32) (want : I32)] : I32
  (if (< max 0) 0 (if (<= (+ used want) max) 1 0)))

(defn ms-ascended! [(db : Any) (loaded : I32) (pruned : I32) (dormant : I32)] : I32
  (do (lua/set! db "ascends" (+ (lua/get db "ascends") 1))
      (reflux-dispatch (ms-first-type) loaded pruned dormant)
      (lua/get db "ascends")))

(defn ms-refused! [(reason : I32) (count : I32)] : I32
  (do (reflux-dispatch (+ (ms-first-type) 1) reason count 0) reason))

;; Haiku: every moment MacroSync speaks has a few, in the catalogue as H_<moment>_<n> (three lines split by "/").
;;   ascend 1 (all loaded)  pruned 2  dormant 3  collision 4  combat 5  noapi 6  full 7  notclass 8  toolong 9
(defn ms-haiku-count [(moment : I32)] : I32
  (if (= moment 1) 3 (if (= moment 2) 2 (if (= moment 3) 2 (if (= moment 4) 1 (if (= moment 5) 2
    (if (= moment 6) 1 (if (= moment 7) 1 (if (= moment 8) 1 (if (= moment 9) 1 0))))))))))

(defn ms-haiku [(moment : I32) (seed : I32)] : I32
  (let [n (ms-haiku-count moment) s (if (< seed 0) (- 0 seed) seed)]
    (if (= n 0) 0 (+ (- s (* (/ s n) n)) 1))))

;; ---- action bars (founder, 2026-11-14: "macro sync needs to sync the macros to my action bars actually") -----------
;; After the macros are written, each one goes on an action bar. The rules:
;;   * a macro already on a bar stays where the player put it;
;;   * a slot planned in the forge (`forge place`) is used if it is empty or holds one of MacroSync's own macros (that
;;     one is moved on to a free slot); if it holds anything else -- a spell, an item, the player's own macro -- it is
;;     left alone and the macro is reported, never overwritten;
;;   * the rest go into empty slots in ms-bar-order: the bottom-left and bottom-right bars first (61-72, 49-60), then
;;     the two right bars (25-36, 37-48), then the main bar's two pages (1-24). Slots 73-120 (stance and form pages)
;;     are never filled automatically, only when planned.
;; Inputs, all Lua tables the host builds from the client (and this function changes):
;;   names    the kit's macro names, in kit order
;;   where    {[name] = slot}: where each managed macro is now (absent: on no bar)
;;   planned  {[name] = slot}: the forge's plan (may be empty)
;;   state    {[slot] = 1 when it holds something not ours, or the managed macro's name when it holds one of ours}
;; Output: an array of steps {name, slot, kind, from}, in the order the host performs them. Kinds:
;;   1 place in the planned slot   2 place in a free slot   5 move from `from` to the planned slot
;;   3 the planned slot holds something else (nothing done)   4 no free slot left (nothing done)

(defn ms-bar-range [(out : Any) (from : I32) (to : I32)] : Any
  (if (> from to) out (do (lua/aset! out (+ (lua/call-fn (lua/global "table.getn") out) 1) from) (ms-bar-range out (+ from 1) to))))

(defn ms-bar-order [] : Any
  (ms-bar-range (ms-bar-range (ms-bar-range (ms-bar-range (ms-bar-range (lua/array) 61 72) 49 60) 25 36) 37 48) 1 24))

;; A slot the forge may plan: 1-120.
(defn ms-bar-slot-ok [(slot : I32)] : I32 (if (and (>= slot 1) (<= slot 120)) 1 0))

(defn ms-bar-n [(t : Any)] : I32 (lua/call-fn (lua/global "table.getn") t))
(defn ms-bar-push [(out : Any) (step : Any)] : Any (do (lua/aset! out (+ (ms-bar-n out) 1) step) out))

;; 1 when some other macro's planned slot is `slot` (kept free for it).
(defn ms-bar-reserved [(planned : Any) (names : Any) (slot : I32) (self : Any) (i : I32)] : I32
  (if (> i (ms-bar-n names)) 0
    (let [n (lua/aget names i)]
      (if (and (not (= n self)) (= (lua/aget planned n) slot)) 1 (ms-bar-reserved planned names slot self (+ i 1))))))

(defn ms-bar-free [(order : Any) (state : Any) (planned : Any) (names : Any) (self : Any) (i : I32)] : I32
  (if (> i (ms-bar-n order)) 0
    (let [slot (lua/aget order i)]
      (if (and (lua/nil? (lua/aget state slot)) (= (ms-bar-reserved planned names slot self 1) 0))
        slot
        (ms-bar-free order state planned names self (+ i 1))))))

;; Pass 1: the planned slots.
(defn ms-bar-planned [(names : Any) (where : Any) (planned : Any) (state : Any) (out : Any) (refused : Any) (i : I32)] : Any
  (if (> i (ms-bar-n names)) out
    (let [name (lua/aget names i)
          p (lua/aget planned name)
          now (lua/aget where name)]
      (do
        (if (or (lua/nil? p) (= now p)) 0
          (let [s (lua/aget state p)]
            (if (= s 1)
              (do (ms-bar-push out (lua/array name p 3 (lua/nil))) (lua/aset! refused name 1) 0)
              (do (ms-bar-push out (lua/array name p (if (lua/nil? now) 1 5) now))
                  ;; a macro of ours in the way is displaced: pass 2 finds it a free slot
                  (if (lua/nil? s) 0 (lua/aset! where s (lua/nil)))
                  (if (lua/nil? now) 0 (lua/aset! state now (lua/nil)))
                  (lua/aset! state p name)
                  (lua/aset! where name p)
                  0))))
        (ms-bar-planned names where planned state out refused (+ i 1))))))

;; Pass 2: everything still on no bar goes into the first free slot.
(defn ms-bar-rest [(names : Any) (where : Any) (planned : Any) (state : Any) (out : Any) (refused : Any) (order : Any) (i : I32)] : Any
  (if (> i (ms-bar-n names)) out
    (let [name (lua/aget names i)]
      (do
        (if (or (not (lua/nil? (lua/aget where name))) (not (lua/nil? (lua/aget refused name)))) 0
          (let [slot (ms-bar-free order state planned names name 1)]
            (if (= slot 0)
              (do (ms-bar-push out (lua/array name 0 4 (lua/nil))) 0)
              (do (ms-bar-push out (lua/array name slot 2 (lua/nil)))
                  (lua/aset! state slot name)
                  (lua/aset! where name slot)
                  0))))
        (ms-bar-rest names where planned state out refused order (+ i 1))))))

(defn ms-bar-plan [(names : Any) (where : Any) (planned : Any) (state : Any)] : Any
  (let [out (lua/array)
        refused (lua/obj)
        pl (if (lua/nil? planned) (lua/obj) planned)]
    (ms-bar-rest names where pl state (ms-bar-planned names where pl state out refused 1) refused (ms-bar-order) 1)))
