;; stdlib/collection/macros.prn -- the macro sets MacroSync loads, by class (the client's class file name, so it is
;; the same in every locale). Written in PARENA until LO is confirmed (see macrosync.prn).
;;
;; A macro is {name, body}. Names are at most 16 characters (the macro frame's limit) and every managed name starts
;; with the class tag, so the set reads as one family in the macro list. Bodies use one MacroSync extension:
;;   {A|B|C}  the first of these spells this character knows, asked of the client at /ascend
;; because Forever's spell names are not confirmed (a classic client says "Judgement", a retail one "Judgment").
;; A line whose alternatives are all unknown makes the macro DORMANT until the spell is learned.
;; The modifiers used ([@mouseover], [help], [harm], [nodead], [mod:shift]) are retail-lineage conditionals.
;;
;; PALADIN -- a levelling and duo set (the Warlock and Paladin duo of the founder's guides; the guides themselves
;; are not on this machine, so the set follows the class's core kit rather than a guide's list):
;;   PalJudge     open with a judgement and start swinging
;;   PalSeal      seal up; shift for the crusader seal
;;   PalHeal      quick heal: mouseover, else your friendly target, else yourself
;;   PalBigHeal   the big heal, same targeting; over a dead friend (mouseover or target) it casts Redemption instead
;;   PalBubble    the bubble
;;   PalBubHearth bubble, then hearth -- the classic exit
;;   PalStun      stun your mouseover enemy, else your target
;;   PalLoH       lay on hands, friendly targeting
;;   PalBless     the first blessing you know, friendly targeting
;;   PalBoP       protection blessing, friendly targeting
;;   PalFreedom   freedom, yourself unless you mouse over a friend
;;   PalCleanse   cleanse, friendly targeting
;;   PalAura      devotion aura; shift for retribution
;;   PalTaunt     the paladin taunt
;;   PalExo       exorcism
;;   PalMount     your class mount

(module collection/macros)
(export macro-set macro-classes)

(defn macro-classes [] : Any (lua/array "PALADIN" "PRIEST" "MAGE" "SHAMAN" "DRUID" "WARRIOR" "ROGUE" "HUNTER"))

(defn macro-paladin [] : Any
  (lua/array
    (lua/array "PalJudge" "#showtooltip\n/startattack\n/cast {Judgement|Judgment}")
    (lua/array "PalSeal" "#showtooltip\n/cast [mod:shift] {Seal of the Crusader|Seal of Command}; {Seal of Righteousness|Seal of Command}")
    (lua/array "PalHeal" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Flash of Light|Holy Light}")
    (lua/array "PalBigHeal" "#showtooltip\n/cast [@mouseover,help,dead][help,dead] {Redemption}; [@mouseover,help,nodead][help,nodead][@player] {Holy Light}")
    (lua/array "PalBubble" "#showtooltip\n/cast {Divine Shield|Divine Protection}")
    (lua/array "PalBubHearth" "#showtooltip {Divine Shield|Divine Protection}\n/cast {Divine Shield|Divine Protection}\n/use Hearthstone")
    (lua/array "PalStun" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Hammer of Justice}")
    (lua/array "PalLoH" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Lay on Hands}")
    (lua/array "PalBless" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Blessing of Might|Blessing of Kings|Blessing of Wisdom}")
    (lua/array "PalBoP" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Blessing of Protection|Hand of Protection}")
    (lua/array "PalFreedom" "#showtooltip\n/cast [@mouseover,help,nodead][@player] {Blessing of Freedom|Hand of Freedom}")
    (lua/array "PalCleanse" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Cleanse|Purify}")
    (lua/array "PalAura" "#showtooltip\n/cast [mod:shift] {Retribution Aura}; {Devotion Aura}")
    (lua/array "PalTaunt" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Hand of Reckoning|Righteous Defense}")
    (lua/array "PalExo" "#showtooltip\n/startattack\n/cast {Exorcism}")
    (lua/array "PalMount" "#showtooltip\n/cast {Summon Charger|Summon Warhorse}")))

;; PRIEST -- a levelling and support set (the class's core kit; no priest guide is on this machine either):
;;   PriShield    the shield: mouseover friend, else friendly target, else yourself
;;   PriHeal      quick heal, same targeting      PriBigHeal  the big heal you know, same targeting
;;   PriRenew     renew, same targeting           PriFort     fortitude, same targeting
;;   PriDispel    dispel, same targeting          PriRez      resurrect your dead mouseover, else your target
;;   PriSWP       pain on your mouseover enemy, else your target      PriMindBlast  likewise
;;   PriSmite     smite                           PriFlay     mind flay
;;   PriWand      start the wand without toggling it off (!Shoot)
;;   PriFear      psychic scream                  PriFade     fade
;;   PriInnerFire inner fire                      PriNova     holy nova
(defn macro-priest [] : Any
  (lua/array
    (lua/array "PriShield" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Power Word: Shield}")
    (lua/array "PriHeal" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Flash Heal|Lesser Heal|Heal}")
    (lua/array "PriBigHeal" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Greater Heal|Heal|Lesser Heal}")
    (lua/array "PriRenew" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Renew}")
    (lua/array "PriFort" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Power Word: Fortitude}")
    (lua/array "PriDispel" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Dispel Magic|Purify}")
    (lua/array "PriRez" "#showtooltip\n/cast [@mouseover,help,dead][help,dead] {Resurrection}")
    (lua/array "PriSWP" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Shadow Word: Pain}")
    (lua/array "PriMindBlast" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Mind Blast}")
    (lua/array "PriSmite" "#showtooltip\n/cast {Smite}")
    (lua/array "PriFlay" "#showtooltip\n/cast {Mind Flay}")
    (lua/array "PriWand" "#showtooltip\n/cast !{Shoot}")
    (lua/array "PriFear" "#showtooltip\n/cast {Psychic Scream}")
    (lua/array "PriFade" "#showtooltip\n/cast {Fade}")
    (lua/array "PriInnerFire" "#showtooltip\n/cast {Inner Fire}")
    (lua/array "PriNova" "#showtooltip\n/cast {Holy Nova}")))

;; MAGE -- damage, control and utility (core kit; no mage guide on this machine). Harmful spells take your
;; mouseover enemy first, then your target; buffs and decurse take a friend the usual way. Where a choice lists
;; several, the best is listed first, so a character casts the strongest one it knows.
(defn macro-mage [] : Any
  (lua/array
    (lua/array "MagFrostbolt" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Frostbolt}")
    (lua/array "MagFireball" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Fireball}")
    (lua/array "MagFireBlast" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Fire Blast}")
    (lua/array "MagPoly" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Polymorph}")
    (lua/array "MagCounter" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Counterspell}")
    (lua/array "MagNova" "#showtooltip\n/cast {Frost Nova}")
    (lua/array "MagConeCold" "#showtooltip\n/cast {Cone of Cold}")
    (lua/array "MagArcExpl" "#showtooltip\n/cast {Arcane Explosion}")
    (lua/array "MagBlink" "#showtooltip\n/cast {Blink}")
    (lua/array "MagIceBlock" "#showtooltip\n/cast {Ice Block|Ice Barrier}")
    (lua/array "MagArmor" "#showtooltip\n/cast {Molten Armor|Mage Armor|Ice Armor|Frost Armor}")
    (lua/array "MagIntellect" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Arcane Brilliance|Arcane Intellect}")
    (lua/array "MagDecurse" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Remove Curse|Remove Lesser Curse}")
    (lua/array "MagWater" "#showtooltip\n/cast {Conjure Refreshment|Conjure Water}")
    (lua/array "MagFood" "#showtooltip\n/cast {Conjure Refreshment|Conjure Food}")
    (lua/array "MagEvocate" "#showtooltip\n/cast {Evocation}")))

;; SHAMAN -- shocks, heals, weapons, shields, one macro per totem element (shift picks the other totem), and a panic
;; button (War Stomp, then heal yourself).
(defn macro-shaman [] : Any
  (lua/array
    (lua/array "ShaBolt" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Lightning Bolt}")
    (lua/array "ShaChain" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Chain Lightning}")
    (lua/array "ShaShock" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Earth Shock}")
    (lua/array "ShaFrostShock" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Frost Shock}")
    (lua/array "ShaFlameShock" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Flame Shock}")
    (lua/array "ShaPurge" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Purge}")
    (lua/array "ShaHeal" "#showtooltip\n/cast [@mouseover,help,dead][help,dead] {Ancestral Spirit}; [@mouseover,help,nodead][help,nodead][@player] {Healing Wave}")
    (lua/array "ShaQuickHeal" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Healing Surge|Lesser Healing Wave|Healing Wave}")
    (lua/array "ShaChainHeal" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Chain Heal}")
    (lua/array "ShaCure" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Purify Spirit|Cleanse Spirit|Cure Poison}")
    (lua/array "ShaWeapon" "#showtooltip\n/cast [mod:shift] {Flametongue Weapon}; {Windfury Weapon|Rockbiter Weapon}")
    (lua/array "ShaShield" "#showtooltip\n/cast [mod:shift] {Water Shield|Lightning Shield}; {Lightning Shield}")
    (lua/array "ShaGhost" "#showtooltip\n/cast {Ghost Wolf}")
    (lua/array "ShaEarthTotem" "#showtooltip\n/cast [mod:shift] {Earthbind Totem}; {Stoneskin Totem|Strength of Earth Totem}")
    (lua/array "ShaFireTotem" "#showtooltip\n/cast [mod:shift] {Fire Nova Totem}; {Searing Totem}")
    (lua/array "ShaWaterTotem" "#showtooltip\n/cast [mod:shift] {Mana Spring Totem}; {Healing Stream Totem}")
    ;; the panic button (founder, 2026-11-14: "a panic cast rotation stomp heal macro"): mash it -- War Stomp stuns
    ;; everything around you, then two quick heals on yourself while they are stunned; it starts over out of combat
    ;; or after 15 s. A shaman who is not a Tauren has no War Stomp, so the first press is a heal for them.
    (lua/array "ShaPanic" "#showtooltip\n/castsequence [@player] reset=combat/15 {War Stomp|Lesser Healing Wave|Healing Wave}, {Lesser Healing Wave|Healing Wave}, {Lesser Healing Wave|Healing Wave}")))

;; DRUID -- caster damage, roots, heals, buffs, cure, the forms, and a way back to caster form.
(defn macro-druid [] : Any
  (lua/array
    (lua/array "DruWrath" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Wrath}")
    (lua/array "DruMoonfire" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Moonfire}")
    (lua/array "DruRoots" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Entangling Roots}")
    (lua/array "DruClaw" "#showtooltip\n/startattack\n/cast {Mangle|Claw}")
    (lua/array "DruHeal" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Healing Touch|Regrowth}")
    (lua/array "DruRegrowth" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Regrowth}")
    (lua/array "DruRejuv" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Rejuvenation}")
    (lua/array "DruMark" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Gift of the Wild|Mark of the Wild}")
    (lua/array "DruThorns" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Thorns}")
    (lua/array "DruCure" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Remove Corruption|Remove Curse|Abolish Poison|Cure Poison}")
    (lua/array "DruInnervate" "#showtooltip\n/cast [@mouseover,help,nodead][help,nodead][@player] {Innervate}")
    (lua/array "DruRebirth" "#showtooltip\n/cast [@mouseover,help,dead][help,dead] {Rebirth}")
    (lua/array "DruBear" "#showtooltip\n/cast {Dire Bear Form|Bear Form}")
    (lua/array "DruCat" "#showtooltip\n/cast {Cat Form}")
    (lua/array "DruTravel" "#showtooltip\n/cast {Travel Form}")
    (lua/array "DruCaster" "/cancelform")))

;; WARRIOR -- stance-aware (classic stances: 1 Battle, 2 Defensive, 3 Berserker). The main strike is whichever
;; talent strike the character has, falling back to Heroic Strike; shift and ctrl pick the other stances.
(defn macro-warrior [] : Any
  (lua/array
    (lua/array "WarCharge" "#showtooltip\n/startattack\n/cast [stance:3] {Intercept}; {Charge}")
    (lua/array "WarStrike" "#showtooltip\n/startattack\n/cast {Mortal Strike|Bloodthirst|Shield Slam|Heroic Strike}")
    (lua/array "WarCleave" "#showtooltip\n/startattack\n/cast {Cleave}")
    (lua/array "WarRend" "#showtooltip\n/startattack\n/cast [@mouseover,harm,nodead][] {Rend}")
    (lua/array "WarHamstring" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Hamstring}")
    (lua/array "WarOverpower" "#showtooltip\n/cast {Overpower}")
    (lua/array "WarExecute" "#showtooltip\n/cast {Execute}")
    (lua/array "WarRevenge" "#showtooltip\n/cast {Revenge}")
    (lua/array "WarSunder" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Devastate|Sunder Armor}")
    (lua/array "WarThunder" "#showtooltip\n/cast {Thunder Clap}")
    (lua/array "WarShout" "#showtooltip\n/cast [mod:shift] {Demoralizing Shout}; {Battle Shout}")
    (lua/array "WarTaunt" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Taunt}")
    (lua/array "WarKick" "#showtooltip\n/cast [stance:3] {Pummel}; {Shield Bash}")
    (lua/array "WarBlock" "#showtooltip\n/cast {Shield Block}")
    (lua/array "WarRage" "#showtooltip\n/cast {Bloodrage}")
    (lua/array "WarStance" "#showtooltip\n/cast [mod:shift] {Defensive Stance}; [mod:ctrl] {Berserker Stance}; {Battle Stance}")))

;; ROGUE -- builders, finishers, the stealth openers ([stealth]: shift for Ambush, else Cheap Shot), control and
;; escapes. Stealth uses [nostealth] so pressing it twice never drops you out.
(defn macro-rogue [] : Any
  (lua/array
    (lua/array "RogSinister" "#showtooltip\n/startattack\n/cast {Mutilate|Sinister Strike}")
    (lua/array "RogOpener" "#showtooltip\n/cast [stealth,mod:shift] {Ambush}; [stealth] {Cheap Shot}; {Sinister Strike}")
    (lua/array "RogStealth" "#showtooltip\n/cast [nostealth] {Stealth}")
    (lua/array "RogEvis" "#showtooltip\n/startattack\n/cast {Eviscerate}")
    (lua/array "RogSnD" "#showtooltip\n/cast {Slice and Dice}")
    (lua/array "RogRupture" "#showtooltip\n/cast {Rupture}")
    (lua/array "RogExpose" "#showtooltip\n/cast {Expose Armor}")
    (lua/array "RogKick" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Kick}")
    (lua/array "RogGouge" "#showtooltip\n/cast {Gouge}")
    (lua/array "RogKidney" "#showtooltip\n/cast {Kidney Shot}")
    (lua/array "RogSap" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Sap}")
    (lua/array "RogBlind" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Blind}")
    (lua/array "RogEvasion" "#showtooltip\n/cast {Evasion}")
    (lua/array "RogSprint" "#showtooltip\n/cast {Sprint}")
    (lua/array "RogVanish" "#showtooltip\n/cast {Vanish}")
    (lua/array "RogPickPocket" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Pick Pocket}")))

;; HUNTER -- shots on your mouseover enemy else your target, Auto Shot that never toggles off (!), melee, traps,
;; aspects, tracking, and the pet: one button revives it when dead, calls it when missing, else mends it.
(defn macro-hunter [] : Any
  (lua/array
    (lua/array "HunAuto" "#showtooltip\n/cast !{Auto Shot}")
    (lua/array "HunArcane" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Arcane Shot}")
    (lua/array "HunSerpent" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Serpent Sting}")
    (lua/array "HunMark" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Hunter's Mark}")
    (lua/array "HunConcuss" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Concussive Shot}")
    (lua/array "HunMulti" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Multi-Shot}")
    (lua/array "HunAimed" "#showtooltip\n/cast [@mouseover,harm,nodead][] {Aimed Shot}")
    (lua/array "HunRaptor" "#showtooltip\n/startattack\n/cast {Raptor Strike}")
    (lua/array "HunWingClip" "#showtooltip\n/cast {Wing Clip}")
    (lua/array "HunDisengage" "#showtooltip\n/cast {Disengage}")
    (lua/array "HunFeign" "#showtooltip\n/cast {Feign Death}")
    (lua/array "HunTrap" "#showtooltip\n/cast [mod:shift] {Immolation Trap}; {Freezing Trap}")
    (lua/array "HunAspect" "#showtooltip\n/cast [mod:shift] {Aspect of the Cheetah}; {Aspect of the Hawk|Aspect of the Monkey}")
    (lua/array "HunTrack" "#showtooltip\n/cast [mod:shift] {Track Humanoids}; {Track Beasts}")
    (lua/array "HunPet" "#showtooltip\n/cast [@pet,dead] {Revive Pet}; [nopet] {Call Pet}; {Mend Pet}")
    (lua/array "HunPetAttack" "/petattack [@mouseover,harm,nodead][]")))

;; The set for a class file name; an empty array for a class without one yet.
(defn macro-set [(class : String)] : Any
  (if (= class "PALADIN") (macro-paladin)
    (if (= class "PRIEST") (macro-priest)
      (if (= class "MAGE") (macro-mage)
        (if (= class "SHAMAN") (macro-shaman)
          (if (= class "DRUID") (macro-druid)
            (if (= class "WARRIOR") (macro-warrior)
              (if (= class "ROGUE") (macro-rogue)
                (if (= class "HUNTER") (macro-hunter) (lua/array))))))))))
