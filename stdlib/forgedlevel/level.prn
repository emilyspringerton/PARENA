;; stdlib/forgedlevel/level.prn — FORGEDLEVEL v0: the parametric, recursive world builder.
;;
;; FORGEDLEVEL is the level/map builder that sits next to FORGEDINFACE (founder real-time,
;; 2026-11-03: "you know how vroid studio you are building a full interactable game affordance? cant
;; we make a level builder in the same way to a certain extent? like paramertized materials etc for
;; building to quickly build out maps" -> "it should be recursive we should be able to create a
;; cinder block and then use a cinder block to create a wall creation tool use the wall creation
;; tool to draw a basic structure use parena mods to make it parametized for helping the level
;; builders"). The chain in that ask is exactly the data model below, one layer per rung:
;;
;;   material  ->  cinder block (an Assembly of material cells)  ->  wall tool (lays Assemblies
;;   along a run)  ->  plan (quantities over many walls)  ->  a PARENA mod (mods/cottage.prn),
;;   which is what a level builder actually touches.
;;
;; The pasted design that started this thread did not compile: `(Vec (Vec (Vec VoxelNode)))`,
;; `defenum ... (Empty Void)`, `f32/from_u8`, struct-field dot access `(deref cell).extrusion_height`,
;; `dotimes`, and `: Void @ [R_nbr, R_out]` region lists all do not exist in the real compiler.
;; What is below is written against the actual `parena build` surface, and `make test-forgedlevel`
;; compiles it with gcc `-Werror` and runs hand-derived assertions on every number.
;;
;; Two real, load-bearing design decisions:
;;
;; 1. RECURSION IS BY ID, AND IDS ONLY POINT BACKWARDS. An assembly cell either holds a material
;;    id (>= 0) or names another assembly (`nested` >= 0). `lib/add!` hands out ids in creation
;;    order, so an assembly can only nest assemblies that already exist — the same invariant the
;;    20-bone skeleton uses for parent < child. That makes a cycle unexpressible rather than
;;    merely detected; the walkers below still carry a depth bound so a future importer that
;;    breaks the invariant fails closed with -1 instead of blowing the stack.
;;
;; 2. THE FLAT BUFFERS ARE THE NESTED STRUCTURE. `cells`/`nested` are one contiguous buffer and
;;    each assembly records `offset`/`span` into it — which is exactly what
;;    `Vec<Vec<Vec<Voxel>>>` compiles to, minus the per-node allocation. One arena, append-only,
;;    no index assignment anywhere in this file.
;;
;; Deliberately NOT here yet, named rather than faked (see NORTHSTAR.md's phases): floor-plan
;; painting + extrusion, the topological adjacency/joinery graph, per-material weathering
;; shaders, mesh emission (the vertex/UV stage FORGEDINFACE's skinning already solves for
;; characters), mechanical FK/IK assemblies, the GOLDENBAND RL actuator loop with real servo
;; data sheets, SDF union for watertight 3D-print export, and .gfd/network serialization.
;;
;; Units: centimetres and millimetres, because this is a CAD-shaped tool. A cell is a cube of
;; `cell-cm`; a cinder block is 4x2x2 cells of 10cm = 40x20x20 cm, the real block size.

(module forgedlevel/level)
(import vec)
(import math)

(export MaterialTable mats/new mats/add! mats/standard
        mats/count mats/density mats/bevel mats/weathering
        Library lib/new lib/add! lib/count lib/in-range?
        lib/cell lib/nested lib/span lib/cell-cm lib/dim
        lib/prims lib/volume-cm3
        block/cinder! block/cell-index block/hollow? block/cell-count
        WallMod Wall wall/params wall/lay wall/blocks-along wall/block-mm
        wall/per-course wall/blocks wall/halves wall/slack-mm wall/laid-blocks
        Plan plan/new plan/add-wall! plan/mass-kg
        self-test)

;; ---------------------------------------------------------------------------
;; #target accessors
;; ---------------------------------------------------------------------------
;; Real gap, not decoration: a plain local `(Vec T)` has no element type hint registered, so
;; element reads/writes go through `#target` (the same class of gap stdlib/regex/pcre.prn's own
;; `vec-i32-at` documents, and the same fix shape stdlib/forgedinface/rig.prn uses). Every write
;; in this module is an APPEND built in index order, which keeps the whole file on the proven
;; `vec_push_` path.
(defn f64-at [(v : &(Vec F64)) (idx : I32)] : F64
  #target {:c (inline-c "*(double *)vec_get(v, idx)")})

(defn i32-at [(v : &(Vec I32)) (idx : I32)] : I32
  #target {:c (inline-c "*(int *)vec_get(v, idx)")})

;; comma-expression, not a bare statement: these are bound in `let`s, and a void-valued call
;; cannot be let-bound (`void _0 = ...` is a real gcc -Werror error).
(defn f64-push! [(v : &mut (Vec F64)) (val : F64)] : I32
  #target {:c (inline-c "(vec_push_(v, vec_box_f64(v, val)), 1)")})

(defn i32-push! [(v : &mut (Vec I32)) (val : I32)] : I32
  #target {:c (inline-c "(vec_push_(v, vec_box_i32(v, val)), 1)")})

;; Explicit conversions. Mixed I32/F64 arithmetic is not something this file relies on: every
;; place a count becomes a distance (or a float result becomes a count) it says so out loud.
(defn i32-to-f64 [(x : I32)] : F64
  #target {:c (inline-c "((double)x)")})

(defn f64-to-i32 [(x : F64)] : I32
  #target {:c (inline-c "((int)x)")})

(defn near? [(a : F64) (b : F64)] : Bool
  (if (< (- a b) 0.0) (< (- b a) 0.000001) (< (- a b) 0.000001)))

;; ---------------------------------------------------------------------------
;; Materials — the parameters a level builder actually slides
;; ---------------------------------------------------------------------------
;; A material is not a texture here; it carries the structural numbers the rest of the pipeline
;; reads: density (mass, so a plan can be weighed), bevel (the CAD edge radius the mesh stage will
;; chamfer by), and weathering (0..1, the erosion coefficient a shader or vertex-color pass
;; blends in). Changing a slider changes every wall built with that material, because nothing
;; downstream stores a cooked mesh.
(defstruct MaterialTable
  (count   : I32)
  (density : (Vec F64))   ;; kg/m^3
  (bevel   : (Vec F64))   ;; cm
  (weather : (Vec F64)))  ;; 0..1

(defn mats/new [(dest : Arena @ Region)] : MaterialTable @ Region
  {:count 0
   :density (vec/new dest)
   :bevel (vec/new dest)
   :weather (vec/new dest)})

;; add! returns the new material's id (its index), which is what every cell stores.
(defn mats/add! [(t : &mut MaterialTable) (density : F64) (bevel : F64) (weather : F64)] : I32
  (let [id (get-field t :count)
        _0 (f64-push! &mut (get-field t :density) density)
        _1 (f64-push! &mut (get-field t :bevel) bevel)
        _2 (f64-push! &mut (get-field t :weather) weather)]
    (set! (get-field t :count) (+ id 1))
    id))

;; Three real materials, the minimum that makes the choice meaningful: structural concrete,
;; lightweight block (what a real cinder block is, ~1900 not 2400, which is why a block weighs
;; what it weighs), and timber.
(defn mats/standard [(dest : Arena @ Region)] : MaterialTable @ Region
  (let [t (mats/new dest)
        _0 (mats/add! &mut t 2400.0 0.5 0.0)
        _1 (mats/add! &mut t 1900.0 0.8 0.25)
        _2 (mats/add! &mut t 600.0 0.2 0.6)]
    t))

(defn mats/count [(t : &MaterialTable)] : I32
  (get-field t :count))

;; Out-of-range ids return -1.0 rather than reading whatever sits next to the buffer.
(defn mats/density [(t : &MaterialTable) (id : I32)] : F64
  (if (or (< id 0) (>= id (get-field t :count)))
    -1.0
    (f64-at &(get-field t :density) id)))

(defn mats/bevel [(t : &MaterialTable) (id : I32)] : F64
  (if (or (< id 0) (>= id (get-field t :count)))
    -1.0
    (f64-at &(get-field t :bevel) id)))

(defn mats/weathering [(t : &MaterialTable) (id : I32)] : F64
  (if (or (< id 0) (>= id (get-field t :count)))
    -1.0
    (f64-at &(get-field t :weather) id)))

;; ---------------------------------------------------------------------------
;; Assemblies — the recursive library
;; ---------------------------------------------------------------------------
;; One flat cell buffer for the whole library, with offset/span per assembly. `cells` holds a
;; material id or -1 (empty, e.g. a cinder block's two cores); `nested` holds an assembly id or
;; -1. The two are parallel and separate on purpose: a single signed field would make "material
;; 3" and "assembly 3" the same number, which is exactly the kind of ambiguity that turns into a
;; loader bug later.
(defstruct Library
  (count   : I32)
  (dim-x   : (Vec I32))    ;; 1 per assembly, cells
  (dim-y   : (Vec I32))
  (dim-z   : (Vec I32))
  (cell-cm : (Vec F64))    ;; 1 per assembly, edge of one cell
  (offset  : (Vec I32))    ;; 1 per assembly, start index into cells/nested
  (span    : (Vec I32))    ;; 1 per assembly, cell count
  (cells   : (Vec I32))
  (nested  : (Vec I32)))

(defn lib/new [(dest : Arena @ Region)] : Library @ Region
  {:count 0
   :dim-x (vec/new dest)
   :dim-y (vec/new dest)
   :dim-z (vec/new dest)
   :cell-cm (vec/new dest)
   :offset (vec/new dest)
   :span (vec/new dest)
   :cells (vec/new dest)
   :nested (vec/new dest)})

;; add! copies one assembly's cell/nested buffers into the library and returns the new id.
;; `off` is read BEFORE the loop appends, so `offset` is the assembly's own first cell.
(defn lib/add! [(lib : &mut Library) (dx : I32) (dy : I32) (dz : I32) (cell-cm : F64)
                (cells : &(Vec I32)) (nested : &(Vec I32))] : I32
  (let [id (get-field lib :count)
        n (vec/len cells)
        off (vec/len &(get-field lib :cells))
        _0 (i32-push! &mut (get-field lib :dim-x) dx)
        _1 (i32-push! &mut (get-field lib :dim-y) dy)
        _2 (i32-push! &mut (get-field lib :dim-z) dz)
        _3 (f64-push! &mut (get-field lib :cell-cm) cell-cm)
        _4 (i32-push! &mut (get-field lib :offset) off)
        _5 (i32-push! &mut (get-field lib :span) n)]
    (loop [i 0]
      (when (< i n)
        (let [_a (i32-push! &mut (get-field lib :cells) (i32-at cells i))
              _b (i32-push! &mut (get-field lib :nested) (i32-at nested i))]
          0)
        (recur (+ i 1))))
    (set! (get-field lib :count) (+ id 1))
    id))

(defn lib/count [(lib : &Library)] : I32
  (get-field lib :count))

(defn lib/in-range? [(lib : &Library) (asm : I32)] : Bool
  (and (>= asm 0) (< asm (get-field lib :count))))

(defn lib/offset [(lib : &Library) (asm : I32)] : I32
  (i32-at &(get-field lib :offset) asm))

(defn lib/span [(lib : &Library) (asm : I32)] : I32
  (i32-at &(get-field lib :span) asm))

(defn lib/cell-cm [(lib : &Library) (asm : I32)] : F64
  (f64-at &(get-field lib :cell-cm) asm))

(defn lib/dim [(lib : &Library) (asm : I32) (axis : I32)] : I32
  (if (= axis 0)
    (i32-at &(get-field lib :dim-x) asm)
    (if (= axis 1)
      (i32-at &(get-field lib :dim-y) asm)
      (i32-at &(get-field lib :dim-z) asm))))

;; In-range guards on both ids: an assembly or cell index that came from a corrupt file reports
;; "empty"/"none" instead of reading a neighbour's data.
(defn lib/cell [(lib : &Library) (asm : I32) (i : I32)] : I32
  (if (or (not (lib/in-range? lib asm)) (< i 0) (>= i (lib/span lib asm)))
    -1
    (i32-at &(get-field lib :cells) (+ (lib/offset lib asm) i))))

(defn lib/nested [(lib : &Library) (asm : I32) (i : I32)] : I32
  (if (or (not (lib/in-range? lib asm)) (< i 0) (>= i (lib/span lib asm)))
    -1
    (i32-at &(get-field lib :nested) (+ (lib/offset lib asm) i))))

;; ---------------------------------------------------------------------------
;; The recursion itself
;; ---------------------------------------------------------------------------
;; vol-walk is a tail-recursive walk over one assembly's cells. A nested cell expands into the
;; assembly it names — that is the whole "cinder block inside a wall inside a structure" idea,
;; evaluated lazily from stored ids rather than baked into baked geometry.
(defn vol-walk [(lib : &Library) (asm : I32) (i : I32) (acc : F64) (depth : I32)] : F64
  (if (>= depth 32)
    -1.0
    (if (>= i (lib/span lib asm))
      acc
      (let [edge (lib/cell-cm lib asm)
            sub (lib/nested lib asm i)
            mat (lib/cell lib asm i)
            add (if (>= sub 0)
                  (vol-walk lib sub 0 0.0 (+ depth 1))
                  (if (>= mat 0) (* (* edge edge) edge) 0.0))]
        (if (< add 0.0)
          -1.0
          (vol-walk lib asm (+ i 1) (+ acc add) depth))))))

(defn prim-walk [(lib : &Library) (asm : I32) (i : I32) (acc : I32) (depth : I32)] : I32
  (if (>= depth 32)
    -1
    (if (>= i (lib/span lib asm))
      acc
      (let [sub (lib/nested lib asm i)
            mat (lib/cell lib asm i)
            add (if (>= sub 0)
                  (prim-walk lib sub 0 0 (+ depth 1))
                  (if (>= mat 0) 1 0))]
        (if (< add 0)
          -1
          (prim-walk lib asm (+ i 1) (+ acc add) depth))))))

;; Solid volume of one assembly, cm^3, with every nested assembly expanded. Empty cells
;; (a cinder block's cores) contribute nothing — a hollow block is lighter because it is hollow,
;; not because a second number says so.
(defn lib/volume-cm3 [(lib : &Library) (asm : I32)] : F64
  (if (lib/in-range? lib asm)
    (vol-walk lib asm 0 0.0 0)
    -1.0))

;; Primitive-cell count: how many material cells the assembly really expands to. This is the
;; number a mesh emitter allocates for, and the number an agent rewrites.
(defn lib/prims [(lib : &Library) (asm : I32)] : I32
  (if (lib/in-range? lib asm)
    (prim-walk lib asm 0 0 0)
    -1))

;; ---------------------------------------------------------------------------
;; The cinder block — the first real assembly
;; ---------------------------------------------------------------------------
;; Index order is row-major with x fastest: i = (z * dim-y + y) * dim-x + x. Same convention as
;; every flat buffer in this stdlib.
(defn block/cell-index [(x : I32) (y : I32) (z : I32) (dx : I32) (dy : I32)] : I32
  (+ (* z (* dx dy)) (+ (* y dx) x)))

;; A real cinder block's two cores run through the depth on the bottom course; every interior
;; x on y == 0 is hollow. For the standard 4-wide block that is x = 1 and x = 2, i.e. 4 cells of
;; 16 — a 25% hollow block, which is why it is lighter than its bounding box.
(defn block/hollow? [(x : I32) (y : I32) (dx : I32)] : Bool
  (and (= y 0) (and (> x 0) (< x (- dx 1)))))

(defn block/cell-count [(dx : I32) (dy : I32) (dz : I32)] : I32
  (* dz (* dx dy)))

;; Appends one cinder block's cells (material `mat` where solid, -1 in the cores) and returns the
;; cell count. Caller owns the two buffers so the same block can be appended, nested, or reused.
(defn block/cinder! [(cells : &mut (Vec I32)) (nested : &mut (Vec I32)) (mat : I32)] : I32
  (let [dx 4
        dy 2
        dz 2]
    (loop [z 0]
      (when (< z dz)
        (loop [y 0]
          (when (< y dy)
            (loop [x 0]
              (when (< x dx)
                (if (block/hollow? x y dx)
                  (let [_0 (i32-push! cells -1)
                        _1 (i32-push! nested -1)]
                    0)
                  (let [_0 (i32-push! cells mat)
                        _1 (i32-push! nested -1)]
                    0))
                (recur (+ x 1))))
            (recur (+ y 1))))
        (recur (+ z 1))))
    (block/cell-count dx dy dz)))

;; ---------------------------------------------------------------------------
;; The wall tool — the second rung
;; ---------------------------------------------------------------------------
;; A block is 40x20x20 cm with a mortar joint between blocks, so the tool counts in pitches, not
;; in blocks-per-metre guesses: n full blocks fit in a run iff n*block + (n-1)*gap <= length,
;; which is n <= (length + gap) / (block + gap). Running bond ("bond 1") offsets every other
;; course by half a block, which in real masonry means a half block at each end of that course —
;; so an offset course costs two halves, not one extra block.
(defstruct WallMod
  (length-mm : F64)   ;; the run being drawn
  (courses   : I32)   ;; block courses high
  (gap-mm    : F64)   ;; mortar joint
  (bond      : I32))  ;; 0 = stack bond, 1 = running bond

(defstruct Wall
  (block      : I32)  ;; which assembly was laid
  (per-course : I32)  ;; full blocks along the run
  (courses    : I32)
  (blocks     : I32)  ;; full blocks, all courses
  (halves     : I32)  ;; half blocks consumed by running bond
  (slack-mm   : F64)) ;; run left over at the end, before the next block would not fit

;; Accessors, not just convenience: a mod or host in ANOTHER file cannot `get-field` a wall
;; returned by a cross-module call (real VS0 gap -- `get-field` on that result reports
;; "'void *' ... isn't a registered defstruct type", the same class of unregistered-type gap
;; the module-level `Vec` accessors exist for). Exported accessors are the working surface.
(defn wall/per-course [(w : &Wall)] : I32 (get-field w :per-course))
(defn wall/blocks [(w : &Wall)] : I32 (get-field w :blocks))
(defn wall/halves [(w : &Wall)] : I32 (get-field w :halves))
(defn wall/slack-mm [(w : &Wall)] : F64 (get-field w :slack-mm))
(defn wall/laid-blocks [(w : &Wall)] : I32 (get-field w :block))

(defn wall/params [(length-mm : F64) (courses : I32) (gap-mm : F64) (bond : I32)] : WallMod
  ;; NB: no space after a key's colon -- `: courses` lexes as a bare `:` token plus two names
  ;; (9 forms here, which is why the parser reported an odd count). Found the hard way below.
  {:length-mm length-mm :courses courses :gap-mm gap-mm :bond bond})

;; Width of one block along the run, in MILLIMETRES: cells * cm-per-cell * 10. All the wall
;; arithmetic below is in mm (mortar joints are quoted in mm), so the cm->mm factor lives here
;; and nowhere else. It was missing at first, which made a 40 cm block read as 40 mm and every
;; count in this file wrong -- caught by the hand-derived per-course assertion, not by the build.
(defn wall/block-mm [(lib : &Library) (block : I32)] : F64
  (if (lib/in-range? lib block)
    (* (* (lib/cell-cm lib block) (i32-to-f64 (lib/dim lib block 0))) 10.0)
    -1.0))

(defn wall/blocks-along [(lib : &Library) (block : I32) (run-mm : F64) (gap-mm : F64)] : I32
  (let [block-mm (wall/block-mm lib block)
        pitch (+ block-mm gap-mm)]
    (if (or (<= pitch 0.0) (< run-mm 0.0))
      0
      (f64-to-i32 (math/floor (/ (+ run-mm gap-mm) pitch))))))

(defn wall/lay [(lib : &Library) (block : I32) (spec : &WallMod)] : Wall
  (let [run-mm (get-field spec :length-mm)
        courses (get-field spec :courses)
        gap-mm (get-field spec :gap-mm)
        bond (get-field spec :bond)
        block-mm (wall/block-mm lib block)
        per (wall/blocks-along lib block run-mm gap-mm)
        laid (+ (* (i32-to-f64 per) block-mm) (* (i32-to-f64 (- per 1)) gap-mm))
        offset-courses (if (= bond 1) (f64-to-i32 (math/floor (/ (i32-to-f64 courses) 2.0))) 0)
        halves (if (> offset-courses 0) (* offset-courses 2) 0)]
    {:block block
     :per-course per
     :courses courses
     :blocks (* per courses)
     :halves halves
     :slack-mm (if (> per 0) (- run-mm laid) run-mm)}))

;; ---------------------------------------------------------------------------
;; The plan — quantities over many walls
;; ---------------------------------------------------------------------------
;; This is the layer a level builder's HUD reads: how many blocks a structure costs, how much
;; material that is, and what it weighs before anyone renders a triangle. Note the arithmetic:
;; prims is exact (each half block is half of the block's primitive cells), volume is exact
;; (a running-bond course's two halves are one block's worth of material between them), and
;; mass falls out of the material's own density — no per-wall fudge factors.
(defstruct Plan
  (walls      : I32)
  (blocks     : I32)
  (halves     : I32)
  (prims      : I32)
  (volume-cm3 : F64))

(defn plan/new [] : Plan
  {:walls 0 :blocks 0 :halves 0 :prims 0 :volume-cm3 0.0})

(defn plan/add-wall! [(p : &mut Plan) (lib : &Library) (w : &Wall)] : I32
  (let [block (get-field w :block)
        blocks (get-field w :blocks)
        halves (get-field w :halves)
        bp (lib/prims lib block)
        bv (lib/volume-cm3 lib block)
        halves-prims (/ (* bp halves) 2)
        units (+ (i32-to-f64 blocks) (* 0.5 (i32-to-f64 halves)))]
    (set! (get-field p :walls) (+ (get-field p :walls) 1))
    (set! (get-field p :blocks) (+ (get-field p :blocks) blocks))
    (set! (get-field p :halves) (+ (get-field p :halves) halves))
    (set! (get-field p :prims) (+ (get-field p :prims) (+ (* bp blocks) halves-prims)))
    (set! (get-field p :volume-cm3) (+ (get-field p :volume-cm3) (* bv units)))
    1))

;; kg. 1 m^3 is 1e6 cm^3, so volume_cm3 * density / 1e6. An unknown material fails closed with
;; -1.0 rather than silently weighing as concrete.
(defn plan/mass-kg [(p : &Plan) (mats : &MaterialTable) (mat : I32)] : F64
  (let [d (mats/density mats mat)]
    (if (< d 0.0)
      -1.0
      (* (get-field p :volume-cm3) (/ d 1000000.0)))))

;; ---------------------------------------------------------------------------
;; self-test — real assertions, written in PARENA, run by tests/test_forgedlevel.c
;; ---------------------------------------------------------------------------
;; Each check keeps its own short `let`: a single let with dozens of bindings hits a real VS0
;; emitter limit (late bindings stop resolving — documented in
;; stdlib/forgedinface/rig.prn's own self-test note).
(defn self-test-materials [(dest : Arena @ Region)] : Bool
  (let [t (mats/standard dest)
        ok-count (= (mats/count &t) 3)
        ok-concrete (near? (mats/density &t 0) 2400.0)
        ok-block (near? (mats/density &t 1) 1900.0)
        ok-timber (near? (mats/density &t 2) 600.0)
        ok-out (near? (mats/density &t 3) -1.0)
        ok-negative (near? (mats/weathering &t -1) -1.0)
        ok-bevel (near? (mats/bevel &t 0) 0.5)]
    (and ok-count
         (and ok-concrete
              (and ok-block (and ok-timber (and ok-out (and ok-negative ok-bevel))))))))

;; A cinder block: 16 cells, 4 of them cores, 12 solid, 12000 cm^3 at a 10cm cell.
(defn self-test-block [(dest : Arena @ Region)] : Bool
  (let [lib (lib/new dest)
        cells (vec/new dest)
        nested (vec/new dest)
        _0 (block/cinder! &mut cells &mut nested 0)
        id (lib/add! &mut lib 4 2 2 10.0 &cells &nested)
        ok-cells (= (vec/len &cells) 16)
        ok-id (= id 0)
        ;; x=3 y=1 z=1 -> z*(dx*dy) + y*dx + x = 8 + 4 + 3
        ok-index (= (block/cell-index 3 1 1 4 2) 15)
        ok-core (block/hollow? 1 0 4)
        ok-edge (not (block/hollow? 3 0 4))
        ok-upper (not (block/hollow? 1 1 4))
        ok-core-cell (= (lib/cell &lib 0 (block/cell-index 1 0 0 4 2)) -1)
        ok-solid-cell (= (lib/cell &lib 0 (block/cell-index 0 0 0 4 2)) 0)
        ok-span (= (lib/span &lib 0) 16)]
    (and ok-cells
         (and ok-id
              (and ok-index
                   (and ok-core (and ok-edge (and ok-upper (and ok-core-cell
                        (and ok-solid-cell ok-span))))))))))

(defn self-test-quantities [(dest : Arena @ Region)] : Bool
  (let [lib (lib/new dest)
        cells (vec/new dest)
        nested (vec/new dest)
        _0 (block/cinder! &mut cells &mut nested 0)
        _1 (lib/add! &mut lib 4 2 2 10.0 &cells &nested)
        ok-prims (= (lib/prims &lib 0) 12)
        ok-volume (near? (lib/volume-cm3 &lib 0) 12000.0)
        ok-out-volume (near? (lib/volume-cm3 &lib 5) -1.0)
        ok-out-prims (= (lib/prims &lib -1) -1)
        ok-block-mm (near? (wall/block-mm &lib 0) 400.0)]
    (and ok-prims (and ok-volume (and ok-out-volume (and ok-out-prims ok-block-mm))))))

;; A 4 m run, 3 courses, 10 mm joint, running bond: 9 full blocks per course (9*400 + 8*10 =
;; 3680 mm, 320 mm left over), 27 full blocks, one offset course costing 2 halves.
(defn self-test-wall [(dest : Arena @ Region)] : Bool
  (let [lib (lib/new dest)
        cells (vec/new dest)
        nested (vec/new dest)
        _0 (block/cinder! &mut cells &mut nested 0)
        _1 (lib/add! &mut lib 4 2 2 10.0 &cells &nested)
        spec (wall/params 4000.0 3 10.0 1)
        w (wall/lay &lib 0 &spec)
        ok-per (= (get-field w :per-course) 9)
        ok-blocks (= (get-field w :blocks) 27)
        ok-halves (= (get-field w :halves) 2)
        ok-slack (near? (get-field w :slack-mm) 320.0)
        ;; stack bond on the same run: same blocks, no halves. Each spec is its own binding:
        ;; `&(call ...)` is not an lvalue in the emitted C (`lvalue required as unary '&'
        ;; operand`), so a call result is never addressed directly.
        flat-spec (wall/params 4000.0 3 10.0 0)
        flat (wall/lay &lib 0 &flat-spec)
        ok-flat (= (get-field flat :halves) 0)
        ;; a run too short for one block lays nothing and reports the whole run as slack.
        ;; NB: `short` is a C keyword and cannot be a binding name -- the same real constraint
        ;; stdlib/forgedinface/rig.prn's header records.
        stub-spec (wall/params 300.0 1 10.0 0)
        stub (wall/lay &lib 0 &stub-spec)
        ok-stub (= (get-field stub :per-course) 0)]
    (and ok-per (and ok-blocks (and ok-halves (and ok-slack (and ok-flat ok-stub)))))))

;; One wall through the plan: 336000 cm^3 = 0.336 m^3 of concrete at 2400 kg/m^3 = 806.4 kg,
;; and 27*12 + 2*6 = 336 primitive cells.
(defn self-test-plan [(dest : Arena @ Region)] : Bool
  (let [lib (lib/new dest)
        cells (vec/new dest)
        nested (vec/new dest)
        _0 (block/cinder! &mut cells &mut nested 0)
        _1 (lib/add! &mut lib 4 2 2 10.0 &cells &nested)
        spec (wall/params 4000.0 3 10.0 1)
        w (wall/lay &lib 0 &spec)
        p (plan/new)
        _2 (plan/add-wall! &mut p &lib &w)
        mats (mats/standard dest)
        ok-walls (= (get-field p :walls) 1)
        ok-prims (= (get-field p :prims) 336)
        ok-volume (near? (get-field p :volume-cm3) 336000.0)
        ok-mass (near? (plan/mass-kg &p &mats 0) 806.4)
        ok-unknown (near? (plan/mass-kg &p &mats 9) -1.0)
        _3 (plan/add-wall! &mut p &lib &w)
        ok-twice (= (get-field p :blocks) 54)]
    (and ok-walls (and ok-prims (and ok-volume (and ok-mass (and ok-unknown ok-twice)))))))

;; The recursion: an assembly whose cells are all "assembly 0" (the cinder block) — a 3-block
;; lintel. 3 * 12 = 36 primitive cells, 3 * 12000 = 36000 cm^3. A nested assembly id cannot name
;; itself, because add! only hands out ids in creation order and this one is created second.
(defn self-test-nested [(dest : Arena @ Region)] : Bool
  (let [lib (lib/new dest)
        bcells (vec/new dest)
        bnested (vec/new dest)
        _0 (block/cinder! &mut bcells &mut bnested 0)
        _1 (lib/add! &mut lib 4 2 2 10.0 &bcells &bnested)
        lcells (vec/new dest)
        lnested (vec/new dest)
        _2 (i32-push! &mut lcells -1)
        _3 (i32-push! &mut lnested 0)
        _4 (i32-push! &mut lcells -1)
        _5 (i32-push! &mut lnested 0)
        _6 (i32-push! &mut lcells -1)
        _7 (i32-push! &mut lnested 0)
        _8 (lib/add! &mut lib 3 1 1 10.0 &lcells &lnested)
        ok-prims (= (lib/prims &lib 1) 36)
        ok-volume (near? (lib/volume-cm3 &lib 1) 36000.0)
        ok-count (= (lib/count &lib) 2)
        ok-nested (= (lib/nested &lib 1 1) 0)]
    (and ok-prims (and ok-volume (and ok-count ok-nested)))))

(defn self-test [(dest : Arena @ Region)] : Bool
  (and (self-test-materials dest)
       (and (self-test-block dest)
            (and (self-test-quantities dest)
                 (and (self-test-wall dest)
                      (and (self-test-plan dest) (self-test-nested dest)))))))
