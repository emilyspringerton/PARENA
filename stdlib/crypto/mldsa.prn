;; stdlib/crypto/mldsa.prn -- ML-DSA-44 (post-quantum digital signature, FIPS 204), real, working
;; PARENA binding. EMILY/BACKLOG.md SECTION 536 follow-up, BIG_O/NORTHSTAR.md §29. Founder
;; real-time: "add real SSH key generation" -> (checked GFD's real SSH server first: no post-
;; quantum public-key auth algorithm exists there) -> "upgrade to quantum safe encryption" ->
;; "scope a real ML-DSA/Dilithium implementation" -> "write it in PARENA".
;;
;; Same real design judgment STDLIB.md's own "crypto/hash"/"crypto/aes"/"crypto/ed25519" section
;; already states explicitly: "hand-rolled crypto is a well-known way to introduce real, serious
;; vulnerabilities, so this explicitly does not attempt it" -- FFI-bound to a real, vendored,
;; independently-verified implementation (runtime/mldsa/, the official CRYSTALS-Dilithium
;; reference, pq-crystals/dilithium, CC0/public domain, vendored byte-for-byte -- see that
;; directory's own attribution header), not lattice arithmetic reimplemented in PARENA itself.
;;
;; REAL, CHECKED, NOT ASSUMED FINDING: `crypto/ed25519.prn` (this same directory) is NOT actually
;; working today -- a design-only stub whose `#target` body calls a C function
;; (`sodium_ed25519_keygen`) that was never implemented anywhere in this repo (no libsodium
;; linked, confirmed via a real grep), AND whose own shape violates the real rule pty.prn's own
;; 2026-08-26 rewrite discovered: a `#target` inline-c body can only return a plain scalar/String/
;; Bytes, never a struct/Result directly (VS0 never auto-boxes). This file is PARENA's first real,
;; actually-working crypto binding, following pty.prn's own corrected shape: raw `-raw-`
;; primitives do the real FFI call and return only a scalar/Bytes, ordinary PARENA code (this
;; file's own `mldsa-keygen`/`mldsa-sign`/`mldsa-verify`) builds the real struct/Bool around it.
;;
;; Uses `Bytes` (stdlib/bytes.prn), not `String`, for every key/signature/message value: `String`
;; is `strlen`-based (NUL-terminated, checked directly against string.prn's own `length`
;; implementation) and would silently truncate real, high-entropy crypto key/signature bytes at
;; their first embedded `0x00` -- exactly the gap class `bytes.prn`'s own doc comment already
;; names. `bytes-slice` (added to bytes.prn in this same pass, a real, additive extension that
;; file's own doc comment explicitly invited) is what splits ML-DSA keygen's real, single
;; concatenated pubkey+seckey output back into two real halves.
;;
;; REAL, HONEST, NAMED GAP (unchanged since this work started): nothing this produces
;; authenticates against GFD's real SSH server -- no post-quantum public-key algorithm is
;; registered in the SSH protocol as GFD implements it (Go's golang.org/x/crypto/ssh v0.24.0,
;; checked directly). A real, working ML-DSA-44 keypair/signature primitive, callable from PARENA,
;; with no live consumer wired to SSH auth yet -- the "correct primitive, no consumer" pattern
;; this whole SECTION 536 thread has already used honestly more than once.
;;
;; Requires PARENA_WITH_MLDSA (a consumer opts in, same real convention PARENA_WITH_TLS already
;; establishes for mbedTLS) plus compiling+linking runtime/mldsa/*.c (excluding nistkat/, test/)
;; into the final binary -- see runtime/parena_runtime.h's own mldsa_*_impl header comment.
;;
;; VERIFIED END TO END (2026-09-24, `make test-mldsa`, tests/test_mldsa.c): the real, generated
;; call chain (this file's own mldsa-keygen/mldsa-sign/mldsa-verify -> mldsa_raw_*_impl ->
;; the vendored CRYSTALS-Dilithium reference), not the vendored C tested standalone -- correctly-
;; sized non-degenerate keys, sign->verify roundtrip, tampered-signature/tampered-message/
;; cross-key rejection, and hedged-signing non-determinism (two signatures over the same message
;; are never byte-identical, both still verify). Clean under gcc -Wall -Wextra -Werror
;; -fsanitize=address,undefined -- zero warnings, zero memory errors.
(module crypto/mldsa)
(import bytes)
(export mldsa-keygen mldsa-sign mldsa-verify KeyPair
        mldsa-pubkey-bytes mldsa-seckey-bytes mldsa-sig-bytes)

(defstruct KeyPair (public-key : Bytes @ Region) (secret-key : Bytes @ Region))

;; Real, fixed ML-DSA-44 sizes (runtime/mldsa/params.h's own real, checked constants -- not
;; guessed): public key 1312 bytes, secret key 2560 bytes, signature 2420 bytes (observed fixed in
;; practice across a real 10000-round self-test, not just an upper bound -- pack_sig's own real
;; encoding is fixed-width for this parameter set).
(defn mldsa-pubkey-bytes [] : I32 1312)
(defn mldsa-seckey-bytes [] : I32 2560)
(defn mldsa-sig-bytes [] : I32 2420)

;; ---- raw FFI primitives -- the only #target bodies in this file, each a single C expression
;; against runtime/parena_runtime.h's own mldsa_*_impl functions, no boxing (pty.prn's own
;; established, real, working shape).

;; mldsa-raw-keygen -- returns pubkey||seckey concatenated (1312+2560 = 3872 bytes) as one real
;; Bytes value, split into the real KeyPair struct below by ordinary PARENA code (bytes-slice),
;; not inside the FFI call itself -- a #target body can't construct a struct directly (see this
;; file's own top comment).
(defn mldsa-raw-keygen [(dest : Arena @ Region)]
  : Bytes @ Region
  #target
  {:c (inline-c "mldsa_keygen_impl(dest)")})

(defn mldsa-raw-sign [(msg : Bytes) (seckey : Bytes) (dest : Arena @ Region)]
  : Bytes @ Region
  #target
  {:c (inline-c "mldsa_sign_impl(msg, seckey, dest)")})

;; mldsa-raw-verify -- 0 = real, valid signature; nonzero = real, honest reject. Mirrors the
;; vendored crypto_sign_verify's own real contract exactly, no reinterpretation.
(defn mldsa-raw-verify [(sig : Bytes) (msg : Bytes) (pubkey : Bytes)]
  : I32
  #target
  {:c (inline-c "mldsa_verify_impl(sig, msg, pubkey)")})

;; ---- real PARENA-level API

(defn mldsa-keygen [(dest : Arena @ Region)]
  : KeyPair @ Region
  (let [blob (mldsa-raw-keygen dest)]
    {:public-key (bytes-slice blob 0 (mldsa-pubkey-bytes) dest)
     :secret-key (bytes-slice blob (mldsa-pubkey-bytes) (+ (mldsa-pubkey-bytes) (mldsa-seckey-bytes)) dest)}))

(defn mldsa-sign [(msg : Bytes) (key : &KeyPair) (dest : Arena @ Region)]
  : Bytes @ Region
  (mldsa-raw-sign msg (get-field key :secret-key) dest))

(defn mldsa-verify [(sig : Bytes) (msg : Bytes) (pubkey : Bytes)]
  : Bool
  (= (mldsa-raw-verify sig msg pubkey) 0))
