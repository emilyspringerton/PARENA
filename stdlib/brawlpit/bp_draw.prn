;; stdlib/brawlpit/bp_draw.prn -- BRAWLPIT web engine: software renderer primitives.
;;
;; Everything on screen is painted here, in wasm, into the 960x540 RGBA framebuffer at fb-base; the
;; page only copies those bytes onto a <canvas>. Colors are 0xAABBGGRR (R is the first byte in
;; memory, which is what ImageData wants). No heap, no libm: sin/cos are polynomial, sqrt is the
;; f32.sqrt instruction.

(defn opaque [] : I32 -16777216)  ; 0xFF000000
(defn rgb [(r : I32) (g : I32) (b : I32)] : I32
  (bit-or (opaque) (bit-or r (bit-or (shl g 8) (shl b 16)))))
(defn to255 [(v : F32)] : I32 (clamp-i (i32 (* v 255.0)) 0 255))
(defn rgbf [(r : F32) (g : F32) (b : F32)] : I32 (rgb (to255 r) (to255 g) (to255 b)))
(defn col-r [(c : I32)] : I32 (bit-and c 255))
(defn col-g [(c : I32)] : I32 (bit-and (shr c 8) 255))
(defn col-b [(c : I32)] : I32 (bit-and (shr c 16) 255))

;; mix(c1, c2, t) with t in 0..255 (0 = c1)
(defn mix [(c1 : I32) (c2 : I32) (t : I32)] : I32
  (rgb (+ (col-r c1) (/ (* (- (col-r c2) (col-r c1)) t) 255))
       (+ (col-g c1) (/ (* (- (col-g c2) (col-g c1)) t) 255))
       (+ (col-b c1) (/ (* (- (col-b c2) (col-b c1)) t) 255))))

(defn px-addr [(x : I32) (y : I32)] : I32 (+ (fb-base) (shl (+ (* y 960) x) 2)))
(defn inside? [(x : I32) (y : I32)] : Bool
  (and (and (>= x 0) (< x 960)) (and (>= y 0) (< y 540))))

(defn put-px [(x : I32) (y : I32) (c : I32)] : Unit
  (when (inside? x y) (store32! (px-addr x y) c)))

;; src over dst at alpha a (0..255)
(defn put-px-a [(x : I32) (y : I32) (c : I32) (a : I32)] : Unit
  (when (inside? x y)
    (let [d (load32 (px-addr x y))]
      (store32! (px-addr x y) (mix d c a)))))

(defn fill-rect [(x : I32) (y : I32) (w : I32) (h : I32) (c : I32)] : Unit
  (let [x0 (max-i x 0) y0 (max-i y 0) x1 (min-i (+ x w) 960) y1 (min-i (+ y h) 540)]
    (loop [yy y0]
      (when (< yy y1)
        (loop [xx x0]
          (when (< xx x1)
            (store32! (px-addr xx yy) c)
            (recur (+ xx 1))))
        (recur (+ yy 1))))))

(defn fill-rect-a [(x : I32) (y : I32) (w : I32) (h : I32) (c : I32) (a : I32)] : Unit
  (let [x0 (max-i x 0) y0 (max-i y 0) x1 (min-i (+ x w) 960) y1 (min-i (+ y h) 540)]
    (loop [yy y0]
      (when (< yy y1)
        (loop [xx x0]
          (when (< xx x1)
            (store32! (px-addr xx yy) (mix (load32 (px-addr xx yy)) c a))
            (recur (+ xx 1))))
        (recur (+ yy 1))))))

(defn rect-outline [(x : I32) (y : I32) (w : I32) (h : I32) (t : I32) (c : I32)] : Unit
  (do (fill-rect x y w t c)
      (fill-rect x (- (+ y h) t) w t c)
      (fill-rect x y t h c)
      (fill-rect (- (+ x w) t) y t h c)))

;; vertical gradient background, top color -> bottom color
(defn fill-gradient [(top : I32) (bot : I32)] : Unit
  (dotimes [y 540]
    (let [c (mix top bot (/ (* y 255) 539))]
      (loop [x 0]
        (when (< x 960)
          (store32! (px-addr x y) c)
          (recur (+ x 1)))))))

;; ---- lines and circles ------------------------------------------------------------------------
(defn line [(x0 : I32) (y0 : I32) (x1 : I32) (y1 : I32) (th : I32) (c : I32)] : Unit
  (let [dx (abs-i (- x1 x0)) dy (- 0 (abs-i (- y1 y0)))
        sx (if (< x0 x1) 1 -1) sy (if (< y0 y1) 1 -1)
        x x0 y y0 err (+ dx dy)]
    (loop [guard 0]
      (when (< guard 4096)
        (fill-rect (- x (/ th 2)) (- y (/ th 2)) th th c)
        (when (not (and (= x x1) (= y y1)))
          (let [e2 (* 2 err)]
            (when (>= e2 dy) (set! err (+ err dy)) (set! x (+ x sx)))
            (when (<= e2 dx) (set! err (+ err dx)) (set! y (+ y sy))))
          (recur (+ guard 1)))))))

(defn fill-circle [(cx : I32) (cy : I32) (r : I32) (c : I32)] : Unit
  (dotimes [i (+ (* 2 r) 1)]
    (let [dy (- i r)
          (w : F32) (sqrt (f32 (max-i 0 (- (* r r) (* dy dy)))))
          hw (i32 w)]
      (fill-rect (- cx hw) (+ cy dy) (+ (* 2 hw) 1) 1 c))))

(defn fill-circle-a [(cx : I32) (cy : I32) (r : I32) (c : I32) (a : I32)] : Unit
  (dotimes [i (+ (* 2 r) 1)]
    (let [dy (- i r)
          (w : F32) (sqrt (f32 (max-i 0 (- (* r r) (* dy dy)))))
          hw (i32 w)]
      (fill-rect-a (- cx hw) (+ cy dy) (+ (* 2 hw) 1) 1 c a))))

;; sin/cos without libm (Bhaskara-style parabola + one refinement; plenty for visuals)
(defn tau [] : F32 6.2831855)
(defn wrap-pi [(x : F32)] : F32
  (let [(y : F32) (- x (* (tau) (floor (/ (+ x 3.1415927) (tau)))))] y))
(defn sin-f [(x : F32)] : F32
  (let [(w : F32) (wrap-pi x)
        (y : F32) (- (* 1.2732395 w) (* (* 0.40528473 w) (fabs w)))]
    (+ (* 0.225 (- (* y (fabs y)) y)) y)))
(defn cos-f [(x : F32)] : F32 (sin-f (+ x 1.5707964)))

(defn circle-outline [(cx : I32) (cy : I32) (r : I32) (segs : I32) (th : I32) (c : I32)] : Unit
  (dotimes [i segs]
    (let [(a0 : F32) (/ (* (tau) (f32 i)) (f32 segs))
          (a1 : F32) (/ (* (tau) (f32 (+ i 1))) (f32 segs))]
      (line (+ cx (i32 (* (f32 r) (cos-f a0)))) (+ cy (i32 (* (f32 r) (sin-f a0))))
            (+ cx (i32 (* (f32 r) (cos-f a1)))) (+ cy (i32 (* (f32 r) (sin-f a1)))) th c))))

;; ---- text (8x16 bitmap font, shared with the GFD terminal) -------------------------------------
(defn nibble [(c : I32)] : I32 (if (>= c 97) (- c 87) (- c 48)))

(defn load-font [] : Unit
  (let [s (str-addr (font-hex))]
    (loop [i 0]
      (when (< i 4080)
        (store8! (+ (font-base) i)
                 (bit-or (shl (nibble (load8 (+ s (shl i 1)))) 4)
                         (nibble (load8 (+ s (+ (shl i 1) 1))))))
        (recur (+ i 1))))))

(defn glyph-idx [(ch : I32)] : I32 (if (and (>= ch 32) (<= ch 126)) (- ch 32) 31))

(defn draw-glyph [(g : I32) (x : I32) (y : I32) (sc : I32) (c : I32)] : Unit
  (dotimes [row 16]
    (let [bits (load8 (+ (font-base) (+ (* g 16) row)))]
      (when (!= bits 0)
        (dotimes [col 8]
          (when (= (bit-and (shr bits (- 7 col)) 1) 1)
            (fill-rect (+ x (* col sc)) (+ y (* row sc)) sc sc c)))))))

(defn str-len [(s : String)] : I32
  (let [a (str-addr s)]
    (loop [i 0] (if (= (load8 (+ a i)) 0) i (recur (+ i 1))))))

(defn text-width [(s : String) (sc : I32)] : I32 (* (str-len s) (* 8 sc)))

(defn draw-text [(s : String) (x : I32) (y : I32) (sc : I32) (c : I32)] : Unit
  (let [a (str-addr s)]
    (loop [i 0]
      (let [ch (load8 (+ a i))]
        (when (!= ch 0)
          (draw-glyph (glyph-idx ch) (+ x (* i (* 8 sc))) y sc c)
          (recur (+ i 1)))))))

;; text with a 1-unit drop shadow (native: text_draw_string_shadowed)
(defn draw-text-s [(s : String) (x : I32) (y : I32) (sc : I32) (c : I32)] : Unit
  (do (draw-text s (+ x sc) (+ y sc) sc (opaque))
      (draw-text s x y sc c)))

(defn draw-text-c [(s : String) (cx : I32) (y : I32) (sc : I32) (c : I32)] : Unit
  (draw-text-s s (- cx (/ (text-width s sc) 2)) y sc c))

;; ---- numbers: decimal, no libc ------------------------------------------------------------------
(defn scratch [] : I32 196000)  ; 32 bytes of digit scratch, below the font

(defn digit-count [(n : I32)] : I32
  (loop [v (abs-i n) d 1] (if (< v 10) d (recur (/ v 10) (+ d 1)))))

(defn num-width [(n : I32) (sc : I32)] : I32
  (* (+ (digit-count n) (b2i (< n 0))) (* 8 sc)))

(defn draw-int [(n : I32) (x : I32) (y : I32) (sc : I32) (c : I32)] : Unit
  (let [d (digit-count n)
        neg (< n 0)]
    (when neg (draw-glyph (glyph-idx 45) x y sc c))
    (let [x0 (+ x (* (b2i neg) (* 8 sc)))]
      (loop [i (- d 1) v (abs-i n)]
        (when (>= i 0)
          (draw-glyph (glyph-idx (+ 48 (mod v 10))) (+ x0 (* i (* 8 sc))) y sc c)
          (recur (- i 1) (/ v 10)))))))

(defn draw-int-s [(n : I32) (x : I32) (y : I32) (sc : I32) (c : I32)] : Unit
  (do (draw-int n (+ x sc) (+ y sc) sc (opaque))
      (draw-int n x y sc c)))

;; ---- image blit: RGBA source, nearest-neighbour scale, optional mirror / flash ---------------
;; mode 0 = as-is, 1 = flash white, 2 = flat grey (invulnerability flicker)
(defn blit [(src : I32) (sw : I32) (sh : I32) (dx : I32) (dy : I32) (dw : I32) (dh : I32)
            (flip : Bool) (mode : I32)] : Unit
  (when (and (> dw 0) (> dh 0))
    (dotimes [y dh]
      (let [py (+ dy y)]
        (when (and (>= py 0) (< py 540))
          (let [sy (/ (* y sh) dh)]
            (dotimes [x dw]
              (let [px (+ dx x)]
                (when (and (>= px 0) (< px 960))
                  (let [sx (/ (* (if flip (- (- dw 1) x) x) sw) dw)
                        c (load32 (+ src (shl (+ (* sy sw) sx) 2)))
                        a (bit-and (ushr c 24) 255)]
                    (when (>= a 128)
                      (store32! (px-addr px py)
                                (cond (= mode 1) -1
                                      (= mode 2) (rgb 128 128 128)
                                      :else (bit-or (opaque) (bit-and c 16777215)))))))))))))))
