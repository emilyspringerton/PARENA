;; stdlib/brawlpit/bp_mem.prn -- BRAWLPIT web engine: linear-memory map and generic accessors.
;;
;; Founder real-time 2026-10-16: "get brawlpit web shipped; PARENA powered; no malloc; wasmdaddy"
;; then "make sure its actually wasm not faked with a bunch of garbage js". The whole game --
;; simulation, bots, menus, software renderer -- is PARENA compiled to wasm32 (scripts/
;; build_brawlpit_wasm.sh: parena build -> opt -> llc -> wasm-ld, no Emscripten). The browser page
;; only feeds it key/pad/pointer state, hands it decoded images, and blits its framebuffer.
;;
;; NO MALLOC: there is no allocator anywhere. Every record lives at a fixed address below, sized at
;; compile time; the module imports nothing and never grows memory (tests/brawlpit_engine_test.mjs
;; asserts both). The ported physics is a line-for-line translation of BRAWLPIT/packages/common/
;; physics.h + packages/simulation/local_game.h, and runs on F32 (single precision), the same
;; float C used, so tests/brawlpit_parity_ref.c can compare the two engines bit for bit.
;;
;; Memory map (byte addresses; module is linked with an 8 MB initial memory):
;;   0x020000 CTL      input: key table, pad slots, pointer          (see bp_input.prn)
;;   0x021000 G        global state words                             (g-* below)
;;   0x022000 PLAYERS  8 x 512 bytes, 64 live words each              (bp_fields.prn)
;;   0x023000 TURNIPS  16 x 32 bytes                                  (projectiles)
;;   0x023400 EDGEKO   16 x 32 bytes                                  (KO flash effects)
;;   0x024000 STAGE    64 platforms x 20 bytes + blast zone           (bp_stage.prn)
;;   0x025000 FIGHTERS 10 x 64 bytes of F32 multipliers/colors        (bp_fighters.prn)
;;   0x030000 FONT     255 glyphs x 16 rows
;;   0x040000 HATS     8 slots x 32x32 RGBA
;;   0x100000 FB       960 x 540 RGBA framebuffer
;;   0x300000 SPRITES  8 slots x 128x128 RGBA (character portraits, optional)

(module brawlpit/engine)

;; ---- region bases -----------------------------------------------------------------------
(defn ctl-base [] : I32 131072)
(defn g-base [] : I32 135168)
(defn players-base [] : I32 139264)
(defn turnips-base [] : I32 143360)
(defn edgeko-base [] : I32 143872)
(defn stage-base [] : I32 147456)
(defn fighters-base [] : I32 151552)
(defn font-base [] : I32 196608)
(defn hats-base [] : I32 262144)
(defn fb-base [] : I32 1048576)
(defn sprites-base [] : I32 3145728)
(defn hatname-base [] : I32 299008)     ; 64 bytes: the page writes the equipped hat's name here

(defn fb-w [] : I32 960)
(defn fb-h [] : I32 540)

(defn max-clients [] : I32 8)
(defn max-turnips [] : I32 16)
(defn max-edge-ko [] : I32 16)

;; record addressing: slot -> base address
(defn pl-base [(p : I32)] : I32 (+ (players-base) (* p 512)))
(defn tn-base [(t : I32)] : I32 (+ (turnips-base) (* t 32)))
(defn ek-base [(e : I32)] : I32 (+ (edgeko-base) (* e 32)))

;; generic by-index player word access (for field-agnostic helpers like tick-down!)
(defn pi [(p : I32) (k : I32)] : I32 (load32 (+ (pl-base p) (shl k 2))))
(defn pi! [(p : I32) (k : I32) (v : I32)] : Unit (store32! (+ (pl-base p) (shl k 2)) v))
(defn pf [(p : I32) (k : I32)] : F32 (loadf32 (+ (pl-base p) (shl k 2))))
(defn pf! [(p : I32) (k : I32) (v : F32)] : Unit (storef32! (+ (pl-base p) (shl k 2)) v))

;; if (p->field > 0) p->field--;   -- the single most common statement in physics.h
(defn tick-down! [(p : I32) (k : I32)] : Unit
  (when (> (pi p k) 0) (pi! p k (- (pi p k) 1))))

;; ---- global state words -----------------------------------------------------------------
(defn gi [(k : I32)] : I32 (load32 (+ (g-base) (shl k 2))))
(defn gi! [(k : I32) (v : I32)] : Unit (store32! (+ (g-base) (shl k 2)) v))
(defn gf [(k : I32)] : F32 (loadf32 (+ (g-base) (shl k 2))))
(defn gf! [(k : I32) (v : F32)] : Unit (storef32! (+ (g-base) (shl k 2)) v))

;; sim (ServerState)
(defn g-server-tick [] : I32 0)
(defn g-game-mode [] : I32 1)
(defn g-match-over [] : I32 2)
(defn g-rng [] : I32 3)
(defn g-num-players [] : I32 4)
(defn g-stage-id [] : I32 5)
;; session
(defn g-phase [] : I32 8)          ; screen: see bp_ui.prn
(defn g-clock-acc [] : I32 9)      ; F32 ms owed to the fixed-step sim
(defn g-clock-last [] : I32 10)    ; F32 ms of the previous frame call
(defn g-frame [] : I32 11)         ; rendered frames
(defn g-sim-frames [] : I32 12)    ; sim ticks since match start
(defn g-winner [] : I32 13)
(defn g-cam-x [] : I32 14)         ; F32
(defn g-cam-y [] : I32 15)         ; F32
(defn g-cam-zoom [] : I32 16)      ; F32
(defn g-cursor [] : I32 17)
(defn g-cursor2 [] : I32 18)
(defn g-sel-p1 [] : I32 19)
(defn g-sel-p2 [] : I32 20)
(defn g-confirm-p1 [] : I32 21)
(defn g-confirm-p2 [] : I32 22)
(defn g-two-human [] : I32 23)     ; 1 = player 2 is a second human
(defn g-cpu-count [] : I32 24)
(defn g-menu-time [] : I32 25)
(defn g-paused [] : I32 26)
(defn g-shake [] : I32 27)
(defn g-hit-stop [] : I32 28)
(defn g-flags [] : I32 29)         ; bit0 sandbox practice
(defn g-hat-mask [] : I32 30)      ; bit n = hat slot n loaded
(defn g-sprite-mask [] : I32 31)   ; bit n = sprite slot n loaded
(defn g-ticker [] : I32 32)        ; wall-clock ms as I32 (animation only, never sim)
(defn g-last-input [] : I32 33)    ; 0 keyboard, 1 pad (for on-screen hints)
(defn g-best-stocks [] : I32 34)
(defn g-nav-prev [] : I32 35)
(defn g-nav-rep [] : I32 36)      ; 4 words: repeat counters for up/down/left/right
(defn g-slot-char0 [] : I32 40)    ; 8 words: character picked per slot for the next match
(defn g-hat-p1 [] : I32 48)        ; hat option: -1 none, 0 = the WOTAN hat, 8/9/10 = free colour hats
(defn g-hat-p2 [] : I32 49)
(defn g-mode [] : I32 50)          ; 0 vs CPU, 1 local 2P, 2 free-for-all, 3 practice
(defn g-step [] : I32 51)          ; fighter-select step: 0 P1, 1 P2, 2 stage
(defn g-countdown [] : I32 52)     ; frames of READY/3/2/1/GO before the sim runs
(defn g-end-delay [] : I32 53)     ; frames of "GAME!" before the results screen
(defn g-stage-sel [] : I32 54)     ; index into the stage list
(defn g-hit-peak [] : I32 55)
(defn g-quit-req [] : I32 56)
(defn g-ai-mode [] : I32 57)       ; CPU brain: 0 classic (the C bot), 1 easy, 2 normal, 3 hard
(defn g-ai-sel [] : I32 58)        ; the level chosen on the select screen
(defn g-hat-touched [] : I32 59)   ; 1 once the player has picked P1's hat by hand (a late store hat then stays out of it)

;; ---- tiny integer / float helpers -------------------------------------------------------
(defn b2i [(c : Bool)] : I32 (if c 1 0))
(defn min-i [(a : I32) (b : I32)] : I32 (if (< a b) a b))
(defn max-i [(a : I32) (b : I32)] : I32 (if (> a b) a b))
(defn clamp-i [(x : I32) (lo : I32) (hi : I32)] : I32 (max-i lo (min-i x hi)))
(defn abs-i [(x : I32)] : I32 (if (< x 0) (- 0 x) x))
(defn fmax2 [(a : F32) (b : F32)] : F32 (if (> a b) a b))
(defn fmin2 [(a : F32) (b : F32)] : F32 (if (< a b) a b))
(defn clamp-f [(x : F32) (lo : F32) (hi : F32)] : F32 (fmax2 lo (fmin2 x hi)))
