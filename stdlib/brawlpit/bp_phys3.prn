;; stdlib/brawlpit/bp_phys3.prn -- BRAWLPIT physics, part 3: update_entity (the per-player,
;; per-tick state machine), update_turnips, update_edge_ko_effects. Port of physics.h.

;; ---- the countdown block at the top of update_entity -------------------------------------
(defn ue-timers [(p : I32)] : Unit
  (do
    (tick-down! p (k-invuln-frames))
    (tick-down! p (k-hitlag-frames))
    (tick-down! p (k-hit-flash-timer))
    (tick-down! p (k-parasol-rehit-timer))
    (when (> (p-hitstun-frames p) 0)
      (set-p-hitstun-frames! p (- (p-hitstun-frames p) 1))
      (when (and (<= (p-hitstun-frames p) 0) (= (p-state p) (st-stunned)))
        (set-p-state! p (st-idle))))
    (tick-down! p (k-attack-cooldown))
    (when (> (p-attack-timer p) 0)
      (set-p-attack-timer! p (- (p-attack-timer p) 1))
      (when (and (= (p-attack-timer p) 0)
                 (and (= (p-state p) (st-attack)) (= (p-smash-active-timer p) 0)))
        (set-p-state! p (st-idle))))
    (when (> (p-smash-active-timer p) 0)
      (set-p-smash-active-timer! p (- (p-smash-active-timer p) 1))
      (when (and (= (p-smash-active-timer p) 0)
                 (and (= (p-state p) (st-attack)) (= (p-attack-timer p) 0)))
        (set-p-state! p (st-idle))))
    (when (> (p-smash-release-timer p) 0)
      (set-p-smash-release-timer! p (- (p-smash-release-timer p) 1))
      (when (= (p-smash-release-timer p) 0)
        (set-p-smash-active-timer! p (c-smash-active))
        (set-p-attack-cooldown! p (c-smash-cooldown))
        (set-p-state! p (st-attack))))
    (tick-down! p (k-smash-flash-timer))
    (tick-down! p (k-parry-timer))
    (tick-down! p (k-shield-stun-frames))
    (tick-down! p (k-shield-drop-timer))
    (tick-down! p (k-upb-landing-lag))
    (tick-down! p (k-wavedash-frames))
    (tick-down! p (k-dash-cooldown))
    (tick-down! p (k-drop-through-timer))
    (tick-down! p (k-special-b-cooldown))))

;; Rosie's side-B (High Score Rush): a timed dash, hit at the start and end, i-frames in the middle.
(defn ue-rosie-dash [(p : I32)] : Unit
  (when (> (p-rosie-dash-frame p) 0)
    (set-p-vx! p (* (f32 (p-facing p)) (c-rosie-dash-speed)))
    (when (= (p-rosie-dash-frame p) 1) (special-high-score-rush-hit p))
    (when (and (>= (p-rosie-dash-frame p) (c-rosie-invuln-start))
               (<= (p-rosie-dash-frame p) (c-rosie-invuln-end)))
      (when (< (p-invuln-frames p) 2) (set-p-invuln-frames! p 2)))
    (when (= (p-rosie-dash-frame p) (c-rosie-dash-total)) (special-high-score-rush-hit p))
    (set-p-rosie-dash-frame! p (+ (p-rosie-dash-frame p) 1))
    (when (> (p-rosie-dash-frame p) (c-rosie-dash-total))
      (set-p-rosie-dash-frame! p 0)
      (when (= (p-state p) (st-rosie-dash)) (set-p-state! p (st-idle))))))

(defn ue-shield-regen [(p : I32)] : Unit
  (if (> (p-shield-regen-timer p) 0)
      (set-p-shield-regen-timer! p (- (p-shield-regen-timer p) 1))
      (when (and (< (p-shield-health p) (c-shield-max))
                 (and (not (= (p-state p) (st-shield))) (= (p-shield-drop-timer p) 0)))
        (set-p-shield-health! p (+ (p-shield-health p) (c-shield-regen)))
        (when (> (p-shield-health p) (c-shield-max)) (set-p-shield-health! p (c-shield-max))))))

(defn latch-buttons! [(p : I32)] : Unit
  (do
    (set-p-btn-jump-prev! p (p-btn-jump p))
    (set-p-btn-attack-prev! p (p-btn-attack p))
    (set-p-btn-shield-prev! p (p-btn-shield p))
    (set-p-btn-special-prev! p (p-btn-special p))))

;; ---- shield (3-phase deploy, BPSW-1213..1217) ----------------------------------------------
(defn ue-shield [(p : I32) (shield-press : Bool)] : Unit
  (if (and (not (= (p-btn-shield p) 0))
           (and (> (p-shield-health p) 0.0) (not (= (p-state p) (st-upb)))))
      (do
        (when shield-press
          (set-p-parry-timer! p (c-parry-window))
          (set-p-shield-windup-frames! p (c-shield-windup))
          (set-p-shield-overpowered-frames! p 0))
        (set-p-state! p (st-shield))
        (set-p-shield-health! p (- (p-shield-health p) (c-shield-drain)))
        (set-p-vx! p (* (p-vx p) 0.9))
        (if (> (p-shield-windup-frames p) 0)
            (do (set-p-shield-windup-frames! p (- (p-shield-windup-frames p) 1))
                (when (= (p-shield-windup-frames p) 0)
                  (set-p-shield-overpowered-frames! p (c-shield-overpowered))))
            (when (> (p-shield-overpowered-frames p) 0)
              (set-p-shield-overpowered-frames! p (- (p-shield-overpowered-frames p) 1))))
        (when (<= (p-shield-health p) 0.0)
          (set-p-state! p (st-stunned))
          (set-p-hitstun-frames! p (c-shield-break-stun))
          (set-p-shield-health! p 0.0)))
      (when (= (p-state p) (st-shield))
        (set-p-state! p (st-idle))
        (set-p-shield-drop-timer! p (c-shield-drop-lag))
        (set-p-shield-windup-frames! p 0)
        (set-p-shield-overpowered-frames! p 0))))

;; ---- the controllable half of update_entity (everything gated by !action_locked) ---------
(defn ue-controls [(p : I32) (jump-press : Bool) (attack-press : Bool) (shield-press : Bool)
                   (special-press : Bool)] : Unit
  (let [cid (p-character-id p)]
    ;; hold down on a soft platform to drop through it
    (when (and (and (not (= (p-on-ground p) 0)) (= (p-ground-platform-type p) 1))
               (< (p-in-y p) -0.6))
      (set-p-drop-through-timer! p (c-drop-through))
      (set-p-on-ground! p 0)
      (set-p-ground-platform-type! p -1)
      (set-p-vy! p -0.2))
    (let [smash-possible (and (not (= (p-on-ground p) 0)) (> (fabs (p-in-x p)) 0.6))
          smash-lock (b2i (or (> (p-smash-charge-timer p) 0) (> (p-smash-release-timer p) 0)))]
      ;; Rosie's rush precedes the smash-charge trigger: both compete for the same input
      (cond
        (and smash-possible
             (and special-press
                  (and (= cid (char-rosie))
                       (and (= (p-dash-cooldown p) 0) (= (p-rosie-dash-frame p) 0)))))
          (do (set-p-rosie-dash-frame! p 1)
              (set-p-state! p (st-rosie-dash))
              (set-p-facing! p (if (> (p-in-x p) 0.0) 1 -1))
              (set-p-dash-cooldown! p (c-dodge-cooldown)))
        (and smash-possible
             (and (not (= (p-btn-special p) 0))
                  (and (= (p-smash-charge-timer p) 0)
                       (and (= (p-smash-active-timer p) 0)
                            (and (= (p-smash-release-timer p) 0)
                                 (and (= (p-attack-timer p) 0)
                                      (and (= (p-attack-cooldown p) 0)
                                           (not (= cid (char-rosie))))))))))
          (do (set-p-smash-charge-timer! p (c-smash-charge))
              (set-p-smash-charge-level! p 0.0)
              (set-p-state! p (st-attack))
              (set! smash-lock 1)))
      (when (> (p-smash-charge-timer p) 0)
        (set-p-vx! p 0.0)
        (when (not (= (p-on-ground p) 0)) (set-p-vy! p 0.0))
        (if (= (p-btn-special p) 0)
            (do (set-p-smash-charge-level! p (- 1.0 (/ (f32 (p-smash-charge-timer p)) (f32 (c-smash-charge)))))
                (set-p-smash-charge-timer! p 0)
                (set-p-smash-release-timer! p (c-smash-release-delay))
                (set-p-smash-flash-timer! p (c-smash-flash)))
            (do (set-p-smash-charge-timer! p (- (p-smash-charge-timer p) 1))
                (set-p-smash-charge-level! p (- 1.0 (/ (f32 (p-smash-charge-timer p)) (f32 (c-smash-charge)))))
                (when (= (p-smash-charge-timer p) 0)
                  (set-p-smash-charge-level! p 1.0)
                  (set-p-smash-release-timer! p (c-smash-release-delay))
                  (set-p-smash-flash-timer! p (c-smash-flash)))))
        (set! smash-lock 1))
      (when (and special-press
                 (and (not smash-possible)
                      (and (= (p-smash-charge-timer p) 0)
                           (and (= (p-smash-active-timer p) 0) (= (p-smash-release-timer p) 0)))))
        (dispatch-special-move p))
      (let [grounded (not (= (p-on-ground p) 0))
            (accel : F32) (* (if grounded (c-ground-accel) (c-air-accel))
                             (if grounded (fd cid (fd-ground-speed-mul)) (fd cid (fd-air-speed-mul))))
            (max-s : F32) (* (if grounded (c-ground-max) (c-air-max))
                             (if grounded (fd cid (fd-ground-speed-mul)) (fd cid (fd-air-speed-mul))))
            (fric : F32) (if grounded (c-ground-friction) (c-air-friction))]
        (when (and (> (p-wavedash-frames p) 0) grounded)
          (set! fric 0.0)
          (when (< max-s (c-wavedash-max)) (set! max-s (c-wavedash-max))))
        (cond
          (and (= smash-lock 0) (> (fabs (p-in-x p)) 0.01))
            (do (set-p-vx! p (+ (p-vx p) (* (p-in-x p) accel)))
                (set-p-facing! p (if (> (p-in-x p) 0.0) 1 -1)))
          (= smash-lock 0)
            (if (<= (fabs (p-vx p)) fric)
                (set-p-vx! p 0.0)
                (set-p-vx! p (- (p-vx p) (if (> (p-vx p) 0.0) fric (- fric))))))
        (when (> (p-vx p) max-s) (set-p-vx! p max-s))
        (when (< (p-vx p) (- max-s)) (set-p-vx! p (- max-s)))
        (when (and (= smash-lock 0) (and jump-press (> (p-jumps-remaining p) 0)))
          (set-p-vy! p (* (c-jump-force) (fd cid (fd-jump-mul))))
          (set-p-jumps-remaining! p (- (p-jumps-remaining p) 1))
          (set-p-on-ground! p 0)))
      (ue-shield p shield-press)
      (when (and attack-press
                 (and (not (= (p-state p) (st-shield)))
                      (and (= (p-attack-cooldown p) 0)
                           (and (= (p-attack-timer p) 0)
                                (and (= (p-smash-charge-timer p) 0)
                                     (and (= (p-smash-active-timer p) 0) (= (p-smash-release-timer p) 0)))))))
        (set-p-state! p (st-attack))
        (set-p-attack-timer! p (c-attack-active))
        (set-p-attack-cooldown! p (c-attack-cooldown))))))

;; ---- gravity, parasol, integration, collision, blast zone ---------------------------------
(defn ue-motion [(p : I32) (prev-y : F32) (dt : F32)] : Unit
  (let [cid (p-character-id p)]
    (set-p-vy! p (- (p-vy p)
                    (* (if (and (< (p-in-y p) -0.5) (= (p-on-ground p) 0)) (c-fast-fall) (c-gravity))
                       (fd cid (fd-gravity-mul)))))
    (when (and (or (not (= (p-umbrella-open p) 0)) (= (p-state p) (st-upb))) (< (p-vy p) 0.0))
      (set-p-vy! p (+ (p-vy p) (- (c-gravity) (c-umbrella-gravity))))
      (when (< (p-vy p) (- (c-umbrella-fall))) (set-p-vy! p (- (c-umbrella-fall)))))
    (when (= (p-state p) (st-upb))
      (set-p-upb-frame! p (+ (p-upb-frame p) 1))
      (cond
        (< (p-upb-frame p) 10)
          (do (set-p-vy! p (fmax2 (p-vy p) 1.2))
              (set-p-vx! p (+ (p-vx p) (* (p-in-x p) (* (c-air-accel) 0.6)))))
        (> (p-upb-frame p) 50)
          (do (set-p-state! p (st-air)) (set-p-umbrella-open! p 0)))
      (when (and (= cid (char-petalia)) (= (p-parasol-rehit-timer p) 0))
        (special-petalia-parasol-hit p)
        (set-p-parasol-rehit-timer! p (c-parasol-rehit))))
    (when (< (p-vy p) (- (c-terminal))) (set-p-vy! p (- (c-terminal))))
    (set-p-x! p (+ (p-x p) (* (* (p-vx p) dt) 60.0)))
    (set-p-y! p (+ (p-y p) (* (* (p-vy p) dt) 60.0)))
    (resolve-platform-collisions p prev-y)
    (when (and (not (= (p-on-ground p) 0))
               (and (= (p-state p) (st-wavedash)) (= (p-wavedash-frames p) 0)))
      (set-p-state! p (st-idle)))
    (when (and (not (= (p-on-ground p) 0)) (= (p-state p) (st-upb)))
      (set-p-state! p (st-idle))
      (set-p-umbrella-open! p 0)
      (set-p-upb-frame! p 0)
      (set-p-upb-landing-lag! p 14))
    (when (not (= (p-on-ground p) 0)) (set-p-umbrella-open! p 0))
    (latch-buttons! p)
    (when (or (< (p-x p) (blast-left))
              (or (> (p-x p) (blast-right))
                  (or (< (p-y p) (blast-bottom)) (> (p-y p) (blast-top)))))
      (phys-start-respawn p))))

;; ---- update_entity -------------------------------------------------------------------------
(defn update-entity [(p : I32) (dt : F32)] : Unit
  (when (not (= (p-state p) (st-dead)))
    (let [(prev-y : F32) (p-y p)]
      (if (> (p-respawn-timer p) 0)
          (do (set-p-respawn-timer! p (- (p-respawn-timer p) 1))
              (when (= (p-respawn-timer p) 0) (phys-respawn p)))
          (do
            (ue-timers p)
            (ue-rosie-dash p)
            (ue-shield-regen p)
            (if (> (p-launch-delay-frames p) 0)
                (do (set-p-launch-delay-frames! p (- (p-launch-delay-frames p) 1))
                    (set-p-vx! p 0.0)
                    (set-p-vy! p 0.0)
                    (when (= (p-launch-delay-frames p) 0)
                      (set-p-vx! p (p-pending-kb-x p))
                      (set-p-vy! p (p-pending-kb-y p)))
                    (latch-buttons! p))
                (let [jump-press (and (not (= (p-btn-jump p) 0)) (= (p-btn-jump-prev p) 0))
                      attack-press (and (not (= (p-btn-attack p) 0)) (= (p-btn-attack-prev p) 0))
                      shield-press (and (not (= (p-btn-shield p) 0)) (= (p-btn-shield-prev p) 0))
                      special-press (and (not (= (p-btn-special p) 0)) (= (p-btn-special-prev p) 0))
                      locked (or (> (p-hitstun-frames p) 0)
                                 (or (> (p-hitlag-frames p) 0)
                                     (or (> (p-shield-stun-frames p) 0)
                                         (or (> (p-shield-drop-timer p) 0)
                                             (or (> (p-launch-delay-frames p) 0)
                                                 (or (> (p-dash-cooldown p) 0) (> (p-upb-landing-lag p) 0)))))))]
                  (when (and (not locked) (not (= (p-state p) (st-stunned))))
                    (ue-controls p jump-press attack-press shield-press special-press))
                  (ue-motion p prev-y dt))))))))

;; ---- update_turnips / update_edge_ko_effects -----------------------------------------------
(defn update-turnips [] : Unit
  (dotimes [i 16]
    (when (not (= (t-active i) 0))
      (set-t-vy! i (- (t-vy i) (c-turnip-gravity)))
      (set-t-x! i (+ (t-x i) (t-vx i)))
      (set-t-y! i (+ (t-y i) (t-vy i)))
      (set-t-ttl-frames! i (- (t-ttl-frames i) 1))
      (if (<= (t-ttl-frames i) 0)
          (set-t-active! i 0)
          (loop [pl 0]
            (when (< pl 8)
              (if (or (= (p-active pl) 0)
                      (or (= (p-state pl) (st-dead)) (= pl (t-owner-id i))))
                  (recur (+ pl 1))
                  (if (check-aabb (- (t-x i) 0.5) (- (t-y i) 0.5) 1.0 1.0
                                  (- (p-x pl) 1.0) (p-y pl) 2.0 4.0)
                      (let [style (t-style i)
                            (dmg : F32) (cond (= style (c-style-bow)) (c-bow-damage)
                                              (= style (c-style-hat)) (c-hat-damage)
                                              (= style (char-vexar)) 10.0
                                              (= style (char-rosie)) (c-coin-damage)
                                              :else 8.0)
                            (ky : F32) (if (= style (char-vexar)) 0.45 0.6)]
                        (apply-knockback pl dmg (if (> (t-vx i) 0.0) 0.8 -0.8) ky)
                        (set-t-active! i 0))
                      (recur (+ pl 1))))))))))

(defn update-edge-ko-effects [] : Unit
  (dotimes [i 16]
    (when (not (= (e-active i) 0))
      (set-e-timer! i (- (e-timer i) 1))
      (when (<= (e-timer i) 0)
        (set-e-active! i 0)
        (set-e-timer! i 0)))))
