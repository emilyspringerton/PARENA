;; stdlib/brawlpit/bp_phys1.prn -- BRAWLPIT physics, part 1: constants, respawn, hit resolution,
;; platform collision. A line-for-line port of BRAWLPIT/packages/common/physics.h to PARENA
;; (F32 throughout, evaluation order preserved) so the wasm engine is bit-identical to the C one:
;; tests/brawlpit_parity_ref.c + tests/brawlpit_parity_test.mjs run both side by side.
;; player ids/states are the protocol.h ones: STATE_IDLE 0 RUN 1 AIR 2 ATTACK 3 STUNNED 4 SHIELD 5
;; DEAD 6 RESPAWN 7 WAVEDASH 13 UPB 14 ROSIE_DASH 15.

;; ---- states ------------------------------------------------------------------------------
(defn st-idle [] : I32 0)
(defn st-attack [] : I32 3)
(defn st-stunned [] : I32 4)
(defn st-shield [] : I32 5)
(defn st-dead [] : I32 6)
(defn st-respawn [] : I32 7)
(defn st-wavedash [] : I32 13)
(defn st-upb [] : I32 14)
(defn st-rosie-dash [] : I32 15)
(defn st-air [] : I32 2)

(defn mode-stock [] : I32 0)
(defn mode-time [] : I32 1)
(defn mode-sandbox [] : I32 2)

;; ---- tuning constants (physics.h #defines) ------------------------------------------------
(defn c-attack-cooldown [] : I32 10)
(defn c-smash-cooldown [] : I32 28)
(defn c-shield-break-stun [] : I32 300)
(defn c-high-percent [] : F32 91.0)
(defn c-high-percent-delay [] : I32 22)
(defn c-kb-scaling [] : F32 0.04)
(defn c-attack-active [] : I32 12)
(defn c-smash-active [] : I32 16)
(defn c-gravity [] : F32 0.08)
(defn c-fast-fall [] : F32 0.14)
(defn c-terminal [] : F32 2.8)
(defn c-ground-accel [] : F32 0.18)
(defn c-air-accel [] : F32 0.08)
(defn c-ground-max [] : F32 1.2)
(defn c-air-max [] : F32 1.0)
(defn c-ground-friction [] : F32 0.10)
(defn c-air-friction [] : F32 0.02)
(defn c-jump-force [] : F32 1.6)
(defn c-dodge-cooldown [] : I32 30)
(defn c-wavedash-frames [] : I32 12)
(defn c-wavedash-ground [] : F32 1.6)
(defn c-wavedash-air [] : F32 1.4)
(defn c-wavedash-drop [] : F32 0.6)
(defn c-wavedash-max [] : F32 1.8)
(defn c-parry-window [] : I32 4)
(defn c-shield-drain [] : F32 0.28)
(defn c-shield-regen [] : F32 0.17)
(defn c-shield-drop-lag [] : I32 11)
(defn c-shield-windup [] : I32 16)
(defn c-shield-overpowered [] : I32 16)
(defn c-op-counter-damage [] : F32 6.0)
(defn c-op-counter-stun [] : I32 8)
(defn c-op-counter-kb [] : F32 1.0)
(defn c-unc-counter-damage [] : F32 10.0)
(defn c-unc-counter-stun [] : I32 14)
(defn c-unc-counter-kb [] : F32 1.6)
(defn c-shield-max-pushback [] : F32 0.35)
(defn c-shield-max-stun [] : I32 20)
(defn c-smash-charge [] : I32 44)
(defn c-smash-release-delay [] : I32 7)
(defn c-smash-flash [] : I32 7)
(defn c-turnip-cooldown [] : I32 45)
(defn c-turnip-speed [] : F32 1.0)
(defn c-turnip-up [] : F32 1.1)
(defn c-umbrella-gravity [] : F32 0.02)
(defn c-umbrella-fall [] : F32 0.6)
(defn c-respawn-delay [] : I32 90)
(defn c-drop-through [] : I32 10)
(defn c-turnip-gravity [] : F32 0.04)
(defn c-turnip-ttl [] : I32 240)
(defn c-respawn-invuln [] : I32 120)
(defn c-shield-max [] : F32 60.0)
(defn c-max-jumps [] : I32 2)
(defn c-stock-count [] : I32 4)
(defn c-dt [] : F32 0.016)

;; special-move tuning
(defn c-rosie-dash-total [] : I32 18)
(defn c-rosie-dash-speed [] : F32 0.22)
(defn c-rosie-dash-range [] : F32 2.2)
(defn c-rosie-dash-damage [] : F32 6.0)
(defn c-rosie-invuln-start [] : I32 4)
(defn c-rosie-invuln-end [] : I32 14)
(defn c-parasol-range [] : F32 2.0)
(defn c-parasol-damage [] : F32 4.0)
(defn c-parasol-rehit [] : I32 12)
(defn c-regrowth-heal [] : F32 15.0)
(defn c-doubt-range [] : F32 2.2)
(defn c-doubt-shield-damage [] : F32 20.0)
(defn c-relic-warp [] : F32 28.4)
(defn c-petrify-range [] : F32 2.2)
(defn c-petrify-stun [] : I32 40)
