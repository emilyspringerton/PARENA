;; stdlib/deadweight/account_rules.prn -- display-name validation, the client-side half of IDUNA's
;; own cleanDisplayName (IDUNA/internal/http/handlers/game_online.go): 1-16 characters, no control
;; characters. Real, live-found need (founder real-time, 2026-09-25, "also it should let me create
;; a deadweight account right there with a button... port it right into TS with PARENA (abstract
;; into parena if not already)"): the DEADWEIGHT web client's new Create Account page (web/src/
;; account.ts's registerAndClaim) wants live, client-side feedback on a chosen display name before
;; it ever reaches the server, matching card_rules.prn/fx_rules.prn's own "PARENA is the decision
;; layer, host does the work" convention rather than hand-rolling the check again in TypeScript.
;;
;; Honest scope: this is a best-effort, ASCII-byte-level control-character check (rejects bytes <
;; 32 and 127), not a full Unicode-category-aware port of Go's unicode.IsControl (which also flags
;; some non-ASCII control code points) -- IDUNA's own server-side check stays authoritative and
;; always re-validates on register; this is client-side UX feedback, not a security boundary.
;;
;; is-valid-display-name itself needs `String @ Region` (needed for the C target's real
;; region-safety verification), which PARENA's Java AND TypeScript emitters both hard-reject on
;; ANY parameter shape beyond plain scalars/`String` (confirmed directly against both emitters,
;; 2026-09-28) -- a real, previously-undiscovered-on-the-Java-side instance of the same compiler
;; gap `web/src/account.ts`'s own doc comment already named for the TS emitter (EMILY/BACKLOG.md
;; SECTION 544; this repo's own DEADWEIGHT/CLAUDE.md S513 platform-correction note this file used
;; to carry, "Android is shelved," was itself the actual reason no one had checked Java yet --
;; that correction was reversed by S555, this file's own note was stale). Not a DEADWEIGHT- or
;; account-rules-specific bug; a real PARENA compiler gap, out of scope to fix here.
;;
;; The two genuinely scalar rules this file used to also define (max-display-name-len,
;; is-control-byte -- neither ever needed the region annotation) moved to the sibling
;; account_rules_scalar.prn (2026-09-28) so they can ALSO target Java/TypeScript; imported back
;; here for is-valid-display-name's own C-target use, same cross-module-import shape
;; bot_brain.prn already uses for `(import deadweight/card-rules)`.

(module deadweight/account-rules)
(import string)
(import deadweight/account-rules-scalar)
(export is-valid-display-name)

;; is-valid-display-name -- mirrors cleanDisplayName exactly: 1-16 characters (the caller is
;; expected to have already trimmed leading/trailing whitespace, matching Go's strings.TrimSpace --
;; this function does not trim on its own, same "host does surrounding I/O, PARENA decides" split
;; count-lines in stdlib/coreutils/wc.prn already establishes), none of them a control byte.
(defn is-valid-display-name [(s : String @ Region)] : Bool
  (let [n (string/length s)]
    (if (< n 1)
      false
      (if (> n (max-display-name-len))
        false
        (loop [i 0]
          (if (>= i n)
            true
            (if (is-control-byte (string/char-at s i))
              false
              (recur (+ i 1)))))))))
