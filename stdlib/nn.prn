;; stdlib/nn.prn — depends on array. Design: STDLIB.md "nn" section.
;; layernorm/gelu/softmax are the exact 3 primitives gpt2.c's
;; gpt2_model_forward calls by name; relu/sigmoid/tanh-activation below
;; are the founder's own follow-up ("build ML and AI primatives in like
;; relu and sigma and all that stuff") -- the standard activation-
;; function trio no real NN stdlib ships without, same short-formula,
;; real-not-deferred treatment as everything else in this file. All go
;; through map-elementwise so adding another activation later is a
;; one-line formula, not another hand-rolled loop.

(module nn)
(import array)
(export layernorm gelu softmax relu sigmoid tanh-activation leaky-relu)

;; map-elementwise — the shared real primitive every activation function
;; below reduces to: apply `f` to every element, same shape out.
(defn map-elementwise [(x : &NDArray) (f : (Fn [F64] F64)) (dest : Arena @ Region)]
  : NDArray @ Region
  (let [n (vec/len &(get-field x :data)) out (vec/new dest)]
    (loop [i 0]
      (when (< i n)
        (vec/push! &out (f (deref (vec/get &(get-field x :data) i))))
        (recur (+ i 1))))
    {:data out :shape (get-field x :shape) :strides (get-field x :strides)}))

(defn layernorm [(x : &NDArray) (weight : &NDArray) (bias : &NDArray) (dest : Arena @ Region)]
  : (Result NDArray ShapeError) @ Region
  (let [m (stats/mean x) v (square (stats/std x)) eps 0.00001
        n (vec/len &(get-field x :data)) out (vec/new dest)]
    (loop [i 0]
      (when (< i n)
        (let [normed (/ (- (deref (vec/get &(get-field x :data) i)) m) (sqrt (+ v eps)))]
          (vec/push! &out (+ (* normed (deref (vec/get &(get-field weight :data) i)))
                              (deref (vec/get &(get-field bias :data) i)))))
        (recur (+ i 1))))
    (Ok {:data out :shape (get-field x :shape) :strides (get-field x :strides)})))

;; gelu — tanh approximation, the same one gpt2.c itself uses.
(defn gelu [(x : &NDArray) (dest : Arena @ Region)]
  : NDArray @ Region
  (let [n (vec/len &(get-field x :data)) out (vec/new dest)]
    (loop [i 0]
      (when (< i n)
        (let [v (deref (vec/get &(get-field x :data) i))]
          (vec/push! &out (* 0.5 v (+ 1.0 (tanh (* 0.7978845608 (+ v (* 0.044715 v v v))))))))
        (recur (+ i 1))))
    {:data out :shape (get-field x :shape) :strides (get-field x :strides)}))

(defn relu [(x : &NDArray) (dest : Arena @ Region)]
  : NDArray @ Region
  (map-elementwise x (fn [v] (if (> v 0.0) v 0.0)) dest))

(defn leaky-relu [(x : &NDArray) (alpha : F64) (dest : Arena @ Region)]
  : NDArray @ Region
  (map-elementwise x (fn [v] (if (> v 0.0) v (* alpha v))) dest))

(defn sigmoid [(x : &NDArray) (dest : Arena @ Region)]
  : NDArray @ Region
  (map-elementwise x (fn [v] (/ 1.0 (+ 1.0 (exp (- 0.0 v))))) dest))

(defn tanh-activation [(x : &NDArray) (dest : Arena @ Region)]
  : NDArray @ Region
  (map-elementwise x (fn [v] (tanh v)) dest))

(defn softmax [(x : &NDArray) (dest : Arena @ Region)]
  : NDArray @ Region
  (let [n (vec/len &(get-field x :data))
        max-v (unwrap (stats/max x))
        exps (vec/new dest)]
    (loop [i 0]
      (when (< i n)
        (vec/push! &exps (exp (- (deref (vec/get &(get-field x :data) i)) max-v)))
        (recur (+ i 1))))
    (let [total (loop [i 0 acc 0.0] (if (>= i n) acc (recur (+ i 1) (+ acc (deref (vec/get &exps i))))))
          out (vec/new dest)]
      (loop [i 0]
        (when (< i n) (vec/push! &out (/ (deref (vec/get &exps i)) total)) (recur (+ i 1))))
      {:data out :shape (get-field x :shape) :strides (get-field x :strides)})))
