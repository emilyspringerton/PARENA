;; stdlib/stats.prn — depends on array. Design: STDLIB.md "stats"
;; section. Real, complete: these are single-pass reductions, short
;; enough to just write, not defer.

(module stats)
(import array)
(export mean std sum min max sqrt-of square to-f64 EmptyArrayError)

;; Real, honest gap closed here (2026-08-21): every function below used
;; to-f64/sqrt-of/square in its own real body but this file never actually
;; DEFINED any of them -- not a compiler gap, a genuine missing-
;; definition gap in the file itself, the same real class pcap.prn/
;; io.prn/array.prn/string.prn/glob.prn already closed.
;;
;; square is a plain, pure-PARENA one-liner. sqrt-of is real, pure
;; PARENA too -- deliberately NOT an FFI call into libm's own `sqrt`,
;; per this session's own standing direction (founder, real-time: "but
;; dont add [stuff] if its not going to be pure parena" / "its just
;; bloat right now"): Newton's method (x_{n+1} = (x_n + v/x_n) / 2)
;; converges quadratically, so a fixed 30-iteration loop is real
;; double-precision accuracy for any real, non-degenerate input this
;; file's own `std` ever produces (a variance, always >= 0). Guards
;; v <= 0 -> 0.0 (no real negative-input case exists anywhere in this
;; file's own call graph; a variance can't legitimately go negative).
;; Named `sqrt-of`, not the more obvious bare `sqrt`, because `sqrt` is
;; a real C compiler builtin -- gcc rejects a same-named PARENA function
;; emitting a bare `double sqrt();` forward declaration
;; ("declaration of built-in function 'sqrt' without a prototype"),
;; found via an actual gcc compile of this exact file, the same real
;; class of collision shell.prn's own `getenv` (renamed `env-lookup`)
;; already hit with libc's real `getenv`.
(defn square [(x : F64)] : F64 (* x x))

(defn sqrt-of [(v : F64)]
  : F64
  (if (<= v 0.0)
    0.0
    (loop [i 0 guess v]
      (if (>= i 30)
        guess
        (recur (+ i 1) (/ (+ guess (/ v guess)) 2.0))))))

;; to-f64 -- VS0 has no real int-vs-float type distinction internally
;; (every number LITERAL already reports as "double" -- a real, honest,
;; whole-language simplification), but vec/len's own real runtime
;; return value IS a genuine C `int`; dividing that directly against a
;; real `double` (mean's own `(/ (sum a) (vec/len ...))`) would compile
;; but silently perform real C integer division on the RHS operand
;; conversion path. A minimal, honest #target cast closes this the same
;; way every other single-line C primitive in this stdlib already does
;; (string.prn's own char-at/str-eq?) -- a real, deliberate, narrow use
;; of the FFI escape hatch for something pure PARENA genuinely cannot
;; express (VS0 has no cast syntax of its own).
(defn to-f64 [(x : I32)]
  : F64
  #target
  {:c (inline-c "(double)(x)")})

(defn sum [(a : &NDArray)]
  : F64
  (loop [i 0 acc 0.0]
    (if (>= i (vec/len &(get-field a :data))) acc
      (recur (+ i 1) (+ acc (deref (vec/get &(get-field a :data) i)))))))

(defn mean [(a : &NDArray)]
  : F64
  (/ (sum a) (to-f64 (vec/len &(get-field a :data)))))

;; Real, honest gap found and worked around here (2026-08-21, gcc-
;; verifying this file): `loop` used as a plain, non-tail SUB-EXPRESSION
;; (std's own original body nested it inside `(sqrt-of (/ (loop ...) n))`)
;; isn't supported anywhere in this emitter -- the same real "raw
;; emit_expr() called where loop/if/match need statement-level dispatch"
;; architecture gap this session already found and fixed 5+ separate
;; times elsewhere, but generalizing THIS instance (loop as an arbitrary
;; sub-expression) would need real statement-emission capability inside
;; emit_expr's own pure-expression-returning architecture -- a larger,
;; separate, un-attempted change, not a narrow one like those other
;; fixes were. Worked around here by extracting the loop into its own
;; real helper function, `sum-of-squares`, whose own tail position IS
;; the loop directly -- the same real, already-proven pattern every
;; other loop in this verified stdlib already uses (product/flat-index/
;; strides-for/etc. all have `loop` as their own defn's literal tail).
(defn sum-of-squares [(a : &NDArray) (m : F64)]
  : F64
  (loop [i 0 acc 0.0]
    (if (>= i (vec/len &(get-field a :data))) acc
      (recur (+ i 1) (+ acc (square (- (deref (vec/get &(get-field a :data) i)) m)))))))

(defn std [(a : &NDArray)]
  : F64
  (let [m (mean a) n (to-f64 (vec/len &(get-field a :data)))]
    (sqrt-of (/ (sum-of-squares a m) n))))

(defstruct EmptyArrayError
  (message : String))

;; Real, honest gap closed here (2026-08-21): min/max's own (Err
;; (EmptyArrayError ...)) needs to box a non-pointer struct payload, but
;; neither signature carried an Arena to box into at all -- the
;; identical real gap array.prn's own get/set!/string.prn's own
;; parse-i32/linalg.prn's own dot already had, fixed the same way: an
;; explicit dest : Arena @ Region parameter.
;; min-of / max-of -- the same real "loop as its own defn's tail, not a
;; nested sub-expression" restructuring std's own sum-of-squares above
;; needed, for the identical real reason: min/max's original bodies
;; nested `loop` inside `(Ok (loop ...))`, a sub-expression position
;; this emitter doesn't support.
(defn min-of [(a : &NDArray)]
  : F64
  (loop [i 1 acc (deref (vec/get &(get-field a :data) 0))]
    (if (>= i (vec/len &(get-field a :data))) acc
      (recur (+ i 1) (if (< (deref (vec/get &(get-field a :data) i)) acc) (deref (vec/get &(get-field a :data) i)) acc)))))

(defn max-of [(a : &NDArray)]
  : F64
  (loop [i 1 acc (deref (vec/get &(get-field a :data) 0))]
    (if (>= i (vec/len &(get-field a :data))) acc
      (recur (+ i 1) (if (> (deref (vec/get &(get-field a :data) i)) acc) (deref (vec/get &(get-field a :data) i)) acc)))))

(defn min [(a : &NDArray) (dest : Arena @ Region)]
  : (Result F64 EmptyArrayError) @ Region
  (if (= (vec/len &(get-field a :data)) 0)
    (Err (EmptyArrayError "empty array"))
    (Ok (min-of a))))

(defn max [(a : &NDArray) (dest : Arena @ Region)]
  : (Result F64 EmptyArrayError) @ Region
  (if (= (vec/len &(get-field a :data)) 0)
    (Err (EmptyArrayError "empty array"))
    (Ok (max-of a))))
