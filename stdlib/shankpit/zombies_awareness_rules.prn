;; stdlib/shankpit/zombies_awareness_rules.prn -- worked example of a REFLUX SUBSCRIBER for SHANKPIT's
;; MODE_ZOMBIES/MODE_SURVIVAL population (packages/simulation/witness_ai.c). It never imports or calls
;; witness_ai.c/zombie_values.c/witness_sim.c; the only link is the shared REFLUX action log (see
;; packages/reflux/reflux_runtime.h):
;;   105 ZOMBIE_MOOD_ESCALATED  a=zombie player_id  b=new ZombieMood (2 HUNTING, 3 FRENZIED)
;;   106 WITNESS_ESCALATED      a=citizen player_id b=new WS_* state (3 SILENCING, 5 ENGAGE)
;;   107 GIANT_BUG_ATE_ZOMBIE   a=bug player_id     b=eaten zombie's player_id
;;   108 MEN_DISPATCHED         a=Man player_id     b=target citizen player_id
;;   109 MEN_RESOLVED           a=Man player_id     b=resolved_count
;; The host (packages/simulation/zombies_hud_bridge.c) polls the log with its own cursor and asks this
;; mod (per new action) whether it deserves a HUD "awareness" ping -- the compass/intensity readout
;; BIG_O/NORTHSTAR.md section 35 specs -- and how severe (0..100) that ping reads. Severity is a flat,
;; honest per-event-type scale, not BIG_O's own conspicuousness*witness-count formula (that one needs a
;; real witness-count input this event log doesn't carry) -- FRENZIED/ENGAGE read worse than their
;; HUNTING/SILENCING counterparts, a bug growing stronger reads worse than a routine Men dispatch, and a
;; resolved hunt reads as the mildest ("stood down") signal of the five.
;; A mod maker adds behaviour by writing another mod like this one -- no host change to react to what
;; already gets dispatched.
(module shankpit/zombies-awareness-rules)
(export zombies-awareness-should-ping zombies-awareness-severity)

(defn zombies-awareness-should-ping [(action-type : I32)] : Bool
  (and (>= action-type 105) (<= action-type 109)))

(defn zombies-awareness-severity [(action-type : I32) (b : I32)] : I32
  (if (= action-type 105) (if (>= b 3) 90 55)
    (if (= action-type 106) (if (>= b 5) 90 60)
      (if (= action-type 107) 70
        (if (= action-type 108) 20
          (if (= action-type 109) 15 0))))))
