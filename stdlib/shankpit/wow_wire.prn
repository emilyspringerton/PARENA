;; WOW WIRE -- the macro/mod surface on the air, not in a chat line.
;;
;; The client compiles a macro once (packages/ui/wow_macro.h), uploads the CLAUSES as bytes, and then
;; invokes it by id. What crosses the network per activation is 5 bytes, not the 40-byte text line, and
;; a target change is 7 bytes sent only when the target actually changes. These numbers are the policy
;; that bounds that traffic; they are per modem/transport preset like the LoRa rules, because the cost
;; of a byte is not the same on a LAN and on a 1k2 radio.
;;
;; preset 0 = LAN / default, 1 = slow (LoRa long), 2 = fast (LoRa turbo)

;; How many target slots the server tracks per client: target, focus, and two the mods can name.
(defn wow-target-slots [(preset : I32)] : I32
  4)

;; Cast intents a client may have outstanding before the server refuses another. One is enough on a
;; slow link: a queue deeper than the link can drain is just latency with extra steps.
(defn wow-cast-queue [(preset : I32)] : I32
  (if (= preset 1) 1
    (if (= preset 2) 3
      2)))

;; Clauses a single macro may carry -- the wire format has to be able to hold whatever the compiler
;; accepts, and nowhere more.
(defn wow-macro-max-clauses [(preset : I32)] : I32
  4)

;; How long a client waits for an ACK before resending an intent. Long enough that a slow link is not
;; flooded with duplicates, short enough that a lost cast is not a lost action.
(defn wow-ack-ms [(preset : I32)] : I32
  (if (= preset 1) 500
    (if (= preset 2) 120
      250)))

;; How often the SERVER may resend its target snapshot to a client. Target state is tiny but it is not
;; free: two clients on one radio must not both stream it every tick.
(defn wow-target-resend-ms [(preset : I32)] : I32
  (if (= preset 1) 1000
    (if (= preset 2) 250
      500)))

;; How many times a client resends ONE unacknowledged frame before giving up. Bounded on purpose: a
;; dead server must not turn a two-byte intent into a loop that floods a 1k2 radio, and the caller has
;; to be told the frame is abandoned (wow_client_retry returns -2) rather than retrying forever.
(defn wow-retry-max [(preset : I32)] : I32
  (if (= preset 1) 2
    (if (= preset 2) 5
      4)))

;; The farthest a cast may be AIMED at a target, in YARDS -- the unit the rule is written in, not the
;; engine's metres. A target beyond it fires along the player's own aim instead: a client's word must
;; not swing the server's crosshair across the map. SHANKPIT converts this through packages/common's
;; unit layer (units_author_length_m), so 40 is never restated as 36.576 anywhere in C.
(defn wow-cast-range-yd [(preset : I32)] : I32
  40)

;; The same rule PER WEAPON, still in yards. One number for every weapon made a magnum reach as far as
;; a sniper, which is not a rule anyone would defend out loud. Ids are SHANKPIT's own WPN_*
;; (packages/common/protocol.h): 0 knife, 1 magnum, 2 assault rifle, 3 shotgun, 4 sniper, 5 katana,
;; 6 missile launcher, 7 flashlight, 8 hammer, 9 spray can. An id this table does not know falls back
;; to the generic 40 above, so a weapon added tomorrow is bounded rather than trusted.
(defn wow-cast-range-yd-for [(weapon : I32)] : I32
  (if (= weapon 0) 2
    (if (= weapon 1) 25
      (if (= weapon 2) 55
        (if (= weapon 3) 20
          (if (= weapon 4) 120
            (if (= weapon 5) 2
              (if (= weapon 6) 90
                (if (= weapon 7) 15
                  (if (= weapon 8) 2
                    (if (= weapon 9) 8
                      40)))))))))))

(export wow-target-slots wow-cast-queue wow-macro-max-clauses wow-ack-ms wow-target-resend-ms wow-retry-max)

;; ---- the wire's ARITHMETIC, not just its policy ------------------------------------------------
;; The byte writes stay in C (PARENA has no arrays to write into), but every NUMBER in the frame is
;; computed here, so the server's packing and the client's are the same arithmetic rather than two
;; copies that agree until someone edits one.

;; Low and high byte of a u16 entity id, expressed with integer division so it cannot depend on a
;; shift instruction the target may not have.
(defn wow-entity-lo [(e : I32)] : I32
  (- e (* (/ e 256) 256)))

(defn wow-entity-hi [(e : I32)] : I32
  (/ e 256))

;; 0 is not a unit: a cleared slot must be absent, not "entity zero".
(defn wow-entity-valid [(e : I32)] : I32
  (if (< e 1) 0 (if (> e 65535) 0 1)))

;; Definition size: header 5 + per clause (6 + argument length). Encoder and decoder both ask this, so
;; they cannot disagree about where a frame ends.
(defn wow-def-bytes [(clauses : I32) (argbytes : I32)] : I32
  (+ 5 (+ (* 6 clauses) argbytes)))

;; The per-client intent sequence, skipping 0 (which means "never sent") and wrapping at 16 bits.
(defn wow-seq-next [(seq : I32)] : I32
  (if (> seq 65534) 1 (+ seq 1)))

(export wow-target-slots wow-cast-queue wow-macro-max-clauses wow-ack-ms wow-target-resend-ms wow-retry-max
        wow-entity-lo wow-entity-hi wow-entity-valid wow-def-bytes wow-seq-next wow-cast-range-yd
        wow-cast-range-yd-for)
