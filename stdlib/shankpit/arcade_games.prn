;; stdlib/shankpit/arcade_games.prn -- THE MOD: the games on the SHANKPHONE's PELLEGRINO app (founder, 2026-11-14:
;; "lets build pellegrino on the phone into a full app that can play the wasm games" / "parenafy it" / "mods first
;; everything"). Add a game here and nowhere else: SHANKPIT's scripts/gen_arcade_rules.sh compiles this with the app's
;; rules (arcade.prn) into packages/simulation/arcade_rules.c, and the phone lists it on the next build.
;;
;; A game is one index, 0 .. arcade-game-count - 1:
;;   name   what the list shows
;;   blurb  one line under it
;;   kind   1 a SHANKPIT level module: WebAssembly built to the T0 level contract (docs/T0_LEVEL_WASM_CONTRACT.md,
;;            exports level_api/enter/tick/render/key/pointer...), run IN the phone by SHANKPIT's own wasm3 host
;;          2 a web game: a page that runs its own WebAssembly with JavaScript. Pellegrino has no JavaScript yet, so
;;            the phone drives Chromium for it (a stopgap -- see arcade.prn arcade-engine)
;;   path   kind 1: the module, relative to the game's working directory; kind 2: the page's URL
;;   level  kind 1: the level id its REFLUX lifecycle rows carry (0 when it has none of its own)
;;   asset  kind 1: up to 4 PNGs the level wants cut into its memory (slot 0..3; "" = none), with their tile size
;;
;; shankpit-460 and Bedrock Racers are both: level modules (bot matches, played natively -- sp_level.prn, br_level.prn) and,
;; for human matchmaking, their web builds (a level has no network). D2 and REDGARDEN are still web only.
;; The web games live on WOTAN (the esports site). Their pages are as the site serves them; a page that moves breaks only
;; its entry here.

(module shankpit/arcade-games)
(export arcade-game-count arcade-game-name arcade-game-blurb arcade-game-kind arcade-game-path arcade-game-level
        arcade-game-asset arcade-game-tile-w arcade-game-tile-h arcade-game-asset-stride)


(defn arcade-game-count [] : I32 7)

(defn arcade-game-name [(i : I32)] : String
  (cond ((= i 0) "BRAWLPIT")
        ((= i 1) "SHANKPIT-460")
        ((= i 2) "BEDROCK RACERS")
        ((= i 3) "SHANKPIT-460 ONLINE")
        ((= i 4) "BEDROCK RACERS ONLINE")
        ((= i 5) "DEADWEIGHT 2")
        ((= i 6) "REDGARDEN")
        (true "")))

(defn arcade-game-blurb [(i : I32)] : String
  (cond ((= i 0) "platform brawler -- runs right here on the phone")
        ((= i 1) "arena shooter vs bots -- on the phone. arrows look, F fires")
        ((= i 2) "rocket-car quidditch vs bots -- on the phone. F magnet")
        ((= i 3) "the arena shooter with human matchmaking, web build")
        ((= i 4) "the racers with human matchmaking, web build")
        ((= i 5) "backpack battler, web build")
        ((= i 6) "10v10 arena, web build")
        (true "")))

(defn arcade-game-kind [(i : I32)] : I32
  (cond ((= i 0) 1)
        ((= i 1) 1)
        ((= i 2) 1)
        ((= i 3) 2)
        ((= i 4) 2)
        ((= i 5) 2)
        ((= i 6) 2)
        (true 0)))

;; kind 1: the module (built from PARENA level manifests -- stdlib/brawlpit, stdlib/shankpit460,
;; stdlib/bedrockracers/web -- by SHANKPIT scripts/build_brawlpit_level.sh and build_phone_levels.sh); kind 2: the page
(defn arcade-game-path [(i : I32)] : String
  (cond ((= i 0) "assets/levels/brawlpit/brawlpit_level.wasm")
        ((= i 1) "assets/levels/shankpit460/shankpit460_level.wasm")
        ((= i 2) "assets/levels/bedrockracers/bedrockracers_level.wasm")
        ((= i 3) "https://wotan.okemily.com/shankpit-460/")
        ((= i 4) "https://wotan.okemily.com/bedrockracers/")
        ((= i 5) "https://wotan.okemily.com/d2/")
        ((= i 6) "https://wotan.okemily.com/redgarden/play.html")
        (true "")))

;; The REFLUX level ids (SHANKPIT packages/reflux: REFLUX_LEVEL_BRAWLPIT 1, _SHANKPIT460 2, _BEDROCKRACERS 3).
(defn arcade-game-level [(i : I32)] : I32
  (cond ((= i 0) 1)
        ((= i 1) 2)
        ((= i 2) 3)
        ((= i 3) 0)
        ((= i 4) 0)
        ((= i 5) 0)
        ((= i 6) 0)
        (true 0)))

(defn arcade-game-asset [(i : I32) (slot : I32)] : String
  (cond ((and (= i 0) (= slot 0)) "assets/levels/brawlpit/sprites.png")   ;; 8 portrait tiles
        ((and (= i 0) (= slot 1)) "assets/levels/brawlpit/duck.png")      ;; the 640x340 duck atlas, one tile
        (true "")))
(defn arcade-game-tile-w [(i : I32) (slot : I32)] : I32 (if (and (= i 0) (= slot 0)) 128 0))
(defn arcade-game-tile-h [(i : I32) (slot : I32)] : I32 (if (and (= i 0) (= slot 0)) 128 0))
(defn arcade-game-asset-stride [(i : I32) (slot : I32)] : I32 (if (and (= i 0) (= slot 0)) 65536 0))
