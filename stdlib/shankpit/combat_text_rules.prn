;; PARENA/stdlib/shankpit/combat_text_rules.prn -- floating combat text (damage numbers) rules.
;;
;; API-first, PARENA-based mod for displaying damage/healing/shield numbers above actors.
;; Similar approach to shield_regen_tags: show numbers floating up and fading out.

(module shankpit/combat-text)

(export combat-text-max-age-ms combat-text-float-speed combat-text-max-distance
        combat-text-scale combat-text-fade-start
        ct-clamp ct-format-damage ct-should-show?)

;; How long combat text is visible (milliseconds)
(defn combat-text-max-age-ms [] : I32 1500)

;; How fast it floats up (units per second, as milli-units conceptually)
(defn combat-text-float-speed [] : I32 2000)

;; Max distance to show combat text
(defn combat-text-max-distance [] : I32 45000) ;; 45 units in milli-units

;; Scale factor
(defn combat-text-scale [] : I32 1000)

;; When to start fading (as fraction of age, in permille)
(defn combat-text-fade-start [] : I32 600) ;; start fading at 60% age

(defn ct-clamp [(lo : I32) (hi : I32) (x : I32)] : I32
  (if (< x lo) lo (if (> x hi) hi x)))

;; Format damage value for display (returns magnitude)
(defn ct-format-damage [(damage : I32)] : I32
  (if (< damage 0) (- 0 damage) damage))

;; Should we show combat text?
(defn ct-should-show? [(age-ms : I32) (dist-units : I32)] : I32
  (if (> age-ms (combat-text-max-age-ms)) 0
    (if (> dist-units (/ (combat-text-max-distance) 1000)) 0 1)))
