;; stdlib/shankpit/tree_rules.prn -- trees and wood: what a tree IS, where trees grow, how they fall, what they give.
;;
;; Founder real-time 2026-11-26: "Add trees to zombie survival modes for shankpit og engine and shankpit wasm zombies ultra low poly
;; models like our skins add resource collection mod parena based mods based dev". One rule file, both engines:
;;   - the PARENA wasm engine (GF gf/modes/survival/sv_trees.prn, PARENA stdlib/shankpit_survival) links it directly;
;;   - the OG C client gets C from it (SHANKPIT scripts/gen_tree_rules.sh -> packages/simulation/tree_rules.c), the way it already
;;     does for chest_rules.prn.
;; It is kept to the subset the C emitter takes today (if/case/let over I32, no cond, no typed let).
;;
;; Models are "ultra low poly like our skins": every tree is at most four boxes (the skins are boxes too). Distances are in
;; thousandths of a unit, relative to the tree's base on the ground; the host multiplies them by the tree's own scale.
;; Kinds: 1 pine, 2 oak, 3 birch. 0 is "no tree".
;; Part 0 is always the trunk: it is the only part that collides and the only part a chop hits.
(module shankpit/tree-rules)
(export tree-kinds tree-parts tree-part tree-part-color tree-at tree-jitter-milli tree-scale-permille tree-max-hp
        tree-chop-damage tree-wood-per-hit tree-fell-bonus tree-regrow-ms tree-cell-milli tree-density-permille
        res-kinds res-cap barricade-cost barricade-dim barricade-color barricade-max-hp)

(defn tree-kinds [] : I32 3)

;; how many boxes a kind is made of
(defn tree-parts [(kind : I32)] : I32 (case kind 1 4 2 4 3 3 0))

;; one number of one box: axis 0 x, 1 y (centre height), 2 z, 3 width, 4 height, 5 depth
(defn pine-part [(part : I32) (axis : I32)] : I32
  (case part
    0 (case axis 0 0 1 1500 2 0 3 600 4 3000 5 600 0)
    1 (case axis 0 0 1 4000 2 0 3 4200 4 2000 5 4200 0)
    2 (case axis 0 0 1 5600 2 0 3 3000 4 1600 5 3000 0)
    3 (case axis 0 0 1 6900 2 0 3 1600 4 1400 5 1600 0)
    0))
(defn oak-part [(part : I32) (axis : I32)] : I32
  (case part
    0 (case axis 0 0 1 1750 2 0 3 900 4 3500 5 900 0)
    1 (case axis 0 0 1 5000 2 0 3 5200 4 3000 5 5200 0)
    2 (case axis 0 1600 1 4300 2 1000 3 2600 4 2000 5 2600 0)
    3 (case axis 0 -800 1 6700 2 -600 3 2800 4 1400 5 2800 0)
    0))
(defn birch-part [(part : I32) (axis : I32)] : I32
  (case part
    0 (case axis 0 0 1 2500 2 0 3 400 4 5000 5 400 0)
    1 (case axis 0 0 1 5600 2 0 3 2400 4 2600 5 2400 0)
    2 (case axis 0 700 1 4600 2 500 3 1400 4 1200 5 1400 0)
    0))
(defn tree-part [(kind : I32) (part : I32) (axis : I32)] : I32
  (case kind 1 (pine-part part axis) 2 (oak-part part axis) 3 (birch-part part axis) 0))

;; 0xRRGGBB per box: bark, then the canopy's shades (the same flat, muted palette as the skins)
(defn tree-part-color [(kind : I32) (part : I32)] : I32
  (if (= part 0)
      (if (= kind 3) 14078920 6835766)   ; birch bark #D6D3C8, else #684E36
      (case kind
        1 (case part 1 3108670 2 3046725 3837006)   ; pine #2F6F3E #2E7D45 #3A8C4E
        2 (case part 1 5150784 2 6923856 4689968)     ; oak  #4E9840 #69A650 #479030
        3 (case part 1 10009152 9088080)   ; birch #98BA40 #8AAC50
        0)))

;; ---- where trees grow ------------------------------------------------------------------------------------------------------------
;; The host lays a grid of candidate cells (tree-cell-milli apart) over the open ground, drops cells inside buildings and on road
;; centre lines, and asks tree-at for each one: 0 = no tree here, else the kind. Deterministic in (cell, seed), so every client of
;; a match grows the same forest.
(defn tree-cell-milli [] : I32 26000)
(defn tree-density-permille [] : I32 260)
(defn tree-hash [(gx : I32) (gz : I32) (seed : I32)] : I32
  (let [h (bit-xor (bit-xor (* gx 73856093) (* gz 19349663)) (* seed 83492791))
        h2 (bit-xor h (* (bit-and h 65535) 2654435))]
    (if (< h2 0) (- 0 h2) h2)))
(defn tree-at [(gx : I32) (gz : I32) (seed : I32)] : I32
  (let [h (tree-hash gx gz seed)]
    (if (< (mod h 1000) (tree-density-permille))
        (+ 1 (mod (/ h 1000) 3))
        0)))
;; jitter inside the cell so the forest is not a grid: axis 0 x, 1 z, in -40%..+40% of a cell
(defn tree-jitter-milli [(gx : I32) (gz : I32) (seed : I32) (axis : I32)] : I32
  (let [h (tree-hash (+ gx (* axis 7919)) (- gz (* axis 104729)) seed)]
    (- (mod h (/ (* (tree-cell-milli) 8) 10)) (/ (* (tree-cell-milli) 4) 10))))
;; 800..1250 permille: no two trees the same size
(defn tree-scale-permille [(gx : I32) (gz : I32) (seed : I32)] : I32
  (+ 800 (mod (tree-hash gz gx (+ seed 31)) 451)))

;; ---- chopping -----------------------------------------------------------------------------------------------------------------------
(defn tree-max-hp [(kind : I32)] : I32 (case kind 1 120 2 200 3 80 100))
;; per hit, by SHANKPIT weapon id (0 knife 1 magnum 2 AR 3 shotgun 4 sniper 5 katana 6 missile): blades chop, bullets chip
(defn tree-chop-damage [(weapon : I32)] : I32 (case weapon 0 40 1 10 2 4 3 12 4 15 5 70 6 60 0))
;; wood from every hit that lands, and the extra wood when the tree comes down
(defn tree-wood-per-hit [(kind : I32)] : I32 1)
(defn tree-fell-bonus [(kind : I32)] : I32 (case kind 1 4 2 6 3 3 0))
;; a felled tree leaves a stump and grows back
(defn tree-regrow-ms [(kind : I32)] : I32 (case kind 1 90000 2 120000 3 60000 90000))

;; ---- resources (the resource-collection mod) ------------------------------------------------------------------------------------
;; resource ids: 1 wood. More kinds (stone from rubble, scrap from cars) slot in here.
(defn res-kinds [] : I32 1)
(defn res-cap [(res : I32)] : I32 (if (= res 1) 999 0))
;; what wood buys: a barricade, a plank wall placed in front of you that zombies have to walk around
(defn barricade-cost [] : I32 5)
(defn barricade-dim [(axis : I32)] : I32 (case axis 0 5000 1 2600 2 700 0))   ; width, height, depth in milli-units
(defn barricade-color [] : I32 9133624)                                       ; #8B5E38 planks
(defn barricade-max-hp [] : I32 300)
