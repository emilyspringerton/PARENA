;; stdlib/shankpit/brick_rules.prn -- the decision layer for SHANKPIT's destructible brick
;; (founder real-time, 2026-10-01: "get papercraft tech shipped to shankpit i want brick to be
;; destructable"). It composes with PAPERCRAFT's real Paper Engine decisions instead of
;; re-deriving them: papercraft/paper_fragment_mod.prn (material resistance + HP tiers) and
;; papercraft/interact_falloff_mod.prn (distance falloff) are compiled in alongside this file
;; (see SHANKPIT/scripts/gen_brick_mod.sh); this module only adds the two decisions that are
;; specific to SHANKPIT's weapons and brick:
;;   * how much a given weapon's damage counts against brick  (on-brick-weapon-damage)
;;   * how much debris a cell state change throws              (on-brick-debris-count)
;;   * which paper material / how many HP a brick cell has     (on-brick-paper-material,
;;                                                              on-brick-cell-max-hp)
;;
;; Same ABI as every other mod in the monorepo (ECOWAR/docs/ARENA_API.md): I32 in, I32 out, no
;; struct/F32/Vec across the boundary. Host C (SHANKPIT packages/world/brick_fracture.h) owns the
;; cell grid, the F32 geometry and the collision/render consequence of a cell being gone.

(module shankpit/brick-rules)
(export on-brick-weapon-damage)
(export on-brick-debris-count)
(export on-brick-paper-material)
(export on-brick-cell-max-hp)
(export on-glass-tint)

;; Weapon ids are SHANKPIT's own (packages/common/protocol.h):
;;   0 KNIFE  1 MAGNUM  2 AR  3 SHOTGUN (per-pellet damage)  4 SNIPER  5 KATANA  6 MISSILE
;;   7 FLASHLIGHT  8 HAMMER
;; Blades and a flashlight do not chip masonry. Explosives demolish it (x5: one rocket opens a
;; player-sized hole). The hammer is the demolition tool (x3 per swing -- slow, so a wall takes a
;; few honest swings, not a burst). The sniper's round punches (x1.25). Everything else counts at
;; face value.
(defn on-brick-weapon-damage [(weapon : I32) (base-damage : I32)] : I32
  (if (= weapon 6)
    (* base-damage 5)
    (if (= weapon 8)
      (* base-damage 3)
      (if (= weapon 4)
        (+ base-damage (/ base-damage 4))
        (if (= weapon 0)
          0
          (if (= weapon 5)
            0
            (if (= weapon 7)
              0
              base-damage)))))))

;; Debris thrown when a cell changes state (states are PAPER_STATE_*: 0 intact, 1 cracked,
;; 2 torn, 3 gone). Only a worsening change throws anything; a cell that is gone throws the most.
(defn on-brick-debris-count [(prev-state : I32) (new-state : I32)] : I32
  (if (<= new-state prev-state)
    0
    (if (= new-state 3)
      4
      (if (= new-state 2)
        2
        (if (= new-state 1)
          1
          0)))))

;; Destructible kinds (host: packages/world/brick_fracture.h BF_KIND_*, chosen from the level box's
;; material NAME): 0 brick, 1 concrete, 2 wood, 3 glass (founder real-time, 2026-10-02: "add
;; papercraft destructability to concrete and wood and add a new one for glass").
;; Brick and concrete share PAPER_MATERIAL_CONCRETE (2, 50 percent of every hit absorbed); wood is
;; PAPER_MATERIAL_WOOD (1, 20 percent); glass is PAPER_MATERIAL_GLASS (4, absorbs nothing).
(defn on-brick-paper-material [(brick-kind : I32)] : I32
  (if (= brick-kind 2) 1
    (if (= brick-kind 3) 4 2)))

;; Cell HP. Brick keeps 80 (same as PAPER_MATERIAL_MAX_HP[CONCRETE]); poured concrete is tougher,
;; wood a little under it, glass a single real hit (any shot, one cell).
(defn on-brick-cell-max-hp [(brick-kind : I32)] : I32
  (if (= brick-kind 1) 120
    (if (= brick-kind 2) 60
      (if (= brick-kind 3) 10 80))))

;; Glass tint, the PARENA-programmable knob: channel 0 R, 1 G, 2 B, 3 A (each 0-255). Default is a
;; slight cyan tint at low alpha; edit these four numbers and re-run scripts/gen_brick_mod.sh to
;; retint every glass box in SHANKPIT without touching host C or the shader.
(defn on-glass-tint [(channel : I32)] : I32
  (if (= channel 0) 150
    (if (= channel 1) 225
      (if (= channel 2) 235 70))))
