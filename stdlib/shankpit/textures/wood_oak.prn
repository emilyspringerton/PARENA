(module gentexture)
(import math)

;; wood_oak — quarter-sawn white oak for the municipal district's court rails, galleries and records
;; stacks (SHANKPIT tools/build_municipal_district.py, material `wood_oak`, density 720).
;;
;; THE THREE WOODS ARE ONE FILE SHAPE WITH THREE STORIES. Oak is dense (720 kg/m^3) and quarter-sawn, so
;; its rings run TIGHT and nearly parallel and its planks are cut narrow; pine (460) is soft and wide-
;; ringed and pale; mahogany (580) is a close, dark, dull-grained cabinet wood. Same generator, same
;; knobs, three different numbers -- which is also why the engine can carry three materials instead of
;; one `wood` with a tint, where a bench's debris would weigh the same as a crate's.
;;
;; Knobs (and nothing else -- everything below is derived, so a rebuild is pixel-identical):
;;   plank-rows   how many board rows across the tile
;;   ring-density how many growth rings a board shows; HIGH = dense timber
;;   tint-r/g/b   the species' own colour, so the three read apart under the same light
;;
;; Renders through NOCK's procedural texture pipeline (IDUNA cmd/nock_gen_textures); the native client
;; draws the same material name with packages/render/proc_tex.c's proctex_make_wood_variant_rgba.

(defn plank-rows [] : F64 6.0)
(defn ring-density [] : F64 9.0)
(defn tint-r [] : F64 0.64)
(defn tint-g [] : F64 0.47)
(defn tint-b [] : F64 0.28)

(defn clamp01 [(v : F64)] : F64
  (if (< v 0.0) 0.0 (if (> v 1.0) 1.0 v)))

(defn frac-coord [(scaled : F64)] : F64
  (- scaled (math/floor scaled)))

;; per-pixel deterministic grain jitter (0..1) -- never math/random-f64, for the same reason
;; institutional_tile.prn keeps its tile ids deterministic.
(defn jitter [(x : F64) (y : F64)] : F64
  (frac-coord (+ (* (math/floor x) 12.9898) (* (math/floor y) 78.233))))

;; No `let` and no variadic operators in this file: NOCK renders it through PARENA's Java target
;; (IDUNA internal/nock/procgen.go), which accepts calls but not `let`, and binary operators only.
;; Both compile on the C target -- see courthouse_plaster.prn's note for how that was found.

;; seam — 1.0 in the last few percent of a board, where the next board starts.
(defn board-frac [(y : F64) (h : F64)] : F64
  (frac-coord (* (/ y h) (plank-rows))))

(defn seam [(y : F64) (h : F64)] : F64
  (if (< (board-frac y h) 0.05) 1.0 0.0))

;; rings — cosine growth rings inside each board. They bow slightly toward the ends of the board, which
;; is what makes quarter-sawn oak read as figured rather than as a striped sticker.
(defn ring-bow [(x : F64) (w : F64)] : F64
  (* 0.10 (math/cos (* 6.2832 (/ x w)))))

(defn ring-phase [(x : F64) (y : F64) (w : F64) (h : F64)] : F64
  (+ (* (ring-density) (/ (board-frac y h) (plank-rows))) (ring-bow x w)))

(defn rings [(x : F64) (y : F64) (w : F64) (h : F64)] : F64
  (* 0.5 (+ 1.0 (math/cos (* 6.2832 (ring-phase x y w h))))))

(defn grain [(x : F64) (y : F64)] : F64
  (- (jitter x y) 0.5))

(defn shade-base [(x : F64) (y : F64) (w : F64) (h : F64)] : F64
  (+ 0.72 (+ (* 0.20 (rings x y w h)) (* 0.06 (grain x y)))))

(defn shade [(x : F64) (y : F64) (w : F64) (h : F64)] : F64
  (* (clamp01 (shade-base x y w h)) (- 1.0 (* 0.55 (seam y h)))))

(defn pixel-r [(x : F64) (y : F64) (w : F64) (h : F64)] : F64
  (* (tint-r) (shade x y w h)))

(defn pixel-g [(x : F64) (y : F64) (w : F64) (h : F64)] : F64
  (* (tint-g) (shade x y w h)))

(defn pixel-b [(x : F64) (y : F64) (w : F64) (h : F64)] : F64
  (* (tint-b) (shade x y w h)))
