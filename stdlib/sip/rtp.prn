;; stdlib/sip/rtp.prn — depends on string, net/wire. Design: STDLIB.md "sip/rtp" section.
;;
;; Real trigger: kanban priority-queue card PBX-001, "Build the narrow scope parena PBX
;; primitives... think low level close to the metal primitives like what does asterisk need to
;; build on top of, do that stuff first" — the real, direct follow-up to
;; docs/SIP_TWILIO_GATEWAY_NORTHSTAR.md's own Phase 1 (which named RTP relay as the media-plane
;; half of a real B2BUA/PBX, and named it as needing zero codec understanding for pure relay).
;;
;; This is the real, most foundational media-plane primitive any real PBX needs, below even a
;; relay decision: parsing/constructing an RTP packet's own 12-byte fixed header (RFC 3550 §5.1)
;; — knowing WHERE a packet's real payload starts and what sequence number/timestamp/SSRC it
;; carries, the exact real bookkeeping Asterisk's own RTP engine needs before it can do anything
;; else (relay, jitter-buffer, reorder-detection). Pure PARENA, no FFI, built entirely from
;; primitives that already exist (net/wire.prn's own raw-byte/read-u16-be/read-u32-be), matching
;; NATIVE_PCAP_NORTHSTAR.md's own real finding that most byte-level wire-format work needs no new
;; compiler primitives at all.
;;
;; Real, honest v0 boundary, named explicitly: only the 12-byte fixed header is parsed — a real
;; CSRC list (present when csrc-count > 0) and RFC 3550's own optional header extension (present
;; when the extension bit is set) are real, separate, NOT-yet-supported cases; `parse-rtp-header`
;; reports a real, honest `Unsupported` error for either rather than silently mis-parsing past
;; them. Real, live PBX/SIP-phone traffic overwhelmingly uses neither (a plain G.711/Opus stream
;; with no CSRC mixing), so this is the real, useful common case, not everything RFC 3550 allows.

(module sip/rtp)
(import string)
(import net/wire)
(export parse-rtp-header build-rtp-header RtpHeader RtpError rtp-header-size)

;; rtp-header-size — the real, fixed 12-byte RTP header size this v0 supports (version/padding/
;; extension/CSRC-count byte, marker/payload-type byte, 2-byte sequence number, 4-byte timestamp,
;; 4-byte SSRC — RFC 3550 §5.1's own real, fixed layout before any CSRC list/extension).
(defn rtp-header-size [] : I32 12)

(defstruct RtpHeader
  (version         : I32)   ;; real RTP version, always 2 for any real, live traffic
  (padding         : Bool)  ;; real padding-present flag
  (extension       : Bool)  ;; real header-extension-present flag (NOT parsed further, v0 boundary)
  (csrc-count      : I32)   ;; real CSRC count (0 for the common, unmixed-stream case)
  (marker          : Bool)  ;; real, payload-type-specific marker bit (e.g. "first packet of a talkspurt")
  (payload-type    : I32)   ;; real RTP payload type number (0 = PCMU/G.711 mu-law, the common Twilio default)
  (sequence-number : I32)   ;; real 16-bit sequence number, for real reorder/loss detection
  (timestamp       : I32)   ;; real 32-bit media timestamp
  (ssrc            : I32))  ;; real 32-bit synchronization source identifier

(defenum RtpError
  (TooShort)      ;; real buffer shorter than the fixed 12-byte header
  (Unsupported))  ;; real CSRC list or header extension present -- v0 doesn't parse past them

;; parse-rtp-header — real, direct bitfield decode of RFC 3550's own fixed 12-byte header.
;; Byte 0: V(2 bits) P(1) X(1) CC(4 bits). Byte 1: M(1 bit) PT(7 bits). Bytes 2-3: sequence
;; number. Bytes 4-7: timestamp. Bytes 8-11: SSRC. Every multi-byte field is real, standard
;; network byte order (big-endian), read via net/wire's own already-tested read-u16-be/
;; read-u32-be -- this file adds zero new byte-order logic of its own. `dest` is required even
;; though every real field here is a scalar: VS0's own C emitter needs a real Arena in scope to
;; box a non-pointer Result/Option payload (a real, genuine, already-documented emitter
;; constraint, confirmed live -- not a design choice of this file's own).
;;
;; Real, genuine, decisive bug found live building this: `len` is a REQUIRED, explicit parameter
;; here, deliberately NOT `(string/length buf)` -- confirmed live that `string/length` is
;; literally `strlen(s)` (see string.prn's own real implementation), which stops at the first
;; embedded NUL byte. Real RTP headers hit this constantly and legitimately (a `sequence-number`,
;; `timestamp`, or `payload-type` of exactly 0 is completely ordinary, real traffic, not an edge
;; case) -- calling `string/length` on a real RTP buffer would silently, incorrectly report it as
;; "too short" the moment ANY header field happens to contain a zero byte. Same real, already-
;; established precedent this session's own `pentest/pcap.prn` already set: `Packet` carries its
;; own separate real `length : I32` field precisely because `Packet.data : String` can't be
;; trusted to self-report its own real byte count once raw binary content is involved.
(defn parse-rtp-header [(buf : String @ Region) (len : I32) (dest : Arena @ Region)]
  : (Result RtpHeader RtpError) @ Region
  (if (< len (rtp-header-size))
    (Err TooShort)
    (let [b0 (net/wire/raw-byte buf 0)
          version (shr b0 6)
          padding (= (bit-and (shr b0 5) 1) 1)
          extension (= (bit-and (shr b0 4) 1) 1)
          csrc-count (bit-and b0 15)
          b1 (net/wire/raw-byte buf 1)
          marker (= (shr b1 7) 1)
          payload-type (bit-and b1 127)]
      (if (or extension (> csrc-count 0))
        (Err Unsupported)
        (Ok {:version version
             :padding padding
             :extension extension
             :csrc-count csrc-count
             :marker marker
             :payload-type payload-type
             :sequence-number (net/wire/read-u16-be buf 2)
             :timestamp (net/wire/read-u32-be buf 4)
             :ssrc (net/wire/read-u32-be buf 8)})))))

;; build-rtp-header — the real, direct inverse of parse-rtp-header: encode a RtpHeader back into
;; its real, wire-format 12 raw bytes. Real, honest v0 boundary carried over: always emits
;; csrc-count=0/extension=0 in byte 0's own low nibble, matching parse's own "doesn't support
;; either" boundary -- a real caller building a header with actual CSRCs/extensions needs real,
;; separate, not-yet-built support, not a header that LOOKS right but omits the data it claims.
;;
;; Real, decisive, genuinely deeper limitation found live building this, confirmed via a real,
;; failing round-trip test before writing this comment: `string/concat` (this function's own
;; only real byte-assembly primitive) is `strcpy(out, a); strcat(out, b);` under the hood (see
;; string.prn's own real implementation) -- if ANY intermediate byte this function emits is a
;; real 0x00 (an entirely ordinary, common real value for `sequence-number`/`timestamp`/`ssrc`,
;; not a rare edge case), `strcat`'s own C semantics silently truncate everything built so far
;; right there. Unlike `parse-rtp-header` above (fixed by taking an explicit `len`, since
;; `char-at`'s own real underlying read never cared about NUL), there is no equivalently small
;; fix on the WRITE side -- `concat` itself would need real, separate, length-aware (`memcpy`,
;; not `strcpy`/`strcat`) semantics, a real, larger change to a shared, widely-used stdlib
;; primitive, genuinely out of this card's own "narrow scope" ask. Real, honest, current
;; conclusion: `build-rtp-header` only produces CORRECT output when none of its own real fields
;; happen to be zero -- a real, meaningful limitation for actual use, named directly rather than
;; silently passed off as working.
(defn build-rtp-header [(h : RtpHeader) (dest : Arena @ Region)]
  : String @ Region
  (let [b0 (bit-or (shl (get-field h :version) 6)
             (bit-or (shl (if (get-field h :padding) 1 0) 5)
                     (shl (if (get-field h :extension) 1 0) 4)))
        b1 (bit-or (shl (if (get-field h :marker) 1 0) 7) (get-field h :payload-type))
        seq (get-field h :sequence-number)
        ts (get-field h :timestamp)
        ssrc (get-field h :ssrc)]
    (concat
      (concat (char-from-code b0 dest) (char-from-code b1 dest) dest)
      (concat
        (concat (char-from-code (bit-and (shr seq 8) 255) dest) (char-from-code (bit-and seq 255) dest) dest)
        (concat
          (concat
            (concat (char-from-code (bit-and (shr ts 24) 255) dest) (char-from-code (bit-and (shr ts 16) 255) dest) dest)
            (concat (char-from-code (bit-and (shr ts 8) 255) dest) (char-from-code (bit-and ts 255) dest) dest)
            dest)
          (concat
            (concat (char-from-code (bit-and (shr ssrc 24) 255) dest) (char-from-code (bit-and (shr ssrc 16) 255) dest) dest)
            (concat (char-from-code (bit-and (shr ssrc 8) 255) dest) (char-from-code (bit-and ssrc 255) dest) dest)
            dest)
          dest)
        dest)
      dest)))
