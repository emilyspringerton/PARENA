;; stdlib/netkit/host/nk_host_survival.prn -- the SHANKPHONE's SURVIVAL button: SHANKPIT SURVIVAL running INSIDE the page.
;;
;; Founder real-time 2026-11-26: "the shankpit net kit can be the shankphone and the shankphone itself can have a button for survival
;; that launches OG shankpit as a level and collection of mods". survival.wasm is the shankpit-460 PARENA engine with the CITY level and the
;; survival mods (stdlib/shankpit_survival/, scripts/build_shankpit_survival_wasm.sh): no imports, no allocator, fixed 8 MB, so it runs
;; under this page's CSP exactly like BRAWLPIT does (nk_host_arcade.prn is the pattern; names here are sv-/surv- because every host file
;; shares one namespace).
;;
;; What this file does, and only this: load the module lazily, run its frame loop while the view is up, blit its 640x360 framebuffer, and
;; turn fingers into the engine's own inputs --
;;   the stick (bottom left)       -> gamepad slot 0's left stick (sp_pad), analog, so a half push walks
;;   a drag on the picture         -> mouse look (sp_mouse), at nk-survival-look-per-100px degrees per 100 CSS pixels
;;   the buttons (bottom right)    -> the keys / wheel / left mouse nk-survival-touch-key names
;;   a tap on the picture in a menu-> a click at that framebuffer pixel (sp_pointer + sp_button)
;; Every held key, the stick and the fire button are released on leaving, on blur and when the page is hidden.
;; THE CAMERA (2026-11-28, "bring in the REDGARDEN OG DNA"): a mouse wheel over the picture zooms (sp_zoom; out = third person, all the way in =
;; first person), a left click that is not a drag becomes sp_click(x, y) = click to move (third person only; the engine refuses it for the sniper),
;; and a drag orbits in third person / looks in first. The right button is the engine's right button in first person (the sniper's scope) and
;; orbits in third person. A touch tap counts as a click too. The decisions are PARENA's (sv_camera.prn over stdlib/camera).
;; THE GFD LINK (2026-11-28, founder: "wire it up to the server ... full command capabilities via the chat log"): the module imports nothing,
;; so this host carries its network. The Chat button opens a log + input on the SURVIVAL view; every line typed is sent UNCHANGED to the live GFD
;; connection (the one the GFD tab opens: signed in over wss, or the guest TCP session), so the chat log has the full command set of the MUD,
;; and everything the MUD says comes back into it. The same connection settles telecrystal casts: survival.wasm's mailbox (sv_crystal.prn)
;; holds a request when a cast commits; each frame this file turns it into `svtravel <id> <x> <z> <fight>` and turns the server's
;; `SVTRAVEL OK|FIZZLE|NO ...` reply line back into the mailbox. No live connection = server-on 0 = the offline rules (wood, local d20).
;; NOT here (named): sound (the engine fills its sound ring; nothing plays it in the SHANKPHONE yet -- BRAWLPIT has no sound here either).

(def surv-state 0)          ; 0 not loaded, 1 loading, 2 ready, 3 could not load (nk_garage.prn's codes)
(def surv-x null)
(def surv-mem null)
(def surv-canvas null)
(def surv-ctx null)
(def surv-img null)
(def surv-run false)
(def surv-looping false)
(def surv-held null)        ; pointerId -> code held by that finger (buttons)
(def surv-listening false)
(def surv-stick-id -1)      ; pointerId on the stick, -1 none
(def surv-lx 0.0)
(def surv-ly 0.0)
(def surv-look-id -1)       ; pointerId dragging the picture to look, -1 none
(def surv-look-x 0.0)
(def surv-look-y 0.0)
(def surv-menu-down false)  ; a menu tap is pressed on the picture
(def surv-down-x 0.0)       ; where the picture was pressed (CSS px), for the click-vs-drag test
(def surv-down-y 0.0)
(def surv-down-tp false)    ; third person when it was pressed
(def surv-rmb false)        ; the right mouse button is held as the engine's right button (the sniper's scope)
(def surv-from-sso false)    ; the sign-in was started from SURVIVAL: come back here when it returns
(def surv-link-code -1)
(def surv-seen 0)           ; the last mailbox request sequence this host relayed
(def surv-chat-lines 0)
(def surv-room "")           ; the GFD room the scene was last built for ("room|zone")
(def surv-dir 0)             ; the way the hero last went (1 N, 2 S, 3 E, 4 W): where the next zone's arrival side comes from
(def surv-dir-at 0.0)
(def surv-exit-at -1.0)      ; when an edge exit's move command went out (-1 none)
(def surv-mouse-seen false)  ; a real mouse has touched the picture: FPS-style look (the app captures the pointer) is worth doing
(def surv-cap false)         ; the app currently holds the pointer captured (relative mouse: NetkitNative.mouseCapture)
(def surv-cap-off false)     ; Esc let go of it; the next mouse press on the picture takes it back
(def surv-mbtn 0)            ; captured-mouse buttons as last reported (bit 0 left, bit 1 right)
(def surv-live false)       ; the badge's last state

(defn surv-say! [(text : Any)] : Unit
  (do (set-text! "survival-msg" text)
      (set-hidden! "survival-msg" (= text ""))))

;; ---- load ---------------------------------------------------------------------------------------------------------------------------------
(defn surv-on-response [(r : Any)] : Any
  (if (js/get r "ok")
      (js/call r "arrayBuffer")
      (js/call (js/global "Promise") "reject" (str "survival.wasm: HTTP " (js/get r "status")))))
(defn surv-on-bytes [(bytes : Any)] : Any
  (js/call (js/global "WebAssembly") "instantiate" bytes (js/obj)))
(defn surv-fail! [(err : Any)] : Unit
  (do (set! surv-state 3)
      (surv-say! (str "SURVIVAL could not load: " err))
      (js/call (js/get (js/global "console") "error") "call" (js/global "console") err)))

(defn survival-load! [] : Unit
  (do (set! surv-state 1)
      (surv-say! "Loading SURVIVAL...")
      (set! surv-held (js/obj))
      (set! surv-canvas (el "sv-canvas"))
      (set! surv-ctx (js/call surv-canvas "getContext" "2d"))
      (js/call
        (js/call
          (js/call
            (js/call
              (js/call-fn (js/global "fetch") "survival.wasm")
              "then" (callback surv-on-response))
            "then" (callback surv-on-bytes))
          "then" (callback surv-on-instance))
        "catch" (callback surv-fail!))))

(defn surv-on-instance [(result : Any)] : Unit
  (do
    (set! surv-x (js/get (js/get result "instance") "exports"))
    (set! surv-mem (js/get surv-x "memory"))
    (js/call surv-x "sp_init")
    (set! surv-img
          (js/new "ImageData"
                  (js/new "Uint8ClampedArray" (js/get surv-mem "buffer") (js/call surv-x "sp_fb_addr")
                          (* (* (js/call surv-x "sp_fb_w") (js/call surv-x "sp_fb_h")) 4))
                  (js/call surv-x "sp_fb_w") (js/call surv-x "sp_fb_h")))
    (surv-install!)
    (js/call surv-x "sp_zone" (surv-hash "meadow") 0 1)   ; offline: a meadow; a GFD room replaces this seed and biome once connected
    (set! surv-state 2)
    (surv-say! "")
    (when surv-run (do (js/call surv-x "sp_lock" 1) (surv-start-loop!)))))

;; ---- the GFD link: chat log + the cast mailbox (layout: stdlib/shankpit_survival/sv_crystal.prn, base = sv-base + 12288 = 536576) ----------
(defn surv-mb [] : I32 536576)
(defn surv-view [] : Any (js/new "DataView" (js/get surv-mem "buffer")))

(defn surv-chat-add! [(cls : String) (text : String)] : Unit
  (let [box (el "sv-log")]
    (when (not (js/null? box))
      (let [d (js/call (doc) "createElement" "div")]
        (do (js/set! d "className" (str "gl " cls))
            (js/set! d "textContent" text)
            (js/call box "appendChild" d)
            (set! surv-chat-lines (+ surv-chat-lines 1))
            (loop [] (when (> surv-chat-lines 120)
                       (do (js/call box "removeChild" (js/get box "firstChild")) (set! surv-chat-lines (- surv-chat-lines 1)) (recur))))
            (js/set! box "scrollTop" (js/get box "scrollHeight")))))))

;; a live, playing GFD session (the wasm's state 3 = in the world)
(defn surv-gfd-live? [] : Bool
  (if (js/null? gfd) false
      (if (js/get gfd "up") (= (js/call (js/get gfd "x") "nk_gfd_state") 3) false)))

(defn surv-link-paint! [] : Unit
  (let [signed (not (js/null? (gfd-sso)))
        live (surv-gfd-live?)]
    (do (set-text! "sv-who"
                   (cond live (str "Connected to GoblinFoxDragon" (if (= (gfd-sso-player) "") "" (str " as player " (gfd-sso-player))))
                         (not (js/null? gfd)) "Connecting to GoblinFoxDragon..."
                         signed "Signed in with IDUNA. Not connected."
                         :else "Not signed in. SURVIVAL is offline."))
        (set-hidden! "btn-sv-sso" (or signed live))
        (set-hidden! "btn-sv-connect" (or (not signed) (or live (not (js/null? gfd))))))))

(defn surv-badge! [(live : Bool)] : Unit
  (when (!= live surv-live)
    (do (set! surv-live live)
        (set-text! "sv-badge" (if live "GFD live" "offline"))
        (surv-link-paint!))))

;; the same IDUNA sign-in the GFD tab uses (NetkitNative.ssoOpen -> the system browser -> shankphone://sso); it returns here
(defn on-sv-sso [(e : Any)] : Unit
  (if (have-native?)
      (do (set! surv-from-sso true)
          (surv-chat-add! "s8" "IDUNA's sign-in page is open in your browser. Come back here when it is done.")
          (js/call nat "ssoOpen"))
      (surv-chat-add! "s8" "Sign-in needs the SHANKPHONE app.")))
(defn on-sv-connect [(e : Any)] : Unit
  (when (js/null? gfd) (on-gfd-resume null)))

;; the shell's sso event, as far as SURVIVAL is concerned: signed in from here -> back to the game and connect
(defn surv-after-sso! [(ok : Bool)] : Unit
  (when surv-from-sso
    (do (set! surv-from-sso false)
        (if ok
            (do (show-view! "survival")
                (surv-chat-add! "s5" "Signed in with IDUNA. Connecting...")
                (when (js/null? gfd) (on-gfd-resume null)))
            (surv-chat-add! "s6" "No browser to sign in with.")))))

;; the server's SVTRAVEL line -> the mailbox reply (the request sequence last, so the wasm never sees a half-written reply)
(defn surv-on-svtravel! [(text : String)] : Unit
  (when (not (js/null? surv-mem))
    (let [p (js/call text "split" " ")
          v (js/aget p 1)
          dv (surv-view)
          b (surv-mb)]
      (do (cond
            (= v "OK")
              (do (js/call dv "setInt32" (+ b 36) 1 true)
                  (js/call dv "setFloat32" (+ b 44) (js/call-fn (js/global "parseFloat") (js/aget p 3)) true)
                  (js/call dv "setFloat32" (+ b 48) (js/call-fn (js/global "parseFloat") (js/aget p 4)) true)
                  (js/call dv "setFloat32" (+ b 52) (js/call-fn (js/global "parseFloat") (js/aget p 5)) true)
                  (js/call dv "setInt32" (+ b 56) (js/call-fn (js/global "parseInt") (js/aget p 6) 10) true))
            (= v "FIZZLE") (js/call dv "setInt32" (+ b 36) 2 true)
            :else
              (let [why (js/aget p 3)]
                (do (js/call dv "setInt32" (+ b 36) 3 true)
                    (js/call dv "setInt32" (+ b 40)
                             (cond (= why "unknown") 1 (= why "out-of-ring") 2 (= why "guard") 3 (= why "flow") 4
                                   (= why "pending") 5 (= why "ko") 6 :else 7) true))))
          (js/call dv "setInt32" (+ b 32) (js/call dv "getInt32" b true) true)))))

;; once a frame: tell the wasm whether a server is there, and send a freshly posted cast
(defn surv-relay! [] : Unit
  (let [dv (surv-view) b (surv-mb) live (surv-gfd-live?)]
    (do (js/call dv "setInt32" (+ b 64) (if live 1 0) true)
        (surv-badge! live)
        (let [code (+ (if live 2 (if (js/null? gfd) 0 1)) (if (js/null? (gfd-sso)) 0 3))]
          (when (!= code surv-link-code) (do (set! surv-link-code code) (surv-link-paint!))))
        (let [seq (js/call dv "getInt32" b true)]
          (when (!= seq surv-seen)
            (do (set! surv-seen seq)
                (when live
                  (let [id (cstr (js/new "Uint8Array" (js/get surv-mem "buffer")) (+ b 128))]
                    (gfd-command! (str "svtravel " id " " (js/call (js/call dv "getFloat32" (+ b 8) true) "toFixed" 2) " "
                                       (js/call (js/call dv "getFloat32" (+ b 12) true) "toFixed" 2) " "
                                       (js/call dv "getInt32" (+ b 16) true)))))))))))

(defn on-sv-chat-send [(e : Any)] : Unit
  (do (js/call e "preventDefault")
      (let [t (str (val "sv-chat-input"))]
        (when (> (js/get t "length") 0)
          (do (set-val! "sv-chat-input" "")
              (if (surv-gfd-live?)
                  (do (surv-note-dir! (surv-dir-of t)) (gfd-command! t))
                  (surv-chat-add! "s8" "Not connected to GoblinFoxDragon. Open the GFD tab, sign in or play as a guest, and tap Play; this log then reaches the whole MUD.")))))))

(defn on-sv-chat-toggle [(e : Any)] : Unit
  (let [box (el "sv-chat")
        open (js/get box "hidden")]
    (do (set-hidden! "sv-chat" (not open))
        (js/call (el "btn-sv-chat") "setAttribute" "aria-expanded" (if open "true" "false"))
        (surv-link-paint!)
        (when open (js/call (el "sv-chat-input") "focus")))))

;; ---- the frame loop (only while the view is up) ------------------------------------------------------------------------------------
;; ---- FPS-style mouse (the Android app captures the pointer: WebView has no Pointer Lock) -----------------------------------------------
;; first person + a mouse + the world showing = relative look, left fires, right scopes the sniper, wheel zooms. Third person keeps the
;; free cursor (click to move), exactly as before.
(defn surv-want-capture? [] : Bool
  (and surv-run (and (= surv-state 2) (and surv-mouse-seen (and (not surv-cap-off)
       (and (= (js/call surv-x "sp_phase") 1) (and (= (js/call surv-x "sp_third_person") 0) (not (arc-typing?)))))))))
(defn surv-capture-sync! [] : Unit
  (when (have-native?)
    (let [want (surv-want-capture?)]
      (when (!= want surv-cap)
        (do (set! surv-cap want)
            (when (not want) (surv-mouse-buttons! 0))
            (js/call nat "mouseCapture" (if want 1 0)))))))

(defn surv-mouse-buttons! [(b : I32)] : Unit
  (do (when (!= (bit-and b 1) (bit-and surv-mbtn 1)) (js/call surv-x "sp_button" 0 (bit-and b 1)))
      (when (!= (bit-and b 2) (bit-and surv-mbtn 2)) (js/call surv-x "sp_button" 2 (if (!= (bit-and b 2) 0) 1 0)))
      (set! surv-mbtn b)))

;; the app's captured mouse: {"dx":..,"dy":..,"b":buttons,"w":-1|0|1}
(defn on-netkit-mouse [(json : String)] : Unit
  (when (and surv-run (and (= surv-state 2) surv-cap))
    (let [ev (js/call (js/global "JSON") "parse" json)
          dx (js/get ev "dx")
          dy (js/get ev "dy")
          w (js/get ev "w")]
      (do (when (or (!= dx 0.0) (!= dy 0.0)) (js/call surv-x "sp_mouse" dx dy))
          (surv-mouse-buttons! (js/get ev "b"))
          (when (!= w 0.0) (js/call surv-x "sp_zoom" (if (> w 0.0) 1 -1)))))))

;; ---- zones: every GFD room is a scene (sv_zone.prn is the other half) -------------------------------------------------------------------
(defn surv-hash [(s : String)] : I32
  (let [(h : F64) 5381.0
        n (js/get s "length")]
    (do (dotimes [i n]
          (set! h (js/call (js/global "Math") "abs" (js/call (js/global "Math") "imul" (+ (js/call (js/global "Math") "imul" h 33) (js/call s "charCodeAt" i)) 1))))
        (js/call (js/global "Math") "max" 1 (js/call (js/global "Math") "floor" (/ h 1.0))))))

;; a GFD zone's name -> its biome (sv_biome.prn, BIOMES.md). Diablo 2 rule: a named zone keeps its identity. Anything unnamed is 255 = the seed picks (Minecraft).
(defn surv-has? [(s : String) (w : String)] : Bool (>= (js/call s "indexOf" w) 0))
(defn surv-biome-of [(key : String)] : I32
  (let [z (js/call (js/call (js/aget (js/call key "split" "|") 1) "toString") "toLowerCase")]
    (cond
      (= z "") 1
      (surv-has? z ":") 13
      (or (surv-has? z "cave") (or (surv-has? z "deeps") (or (surv-has? z "mine") (or (surv-has? z "stacks") (or (surv-has? z "archive") (surv-has? z "geode")))))) 13
      (or (surv-has? z "swamp") (or (surv-has? z "marsh") (surv-has? z "moor-bog"))) 2
      (surv-has? z "salt") 4
      (or (surv-has? z "tidepool") (or (surv-has? z "coast") (or (surv-has? z "docks") (or (surv-has? z "quay") (or (surv-has? z "balance") (surv-has? z "kuroshio")))))) 5
      (surv-has? z "moor") 6
      (or (surv-has? z "tor") (or (surv-has? z "ridge") (or (surv-has? z "perch") (surv-has? z "wall")))) 7
      (or (surv-has? z "terrace") (or (surv-has? z "stair") (surv-has? z "shrine"))) 8
      (or (surv-has? z "handington") (surv-has? z "town")) 11
      (surv-has? z "hill") 3
      (or (surv-has? z "meadow") (surv-has? z "field")) 1
      :else 255)))
(defn surv-dir-word [(d : I32)] : String
  (cond (= d 1) "north" (= d 2) "south" (= d 3) "east" :else "west"))
(defn surv-dir-of [(t : String)] : I32
  (let [w (js/call (js/call t "trim") "toLowerCase")]
    (cond (or (= w "n") (= w "north")) 1
          (or (= w "s") (= w "south")) 2
          (or (= w "e") (= w "east")) 3
          (or (= w "w") (= w "west")) 4
          :else 0)))
(defn surv-note-dir! [(d : I32)] : Unit
  (when (> d 0) (do (set! surv-dir d) (set! surv-dir-at (js/call (js/global "performance") "now")))))

(defn surv-zone-sync! [(t : F64)] : Unit
  (let [live (surv-gfd-live?)]
    (do
      (when live
        (let [key (str (gfd-word0 "nk_gfd_room_addr") "|" (gfd-word0 "nk_gfd_zone_addr"))]
          (when (and (!= key "|") (!= key surv-room))
            (let [first (= surv-room "")
                  side (if (and (not first) (< (- t surv-dir-at) 6000.0)) surv-dir 0)]
              (do (set! surv-room key)
                  (set! surv-dir 0)
                  (js/call surv-x "sp_zone" (surv-hash key) side (surv-biome-of key))
                  (set! surv-exit-at -1.0)
                  (surv-chat-add! "s5" (str "Zone: " (gfd-word0 "nk_gfd_room_addr")))
                  (js/set! (el "sv-room") "title" key))))))
      (let [d (js/call surv-x "sp_zone_exit")]
        (if (= d 0)
            (set! surv-exit-at -1.0)
            (if (and live (< surv-exit-at 0.0))
                (do (surv-note-dir! d) (set! surv-exit-at t) (gfd-command! (surv-dir-word d)))
                (when (or (not live) (> (- t surv-exit-at) 2500.0))
                  (do (set! surv-exit-at -1.0)
                      (js/call surv-x "sp_zone_ack")
                      (surv-chat-add! "s8" (if live "You cannot go that way." "Not connected to GoblinFoxDragon: the edge of this zone is closed."))))))))))

(defn on-sv-gfd-toggle [(e : Any)] : Unit
  (let [box (el "sv-gfd")
        open (js/get box "hidden")]
    (do (set-hidden! "sv-gfd" (not open))
        (js/call (el "btn-sv-gfd") "setAttribute" "aria-expanded" (if open "true" "false")))))
(defn surv-compass-code [(c : I32)] : I32 (if (and (>= c 1) (<= c 4)) c 0))
(defn on-sv-gfd-btn [(e : Any)] : Unit
  (let [b (js/call (js/get e "target") "closest" "[data-gb]")]
    (when (not (js/null? b))
      (do (surv-note-dir! (surv-compass-code (js/call-fn (js/global "parseInt") (js/get (js/get b "dataset") "gb") 10)))
          (on-gfd-button e)))))

(defn surv-tick [(t : F64)] : Unit
  (do (set! surv-looping false)
      (when (and surv-run (= surv-state 2))
        (do (js/call surv-x "sp_pad" 0 surv-lx surv-ly 0.0 0.0 0.0 0.0 0)
            (surv-relay!)
            (surv-zone-sync! t)
            (surv-capture-sync!)
            (js/call surv-x "sp_frame" t)
            (js/call surv-ctx "putImageData" surv-img 0 0)
            (surv-start-loop!)))))

(defn surv-start-loop! [] : Unit
  (when (not surv-looping)
    (do (set! surv-looping true)
        (js/call (win) "requestAnimationFrame" (callback surv-tick)))))

;; ---- entering and leaving ---------------------------------------------------------------------------------------------------------
(defn survival-enter! [] : Unit
  (do (set! surv-run true)
      ;; signed in with IDUNA and no session yet: open one, so the chat log and the crystals reach the server without a detour
      (when (and (js/null? gfd) (not (js/null? (gfd-sso)))) (on-gfd-resume null))
      (when (or (= surv-state 0) (= surv-state 3)) (survival-load!))
      (when (= surv-state 2) (do (js/call surv-x "sp_lock" 1) (surv-start-loop!)))))

(defn survival-leave! [] : Unit
  (when surv-run
    (do (set! surv-run false)
        (surv-release-all!)
        (when (not (js/null? surv-x)) (js/call surv-x "sp_lock" 0)))))

(defn surv-unpress! [(b : Any)] : Unit (js/call (js/get b "classList") "remove" "down"))

(defn surv-release-all! [] : Unit
  (when (not (js/null? surv-held))
    (let [ids (js/call (js/global "Object") "keys" surv-held)]
      (do (dotimes [i (js/get ids "length")]
            (surv-code-up! (js/aget surv-held (js/aget ids i))))
          (set! surv-held (js/obj))
          (js/call (js/call (doc) "querySelectorAll" "#sv-pad .down, #sv-zoom .down") "forEach" (callback surv-unpress!))
          (set! surv-stick-id -1) (set! surv-lx 0.0) (set! surv-ly 0.0) (surv-knob! 0.0 0.0)
          (set! surv-look-id -1)
          (when (and surv-cap (have-native?)) (js/call nat "mouseCapture" 0))
          (set! surv-cap false) (set! surv-mbtn 0)
          (when (not (js/null? surv-x))
            (do (when surv-menu-down (js/call surv-x "sp_button" 0 0))
                (when surv-rmb (do (set! surv-rmb false) (js/call surv-x "sp_button" 2 0)))
                (set! surv-menu-down false)
                (js/call surv-x "sp_pad_gone" 0)
                (js/call surv-x "sp_blur")))))))

;; a touch-button code -> the engine (nk-survival-touch-key: key codes, 1000 = next weapon, 1001 = fire)
(defn surv-code-down! [(code : I32)] : Unit
  (when (and (not (js/null? surv-x)) (> code 0))
    (cond (= code 1000) (js/call surv-x "sp_wheel" 1)
          (= code 1002) (js/call surv-x "sp_zoom" -1)
          (= code 1003) (js/call surv-x "sp_zoom" 1)
          (= code 1001) (js/call surv-x "sp_button" 0 1)
          :else (js/call surv-x "sp_key" code 1))))
(defn surv-code-up! [(code : I32)] : Unit
  (when (and (not (js/null? surv-x)) (> code 0))
    (cond (= code 1000) unit
          (= code 1002) unit
          (= code 1003) unit
          (= code 1001) (js/call surv-x "sp_button" 0 0)
          :else (js/call surv-x "sp_key" code 0))))

;; ---- the buttons --------------------------------------------------------------------------------------------------------------------
(defn surv-pad-down [(e : Any)] : Unit
  (let [b (js/call (js/get e "target") "closest" "[data-sv]")]
    (when (and (not (js/null? b)) (and surv-run (= surv-state 2)))
      (let [code (js/call scan-x "nk_survival_touch_key" (js/call-fn (js/global "parseInt") (js/get (js/get b "dataset") "sv") 10))
            pid (js/get e "pointerId")]
        (do (js/call e "preventDefault")
            (js/call b "setPointerCapture" pid)
            (js/call (js/get b "classList") "add" "down")
            (js/aset! surv-held (str pid) code)
            (surv-code-down! code))))))

(defn surv-pad-up [(e : Any)] : Unit
  (let [pid (str (js/get e "pointerId"))]
    (when (not (js/null? surv-held))
      (let [code (js/aget surv-held pid)]
        (when (= (js/typeof code) "number")
          (do (surv-code-up! code)
              (js/aset! surv-held pid 0)
              (let [b (js/call (js/get e "target") "closest" "[data-sv]")]
                (when (not (js/null? b)) (js/call (js/get b "classList") "remove" "down")))))))))

;; ---- the stick ------------------------------------------------------------------------------------------------------------------------
(defn surv-knob! [(lx : F64) (ly : F64)] : Unit
  (let [k (el "sv-knob")
        r (js/call scan-x "nk_survival_stick_radius")]
    (when (not (js/null? k))
      (js/set! (js/get k "style") "transform" (str "translate(" (* lx r) "px," (* ly r) "px)")))))

(defn surv-stick-set! [(e : Any)] : Unit
  (let [s (el "sv-stick")
        rect (js/call s "getBoundingClientRect")
        r (js/call scan-x "nk_survival_stick_radius")
        dx (/ (- (js/get e "clientX") (+ (js/get rect "left") (/ (js/get rect "width") 2.0))) r)
        dy (/ (- (js/get e "clientY") (+ (js/get rect "top") (/ (js/get rect "height") 2.0))) r)
        len (math/sqrt (+ (* dx dx) (* dy dy)))
        k (if (> len 1.0) (/ 1.0 len) 1.0)]
    (do (set! surv-lx (* dx k))
        (set! surv-ly (* dy k))
        (surv-knob! surv-lx surv-ly))))

(defn surv-stick-down [(e : Any)] : Unit
  (when (and surv-run (= surv-state 2))
    (do (js/call e "preventDefault")
        (set! surv-stick-id (js/get e "pointerId"))
        (js/call (el "sv-stick") "setPointerCapture" surv-stick-id)
        (surv-stick-set! e))))
(defn surv-stick-move [(e : Any)] : Unit
  (when (= (js/get e "pointerId") surv-stick-id) (surv-stick-set! e)))
(defn surv-stick-up [(e : Any)] : Unit
  (when (= (js/get e "pointerId") surv-stick-id)
    (do (set! surv-stick-id -1) (set! surv-lx 0.0) (set! surv-ly 0.0) (surv-knob! 0.0 0.0))))

;; ---- the picture: look while playing, click in the menus -------------------------------------------------------------------------------
(defn surv-fb-x [(e : Any)] : I32
  (let [rect (js/call surv-canvas "getBoundingClientRect")]
    (math/floor (/ (* (- (js/get e "clientX") (js/get rect "left")) (js/call surv-x "sp_fb_w")) (js/get rect "width")))))
(defn surv-fb-y [(e : Any)] : I32
  (let [rect (js/call surv-canvas "getBoundingClientRect")]
    (math/floor (/ (* (- (js/get e "clientY") (js/get rect "top")) (js/call surv-x "sp_fb_h")) (js/get rect "height")))))

(defn surv-canvas-down [(e : Any)] : Unit
  (when (= surv-state 2)
    (do (js/call e "preventDefault")
        (when (= (js/get e "pointerType") "mouse") (do (set! surv-mouse-seen true) (set! surv-cap-off false)))
        (if (= (js/call surv-x "sp_phase") 1)
            (if (and (= (js/get e "pointerType") "mouse") (and (= (js/get e "button") 2) (= (js/call surv-x "sp_third_person") 0)))
                (do (set! surv-rmb true) (js/call surv-x "sp_button" 2 1))
                (when (< surv-look-id 0)
                  (do (set! surv-look-id (js/get e "pointerId"))
                      (set! surv-look-x (js/get e "clientX"))
                      (set! surv-look-y (js/get e "clientY"))
                      (set! surv-down-x (js/get e "clientX"))
                      (set! surv-down-y (js/get e "clientY"))
                      (set! surv-down-tp (= (js/call surv-x "sp_third_person") 1))
                      (js/call surv-canvas "setPointerCapture" surv-look-id))))
            (do (js/call surv-x "sp_pointer" (surv-fb-x e) (surv-fb-y e))
                (set! surv-menu-down true)
                (js/call surv-x "sp_button" 0 1))))))

(defn surv-canvas-move [(e : Any)] : Unit
  (when (= surv-state 2)
    (when (= (js/get e "pointerType") "mouse") (set! surv-mouse-seen true))
    (if (= (js/get e "pointerId") surv-look-id)
        ;; the engine turns by 0.15 degrees per mouse unit (sp_input look-sens); the wasm says how many degrees a 100 px drag is
        (let [per (/ (js/call scan-x "nk_survival_look_per_100px") 15.0)
              dx (* (- (js/get e "clientX") surv-look-x) per)
              dy (* (- (js/get e "clientY") surv-look-y) per)]
          (do (set! surv-look-x (js/get e "clientX"))
              (set! surv-look-y (js/get e "clientY"))
              (js/call surv-x "sp_mouse" dx dy)))
        (js/call surv-x "sp_pointer" (surv-fb-x e) (surv-fb-y e)))))

(defn surv-abs [(v : F64)] : F64 (if (< v 0.0) (- 0.0 v) v))

(defn surv-canvas-wheel [(e : Any)] : Unit
  (when (= surv-state 2)
    (do (js/call e "preventDefault")
        (when (!= (js/get e "deltaY") 0.0)
          (js/call surv-x "sp_zoom" (if (> (js/get e "deltaY") 0.0) -1 1))))))

(defn surv-canvas-up [(e : Any)] : Unit
  (when (= surv-state 2)
    (do (when (= (js/get e "pointerId") surv-look-id)
          (do (set! surv-look-id -1)
              ;; a press that barely moved, in third person, is a click: click to move
              (when (and surv-down-tp (and (= (js/get e "type") "pointerup") (= (js/get e "button") 0)))
                (when (< (+ (surv-abs (- (js/get e "clientX") surv-down-x)) (surv-abs (- (js/get e "clientY") surv-down-y))) 8.0)
                  (js/call surv-x "sp_click" (surv-fb-x e) (surv-fb-y e))))))
        (when (and surv-rmb (= (js/get e "button") 2))
          (do (set! surv-rmb false) (js/call surv-x "sp_button" 2 0)))
        (when surv-menu-down
          (do (set! surv-menu-down false)
              (js/call surv-x "sp_button" 0 0)
              ;; a menu tap that started the run: hold the "pointer" so the engine plays (it pauses its own HUD when unlocked)
              (js/call surv-x "sp_lock" 1))))))

;; hardware keyboard (Bluetooth, ChromeOS, a desktop browser): forwarded while the view is up and no text field has focus
(defn surv-on-keydown [(e : Any)] : Unit
  (when (and surv-run (and (= surv-state 2) (not (arc-typing?))))
    (do (when (= (js/get e "keyCode") 27) (set! surv-cap-off true))
        (js/call surv-x "sp_key" (js/get e "keyCode") 1)
        (when (arc-game-key? e) (js/call e "preventDefault")))))
(defn surv-on-keyup [(e : Any)] : Unit
  (when (and surv-run (= surv-state 2)) (js/call surv-x "sp_key" (js/get e "keyCode") 0)))
(defn surv-on-blur [(e : Any)] : Unit (surv-release-all!))
(defn surv-on-visibility [(e : Any)] : Unit (when (js/get (doc) "hidden") (surv-release-all!)))

(defn surv-install! [] : Unit
  (when (not surv-listening)
    (do (set! surv-listening true)
        (let [w (win)]
          (do (js/call w "addEventListener" "keydown" (callback surv-on-keydown))
              (js/call w "addEventListener" "keyup" (callback surv-on-keyup))
              (js/call w "addEventListener" "blur" (callback surv-on-blur))
              (js/call (doc) "addEventListener" "visibilitychange" (callback surv-on-visibility))))
        (js/call surv-canvas "addEventListener" "pointerdown" (callback surv-canvas-down))
        (js/call surv-canvas "addEventListener" "pointermove" (callback surv-canvas-move))
        (js/call surv-canvas "addEventListener" "pointerup" (callback surv-canvas-up))
        (js/call surv-canvas "addEventListener" "pointercancel" (callback surv-canvas-up))
        (js/call surv-canvas "addEventListener" "contextmenu" (callback arc-no-menu))
        (js/call surv-canvas "addEventListener" "wheel" (callback surv-canvas-wheel) (js/obj "passive" false))
        (on! "sv-chat-form" "submit" (callback on-sv-chat-send))
        (on! "btn-sv-chat" "click" (callback on-sv-chat-toggle))
        (on! "btn-sv-gfd" "click" (callback on-sv-gfd-toggle))
        (on! "sv-actions" "click" (callback on-sv-gfd-btn))
        (on! "sv-compass" "click" (callback on-sv-gfd-btn))
        (on! "sv-here" "click" (callback on-gfd-here))
        (on! "btn-sv-sso" "click" (callback on-sv-sso))
        (on! "btn-sv-connect" "click" (callback on-sv-connect)))))
