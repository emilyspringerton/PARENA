;; stdlib/netkit/nk_oui_gen.prn -- builds the Netkit scanner's maker table (oui.bin). PARENA, wasm32, no imports, no malloc.
;; Its own small module (not part of netkit.wasm): run at BUILD time by scripts/build_netkit_oui.sh, whose host
;; (stdlib/netkit/tools/nk_oui_host.prn, PARENA -> TypeScript -> node) only reads a file into memory and writes the answer out.
;;
;; Founder, 2026-11-26: "ALL PARENA BASED MODS BASED DEVELOPMENT" -- so the decisions here (which IEEE blocks to keep, under which
;; maker name, and the exact bytes of oui.bin) are PARENA, replacing the first Python version (tools/netkit_oui_gen.py, deleted; this
;; module reproduces its output byte for byte, checked on the real registry before it was removed).
;;
;; Two jobs:
;;   nk-oui-curate(len)  Wireshark's `manuf` text (generated from the public IEEE registries) at IN -> the curated TSV at OUT:
;;                       "aa:bb:cc<TAB>Maker\n" for every 24-bit (MA-L) block whose registered name matches a brand rule below.
;;                       Run by hand when the registry is refreshed; its output is checked in (stdlib/netkit/data/oui_brands.tsv).
;;   nk-oui-pack(len)    that TSV at IN -> oui.bin at OUT (run by every page build, no network needed):
;;                       0 "NKOU"  4 n entries  8 m makers  12 name-table offset (16 + 4n)
;;                       16 n x u32 LE: prefix24 | maker << 24, ascending      then m x 24-byte NUL-padded names, sorted; maker 0 = "".
;; Both return the output length, or a negative error (nk-oui-gen-err-line says which input line): -1 malformed line, -2 not in
;; ascending prefix order, -3 maker name longer than 23 bytes, -4 more than 255 makers, -5 oui.bin would exceed 64 KB, -6 output full.
;;
;; Memory (16 MB fixed): 0x030000 G words | 0x040000 NAMES 256 x 32 B | 0x042000 MAP 256 x I32 | 0x100000 IN 8 MB |
;;                       0x900000 OUT 4 MB | 0xD00000 ENT 16384 x 8 B (prefix, unsorted name index)

(module netkit/oui_gen)

(defn g-base [] : I32 196608)
(defn names-base [] : I32 262144)
(defn map-base [] : I32 270336)
(defn in-base [] : I32 1048576)
(defn in-cap [] : I32 8388608)
(defn out-base [] : I32 9437184)
(defn out-cap [] : I32 4194304)
(defn ent-base [] : I32 13631488)
(defn ent-max [] : I32 16384)

(defn nk-oui-gen-in-addr [] : I32 (in-base))
(defn nk-oui-gen-in-cap [] : I32 (in-cap))
(defn nk-oui-gen-out-addr [] : I32 (out-base))

(defn gi [(k : I32)] : I32 (load32 (+ (g-base) (shl k 2))))
(defn gi! [(k : I32) (v : I32)] : Unit (store32! (+ (g-base) (shl k 2)) v))
(defn g-out [] : I32 0)          ; bytes written to OUT
(defn g-err-line [] : I32 1)
(defn g-nnames [] : I32 2)
(defn nk-oui-gen-err-line [] : I32 (gi (g-err-line)))

(defn ib [(i : I32)] : I32 (load8 (+ (in-base) i)))
(defn space? [(c : I32)] : Bool (or (= c 32) (or (and (>= c 9) (<= c 13)) false)))
(defn cstr-len [(s : I32)] : I32 (loop [k 0] (if (= (load8 (+ s k)) 0) k (recur (+ k 1)))))

;; ---- OUT -------------------------------------------------------------------------------------------------------------------------
(defn out8! [(v : I32)] : Unit
  (let [n (gi (g-out))]
    (when (< n (out-cap)) (store8! (+ (out-base) n) v) (gi! (g-out) (+ n 1)))))
(defn out-cstr! [(s : I32)] : Unit (dotimes [k (cstr-len s)] (out8! (load8 (+ s k)))))
(defn out-in! [(a : I32) (b : I32)] : Unit (loop [i a] (when (< i b) (out8! (ib i)) (recur (+ i 1)))))
(defn out-full? [] : Bool (>= (gi (g-out)) (out-cap)))

;; ---- text helpers over IN -------------------------------------------------------------------------------------------------------------
(defn line-end [(p : I32) (len : I32)] : I32 (loop [i p] (if (or (>= i len) (= (ib i) 10)) i (recur (+ i 1)))))
(defn find-tab [(p : I32) (e : I32)] : I32 (loop [i p] (if (>= i e) -1 (if (= (ib i) 9) i (recur (+ i 1))))))
(defn trim-start [(a : I32) (b : I32)] : I32 (loop [i a] (if (and (< i b) (space? (ib i))) (recur (+ i 1)) i)))
(defn trim-end [(a : I32) (b : I32)] : I32 (loop [i b] (if (and (> i a) (space? (ib (- i 1)))) (recur (- i 1)) i)))
(defn has-byte? [(a : I32) (b : I32) (c : I32)] : Bool (loop [i a] (if (>= i b) false (if (= (ib i) c) true (recur (+ i 1))))))
(defn lower-hex [(c : I32)] : I32 (if (and (>= c 65) (<= c 70)) (+ c 32) c))
(defn hexv [(c : I32)] : I32
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55)
        :else -1))
;; "aa:bb:cc" at p -> 24-bit value, or -1
(defn parse-prefix [(p : I32)] : I32
  (loop [k 0 v 0]
    (if (= k 3) v
        (let [h (hexv (ib (+ p (* k 3))))
              l (hexv (ib (+ p (+ (* k 3) 1))))
              sep (if (< k 2) (= (ib (+ p (+ (* k 3) 2))) 58) true)]
          (if (or (< h 0) (or (< l 0) (not sep))) -1
              (recur (+ k 1) (bit-or (shl v 8) (bit-or (shl h 4) l))))))))

;; does IN[a,b) match the pattern s (mode 0 starts with, 1 contains, 2 exactly)?
(defn match-at? [(a : I32) (b : I32) (s : I32) (sn : I32)] : Bool
  (and (<= (+ a sn) b)
       (loop [k 0] (if (= k sn) true (if (= (ib (+ a k)) (load8 (+ s k))) (recur (+ k 1)) false)))))
(defn rule-matches? [(k : I32) (a : I32) (b : I32)] : Bool
  (let [s (rule-text-addr k)
        sn (cstr-len s)
        mode (rule-mode k)]
    (cond (= mode 0) (match-at? a b s sn)
          (= mode 2) (and (= (- b a) sn) (match-at? a b s sn))
          :else (loop [p a] (if (> (+ p sn) b) false (if (match-at? p b s sn) true (recur (+ p 1))))))))
;; the first brand whose rule matches the registered name IN[a,b), or -1
(defn brand-of [(a : I32) (b : I32)] : I32
  (loop [k 0] (if (>= k (rule-count)) -1 (if (rule-matches? k a b) (rule-brand k) (recur (+ k 1))))))

;; ---- curate: manuf -> TSV ------------------------------------------------------------------------------------------------------------------
(defn nk-oui-curate [(len : I32)] : I32
  (do
    (gi! (g-out) 0) (gi! (g-err-line) 0)
    (out-cstr! (str-addr "# Netkit manufacturer table -- generated by PARENA stdlib/netkit/nk_oui_gen.prn (nk-oui-curate) from Wireshark's manuf (IEEE MA-L blocks).\n"))
    (out-cstr! (str-addr "# prefix<TAB>maker. Regenerate: scripts/build_netkit_oui.sh --curate <manuf> stdlib/netkit/data/oui_brands.tsv\n"))
    (loop [p 0 line 1 last -1]
      (if (>= p (min-i len (in-cap)))
          (if (out-full?) -6 (gi (g-out)))
          (let [e (line-end p len)
                t1 (find-tab p e)
                a0 (trim-start p (if (< t1 0) e t1))
                b0 (trim-end a0 (if (< t1 0) e t1))
                skip (or (= (ib p) 35) (or (= (trim-start p e) e) (or (< t1 0) (or (!= (- b0 a0) 8) (has-byte? a0 b0 47)))))]
            (if skip
                (recur (+ e 1) (+ line 1) last)
                (let [t2 (find-tab (+ t1 1) e)
                      fa (if (< t2 0) (+ t1 1) (+ t2 1))
                      fe (if (< t2 0) e (let [t3 (find-tab (+ t2 1) e)] (if (< t3 0) e t3)))
                      a (trim-start fa fe)
                      b (trim-end a fe)
                      v (parse-prefix a0)
                      br (brand-of a b)]
                  (cond
                    (< v 0) (do (gi! (g-err-line) line) -1)
                    (< br 0) (recur (+ e 1) (+ line 1) last)
                    (<= v last) (do (gi! (g-err-line) line) -2)
                    :else (do (dotimes [k 8] (out8! (lower-hex (ib (+ a0 k)))))
                              (out8! 9)
                              (out-cstr! (brand-name-addr br))
                              (out8! 10)
                              (recur (+ e 1) (+ line 1) v))))))))))

;; ---- pack: TSV -> oui.bin ---------------------------------------------------------------------------------------------------------------------
(defn name-addr [(i : I32)] : I32 (+ (names-base) (shl i 5)))
;; index of the maker name IN[a,b) in NAMES, adding it when new; -3 too long, -4 too many
(defn name-index [(a : I32) (b : I32)] : I32
  (let [n (gi (g-nnames))
        len (- b a)]
    (if (> len 23) -3
        (let [f (loop [i 0]
                  (if (>= i n) -1
                      (let [s (name-addr i)]
                        (if (and (= (cstr-len s) len) (loop [k 0] (if (= k len) true (if (= (load8 (+ s k)) (ib (+ a k))) (recur (+ k 1)) false))))
                            i (recur (+ i 1))))))]
          (cond (>= f 0) f
                (>= n 255) -4
                :else (let [s (name-addr n)]
                        (do (dotimes [k 32] (store8! (+ s k) (if (< k len) (ib (+ a k)) 0)))
                            (gi! (g-nnames) (+ n 1))
                            n)))))))

;; byte order of two NUL-terminated names (shorter first on a tie), as a sort key
(defn name-less? [(x : I32) (y : I32)] : Bool
  (loop [k 0]
    (let [c (load8 (+ x k)) d (load8 (+ y k))]
      (cond (!= c d) (< c d)
            (= c 0) false
            :else (recur (+ k 1))))))

(defn out32! [(v : I32)] : Unit (do (out8! (bit-and v 255)) (out8! (bit-and (ushr v 8) 255)) (out8! (bit-and (ushr v 16) 255)) (out8! (ushr v 24))))

(defn nk-oui-pack [(len : I32)] : I32
  (do
    (gi! (g-out) 0) (gi! (g-err-line) 0) (gi! (g-nnames) 0)
    (let [n (loop [p 0 line 1 cnt 0 last -1]
              (if (>= p (min-i len (in-cap))) cnt
                  (let [e (line-end p len)]
                    (if (or (= (ib p) 35) (= (trim-start p e) e))
                        (recur (+ e 1) (+ line 1) cnt last)
                        (let [t (find-tab p e)
                              v (if (= t (+ p 8)) (parse-prefix p) -1)
                              ni (if (< v 0) -1 (name-index (+ t 1) e))]
                          (cond (< v 0) (do (gi! (g-err-line) line) -1)
                                (< ni 0) (do (gi! (g-err-line) line) ni)
                                (<= v last) (do (gi! (g-err-line) line) -2)
                                (>= cnt (ent-max)) (do (gi! (g-err-line) line) -5)
                                :else (do (store32! (+ (ent-base) (shl cnt 3)) v)
                                          (store32! (+ (ent-base) (+ (shl cnt 3) 4)) ni)
                                          (recur (+ e 1) (+ line 1) (+ cnt 1) v))))))))
          m (gi (g-nnames))]
      (if (< n 0) n
          (if (> (+ 16 (+ (shl n 2) (* (+ m 1) 24))) 65536) -5
              (do
                ;; sort the names (insertion sort over an index list in MAP), then MAP[old] = new maker number (1-based)
                (let [ord (+ (map-base) 1024)]
                  (do (dotimes [i m] (store32! (+ ord (shl i 2)) i))
                      (loop [i 1]
                        (when (< i m)
                          (let [x (load32 (+ ord (shl i 2)))]
                            (do (loop [j (- i 1)]
                                  (if (and (>= j 0) (name-less? (name-addr x) (name-addr (load32 (+ ord (shl j 2))))))
                                      (do (store32! (+ ord (shl (+ j 1) 2)) (load32 (+ ord (shl j 2)))) (recur (- j 1)))
                                      (store32! (+ ord (shl (+ j 1) 2)) x)))
                                (recur (+ i 1))))))
                      (dotimes [r m] (store32! (+ (map-base) (shl (load32 (+ ord (shl r 2))) 2)) (+ r 1)))
                      (out8! 78) (out8! 75) (out8! 79) (out8! 85)               ; "NKOU"
                      (out32! n) (out32! (+ m 1)) (out32! (+ 16 (shl n 2)))
                      (dotimes [i n]
                        (out32! (bit-or (load32 (+ (ent-base) (shl i 3)))
                                        (shl (load32 (+ (map-base) (shl (load32 (+ (ent-base) (+ (shl i 3) 4))) 2))) 24))))
                      (dotimes [k 24] (out8! 0))                               ; maker 0: ""
                      (dotimes [r m]
                        (let [s (name-addr (load32 (+ ord (shl r 2))))]
                          (dotimes [k 24] (out8! (load8 (+ s k))))))
                      (gi (g-out))))))))))

(defn min-i [(a : I32) (b : I32)] : I32 (if (< a b) a b))

;; ---- the brand rules (transcribed from the first, Python version; edit here) ----------------------------------------------------------------
