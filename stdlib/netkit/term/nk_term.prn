;; stdlib/netkit/term/nk_term.prn -- the SHANKPIT Netkit SSH terminal: an xterm-style emulator in PARENA, compiled to wasm32.
;;
;; A fork of stdlib/gfd/term.prn (the GoblinFoxDragon web terminal), kept separate on purpose: the GFD terminal is a MUD
;; console -- its key handling does local line editing and history, which would corrupt a real shell session -- and it is
;; deployed on WOTAN, so it is not changed under it. What is reused as-is: the 8x16 bitmap font (gfd/term_font.prn), the
;; software renderer, the scrollback ring, selection/copy, the UTF-8 + CSI + SGR parser. What is new, because bash,
;; readline, ls --color, nano, less, htop and apt need it:
;;   * RAW keys: term-key turns a key into the exact xterm byte sequence (arrows, Home/End, PgUp/PgDn, Delete, F1..F12,
;;     Ctrl+letter, Alt+key as ESC-prefix, Shift+Tab, application-cursor-key mode) -- nothing is edited locally.
;;   * VT operations: insert/delete characters (ICH/DCH/ECH) and lines (IL/DL), scroll up/down (SU/SD), scroll regions
;;     (DECSTBM), reverse index / index / next line (ESC M/D/E), full reset (ESC c), the alternate screen (?1049/?47/?1047),
;;     autowrap (?7), cursor visibility (?25), application cursor keys (?1), bracketed paste (?2004, reported to the page),
;;     DEC line-drawing charset (ESC ( 0), and replies the server asks for (cursor position report, device attributes).
;; Not implemented (named): double-width glyphs, combining marks, characters outside ASCII + box drawing + blocks (shown as
;; a placeholder), mouse reporting, 132-column mode. The grid is fixed at 100 x 34; the SSH session asks for exactly that size.
;;
;; All state lives in wasm linear memory at fixed addresses (no globals in the v0 emitter); no imports, no allocator:
;;   0x020000 IN (64K)      bytes from the server; the page writes, then calls term-feed
;;   0x030000 OUT (4K)      bytes for the server: replies (cursor report...) after term-feed, key bytes after term-key
;;   0x031000 STATE         32-bit words, see below
;;   0x032000 FONT          255 glyphs x 16 rows
;;   0x040000 PALETTE       256 x 0x00BBGGRR
;;   0x100000 GRID          1500 lines x 100 cols x 12 bytes (glyph|flags<<16, fg, bg)
;;   0x300000 FRAMEBUFFER   800 x 544 RGBA
;;   0x4B0000 COPY          256K text buffer for term-copy
;;   0x4F0000 ALT           saved main screen while the alternate screen is up (34 x 100 x 12)
;; STATE: 0 col, 1 row, 2 top (abs line of screen row 0), 3 view (scrollback offset), 4 fg, 5 bg, 6 flags (1 bold, 2 underline,
;;   4 reverse), 7 parser (0 text, 1 esc, 2 csi, 3 osc, 4 skip one, 5 designate G0), 8 last-param-index, 9 private-marker,
;;   10 utf8-bytes-needed, 11 utf8-accumulator, 12 dirty, 13/14 saved col/row, 15 selection-on, 16/17 anchor (line,col),
;;   18/19 head (line,col), 24 dragging, 25 pending-wrap, 26 cursor shown, 27 region top, 28 region bottom, 29 autowrap,
;;   30 application cursor keys, 31 (spare), 32..47 CSI params, 48 alt screen active, 49/50 col,row saved by the alt screen,
;;   51 bracketed paste, 52 G0 is the DEC graphics set, 53 OUT length (replies this feed), 54 reserved.

(module netkit/term)
(export term-init term-feed term-key term-render term-mouse term-scroll term-copy)

;; ---- geometry & memory map --------------------------------------------------------------
(defn cols [] : I32 100)
(defn rows [] : I32 34)
(defn nlines [] : I32 1500)
(defn in-base [] : I32 131072)
(defn out-base [] : I32 196608)
(defn st-base [] : I32 200704)
(defn font-base [] : I32 204800)
(defn pal-base [] : I32 262144)
(defn grid-base [] : I32 1048576)
(defn fb-base [] : I32 3145728)
(defn copy-base [] : I32 4915200)
(defn alt-base [] : I32 5177344)

;; theme (0x00BBGGRR)
(defn def-fg [] : I32 15918054)
(defn def-bg [] : I32 1510157)
(defn sel-color [] : I32 7024443)
(defn cursor-color [] : I32 4965104)

;; public: where JS finds things
(defn term-in-addr [] : I32 (in-base))
(defn term-out-addr [] : I32 (out-base))
(defn term-copy-addr [] : I32 (copy-base))
(defn term-fb-addr [] : I32 (fb-base))
(defn term-fb-w [] : I32 800)
(defn term-fb-h [] : I32 544)
(defn term-cols [] : I32 (cols))
(defn term-rows [] : I32 (rows))

;; ---- small helpers ----------------------------------------------------------------------
(defn min-i [(a : I32) (b : I32)] : I32 (if (< a b) a b))
(defn max-i [(a : I32) (b : I32)] : I32 (if (> a b) a b))
(defn clamp-i [(x : I32) (lo : I32) (hi : I32)] : I32 (max-i lo (min-i x hi)))

(defn st [(i : I32)] : I32 (load32 (+ (st-base) (shl i 2))))
(defn set-st [(i : I32) (v : I32)] : Unit (store32! (+ (st-base) (shl i 2)) v))

(defn col [] : I32 (st 0))
(defn row [] : I32 (st 1))
(defn top [] : I32 (st 2))
(defn view [] : I32 (st 3))
(defn set-col [(v : I32)] : Unit (set-st 0 v))
(defn set-row [(v : I32)] : Unit (set-st 1 v))
(defn set-top [(v : I32)] : Unit (set-st 2 v))
(defn set-view [(v : I32)] : Unit (set-st 3 v))
(defn dirty [] : Unit (set-st 12 1))

(defn max-view [] : I32 (min-i (top) (- (nlines) (+ (rows) 2))))

;; replies for the server go to OUT (after term-feed the page reads term-out-len)
(defn reply! [(b : I32)] : Unit
  (let [n (st 53)] (when (< n 4000) (store8! (+ (out-base) n) b) (set-st 53 (+ n 1)))))
(defn reply-num! [(v : I32)] : Unit
  (do (when (>= v 100) (reply! (+ 48 (/ v 100))))
      (when (>= v 10) (reply! (+ 48 (mod (/ v 10) 10))))
      (reply! (+ 48 (mod v 10)))))

;; ---- font + palette init ----------------------------------------------------------------
(defn nibble [(c : I32)] : I32 (if (>= c 97) (- c 87) (- c 48)))

(defn load-font [] : Unit
  (let [s (str-addr (font-hex))]
    (loop [i 0]
      (when (< i 4080)
        (store8! (+ (font-base) i)
                 (bit-or (shl (nibble (load8 (+ s (shl i 1)))) 4)
                         (nibble (load8 (+ s (+ (shl i 1) 1))))))
        (recur (+ i 1))))))

(defn cube-level [(x : I32)] : I32 (if (= x 0) 0 (+ 55 (* x 40))))

(defn set-pal [(n : I32) (c : I32)] : Unit (store32! (+ (pal-base) (shl n 2)) c))
(defn pal [(n : I32)] : I32 (load32 (+ (pal-base) (shl (bit-and n 255) 2))))

(defn load-palette [] : Unit
  (do
    (set-pal 0 2365979) (set-pal 1 4936677) (set-pal 2 5942103) (set-pal 3 2527430)
    (set-pal 4 16096083) (set-pal 5 15762352) (set-pal 6 13616441) (set-pal 7 15063501)
    (set-pal 8 6839636) (set-pal 9 9081855) (set-pal 10 7193707) (set-pal 11 4172506)
    (set-pal 12 16758380) (set-pal 13 16498140) (set-pal 14 14537814) (set-pal 15 16447477)
    (loop [n 16]
      (when (< n 232)
        (let [i (- n 16)
              r (cube-level (/ i 36))
              g (cube-level (mod (/ i 6) 6))
              b (cube-level (mod i 6))]
          (set-pal n (bit-or r (bit-or (shl g 8) (shl b 16)))))
        (recur (+ n 1))))
    (loop [n 232]
      (when (< n 256)
        (let [v (+ 8 (* 10 (- n 232)))]
          (set-pal n (bit-or v (bit-or (shl v 8) (shl v 16)))))
        (recur (+ n 1))))))

;; ---- grid cells -------------------------------------------------------------------------
(defn cell-addr [(abs : I32) (c : I32)] : I32
  (+ (grid-base) (* (+ (* (mod abs (nlines)) (cols)) c) 12)))

(defn put-cell [(abs : I32) (c : I32) (g : I32) (fl : I32) (fg : I32) (bg : I32)] : Unit
  (let [a (cell-addr abs c)]
    (store32! a (bit-or g (shl fl 16)))
    (store32! (+ a 4) fg)
    (store32! (+ a 8) bg)))

(defn blank-range [(abs : I32) (from : I32) (to : I32)] : Unit
  (loop [c from]
    (when (< c to)
      (put-cell abs c 0 0 (st 4) (st 5))
      (recur (+ c 1)))))

(defn clear-all [] : Unit
  (loop [l 0]
    (when (< l (nlines))
      (loop [c 0]
        (when (< c (cols))
          (put-cell l c 0 0 (def-fg) (def-bg))
          (recur (+ c 1))))
      (recur (+ l 1)))))

(defn copy-cell! [(dst : I32) (src : I32)] : Unit
  (do (store32! dst (load32 src)) (store32! (+ dst 4) (load32 (+ src 4))) (store32! (+ dst 8) (load32 (+ src 8)))))

;; copy one whole screen line (absolute line numbers)
(defn copy-row! [(dst-abs : I32) (src-abs : I32)] : Unit
  (loop [c 0]
    (when (< c (cols))
      (copy-cell! (cell-addr dst-abs c) (cell-addr src-abs c))
      (recur (+ c 1)))))

;; ---- scrolling: the region, with scrollback only for the full-height main screen ----------
(defn region-full [] : Bool (and (= (st 27) 0) (= (st 28) (- (rows) 1))))

;; one line up inside the region
(defn scroll-up-1! [] : Unit
  (if (and (region-full) (= (st 48) 0))
      (do (set-top (+ (top) 1))
          (when (> (view) 0) (set-view (min-i (+ (view) 1) (max-view))))
          (blank-range (+ (top) (- (rows) 1)) 0 (cols)))
      (do (loop [r (st 27)]
            (when (< r (st 28))
              (copy-row! (+ (top) r) (+ (top) (+ r 1)))
              (recur (+ r 1))))
          (blank-range (+ (top) (st 28)) 0 (cols)))))

;; one line down inside the region
(defn scroll-down-1! [] : Unit
  (do (loop [r (st 28)]
        (when (> r (st 27))
          (copy-row! (+ (top) r) (+ (top) (- r 1)))
          (recur (- r 1))))
      (blank-range (+ (top) (st 27)) 0 (cols))))

(defn line-feed [] : Unit
  (do
    (set-st 25 0)
    (if (= (row) (st 28))
        (scroll-up-1!)
        (when (< (row) (- (rows) 1)) (set-row (+ (row) 1))))
    (dirty)))

(defn reverse-index [] : Unit
  (do (set-st 25 0)
      (if (= (row) (st 27))
          (scroll-down-1!)
          (when (> (row) 0) (set-row (- (row) 1))))
      (dirty)))

;; ---- glyphs -----------------------------------------------------------------------------
(defn glyph-for [(cp : I32)] : I32
  (if (and (>= cp 32) (<= cp 126)) (- cp 32)
    (if (and (>= cp 9472) (<= cp 9599)) (+ 95 (- cp 9472))
      (if (and (>= cp 9600) (<= cp 9631)) (+ 223 (- cp 9600))
        (if (= cp 160) 0 31)))))

;; DEC special graphics (ESC ( 0): the line-drawing subset of 0x5f..0x7e as Unicode box / block characters
(defn dec-graphics [(b : I32)] : I32
  (case b
    106 9496    ; j  lower right corner
    107 9488    ; k  upper right
    108 9484    ; l  upper left
    109 9492    ; m  lower left
    110 9532    ; n  crossing
    113 9472    ; q  horizontal line
    116 9500    ; t  left tee
    117 9508    ; u  right tee
    118 9524    ; v  bottom tee
    119 9516    ; w  top tee
    120 9474    ; x  vertical line
    97 9618     ; a  checkerboard
    96 9670     ; `  diamond (no glyph: placeholder)
    102 176     ; f  degree
    103 177     ; g  plus/minus
    b))

(defn put-glyph [(g : I32)] : Unit
  (do
    (when (and (= (st 25) 1) (= (st 29) 1))
      (set-col 0)
      (line-feed))
    (put-cell (+ (top) (row)) (col) g (st 6) (st 4) (st 5))
    (if (< (col) (- (cols) 1))
        (set-col (+ (col) 1))
        (when (= (st 29) 1) (set-st 25 1)))
    (dirty)))

;; ---- parser: text / UTF-8 / controls ----------------------------------------------------
(defn control [(b : I32)] : Unit
  (do
    (when (or (= b 10) (or (= b 11) (= b 12))) (line-feed))
    (when (= b 13) (set-col 0) (set-st 25 0))
    (when (= b 8)
      (when (> (col) 0) (set-col (- (col) 1)))
      (set-st 25 0))
    (when (= b 9)
      (set-col (min-i (- (cols) 1) (* (+ (/ (col) 8) 1) 8)))
      (set-st 25 0))
    (when (= b 27) (set-st 7 1))
    (dirty)))

(defn utf-lead [(b : I32)] : Unit
  (if (and (>= b 192) (< b 224))
      (do (set-st 10 1) (set-st 11 (bit-and b 31)))
      (if (and (>= b 224) (< b 240))
          (do (set-st 10 2) (set-st 11 (bit-and b 15)))
          (if (and (>= b 240) (< b 248))
              (do (set-st 10 3) (set-st 11 (bit-and b 7)))
              (put-glyph 31)))))

(defn normal-byte [(b : I32)] : Unit
  (if (> (st 10) 0)
      (utf-cont b)
      (if (< b 32)
          (control b)
          (if (< b 128)
              (put-glyph (glyph-for (if (and (= (st 52) 1) (>= b 96)) (dec-graphics b) b)))
              (utf-lead b)))))

(defn utf-cont [(b : I32)] : Unit
  (if (= (bit-and b 192) 128)
      (do
        (set-st 11 (bit-or (shl (st 11) 6) (bit-and b 63)))
        (set-st 10 (- (st 10) 1))
        (when (= (st 10) 0) (put-glyph (glyph-for (st 11)))))
      (do
        (set-st 10 0)
        (normal-byte b))))

;; ---- parser: ESC / CSI / OSC ------------------------------------------------------------
(defn param [(i : I32)] : I32 (st (+ 32 (bit-and i 15))))
(defn set-param [(i : I32) (v : I32)] : Unit (set-st (+ 32 (bit-and i 15)) v))
(defn pd [(i : I32) (d : I32)] : I32 (if (= (param i) 0) d (param i)))

(defn csi-start [] : Unit
  (do
    (set-st 8 0)
    (set-st 9 0)
    (loop [i 0]
      (when (< i 16)
        (set-param i 0)
        (recur (+ i 1))))
    (set-st 7 2)))

(defn reset-attrs [] : Unit
  (do (set-st 4 (def-fg)) (set-st 5 (def-bg)) (set-st 6 0)))

(defn move-cursor [(r : I32) (c : I32)] : Unit
  (do
    (set-row (clamp-i r 0 (- (rows) 1)))
    (set-col (clamp-i c 0 (- (cols) 1)))
    (set-st 25 0)))

;; full reset (ESC c)
(defn term-reset! [] : Unit
  (do (reset-attrs) (set-st 27 0) (set-st 28 (- (rows) 1)) (set-st 29 1) (set-st 30 0) (set-st 48 0)
      (set-st 51 0) (set-st 52 0) (set-st 25 0) (set-st 26 1) (set-st 13 0) (set-st 14 0) (set-st 7 0) (set-st 10 0)
      (loop [l 0] (when (< l (rows)) (blank-range (+ (top) l) 0 (cols)) (recur (+ l 1))))
      (set-col 0) (set-row 0) (dirty)))

(defn esc-byte [(b : I32)] : Unit
  (do
    (set-st 7 0)
    (when (= b 91) (csi-start))
    (when (= b 93) (set-st 7 3))
    (when (= b 40) (set-st 7 5))                                   ; designate G0: the next byte picks the set
    (when (or (= b 41) (or (= b 42) (= b 43))) (set-st 7 4))
    (when (= b 55) (set-st 13 (col)) (set-st 14 (row)))
    (when (= b 56) (move-cursor (st 14) (st 13)))
    (when (= b 77) (reverse-index))                                 ; RI
    (when (= b 68) (line-feed))                                     ; IND
    (when (= b 69) (do (set-col 0) (line-feed)))                    ; NEL
    (when (= b 99) (term-reset!))))                                 ; RIS

(defn osc-byte [(b : I32)] : Unit
  (when (or (= b 7) (= b 27))
    (set-st 7 (if (= b 27) 4 0))))

;; ---- editing operations -----------------------------------------------------------------------
(defn erase-display [(mode : I32)] : Unit
  (do
    (when (= mode 0)
      (blank-range (+ (top) (row)) (col) (cols))
      (loop [r (+ (row) 1)]
        (when (< r (rows))
          (blank-range (+ (top) r) 0 (cols))
          (recur (+ r 1)))))
    (when (= mode 1)
      (blank-range (+ (top) (row)) 0 (+ (col) 1))
      (loop [r 0]
        (when (< r (row))
          (blank-range (+ (top) r) 0 (cols))
          (recur (+ r 1)))))
    (when (> mode 1)
      (loop [r 0]
        (when (< r (rows))
          (blank-range (+ (top) r) 0 (cols))
          (recur (+ r 1)))))
    (dirty)))

(defn erase-line [(mode : I32)] : Unit
  (do
    (when (= mode 0) (blank-range (+ (top) (row)) (col) (cols)))
    (when (= mode 1) (blank-range (+ (top) (row)) 0 (+ (col) 1)))
    (when (= mode 2) (blank-range (+ (top) (row)) 0 (cols)))
    (dirty)))

;; ICH: insert n blank cells at the cursor, pushing the rest of the line right (what falls off the end is lost)
(defn insert-chars [(n0 : I32)] : Unit
  (let [n (min-i n0 (- (cols) (col)))
        abs (+ (top) (row))]
    (do (loop [c (- (cols) 1)]
          (when (>= c (+ (col) n))
            (copy-cell! (cell-addr abs c) (cell-addr abs (- c n)))
            (recur (- c 1))))
        (blank-range abs (col) (+ (col) n))
        (dirty))))

;; DCH: delete n cells at the cursor, pulling the rest of the line left
(defn delete-chars [(n0 : I32)] : Unit
  (let [n (min-i n0 (- (cols) (col)))
        abs (+ (top) (row))]
    (do (loop [c (col)]
          (when (< c (- (cols) n))
            (copy-cell! (cell-addr abs c) (cell-addr abs (+ c n)))
            (recur (+ c 1))))
        (blank-range abs (- (cols) n) (cols))
        (dirty))))

(defn erase-chars [(n : I32)] : Unit
  (do (blank-range (+ (top) (row)) (col) (min-i (cols) (+ (col) n))) (dirty)))

;; IL / DL act only when the cursor is inside the scroll region
(defn in-region [] : Bool (and (>= (row) (st 27)) (<= (row) (st 28))))

(defn insert-lines [(n0 : I32)] : Unit
  (when (in-region)
    (let [n (min-i n0 (+ (- (st 28) (row)) 1))]
      (do (loop [r (st 28)]
            (when (>= r (+ (row) n))
              (copy-row! (+ (top) r) (+ (top) (- r n)))
              (recur (- r 1))))
          (loop [r (row)]
            (when (< r (+ (row) n)) (blank-range (+ (top) r) 0 (cols)) (recur (+ r 1))))
          (set-col 0) (set-st 25 0) (dirty)))))

(defn delete-lines [(n0 : I32)] : Unit
  (when (in-region)
    (let [n (min-i n0 (+ (- (st 28) (row)) 1))]
      (do (loop [r (row)]
            (when (<= r (- (st 28) n))
              (copy-row! (+ (top) r) (+ (top) (+ r n)))
              (recur (+ r 1))))
          (loop [r (+ (- (st 28) n) 1)]
            (when (<= r (st 28)) (blank-range (+ (top) r) 0 (cols)) (recur (+ r 1))))
          (set-col 0) (set-st 25 0) (dirty)))))

(defn scroll-up-n! [(n : I32)] : Unit
  (do (loop [i 0] (when (< i n) (scroll-up-1!) (recur (+ i 1)))) (dirty)))
(defn scroll-down-n! [(n : I32)] : Unit
  (do (loop [i 0] (when (< i n) (scroll-down-1!) (recur (+ i 1)))) (dirty)))

;; ---- the alternate screen ----------------------------------------------------------------------
(defn enter-alt! [] : Unit
  (when (= (st 48) 0)
    (do (loop [r 0]
          (when (< r (rows))
            (loop [c 0]
              (when (< c (cols))
                (copy-cell! (+ (alt-base) (* (+ (* r (cols)) c) 12)) (cell-addr (+ (top) r) c))
                (recur (+ c 1))))
            (recur (+ r 1))))
        (set-st 49 (col)) (set-st 50 (row))
        (set-st 48 1)
        (set-st 27 0) (set-st 28 (- (rows) 1))
        (loop [r 0] (when (< r (rows)) (blank-range (+ (top) r) 0 (cols)) (recur (+ r 1))))
        (set-col 0) (set-row 0) (set-st 25 0) (dirty))))

(defn leave-alt! [] : Unit
  (when (= (st 48) 1)
    (do (loop [r 0]
          (when (< r (rows))
            (loop [c 0]
              (when (< c (cols))
                (copy-cell! (cell-addr (+ (top) r) c) (+ (alt-base) (* (+ (* r (cols)) c) 12)))
                (recur (+ c 1))))
            (recur (+ r 1))))
        (set-st 48 0)
        (set-st 27 0) (set-st 28 (- (rows) 1))
        (move-cursor (st 50) (st 49)) (dirty))))

;; ---- modes (CSI ? n h / l) ---------------------------------------------------------------------
(defn set-mode [(n : I32) (on : I32)] : Unit
  (do
    (when (= n 1) (set-st 30 on))
    (when (= n 7) (do (set-st 29 on) (when (= on 0) (set-st 25 0))))
    (when (= n 25) (set-st 26 on))
    (when (= n 2004) (set-st 51 on))
    (when (or (= n 47) (or (= n 1047) (= n 1049)))
      (if (= on 1) (enter-alt!) (leave-alt!)))))

(defn modes [(on : I32)] : Unit
  (loop [i 0]
    (when (<= i (st 8))
      (do (set-mode (param i) on) (recur (+ i 1))))))

;; ---- SGR ---------------------------------------------------------------------------------------
(defn extended-color [(n : I32) (i : I32)] : I32
  (let [mode (param (+ i 1))
        c5 (pal (param (+ i 2)))
        c2 (bit-or (bit-and (param (+ i 2)) 255)
                   (bit-or (shl (bit-and (param (+ i 3)) 255) 8)
                           (shl (bit-and (param (+ i 4)) 255) 16)))]
    (if (= mode 5)
        (do (set-st (if (= n 38) 4 5) c5) (+ i 3))
        (if (= mode 2)
            (do (set-st (if (= n 38) 4 5) c2) (+ i 5))
            (+ i 1)))))

(defn sgr-one [(i : I32)] : I32
  (let [n (param i)]
    (if (= n 0) (do (reset-attrs) (+ i 1))
    (if (= n 1) (do (set-st 6 (bit-or (st 6) 1)) (+ i 1))
    (if (= n 4) (do (set-st 6 (bit-or (st 6) 2)) (+ i 1))
    (if (= n 7) (do (set-st 6 (bit-or (st 6) 4)) (+ i 1))
    (if (= n 22) (do (set-st 6 (bit-and (st 6) 6)) (+ i 1))
    (if (= n 24) (do (set-st 6 (bit-and (st 6) 5)) (+ i 1))
    (if (= n 27) (do (set-st 6 (bit-and (st 6) 3)) (+ i 1))
    (if (and (>= n 30) (<= n 37)) (do (set-st 4 (pal (- n 30))) (+ i 1))
    (if (= n 39) (do (set-st 4 (def-fg)) (+ i 1))
    (if (and (>= n 40) (<= n 47)) (do (set-st 5 (pal (- n 40))) (+ i 1))
    (if (= n 49) (do (set-st 5 (def-bg)) (+ i 1))
    (if (and (>= n 90) (<= n 97)) (do (set-st 4 (pal (+ 8 (- n 90)))) (+ i 1))
    (if (and (>= n 100) (<= n 107)) (do (set-st 5 (pal (+ 8 (- n 100)))) (+ i 1))
    (if (or (= n 38) (= n 48)) (extended-color n i)
        (+ i 1)))))))))))))))))

(defn sgr [] : Unit
  (loop [i 0]
    (when (<= i (st 8))
      (recur (sgr-one i)))))

;; ---- CSI dispatch ------------------------------------------------------------------------------
(defn csi-final [(b : I32)] : Unit
  (do
    (when (and (= (st 9) 0) (= b 65)) (move-cursor (- (row) (pd 0 1)) (col)))
    (when (and (= (st 9) 0) (= b 66)) (move-cursor (+ (row) (pd 0 1)) (col)))
    (when (and (= (st 9) 0) (= b 67)) (move-cursor (row) (+ (col) (pd 0 1))))
    (when (and (= (st 9) 0) (= b 68)) (move-cursor (row) (- (col) (pd 0 1))))
    (when (and (= (st 9) 0) (= b 69)) (move-cursor (+ (row) (pd 0 1)) 0))          ; CNL
    (when (and (= (st 9) 0) (= b 70)) (move-cursor (- (row) (pd 0 1)) 0))          ; CPL
    (when (and (= (st 9) 0) (or (= b 71) (= b 96))) (move-cursor (row) (- (pd 0 1) 1)))   ; CHA / HPA
    (when (and (= (st 9) 0) (= b 100)) (move-cursor (- (pd 0 1) 1) (col)))         ; VPA
    (when (and (= (st 9) 0) (or (= b 72) (= b 102))) (move-cursor (- (pd 0 1) 1) (- (pd 1 1) 1)))
    (when (and (= (st 9) 0) (= b 74)) (erase-display (param 0)))
    (when (and (= (st 9) 0) (= b 75)) (erase-line (param 0)))
    (when (and (= (st 9) 0) (= b 64)) (insert-chars (pd 0 1)))                      ; ICH
    (when (and (= (st 9) 0) (= b 80)) (delete-chars (pd 0 1)))                      ; DCH
    (when (and (= (st 9) 0) (= b 88)) (erase-chars (pd 0 1)))                       ; ECH
    (when (and (= (st 9) 0) (= b 76)) (insert-lines (pd 0 1)))                      ; IL
    (when (and (= (st 9) 0) (= b 77)) (delete-lines (pd 0 1)))                      ; DL
    (when (and (= (st 9) 0) (= b 83)) (scroll-up-n! (pd 0 1)))                      ; SU
    (when (and (= (st 9) 0) (= b 84)) (scroll-down-n! (pd 0 1)))                    ; SD
    (when (and (= (st 9) 0) (= b 114))                                              ; DECSTBM
      (let [t (- (pd 0 1) 1) bt (- (pd 1 (rows)) 1)]
        (when (and (>= t 0) (and (< bt (rows)) (< t bt)))
          (do (set-st 27 t) (set-st 28 bt) (move-cursor 0 0)))))
    (when (and (= (st 9) 0) (= b 109)) (sgr))
    (when (and (= (st 9) 0) (= b 115)) (set-st 13 (col)) (set-st 14 (row)))
    (when (and (= (st 9) 0) (= b 117)) (move-cursor (st 14) (st 13)))
    (when (= b 104) (modes 1))                                                       ; h  (private modes only)
    (when (= b 108) (modes 0))                                                       ; l
    (when (and (= (st 9) 0) (= b 110))                                               ; DSR
      (do (when (= (param 0) 6)
            (do (reply! 27) (reply! 91) (reply-num! (+ (row) 1)) (reply! 59) (reply-num! (+ (col) 1)) (reply! 82)))
          (when (= (param 0) 5) (do (reply! 27) (reply! 91) (reply! 48) (reply! 110)))))
    (when (and (= (st 9) 0) (and (= b 99) (= (param 0) 0)))                          ; DA: a VT100 with AVO
      (do (reply! 27) (reply! 91) (reply! 63) (reply! 49) (reply! 59) (reply! 50) (reply! 99)))
    (dirty)))

(defn csi-byte [(b : I32)] : Unit
  (if (and (>= b 48) (<= b 57))
      (set-param (st 8) (+ (* (param (st 8)) 10) (- b 48)))
      (if (= b 59)
          (do (set-st 8 (min-i (+ (st 8) 1) 15)) (set-param (st 8) 0))
          (if (and (>= b 60) (<= b 63))
              (set-st 9 1)
              (if (and (>= b 64) (<= b 126))
                  (do (set-st 7 0) (csi-final b))
                  unit)))))

(defn feed-byte [(b : I32)] : Unit
  (let [ps (st 7)]
    (if (= ps 0) (normal-byte b)
      (if (= ps 1) (esc-byte b)
        (if (= ps 2) (csi-byte b)
          (if (= ps 3) (osc-byte b)
            (if (= ps 5) (do (set-st 52 (if (= b 48) 1 0)) (set-st 7 0))
                (set-st 7 0))))))))

;; Feed n bytes the page wrote at IN. Returns the number of reply bytes now waiting at OUT (cursor reports etc).
(defn term-feed [(n : I32)] : I32
  (do
    (set-st 53 0)
    (loop [i 0]
      (when (< i n)
        (feed-byte (load8 (+ (in-base) i)))
        (recur (+ i 1))))
    (dirty)
    (st 53)))

;; ---- view / selection -------------------------------------------------------------------
(defn term-scroll [(delta : I32)] : Unit
  (do (set-view (clamp-i (+ (view) delta) 0 (max-view))) (dirty)))

(defn is-selected [(abs : I32) (c : I32)] : Bool
  (if (= (st 15) 0)
      false
      (let [k (+ (* abs 100) c)
            ka (+ (* (st 16) 100) (st 17))
            kh (+ (* (st 18) 100) (st 19))]
        (and (>= k (min-i ka kh)) (<= k (max-i ka kh))))))

(defn cell-glyph [(abs : I32) (c : I32)] : I32
  (bit-and (load32 (cell-addr abs c)) 65535))

(defn term-mouse [(kind : I32) (c0 : I32) (r0 : I32)] : Unit
  (let [c (clamp-i c0 0 (- (cols) 1))
        r (clamp-i r0 0 (- (rows) 1))
        abs (+ (- (top) (view)) r)]
    (do
      (when (= kind 0)
        (set-st 16 abs) (set-st 17 c) (set-st 18 abs) (set-st 19 c)
        (set-st 15 0) (set-st 24 1))
      (when (and (= kind 1) (= (st 24) 1))
        (set-st 18 abs) (set-st 19 c) (set-st 15 1))
      (when (= kind 2) (set-st 24 0))
      (when (= kind 3)
        (set-st 15 1) (set-st 16 abs) (set-st 18 abs)
        (set-st 17 (word-edge abs c (- 0 1)))
        (set-st 19 (word-edge abs c 1)))
      (when (= kind 4) (set-st 15 0))
      (dirty))))

;; Walk from c in direction dir while cells are non-blank; returns the last non-blank column.
(defn word-edge [(abs : I32) (c : I32) (dir : I32)] : I32
  (loop [x c]
    (let [nx (+ x dir)]
      (if (or (< nx 0) (or (>= nx (cols)) (= (cell-glyph abs nx) 0)))
          x
          (recur nx)))))

;; ---- copy -------------------------------------------------------------------------------
(defn wbyte [(base : I32) (n : I32) (b : I32)] : I32
  (do (store8! (+ base n) b) (+ n 1)))

(defn wutf8 [(base : I32) (n : I32) (cp : I32)] : I32
  (if (< cp 128)
      (wbyte base n cp)
      (if (< cp 2048)
          (wbyte base (wbyte base n (bit-or 192 (shr cp 6))) (bit-or 128 (bit-and cp 63)))
          (if (< cp 65536)
              (wbyte base
                     (wbyte base (wbyte base n (bit-or 224 (shr cp 12)))
                            (bit-or 128 (bit-and (shr cp 6) 63)))
                     (bit-or 128 (bit-and cp 63)))
              (wbyte base
                     (wbyte base
                            (wbyte base (wbyte base n (bit-or 240 (shr cp 18)))
                                   (bit-or 128 (bit-and (shr cp 12) 63)))
                            (bit-or 128 (bit-and (shr cp 6) 63)))
                     (bit-or 128 (bit-and cp 63)))))))

(defn glyph-cp [(g : I32)] : I32
  (if (< g 95) (+ g 32)
    (if (< g 223) (+ 9472 (- g 95))
      (+ 9600 (- g 223)))))

(defn last-nonblank [(abs : I32) (from : I32) (to : I32)] : I32
  (loop [c to]
    (if (< c from)
        (- from 1)
        (if (= (cell-glyph abs c) 0)
            (recur (- c 1))
            c))))

(defn copy-line [(abs : I32) (from : I32) (to : I32) (last : Bool) (n : I32)] : I32
  (let [end (last-nonblank abs from to)
        n2 (loop [c from n n]
             (if (> c end)
                 n
                 (recur (+ c 1) (wutf8 (copy-base) n (glyph-cp (cell-glyph abs c))))))]
    (if last n2 (wbyte (copy-base) n2 10))))

(defn term-copy [] : I32
  (if (= (st 15) 0)
      0
      (let [ka (+ (* (st 16) 100) (st 17))
            kh (+ (* (st 18) 100) (st 19))
            fwd (<= ka kh)
            l1 (if fwd (st 16) (st 18))
            c1 (if fwd (st 17) (st 19))
            l2 (if fwd (st 18) (st 16))
            c2 (if fwd (st 19) (st 17))]
        (loop [l l1 n 0]
          (if (or (> l l2) (> n 250000))
              n
              (recur (+ l 1)
                     (copy-line l
                                (if (= l l1) c1 0)
                                (if (= l l2) c2 (- (cols) 1))
                                (= l l2)
                                n)))))))

;; ---- keys: the exact xterm byte sequences -----------------------------------------------------------------------------
;; Key codes: Unicode scalar values below 0x110000 are characters; specials above it (the page maps DOM keys):
;;   ENTER 1114113  BACKSPACE 1114114  UP 1114115  DOWN 1114116  PGUP 1114117  PGDN 1114118  TAB 1114119  ESC 1114120
;;   LEFT 1114121   RIGHT 1114122      HOME 1114123  END 1114124   DELETE 1114125  INSERT 1114126
;;   F1..F12 = 1114127 + (n - 1)
;; mods: 1 ctrl, 2 alt, 4 shift. term-key returns how many bytes to send from OUT (0 = nothing).
(defn key-mod-param [(mods : I32)] : I32
  (+ 1 (+ (if (= (bit-and mods 4) 4) 1 0) (+ (if (= (bit-and mods 2) 2) 2 0) (if (= (bit-and mods 1) 1) 4 0)))))

(defn out! [(n : I32) (b : I32)] : I32 (do (store8! (+ (out-base) n) b) (+ n 1)))

;; ESC [ <final>   or   ESC O <final> (application mode)   or   ESC [ 1 ; m <final> with modifiers
(defn key-cursor [(final : I32) (mods : I32)] : I32
  (if (> (bit-and mods 7) 0)
      (out! (out! (out! (out! (out! (out! 0 27) 91) 49) 59) (+ 48 (key-mod-param mods))) final)
      (if (= (st 30) 1)
          (out! (out! (out! 0 27) 79) final)
          (out! (out! (out! 0 27) 91) final))))

;; ESC [ <number> ~
(defn key-tilde [(num : I32) (mods : I32)] : I32
  (let [n0 (out! (out! 0 27) 91)
        n1 (if (>= num 10) (out! (out! n0 (+ 48 (/ num 10))) (+ 48 (mod num 10))) (out! n0 (+ 48 num)))
        n2 (if (> (bit-and mods 7) 0) (out! (out! n1 59) (+ 48 (key-mod-param mods))) n1)]
    (out! n2 126)))

(defn key-fn [(n : I32) (mods : I32)] : I32
  (if (<= n 4)
      (out! (out! (out! 0 27) 79) (+ 79 n))              ; F1..F4 = ESC O P/Q/R/S
      (key-tilde (case n 5 15 6 17 7 18 8 19 9 20 10 21 11 23 24) mods)))

;; a typed character (Unicode scalar): Ctrl makes control codes, Alt prefixes ESC
(defn key-text [(code : I32) (mods : I32)] : I32
  (let [alt (= (bit-and mods 2) 2)
        ctrl (= (bit-and mods 1) 1)
        n0 (if alt (out! 0 27) 0)]
    (if (and ctrl (and (>= (bit-and code 95) 64) (<= (bit-and code 95) 95)))
        (out! n0 (bit-and code 31))                      ; Ctrl+@ A-Z [ \ ] ^ _  (also lower case)
        (if (and ctrl (= code 32)) (out! n0 0)
            (if (and ctrl (= code 63)) (out! n0 127)
                (wutf8 (out-base) n0 code))))))

(defn term-key [(code : I32) (mods : I32)] : I32
  (if (and (= code 1114117) (= (bit-and mods 4) 4))
      (do (term-scroll (- (rows) 2)) 0)                  ; Shift+PgUp / Shift+PgDn scroll the local history
      (if (and (= code 1114118) (= (bit-and mods 4) 4))
          (do (term-scroll (- 2 (rows))) 0)
          (do (set-view 0) (dirty)
              (cond
                (= code 1114113) (out! 0 13)
                (= code 1114114) (out! 0 127)
                (= code 1114119) (if (= (bit-and mods 4) 4) (out! (out! (out! 0 27) 91) 90) (out! 0 9))
                (= code 1114120) (out! 0 27)
                (= code 1114115) (key-cursor 65 mods)
                (= code 1114116) (key-cursor 66 mods)
                (= code 1114122) (key-cursor 67 mods)
                (= code 1114121) (key-cursor 68 mods)
                (= code 1114123) (key-cursor 72 mods)
                (= code 1114124) (key-cursor 70 mods)
                (= code 1114117) (key-tilde 5 mods)
                (= code 1114118) (key-tilde 6 mods)
                (= code 1114125) (key-tilde 3 mods)
                (= code 1114126) (key-tilde 2 mods)
                (and (>= code 1114127) (<= code 1114138)) (key-fn (+ 1 (- code 1114127)) mods)
                (>= code 1114112) 0
                :else (key-text code mods))))))

;; ---- rendering --------------------------------------------------------------------------
(defn glyph-bits [(g : I32) (fl : I32) (y : I32)] : I32
  (let [b (load8 (+ (font-base) (+ (* g 16) y)))
        bold (if (= (bit-and fl 1) 1) (bit-or b (shr b 1)) b)]
    (if (and (= (bit-and fl 2) 2) (= y 15)) 255 bold)))

(defn draw-glyph-row [(x0 : I32) (y : I32) (bits : I32) (fg : I32) (bg : I32)] : Unit
  (loop [x 0]
    (when (< x 8)
      (store32! (+ (fb-base) (shl (+ (* y 800) (+ x0 x)) 2))
                (bit-or (shl 255 24)
                        (if (= (bit-and (shr bits (- 7 x)) 1) 1) fg bg)))
      (recur (+ x 1)))))

(defn draw-cell [(x0 : I32) (y0 : I32) (g : I32) (fl : I32) (fg : I32) (bg : I32)] : Unit
  (loop [y 0]
    (when (< y 16)
      (draw-glyph-row x0 (+ y0 y) (glyph-bits g fl y) fg bg)
      (recur (+ y 1)))))

(defn render-cell [(r : I32) (c : I32)] : Unit
  (let [abs (+ (- (top) (view)) r)
        a (cell-addr abs c)
        w (load32 a)
        g (bit-and w 65535)
        fl (bit-and (shr w 16) 255)
        fg0 (load32 (+ a 4))
        bg0 (load32 (+ a 8))
        rev (= (bit-and fl 4) 4)
        fg1 (if rev bg0 fg0)
        bg1 (if rev fg0 bg0)
        sel (is-selected abs c)
        cur (and (= (view) 0) (and (= (st 26) 1) (and (= r (row)) (= c (col)))))
        bg2 (if sel (sel-color) bg1)
        fg3 (if cur (def-bg) fg1)
        bg3 (if cur (cursor-color) bg2)]
    (draw-cell (* c 8) (* r 16) g fl fg3 bg3)))

(defn render-row [(r : I32)] : Unit
  (loop [c 0]
    (when (< c (cols))
      (render-cell r c)
      (recur (+ c 1)))))

;; Returns 1 if a new frame was painted (JS then uploads the framebuffer), 0 if nothing changed.
(defn term-render [] : I32
  (if (= (st 12) 0)
      0
      (do
        (loop [r 0]
          (when (< r (rows))
            (render-row r)
            (recur (+ r 1))))
        (set-st 12 0)
        1)))

(defn term-set-cursor [(on : I32)] : Unit
  (do (set-st 26 on) (dirty)))

(defn term-has-sel [] : I32 (st 15))
(defn term-view [] : I32 (view))
(defn term-alt-active [] : I32 (st 48))
(defn term-bracketed [] : I32 (st 51))
(defn term-app-cursor [] : I32 (st 30))
(defn term-cursor-shown [] : I32 (st 26))
(defn term-col [] : I32 (col))
(defn term-row [] : I32 (row))
(defn term-cell [(r : I32) (c : I32)] : I32 (cell-glyph (+ (top) r) c))     ; glyph index at a screen cell (0 = blank)
(defn term-glyph-cp [(g : I32)] : I32 (glyph-cp g))

(defn term-init [] : Unit
  (do
    (loop [i 0]
      (when (< i 64)
        (set-st i 0)
        (recur (+ i 1))))
    (load-font)
    (load-palette)
    (reset-attrs)
    (clear-all)
    (set-st 26 1)
    (set-st 27 0)
    (set-st 28 (- (rows) 1))
    (set-st 29 1)
    (dirty)))
