;; stdlib/k8s/pod.prn — multi-container Pod Deployments with a shared unix-socket volume.
;; Founder real-time, 2026-10-04: move PRRJECT_FATBABY into Kubernetes, same-node IPC over unix
;; domain sockets, "use whatever we were using for the GOLDEN DOCS service ... GITOPS etc." —
;; golden docs ships via parena-k8s-render -> manifests repo -> parena-gitops, but k8s.prn's
;; `Deployment` is one container only. Sockets only connect containers that share a volume, so the
;; FatBaby processors must live in ONE pod; this module is the missing renderer piece
;; (docs: PRRJECT_FATBABY/docs/northstar/FATBABY_K8S_UDS_NORTHSTAR.md).
;;
;; Shape: a Deployment whose pod mounts two volumes into every container —
;;   var  (PersistentVolumeClaim, ReadWriteOnce)  the shared event store
;;   run  (emptyDir)                              unix sockets + notify datagrams
;; Because the PVC is ReadWriteOnce the Deployment uses strategy Recreate (a rolling update would
;; start the new pod while the old one still holds the volume and hang). Composition is by
;; fragments so the C host (tools/pod_render_host.c) loops over a spec file: one pod-head, N
;; pod-container, one pod-tail. Container args are a comma-separated string (no commas/quotes
;; inside an arg). Requests == limits, same Autopilot cost rule as k8s.prn.

(module k8s/pod)
(import string)
(export args-yaml pod-head-yaml pod-container-yaml pod-tail-yaml pod-service-yaml pod-udp-service-yaml pod-backendconfig-yaml pod-gateway-yaml pod-ingress-yaml)

;; args-yaml — "a,b" -> block list lines at `indent`, each arg double-quoted. "" -> "".
(defn args-yaml [(csv : String @ Region) (indent : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (if (= (string/length csv) 0)
    ""
    (let [parts (string/split csv "," dest)]
      (loop [i 0 acc ""]
        (if (>= i (vec/len &parts))
          acc
          (recur (+ i 1)
            (string/concat acc
              (string/concat indent
                (string/concat "- \""
                  (string/concat (vec/get &parts i) "\"\n" dest)
                  dest)
                dest)
              dest)))))))

;; pod-head-yaml — Deployment header through `containers:`. fsGroup 65532 = distroless nonroot,
;; so the PVC and emptyDir are writable by the containers.
(defn pod-head-yaml [(name : String @ Region) (namespace : String @ Region) (replicas : I32) (dest : Arena @ Region)]
  : String @ Region
  (string/concat
    "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: "
    (string/concat name
      (string/concat "\n  namespace: "
        (string/concat namespace
          (string/concat "\nspec:\n  replicas: "
            (string/concat (string/i32-to-string replicas dest)
              (string/concat "\n  strategy:\n    type: Recreate\n  selector:\n    matchLabels:\n      app: "
                (string/concat name
                  (string/concat "\n  template:\n    metadata:\n      labels:\n        app: "
                    (string/concat name "\n    spec:\n      securityContext:\n        fsGroup: 65532\n      containers:\n" dest)
                    dest)
                  dest)
                dest)
              dest)
            dest)
          dest)
        dest)
      dest)
    dest))

;; port-block-yaml — ports + tcpSocket readiness probe, or "" when port is 0.
(defn port-block-yaml [(port : I32) (dest : Arena @ Region)]
  : String @ Region
  (if (> port 0)
    (let [p (string/i32-to-string port dest)]
      (string/concat "          ports:\n            - containerPort: "
        (string/concat p
          (string/concat "\n          readinessProbe:\n            tcpSocket:\n              port: "
            (string/concat p "\n" dest)
            dest)
          dest)
        dest))
    ""))

;; pod-container-yaml — one container: command + args, optional TCP port with readiness probe
;; (port 0 = no listener reachable from outside the pod, e.g. a socket-only process, so no probe),
;; envFrom an OPTIONAL Secret (the pipeline runs fine with none; a missing Secret must not wedge the pod), both shared volumes mounted, FATBABY_NOTIFY_DIR pointing at <run-path>/notify.
(defn pod-container-yaml [(name : String @ Region) (image : String @ Region) (command : String @ Region)
                          (args-csv : String @ Region) (port : I32) (cpu-milli : I32) (memory-mi : I32)
                          (secret : String @ Region) (var-path : String @ Region) (run-path : String @ Region)
                          (dest : Arena @ Region)]
  : String @ Region
  (let [cpu-s (string/i32-to-string cpu-milli dest)
        mem-s (string/i32-to-string memory-mi dest)
        port-block (port-block-yaml port dest)]
    (string/concat "        - name: "
      (string/concat name
        (string/concat "\n          image: "
          (string/concat image
            (string/concat "\n          command:\n            - "
              (string/concat command
                (string/concat "\n"
                  (string/concat (if (= (string/length args-csv) 0) "" "          args:\n")
                    (string/concat (args-yaml args-csv "            " dest)
                      (string/concat port-block
                        (string/concat "          env:\n            - name: FATBABY_NOTIFY_DIR\n              value: "
                          (string/concat run-path
                            (string/concat "/notify\n          envFrom:\n            - secretRef:\n                optional: true\n                name: "
                              (string/concat secret
                                (string/concat "\n          volumeMounts:\n            - name: var\n              mountPath: "
                                  (string/concat var-path
                                    (string/concat "\n            - name: run\n              mountPath: "
                                      (string/concat run-path
                                        (string/concat "\n          resources:\n            requests:\n              cpu: "
                                          (string/concat cpu-s
                                            (string/concat "m\n              memory: "
                                              (string/concat mem-s
                                                (string/concat "Mi\n              ephemeral-storage: 256Mi\n            limits:\n              cpu: "
                                                  (string/concat cpu-s
                                                    (string/concat "m\n              memory: "
                                                      (string/concat mem-s "Mi\n              ephemeral-storage: 256Mi\n" dest)
                                                      dest)
                                                    dest)
                                                  dest)
                                                dest)
                                              dest)
                                            dest)
                                          dest)
                                        dest)
                                      dest)
                                    dest)
                                  dest)
                                dest)
                              dest)
                            dest)
                          dest)
                        dest)
                      dest)
                    dest)
                  dest)
                dest)
              dest)
            dest)
          dest)
        dest)
      dest)))

;; pod-tail-yaml — the two shared volumes. An empty pvc name means a stateless pod (game servers):
;; `var` becomes an emptyDir too, and no PVC is rendered.
(defn pod-tail-yaml [(pvc : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (if (= (string/length pvc) 0)
    "      volumes:\n        - name: var\n          emptyDir: {}\n        - name: run\n          emptyDir: {}\n"
    (string/concat "      volumes:\n        - name: var\n          persistentVolumeClaim:\n            claimName: "
      (string/concat pvc "\n        - name: run\n          emptyDir: {}\n" dest)
      dest)))

;; port-entry-yaml — one Service port list item.
(defn port-entry-yaml [(p : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (string/concat "    - name: p"
    (string/concat p
      (string/concat "\n      port: "
        (string/concat p
          (string/concat "\n      targetPort: " (string/concat p "\n" dest) dest)
          dest)
        dest)
      dest)
    dest))

;; pod-service-yaml — ONE ClusterIP Service for the pod exposing several ports (ports-csv "8082,9091";
;; targetPort == port). Never LoadBalancer: the single shared Ingress is the only external entry.
;; backend-config ("" = none) names a BackendConfig (pod-backendconfig-yaml) attached via the GKE annotation.
(defn pod-service-yaml [(name : String @ Region) (namespace : String @ Region) (ports-csv : String @ Region) (backend-config : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [parts (string/split ports-csv "," dest)
        ports (loop [i 0 acc ""]
                (if (>= i (vec/len &parts))
                  acc
                  (recur (+ i 1) (string/concat acc (port-entry-yaml (vec/get &parts i) dest) dest))))
        ann (if (= (string/length backend-config) 0)
              ""
              (string/concat "  annotations:\n    cloud.google.com/backend-config: '{\"default\": \""
                (string/concat backend-config "\"}'\n" dest)
                dest))]
    (string/concat "apiVersion: v1\nkind: Service\nmetadata:\n  name: "
      (string/concat name
        (string/concat "\n  namespace: "
          (string/concat namespace
            (string/concat "\n"
              (string/concat ann
                (string/concat "spec:\n  selector:\n    app: "
                  (string/concat name
                    (string/concat "\n  ports:\n" (string/concat ports "  type: ClusterIP\n" dest) dest)
                    dest)
                  dest)
                dest)
              dest)
            dest)
          dest)
        dest)
      dest)))

;; pod-backendconfig-yaml — GKE BackendConfig: LB timeout in seconds (WebSockets need > the 30s default).
(defn pod-backendconfig-yaml [(name : String @ Region) (namespace : String @ Region) (timeout : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (string/concat "apiVersion: cloud.google.com/v1\nkind: BackendConfig\nmetadata:\n  name: "
    (string/concat name
      (string/concat "\n  namespace: "
        (string/concat namespace
          (string/concat "\nspec:\n  timeoutSec: " (string/concat timeout "\n" dest) dest)
          dest)
        dest)
      dest)
    dest))

;; udp-port-entry-yaml — one UDP Service port list item (name must be unique: u<port>).
(defn udp-port-entry-yaml [(p : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (string/concat "    - name: u"
    (string/concat p
      (string/concat "\n      protocol: UDP\n      port: "
        (string/concat p
          (string/concat "\n      targetPort: " (string/concat p "\n" dest) dest)
          dest)
        dest)
      dest)
    dest))

;; pod-udp-service-yaml — the ONE deliberate exception to "never LoadBalancer": game servers speak
;; UDP, which an HTTP Ingress cannot carry, so a pod may also get a UDP LoadBalancer Service
;; "<name>-udp" bound to a pre-reserved regional static IP (ip, so DNS can point at it before and
;; after redeploys). ports-csv is the explicit port list ("8778,8300,8301"). Local traffic policy
;; keeps the client source address intact for the matchmaker's per-client reply routing.
(defn pod-udp-service-yaml [(name : String @ Region) (namespace : String @ Region) (ports-csv : String @ Region) (ip : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [parts (string/split ports-csv "," dest)
        ports (loop [i 0 acc ""]
                (if (>= i (vec/len &parts))
                  acc
                  (recur (+ i 1) (string/concat acc (udp-port-entry-yaml (vec/get &parts i) dest) dest))))]
    (string/concat "apiVersion: v1\nkind: Service\nmetadata:\n  name: "
      (string/concat name
        (string/concat "-udp\n  namespace: "
          (string/concat namespace
            (string/concat "\nspec:\n  type: LoadBalancer\n  externalTrafficPolicy: Local\n"
              (string/concat (if (= (string/length ip) 0) "" (string/concat "  loadBalancerIP: " (string/concat ip "\n" dest) dest))
                (string/concat "  selector:\n    app: "
                  (string/concat name
                    (string/concat "\n  ports:\n" (string/concat ports "" dest) dest)
                    dest)
                  dest)
                dest)
              dest)
            dest)
          dest)
        dest)
      dest)))

;; route-yaml — one HTTPRoute + one GCPBackendPolicy for "host@service@port"; name is gw-<service>.
(defn route-yaml [(gw : String @ Region) (namespace : String @ Region) (rule : String @ Region) (timeout : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [hp (string/split rule "@" dest)
        host (vec/get &hp 0)
        svc (vec/get &hp 1)
        port (vec/get &hp 2)]
    (string/concat "---\napiVersion: gateway.networking.k8s.io/v1\nkind: HTTPRoute\nmetadata:\n  name: "
      (string/concat svc
        (string/concat "\n  namespace: "
          (string/concat namespace
            (string/concat "\nspec:\n  parentRefs:\n    - name: "
              (string/concat gw
                (string/concat "\n  hostnames:\n    - "
                  (string/concat host
                    (string/concat "\n  rules:\n    - backendRefs:\n        - name: "
                      (string/concat svc
                        (string/concat "\n          port: "
                          (string/concat port
                            (string/concat "\n---\napiVersion: networking.gke.io/v1\nkind: GCPBackendPolicy\nmetadata:\n  name: "
                              (string/concat svc
                                (string/concat "\n  namespace: "
                                  (string/concat namespace
                                    (string/concat "\nspec:\n  default:\n    timeoutSec: "
                                      (string/concat timeout
                                        (string/concat "\n  targetRef:\n    group: \"\"\n    kind: Service\n    name: " (string/concat svc "\n" dest) dest)
                                        dest)
                                      dest)
                                    dest)
                                  dest)
                                dest)
                              dest)
                            dest)
                          dest)
                        dest)
                      dest)
                    dest)
                  dest)
                dest)
              dest)
            dest)
          dest)
        dest)
      dest)))

;; pod-gateway-yaml — a Gateway API external HTTPS gateway (class gke-l7-global-external-managed) whose TLS is a
;; Certificate Manager cert map (annotation networking.gke.io/certmap — wildcard certs; GCE *Ingress* cannot use
;; Certificate Manager), on a reserved global static IP (ip-name), plus an HTTPRoute and a GCPBackendPolicy per
;; "host@service@port" route (timeout seconds lifts the LB's 30s default so WebSockets survive).
(defn pod-gateway-yaml [(name : String @ Region) (namespace : String @ Region) (certmap : String @ Region) (ip-name : String @ Region) (routes-csv : String @ Region) (timeout : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [parts (string/split routes-csv "," dest)
        routes (loop [i 0 acc ""]
                 (if (>= i (vec/len &parts))
                   acc
                   (recur (+ i 1) (string/concat acc (route-yaml name namespace (vec/get &parts i) timeout dest) dest))))]
    (string/concat "apiVersion: gateway.networking.k8s.io/v1\nkind: Gateway\nmetadata:\n  name: "
      (string/concat name
        (string/concat "\n  namespace: "
          (string/concat namespace
            (string/concat "\n  annotations:\n    networking.gke.io/certmap: "
              (string/concat certmap
                (string/concat "\nspec:\n  gatewayClassName: gke-l7-global-external-managed\n  listeners:\n    - name: https\n      protocol: HTTPS\n      port: 443\n      allowedRoutes:\n        kinds:\n          - kind: HTTPRoute\n  addresses:\n    - type: NamedAddress\n      value: "
                  (string/concat ip-name (string/concat "\n" (string/concat routes "" dest) dest) dest)
                  dest)
                dest)
              dest)
            dest)
          dest)
        dest)
      dest)))

;; rule-yaml — one Ingress host rule: "host@service@port".
(defn rule-yaml [(rule : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [hp (string/split rule "@" dest)]
    (string/concat "    - host: "
      (string/concat (vec/get &hp 0)
        (string/concat "\n      http:\n        paths:\n          - path: /\n            pathType: Prefix\n            backend:\n              service:\n                name: "
          (string/concat (vec/get &hp 1)
            (string/concat "\n                port:\n                  number: "
              (string/concat (vec/get &hp 2) "\n" dest)
              dest)
            dest)
          dest)
        dest)
      dest)))

;; frontend-config/ip-name ("" = omit): name of a FrontendConfig (pod-frontendconfig-yaml, carries the Certificate Manager cert map) and a reserved global IP.
;; pod-ingress-yaml — the cluster's ONE Ingress (GCE class = one external HTTP(S) LB; every extra
;; Ingress object is another billed LB). Several host rules (rules-csv
;; "fatbaby.io@fatbaby-core@8082,golden.okemily.com@collections-server@8087"); backends must be
;; Services in the same namespace, so every app behind the edge lives in that namespace.
(defn pod-ingress-yaml [(name : String @ Region) (namespace : String @ Region) (rules-csv : String @ Region) (frontend-config : String @ Region) (ip-name : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [parts (string/split rules-csv "," dest)
        rules (loop [i 0 acc ""]
                (if (>= i (vec/len &parts))
                  acc
                  (recur (+ i 1) (string/concat acc (rule-yaml (vec/get &parts i) dest) dest))))]
    (string/concat "apiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: "
      (string/concat name
        (string/concat "\n  namespace: "
          (string/concat namespace
            (string/concat "\n  annotations:\n    kubernetes.io/ingress.class: gce\n"
              (string/concat (if (= (string/length frontend-config) 0) "" (string/concat "    networking.gke.io/certmap: " (string/concat frontend-config "\n" dest) dest))
                (string/concat (if (= (string/length ip-name) 0) "" (string/concat "    kubernetes.io/ingress.global-static-ip-name: " (string/concat ip-name "\n" dest) dest))
                  (string/concat "spec:\n  rules:\n" (string/concat rules "" dest) dest)
                  dest)
                dest)
              dest)
            dest)
          dest)
        dest)
      dest)))
