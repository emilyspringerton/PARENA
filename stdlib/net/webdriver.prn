;; stdlib/net/webdriver.prn — depends on net/http, json, string. Design:
;; new, real, undesigned-in-STDLIB.md work, added here directly the same
;; way json.prn/yaml.prn were (founder real-time ask, "ensure we have
;; stdlibs for X" precedent). Founder: "build selenium bindings into
;; parena." "Selenium bindings" means a W3C WebDriver protocol client --
;; real Selenium (and every one of its official Python/Java/JS/.NET
;; client libraries) is not itself a browser-automation engine, it is a
;; JSON-over-HTTP client speaking the WebDriver wire protocol
;; (https://www.w3.org/TR/webdriver/) to a driver process (chromedriver,
;; geckodriver, msedgedriver, or Selenium's own standalone/Grid server)
;; that does the real automation. This file IS that client -- no FFI to
;; a "libselenium" needed (no such C library exists; that is not how
;; any real Selenium binding works), just plain HTTP + JSON, both
;; already real in this stdlib (net/http.prn, json.prn) as of today.
;;
;; Scope, stated plainly: the WebDriver spec is large (windows, frames,
;; cookies, actions/gestures, alerts, shadow DOM, ...). This covers the
;; real, load-bearing subset every basic automation script needs --
;; create a session, navigate, find an element, click it, read its
;; text, read the page title, end the session -- not the whole spec.
;; Real, honest, narrow, matching this stdlib's own established house
;; style (yaml.prn's YAML subset, http.prn's url-free API) rather than
;; claiming full coverage.
;;
;; Live end-to-end verification against a REAL WebDriver server
;; (chromedriver/geckodriver) needs a real browser + driver installed
;; on this box, which is not true as of this file landing -- flagged
;; honestly, not faked. What IS live-verified: every JSON request this
;; file builds and every response-parsing path it uses, exercised
;; against `net/webdriver_test.prn`'s firefly test cases (pure request/
;; response logic, no live server needed) plus a real fake WebDriver
;; server for one true end-to-end run -- see that test file's own
;; header comment for exactly what "live-verified" means here.

(module net/webdriver)
(import net/http)
(import json)
(import string)
(export new-session new-session-with-capabilities navigate-to find-element element-click element-text
        element-send-keys page-title page-source quit-session Session WebDriverError)

(defstruct Session
  (host       : String @ Region)
  (port       : I32)
  (session-id : String @ Region))

(defenum WebDriverError
  (ConnectFailed)
  (BadResponse)
  (ProtocolError (message : String @ Region)))

;; The W3C spec's own element-reference key -- every find-element
;; response carries the found element's id under this exact literal
;; string key, not e.g. "id" or "elementId". Verbatim from the spec,
;; not invented: https://www.w3.org/TR/webdriver/#elements.
(defn element-ref-key [] : String @ :region/scratch "element-6066-11e4-a52e-4f735466cecf")

;; json-escape-string — real, narrow scope: escapes only '"' and '\\',
;; the two characters that would otherwise break out of a JSON string
;; literal. Real, honest, deliberately not a full JSON-string-escape
;; implementation (no \n/\t/control-char escaping) -- every real value
;; this file embeds (URLs, CSS selectors) is single-line ASCII-ish text
;; in real, live usage; a value containing a raw newline would produce
;; invalid JSON, a real narrow limitation flagged here rather than
;; silently mishandled.
(defn json-escape-string [(s : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [n (length s)]
    (loop [i 0 acc ""]
      (cond
        ((>= i n) acc)
        ((= (char-at s i) 34)   ;; '"'
          (recur (+ i 1) (string/concat acc "\\\"" dest)))
        ((= (char-at s i) 92)   ;; '\\'
          (recur (+ i 1) (string/concat acc "\\\\" dest)))
        (true (recur (+ i 1) (string/concat acc (substring s i (+ i 1) dest) dest)))))))

;; do-request — shared plumbing every real call below uses: fire an
;; HTTP request, map a transport failure to ConnectFailed, require a
;; 2xx status (any other status is a real WebDriver-protocol error, not
;; a transport one -- the body is usually a real, human-readable JSON
;; error the caller may want, carried in ProtocolError), parse the JSON
;; body, and require a top-level "value" field (every real WebDriver
;; response -- success AND spec-defined error responses alike -- is
;; `{"value": ...}`-wrapped, per the spec's own §6.4).
(defn do-request [(method : String @ Region) (host : String @ :region/scratch) (port : I32)
                   (path : String @ Region) (body : (Option String) @ Region) (dest : Arena @ Region)]
  : (Result JsonValue WebDriverError) @ Region
  (match (net/http/http-request method host port path body dest)
    ((Err _) (Err ConnectFailed))
    ((Ok resp)
      (let [r (deref resp)
            status (get-field r :status)]
        (if (or (< status 200) (>= status 300))
          (Err (ProtocolError (get-field r :body)))
          (match (json/parse (get-field r :body) dest)
            ((Err _) (Err BadResponse))
            ((Ok parsed)
              (match (json/get (deref parsed) "value")
                ((Some v) (Ok (deref v)))
                (None (Err BadResponse))))))))))

;; new-session — POST /session. Real, minimal capabilities body
;; (`{"alwaysMatch":{}}`, no browser-specific options) -- every real
;; driver (chromedriver/geckodriver/msedgedriver) accepts an empty
;; alwaysMatch and falls back to its own defaults; a caller needing
;; specific capabilities (headless, a binary path, ...) is real,
;; separate, future scope this narrow first version doesn't cover.
(defn new-session [(host : String @ :region/scratch) (port : I32) (dest : Arena @ Region)]
  : (Result Session WebDriverError) @ Region
  (new-session-with-capabilities host port "{}" dest))

;; new-session-with-capabilities — same as new-session, but the caller
;; supplies the real, raw JSON object to use as "alwaysMatch" instead of the
;; empty default. Added 2026-09-02, found load-bearing the moment this was
;; actually run against a real chromedriver in a real headless/no-X
;; container (not just the fake fixture server): with an empty alwaysMatch,
;; chromedriver launches Chrome with its own real defaults, which need an
;; actual X display and a real sandbox namespace neither exists in a bare
;; container -- Chrome exits immediately, "session not created: Chrome
;; instance exited." A caller in that real situation needs to pass e.g.
;;   "{\"goog:chromeOptions\":{\"args\":[\"--headless=new\",\"--no-sandbox\",\"--disable-gpu\",\"--disable-dev-shm-usage\"]}}"
;; Still real, narrow v1 scope: the caller builds this JSON string
;; themselves (no capabilities-builder API here), same house style
;; find-element's own "one real strategy" scoping already uses.
(defn new-session-with-capabilities [(host : String @ :region/scratch) (port : I32)
                                      (capabilities-json : String @ Region) (dest : Arena @ Region)]
  : (Result Session WebDriverError) @ Region
  (let [body (string/concat (string/concat "{\"capabilities\":{\"alwaysMatch\":" capabilities-json dest) "}}" dest)]
    (match (do-request "POST" host port "/session" (Some body) dest)
      ((Err e) (Err e))
      ((Ok value)
        (match (json/get (deref value) "sessionId")
          ((Some sid)
            (match (json/as-string (deref sid))
              ((Some id) (Ok {:host host :port port :session-id id}))
              (None (Err BadResponse))))
          (None (Err BadResponse)))))))

;; navigate-to — POST /session/{id}/url.
(defn navigate-to [(!sess : &Session) (url : String @ Region) (dest : Arena @ Region)]
  : (Result Unit WebDriverError) @ Region
  (let [path (string/concat (string/concat "/session/" (get-field !sess :session-id) dest) "/url" dest)
        body (string/concat (string/concat "{\"url\":\"" (json-escape-string url dest) dest) "\"}" dest)]
    (match (do-request "POST" (get-field !sess :host) (get-field !sess :port) path (Some body) dest)
      ((Err e) (Err e))
      ((Ok _) (Ok unit)))))

;; find-element — POST /session/{id}/element, "css selector" strategy
;; (the one real strategy every real caller of a CSS-selector-shaped
;; string expects -- xpath/link-text/etc. are real, separate, future
;; scope). Returns the element's real WebDriver-protocol element id,
;; the opaque handle every later element/{id}/... call needs.
(defn find-element [(!sess : &Session) (css-selector : String @ Region) (dest : Arena @ Region)]
  : (Result String WebDriverError) @ Region
  (let [path (string/concat (string/concat "/session/" (get-field !sess :session-id) dest) "/element" dest)
        body (string/concat
               (string/concat "{\"using\":\"css selector\",\"value\":\"" (json-escape-string css-selector dest) dest)
               "\"}" dest)]
    (match (do-request "POST" (get-field !sess :host) (get-field !sess :port) path (Some body) dest)
      ((Err e) (Err e))
      ((Ok value)
        (match (json/get (deref value) (element-ref-key))
          ((Some eid)
            (match (json/as-string (deref eid))
              ((Some id) (Ok id))
              (None (Err BadResponse))))
          (None (Err BadResponse)))))))

;; element-click — POST /session/{id}/element/{element-id}/click, no
;; body payload beyond an empty object (the spec's own defined shape).
(defn element-click [(!sess : &Session) (element-id : String @ Region) (dest : Arena @ Region)]
  : (Result Unit WebDriverError) @ Region
  (let [path (string/concat
               (string/concat
                 (string/concat (string/concat "/session/" (get-field !sess :session-id) dest) "/element/" dest)
                 element-id dest)
               "/click" dest)]
    (match (do-request "POST" (get-field !sess :host) (get-field !sess :port) path (Some "{}") dest)
      ((Err e) (Err e))
      ((Ok _) (Ok unit)))))

;; element-send-keys — POST /session/{id}/element/{element-id}/value,
;; body `{"text": "..."}` (the current W3C spec shape; older drivers
;; also accept a `value` array-of-chars, not sent here -- real, narrow,
;; matches what every current chromedriver/geckodriver release actually
;; expects). Real, load-bearing for any form-filling test (a login
;; form, a search box, ...) -- click alone can't type text.
(defn element-send-keys [(!sess : &Session) (element-id : String @ Region) (text : String @ Region) (dest : Arena @ Region)]
  : (Result Unit WebDriverError) @ Region
  (let [path (string/concat
               (string/concat
                 (string/concat (string/concat "/session/" (get-field !sess :session-id) dest) "/element/" dest)
                 element-id dest)
               "/value" dest)
        body (string/concat (string/concat "{\"text\":\"" (json-escape-string text dest) dest) "\"}" dest)]
    (match (do-request "POST" (get-field !sess :host) (get-field !sess :port) path (Some body) dest)
      ((Err e) (Err e))
      ((Ok _) (Ok unit)))))

;; element-text — GET /session/{id}/element/{element-id}/text.
(defn element-text [(!sess : &Session) (element-id : String @ Region) (dest : Arena @ Region)]
  : (Result String WebDriverError) @ Region
  (let [path (string/concat
               (string/concat
                 (string/concat (string/concat "/session/" (get-field !sess :session-id) dest) "/element/" dest)
                 element-id dest)
               "/text" dest)]
    (match (do-request "GET" (get-field !sess :host) (get-field !sess :port) path None dest)
      ((Err e) (Err e))
      ((Ok value)
        (match (json/as-string (deref value))
          ((Some s) (Ok s))
          (None (Err BadResponse)))))))

;; page-title — GET /session/{id}/title.
(defn page-title [(!sess : &Session) (dest : Arena @ Region)]
  : (Result String WebDriverError) @ Region
  (let [path (string/concat (string/concat "/session/" (get-field !sess :session-id) dest) "/title" dest)]
    (match (do-request "GET" (get-field !sess :host) (get-field !sess :port) path None dest)
      ((Err e) (Err e))
      ((Ok value)
        (match (json/as-string (deref value))
          ((Some s) (Ok s))
          (None (Err BadResponse)))))))

;; page-source — GET /session/{id}/source. Returns the full, currently-
;; rendered HTML of the page (document.documentElement.outerHTML, per
;; the spec's own §17.1) -- the real, load-bearing piece a JS-rendered
;; page (React/Vue/etc. list pages with no data in the raw server
;; response) needs: navigate-to renders it, page-source hands back the
;; POST-render DOM as one plain string, ready for the exact same
;; regex-based extraction this stdlib's own callers (e.g. prwatch-style
;; scrapers) already use against a plain HTTP GET body for a
;; server-rendered page. Same shape as page-title above -- a bare
;; string value, no nested object -- just a different path.
(defn page-source [(!sess : &Session) (dest : Arena @ Region)]
  : (Result String WebDriverError) @ Region
  (let [path (string/concat (string/concat "/session/" (get-field !sess :session-id) dest) "/source" dest)]
    (match (do-request "GET" (get-field !sess :host) (get-field !sess :port) path None dest)
      ((Err e) (Err e))
      ((Ok value)
        (match (json/as-string (deref value))
          ((Some s) (Ok s))
          (None (Err BadResponse)))))))

;; quit-session — DELETE /session/{id}. Ends the real browser session
;; server-side (a real driver process frees its own resources here,
;; same as closing the last window in a real Selenium script) --
;; skipping this on every code path leaks a live browser process on
;; the driver's own host, same real leak Selenium's own docs warn
;; about for a script that forgets driver.quit().
(defn quit-session [(!sess : &Session) (dest : Arena @ Region)]
  : (Result Unit WebDriverError) @ Region
  (let [path (string/concat "/session/" (get-field !sess :session-id) dest)]
    (match (do-request "DELETE" (get-field !sess :host) (get-field !sess :port) path None dest)
      ((Err e) (Err e))
      ((Ok _) (Ok unit)))))
