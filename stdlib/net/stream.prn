;; stdlib/net/stream.prn -- cross-platform TCP client streaming + a small line-input buffer.
;; Added 2026-10-14 for PELLEGRINO ("actual product": fetch a URL and paint bytes as they land).
;; Design/limits: see the "net/stream" section comment in runtime/parena_runtime.h. Plain scalar
;; returns (no Result boxing), like io.prn's raw primitives. Works on Linux/macOS and Windows
;; (winsock2). One stream at a time. HTTPS: stream-connect-tls (mbedTLS, opt-in PARENA_WITH_TLS --
;; see the runtime's net/stream comment) returns the same kind of handle; stream-send/pull/close
;; then work on it unchanged. Certificate verification is always on.

(module net/stream)
(export stream-connect stream-connect-tls stream-tls-code stream-tls-error stream-tls-page stream-tls-info stream-tls-heap-peak
        stream-send stream-pull stream-buf stream-len stream-reset stream-close stream-bank stream-copy-bytes
        css-append css-buf css-len css-reset
        linebuf-append linebuf-backspace linebuf-clear linebuf-get linebuf-len
        cururl-set cururl-get slot-get slot-set)

;; fd >= 0 on success, -1 on DNS/connect failure (5 s connect timeout)
(defn stream-connect [(host : String @ Region) (port : I32)] : I32
  #target
  {:c (inline-c "stream_connect_impl(host, port)")})

;; Like stream-connect, but TLS: handle >= 0 on a verified handshake, -1 otherwise (then see
;; stream-tls-code / stream-tls-error). Hostname + chain are always verified.
(defn stream-connect-tls [(host : String @ Region) (port : I32)] : I32
  #target
  {:c (inline-c "stream_connect_tls_impl(host, port)")})

;; why the last stream-connect-tls failed: 0 none, 1 connect, 2 handshake, 3 certificate rejected,
;; 4 no CA bundle, 5 this build has no TLS
(defn stream-tls-code [] : I32
  #target
  {:c (inline-c "stream_tls_code_impl()")})

;; short human-readable reason for the last failure ("" if none); valid until the next connect
(defn stream-tls-error [] : String
  #target
  {:c (inline-c "stream_tls_error_impl()")})

;; the last TLS failure as a small ready-to-render HTML page (headline + reason)
(defn stream-tls-page [] : String
  #target
  {:c (inline-c "stream_tls_page_impl()")})

;; negotiated "TLSv1.3 <ciphersuite>" of the live TLS session, "" if none
(defn stream-tls-info [] : String
  #target
  {:c (inline-c "stream_tls_info_impl()")})

;; high-water mark (bytes) of the static TLS heap; 0 if this build uses the system allocator
(defn stream-tls-heap-peak [] : I32
  #target
  {:c (inline-c "stream_tls_heap_peak_impl()")})

;; 0 ok, -1 failure
(defn stream-send [(fd : I32) (data : String @ Region)] : I32
  #target
  {:c (inline-c "stream_send_impl(fd, data)")})

;; n>0 bytes appended to the stream buffer; 0 = nothing yet; -1 = closed (for TLS: an authenticated
;; close_notify) or error; -2 = buffer full; -3 = TLS stream ended WITHOUT a close_notify (TCP EOF, reset
;; or alert) -- the body may be truncated
(defn stream-pull [(fd : I32)] : I32
  #target
  {:c (inline-c "stream_pull_impl(fd)")})

;; The received bytes so far (one static NUL-terminated buffer; valid until stream-reset)
(defn stream-buf [] : String
  #target
  {:c (inline-c "stream_buf_impl()")})

(defn stream-len [] : I32
  #target
  {:c (inline-c "stream_len_impl()")})

(defn stream-reset [] : I32
  #target
  {:c (inline-c "(stream_reset_impl(), 0)")})

(defn stream-close [(fd : I32)] : I32
  #target
  {:c (inline-c "stream_close_impl(fd)")})

;; select the receive buffer stream-pull/buf/len/reset act on: 0 = page (default, PARENA_STREAM_MAX),
;; 1 = image bank (PARENA_IMAGE_MAX, 2 MiB). Returns the previously selected bank.
(defn stream-bank [(b : I32)] : I32
  #target
  {:c (inline-c "stream_bank_impl(b)")})

;; binary-safe copy of the selected bank from byte `off` to its end
(defn stream-copy-bytes [(off : I32) (dest : Arena @ Region)] : Bytes @ Region
  #target
  {:c (inline-c "stream_copy_bytes_impl(dest, off)")})

;; Static stylesheet text store (256 KiB, no malloc): css-append copies the SELECTED bank from byte `off` to its end
;; (at most `maxlen` bytes, -1 for no limit; plus a newline) and returns where the copy starts in the store, or -1
;; when the store is full. css-buf is the
;; whole store as a String (grows; earlier offsets stay valid), css-len its length, css-reset empties it.
(defn css-append [(off : I32) (maxlen : I32)] : I32
  #target
  {:c (inline-c "css_append_impl(off, maxlen)")})

(defn css-buf [] : String
  #target
  {:c (inline-c "css_buf_impl()")})

(defn css-len [] : I32
  #target
  {:c (inline-c "css_len_impl()")})

(defn css-reset [] : I32
  #target
  {:c (inline-c "(css_reset_impl(), 0)")})

(defn linebuf-append [(s : String @ Region)] : I32
  #target
  {:c (inline-c "(linebuf_append_impl(s), 0)")})

(defn linebuf-backspace [] : I32
  #target
  {:c (inline-c "(linebuf_backspace_impl(), 0)")})

(defn linebuf-clear [] : I32
  #target
  {:c (inline-c "(linebuf_clear_impl(), 0)")})

(defn linebuf-get [] : String
  #target
  {:c (inline-c "linebuf_get_impl()")})

(defn linebuf-len [] : I32
  #target
  {:c (inline-c "linebuf_len_impl()")})

;; slot-get / slot-set -- 1024 (PARENA_SLOTS) static int cells of mutable program state (see runtime comment).
(defn slot-get [(k : I32)] : I32
  #target
  {:c (inline-c "slot_get_impl(k)")})

(defn slot-set [(k : I32) (v : I32)] : I32
  #target
  {:c (inline-c "slot_set_impl(k, v)")})

(defn cururl-set [(s : String @ Region)] : I32
  #target
  {:c (inline-c "cururl_set_impl(s)")})

(defn cururl-get [] : String
  #target
  {:c (inline-c "cururl_get_impl()")})
