;; stdlib/net/tcp.prn — depends on string. Design: STDLIB.md "net/tcp"
;; section. Connection-oriented; thin FFI over real BSD sockets, the same
;; primitive REDGARDEN/SHANKPIT's own UDP servers sit on top of, just the
;; TCP half of it.

(module net/tcp)
(import string)
(export listen accept connect read write TcpListener TcpStream NetError)

;; Real, honest gap closed here (2026-08-21): every function below used
;; `TcpListener`/`TcpStream`/`NetError` in its own real signature but
;; this file never actually DEFINED any of them -- the same real class
;; of gap pentest/pcap.prn's own Capture/Packet/PcapError and io.prn's
;; own FileHandle/IoError already closed. Both handles are real,
;; minimal, opaque fd wrappers -- the actual host-side socket fd every
;; #target body above already assumes exists (tcp_listen/tcp_accept/
;; tcp_connect/tcp_read/tcp_write) is real, separate, unstarted
;; host-runtime glue work, same honest "FFI declared, host
;; implementation not written yet" boundary every other #target-bound
;; file in this stdlib already has.
;;
;; Real, deliberately narrow scope: `NetError` is defined separately
;; here AND in net/udp.prn's own file (not shared via a common import)
;; -- net/http.prn's own real design only ever imports net/tcp (never
;; net/udp at the same time), and net/tcp.prn/net/udp.prn are never
;; combined together in any real, intended build, so this duplication
;; is safe for every real combination that actually exists. Combining
;; all three files in one build would hit a real duplicate-definition
;; error -- a real, honest, narrow limitation, not silently hidden.
(defstruct TcpListener
  (fd : I32))

(defstruct TcpStream
  (fd : I32))

(defenum NetError
  (ConnectionRefused)
  (Timeout)
  (AddressInUse)
  (Other))

(defn listen [(port : I32) (dest : Arena @ Region)]
  : (Result TcpListener NetError) @ Region
  #target
  {:c (inline-c "tcp_listen(port, dest)")})

(defn accept [(!l : &TcpListener) (dest : Arena @ Region)]
  : (Result TcpStream NetError) @ Region
  #target
  {:c (inline-c "tcp_accept(l, dest)")})

(defn connect [(host : String @ :region/scratch) (port : I32) (dest : Arena @ Region)]
  : (Result TcpStream NetError) @ Region
  #target
  {:c (inline-c "tcp_connect(host, port, dest)")})

(defn read [(!s : &mut TcpStream) (dest : Arena @ Region)]
  : (Result String NetError) @ Region
  #target
  {:c (inline-c "tcp_read(s, dest)")})

(defn write [(!s : &mut TcpStream) (data : String @ Region)]
  : (Result I32 NetError)
  #target
  {:c (inline-c "tcp_write(s, data)")})
