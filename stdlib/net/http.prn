;; stdlib/net/http.prn — depends on net/tcp, string, vec. Design:
;; STDLIB.md "net/http" section. Client-side only (http-get/http-post/
;; http-request) -- the original design also specified a server-side
;; `serve`, dropped here (see below).
;;
;; Rewritten 2026-08-25, closing two real gaps found while building
;; stdlib/net/webdriver.prn (a WebDriver-protocol client, "Selenium
;; bindings" -- see that file's own header comment) on top of this one:
;;
;; 1. This file never actually compiled. Its own original design used
;;    `(Map String String)` for headers, but stdlib/map.prn's `K`/`V`
;;    generic type parameters fail VS0's emitter today ("unsupported
;;    return type symbol 'K'") -- confirmed live, the exact same real
;;    constraint json.prn's own header comment already documents for
;;    its own JObject. Fixed the identical way: headers are two
;;    parallel `Vec String`s (names, values) at the same index, real
;;    and O(n)-lookup, not a hash map -- json.prn's JObject is the
;;    direct precedent.
;; 2. Every function called helper functions (`connect-from-url`,
;;    `build-get-request`, `build-post-request`, `parse-http-response`,
;;    `parse-http-request`, `serialize-response`) that this file never
;;    actually defined -- real, original implementation work below, not
;;    a fill-in-the-blank.
;;
;; `serve` (the original design's server side) is dropped, not merely
;; deferred: it depended on the same undefined `parse-http-request`/
;; `serialize-response` pair, and nothing in this codebase's real,
;; current consumers (webdriver.prn is a CLIENT of an external WebDriver
;; server) needs a PARENA-side HTTP server yet. Flagged as real,
;; deliberately out-of-scope work for whoever needs it next, not
;; silently dropped.
;;
;; URL strings are NOT parsed here -- callers pass host/port/path
;; separately. A real, deliberate simplification over the original
;; design (which took one `url : String` per call): general URL parsing
;; (scheme, userinfo, IPv6 literals, query strings) is real, separate
;; scope this file's actual callers don't need (webdriver.prn always
;; talks to a fixed local WebDriver host:port; a future caller that
;; genuinely needs URL parsing can add it as its own function without
;; touching this one).
;;
;; TLS is still not implemented (carried over from the original design
;; note): https:// needs a real TLS library via FFI, same judgment as
;; linalg's BLAS/LAPACK note. Everything below is plain HTTP.
;;
;; Every request sends `Connection: close` and every response is read
;; via net/tcp's own real, documented limitation (reads until the peer
;; closes, no Content-Length-aware early stop) -- the two are a matched
;; pair, not independent choices: forcing the server to close after
;; responding is what makes tcp-read's real behavior correct here
;; instead of hanging forever on a keep-alive connection.

(module net/http)
(import net/tcp)
(import string)
(import vec)
;; find-crlfcrlf/find-colon/trim-trailing-cr/trim-leading-space added to this export list
;; 2026-09-04 (net/proxy real reuse, see that file's own header comment) -- these were real,
;; already-written, already-correct low-level HTTP text scanners with no reason to duplicate.
(export http-get http-post http-request HttpResponse
        find-crlfcrlf find-colon trim-trailing-cr trim-leading-space)

(defstruct HttpResponse
  (status        : I32)
  (header-names  : (Vec String) @ Region)
  (header-values : (Vec String) @ Region)
  (body          : String @ Region))

;; ---- small internal string scanners -- string.prn's own `split` only
;; splits on every occurrence of a single char, which loses information
;; for "Name: Value" lines whose Value itself may contain ':' (a real,
;; live example: WebDriver session URLs echo their own port back in
;; header-adjacent JSON, not headers themselves, but this is still the
;; more correct general behavior) and can't find a 4-byte "\r\n\r\n"
;; boundary at all. Real, minimal manual scans, same idiom split's own
;; body already uses (char-at in a loop/cond/recur).

;; find-crlfcrlf — byte offset of the first "\r\n\r\n" in `s`, or -1.
;; This is the header/body boundary; everything from this offset + 4
;; onward is the real, verbatim body (never re-split, so a body
;; containing its own newlines or colons is never corrupted).
(defn find-crlfcrlf [(s : String @ Region)]
  : I32
  (let [n (length s)]
    (loop [i 0]
      (cond
        ((> (+ i 4) n) -1)
        ((and (= (char-at s i) 13)
              (and (= (char-at s (+ i 1)) 10)
                   (and (= (char-at s (+ i 2)) 13)
                        (= (char-at s (+ i 3)) 10))))
         i)
        (true (recur (+ i 1)))))))

;; find-colon — byte offset of the first ':' in `s`, or -1. Used to
;; split one already-isolated header line into name/value without
;; string/split's own "every occurrence" behavior discarding a colon
;; that belongs to the value.
(defn find-colon [(s : String @ Region)]
  : I32
  (let [n (length s)]
    (loop [i 0]
      (cond
        ((>= i n) -1)
        ((= (char-at s i) 58) i)   ;; ASCII ':'
        (true (recur (+ i 1)))))))

;; trim-trailing-cr — drops one trailing '\r', if present. Every header
;; line split off of a "\r\n"-terminated block carries one; body text
;; never passes through here (it is taken verbatim past the
;; find-crlfcrlf boundary, see the file header comment).
(defn trim-trailing-cr [(s : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [n (length s)]
    (if (and (> n 0) (= (char-at s (- n 1)) 13))
      (substring s 0 (- n 1) dest)
      s)))

;; trim-leading-space — drops at most one leading ' '. "Name: Value"
;; headers conventionally carry exactly one space after the colon;
;; real, narrow, matches the one real shape this parses.
(defn trim-leading-space [(s : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (if (and (> (length s) 0) (= (char-at s 0) 32))
    (substring s 1 (length s) dest)
    s))

;; ---- request building

;; build-request — the raw request text for one HTTP/1.1 call.
;; Content-Type/Content-Length are only emitted when `body` is Some --
;; a GET with no body sends neither, matching real HTTP client
;; convention (an empty Content-Length: 0 is legal but not what any
;; real server expects from a bodyless GET).
;;
;; Real CRLF line endings (2026-09-02, found load-bearing against a real
;; chromedriver session -- see PARENA's own CHANGELOG for the full trace).
;; This function used to send bare `\n` only, on the theory that every real
;; server it had actually been tested against (IDUNA's own Go net/http)
;; parses bare-LF requests without complaint -- true, but not universal:
;; chromedriver's own embedded HTTP server does NOT tolerate it (a real,
;; identical JSON body succeeds via curl -- which sends real CRLF -- and
;; fails via this client with an empty-body protocol error). Real, honest
;; compiler limitation this works around, still not fixed at the source:
;; src/lexer.c's own lex_string() only unescapes `\n` inside a string
;; literal (confirmed live in source -- no `case 'r'` at all), so a literal
;; `\r` in a PARENA string can't be written directly -- `crlf` below builds
;; a real carriage-return byte via `string/char-from-code` instead. A real,
;; separate, smaller compiler fix (add `case 'r'` to the lexer) would remove
;; the need for this -- flagged, not fixed here, since this file's own real
;; scope is stdlib, not the compiler.
;;
;; Real, second limitation found building this: VS0 rejects re-binding
;; the same name twice in one `let` (each binding becomes its own C
;; declaration, so a second `head` is a C redeclaration error) --
;; every step below therefore nests calls (`(concat (concat a b) c)`)
;; rather than accumulating through a repeatedly-rebound `head`, the
;; same shape sed.prn's own `(string/concat (string/concat acc ...) ...)`
;; already establishes as this stdlib's real, working idiom for
;; multi-step string building.
(defn build-request [(method : String @ Region) (host : String @ Region) (path : String @ Region)
                      (body : (Option String) @ Region) (dest : Arena @ Region)]
  : String @ Region
  (let [crlf (string/concat (string/char-from-code 13 dest) "\n" dest)
        head (string/concat
               (string/concat
                 (string/concat
                   (string/concat
                     (string/concat
                       (string/concat
                         (string/concat method " " dest)
                         path dest)
                       " HTTP/1.1" dest)
                     crlf dest)
                   (string/concat "Host: " host dest) dest)
                 crlf dest)
               (string/concat "Connection: close" crlf dest) dest)]
    (match body
      ((Some b)
        (string/concat
          (string/concat
            (string/concat
              (string/concat
                (string/concat head "Content-Type: application/json" dest)
                crlf dest)
              (string/concat "Content-Length: " (string/i32-to-string (length b) dest) dest) dest)
            (string/concat crlf crlf dest) dest)
          b dest))
      (None (string/concat head crlf dest)))))

;; ---- response parsing

;; parse-status-line — "HTTP/1.1 200 OK" (trailing \r already trimmed
;; by the caller) -> 200. Splits on a single space; string/split's
;; every-occurrence behavior is fine here since the reason-phrase after
;; the second space is discarded anyway.
(defn parse-status-line [(line : String @ Region) (dest : Arena @ Region)]
  : I32
  (let [parts (string/split line " " dest)]
    (if (< (vec/len &parts) 2)
      0
      (match (parse-i32 (vec/get &parts 1) dest)
        ((Ok n) (deref n))
        ((Err _) 0)))))

;; parse-http-response — real, live-verified shape (see
;; net/webdriver_test.prn): finds the header/body boundary once via
;; find-crlfcrlf, line-splits only the header block, parses the status
;; line and each "Name: Value" header, and takes the body verbatim from
;; the original string (never re-derived from the split lines, so a
;; JSON body's own newlines/colons never corrupt parsing).
(defn parse-http-response [(raw : String @ Region) (dest : Arena @ Region)]
  : HttpResponse @ Region
  (let [boundary (find-crlfcrlf raw)
        head-text (if (>= boundary 0) (substring raw 0 boundary dest) raw)
        body (if (>= boundary 0) (substring raw (+ boundary 4) (length raw) dest) "")
        lines (string/split head-text "\n" dest)
        names (vec/new dest)
        values (vec/new dest)
        n-lines (vec/len &lines)
        status (if (> n-lines 0) (parse-status-line (trim-trailing-cr (vec/get &lines 0) dest) dest) 0)
        scan (loop [i 1]
               (cond
                 ((>= i n-lines) 0)
                 (true
                   (let [line (trim-trailing-cr (vec/get &lines i) dest)
                         colon (find-colon line)]
                     (cond
                       ((< colon 0) (recur (+ i 1)))
                       (true
                         (do
                           (vec/push! &names (substring line 0 colon dest))
                           (vec/push! &values (trim-leading-space (substring line (+ colon 1) (length line) dest) dest))
                           (recur (+ i 1)))))))))]
    (do
      scan
      {:status status
       :header-names names
       :header-values values
       :body body})))

;; ---- public client API

(defn http-request [(method : String @ Region) (host : String @ :region/scratch) (port : I32)
                     (path : String @ Region) (body : (Option String) @ Region) (dest : Arena @ Region)]
  : (Result HttpResponse NetError) @ Region
  (match (net/tcp/tcp-connect host port dest)
    ((Ok !stream)
      (do
        (net/tcp/tcp-write !stream (build-request method host path body dest) dest)
        (match (net/tcp/tcp-read !stream dest)
          ((Ok raw)
            (do
              (net/tcp/tcp-close !stream dest)
              (Ok (parse-http-response raw dest))))
          ((Err e) (Err e)))))
    ((Err e) (Err e))))

(defn http-get [(host : String @ :region/scratch) (port : I32) (path : String @ Region) (dest : Arena @ Region)]
  : (Result HttpResponse NetError) @ Region
  (http-request "GET" host port path None dest))

(defn http-post [(host : String @ :region/scratch) (port : I32) (path : String @ Region)
                  (body : String @ Region) (dest : Arena @ Region)]
  : (Result HttpResponse NetError) @ Region
  (http-request "POST" host port path (Some body) dest))
