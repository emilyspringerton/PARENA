;; stdlib/bedrockracers/web/br_sim.prn -- the simulation driver: commands, the replay log, the 16 ms tick.
;;
;; A human's command is nine numbers; here it is made into EIGHT BYTES -- thr, steer, pitch, roll, strafe (signed, /127), lift
;; (unsigned, /255), flags (1 boost, 2 fans off, 4 magnet), a spare -- and the car is driven FROM THOSE BYTES, in the live game and
;; in a replay alike. So the log IS the human half of the match: with (seed, level, roster) it replays bit for bit.

(defn tick-ms [] : F32 16.0)

;; ---- pending commands: 12 x 8 bytes -------------------------------------------------------------------------
(defn pend-base [] : I32 172544)
(defn pend-addr [(s : I32) (k : I32)] : I32 (+ (pend-base) (+ (* s 8) k)))

(defn quant [(v : F32)] : I32 (clamp-i (i32 (floor (+ (* v 127.0) 0.5))) -127 127))
(defn quant-u [(v : F32)] : I32 (clamp-i (i32 (floor (+ (* v 255.0) 0.5))) 0 255))
(defn sbyte [(b : I32)] : I32 (if (> b 127) (- b 256) b))

;; write the local player's global command (g-cmd-*) into slot s's pending bytes
(defn pend-from-cmd! [(s : I32)] : Unit
  (do
    (store8! (pend-addr s 0) (bit-and (quant (gf (g-cmd-thr))) 255))
    (store8! (pend-addr s 1) (bit-and (quant (gf (g-cmd-steer))) 255))
    (store8! (pend-addr s 2) (bit-and (quant (gf (g-cmd-pitch))) 255))
    (store8! (pend-addr s 3) (bit-and (quant (gf (g-cmd-roll))) 255))
    (store8! (pend-addr s 4) (bit-and (quant (gf (g-cmd-strafe))) 255))
    (store8! (pend-addr s 5) (quant-u (gf (g-cmd-lift))))
    (store8! (pend-addr s 6) (+ (+ (b2i (!= (gi (g-cmd-boost)) 0)) (* 2 (b2i (!= (gi (g-cmd-fans-off)) 0))))
                                (* 4 (b2i (!= (gi (g-cmd-magnet)) 0)))))
    (store8! (pend-addr s 7) 0)))

(defn pend-clear! [(s : I32)] : Unit (dotimes [k 8] (store8! (pend-addr s k) 0)))

(defn apply-pend! [(s : I32)] : Unit
  (let [fl (load8 (pend-addr s 6))]
    (set-c-in-thr! s (/ (f32 (sbyte (load8 (pend-addr s 0)))) 127.0))
    (set-c-in-steer! s (/ (f32 (sbyte (load8 (pend-addr s 1)))) 127.0))
    (set-c-in-pitch! s (/ (f32 (sbyte (load8 (pend-addr s 2)))) 127.0))
    (set-c-in-roll! s (/ (f32 (sbyte (load8 (pend-addr s 3)))) 127.0))
    (set-c-in-strafe! s (/ (f32 (sbyte (load8 (pend-addr s 4)))) 127.0))
    (set-c-in-lift! s (/ (f32 (load8 (pend-addr s 5))) 255.0))
    (set-c-in-boost! s (bit-and fl 1))
    (set-c-in-fans-off! s (bit-and (shr fl 1) 1))
    (set-c-in-magnet! s (bit-and (shr fl 2) 1))))

;; ---- the log ------------------------------------------------------------------------------------------------------
(defn log-room? [] : Bool (< (+ (* (gi (g-log-n)) 8) 8) (log-cap)))

;; every human's pending bytes, in slot order, appended
(defn log-append! [] : Unit
  (dotimes [s (max-cars)]
    (when (and (human? s) (log-room?))
      (let [a (+ (log-base) (* (gi (g-log-n)) 8))]
        (dotimes [k 8] (store8! (+ a k) (load8 (pend-addr s k))))
        (gi! (g-log-n) (+ (gi (g-log-n)) 1))))))

;; a replay: pull every human's bytes for this tick out of the log
(defn log-read! [] : Unit
  (dotimes [s (max-cars)]
    (when (human? s)
      (if (< (gi (g-replay-pos)) (gi (g-log-n)))
          (let [a (+ (log-base) (* (gi (g-replay-pos)) 8))]
            (dotimes [k 8] (store8! (pend-addr s k) (load8 (+ a k))))
            (gi! (g-replay-pos) (+ (gi (g-replay-pos)) 1)))
          (pend-clear! s)))))

;; ---- one tick ---------------------------------------------------------------------------------------------------------
;; the online room (br_net.prn) fills the other humans' pending bytes before this runs; the local one is read here
(defn gather-pend! [] : Unit
  (if (= (gi (g-replay)) 1)
      (log-read!)
      (do (when (human? (gi (g-me))) (pend-from-cmd! (gi (g-me))))
          (log-append!))))

;; the cosmetics (br_fx.prn) run last, after the match has moved, and on the frozen countdown ticks too; they only read the match
(defn sim-tick! [] : Unit
  (cond
    (> (gi (g-countdown)) 0)
      (do (capture-prev!)
          (gi! (g-countdown) (- (gi (g-countdown)) 1))
          (set-b-hit-t! 0)
          (fx-tick!))
    :else
      (do
        (capture-prev!)
        (gather-pend!)
        (dotimes [s (max-cars)] (when (human? s) (apply-pend! s)))
        (ai-think-all!)
        (physics-tick!)
        (gi! (g-tick) (+ (gi (g-tick)) 1))
        (rules-tick!)
        (fx-tick!))))
