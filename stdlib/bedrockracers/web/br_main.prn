;; stdlib/bedrockracers/web/br_main.prn -- the exports the page calls (and the test hooks).
(defn br-init [] : Unit
  (do (load-font) (init-arena!) (build-meshes!) (gi! (g-rng2) 9001)
      (gf! (g-sens) 1.0) (gi! (g-phase) 0) (gi! (g-cam-mode) 3)
      ;; memory starts zeroed, and holder 0 would mean car 0 has the ball: nobody has it
      (set-b-holder! -1) (set-b-pass-from! -1)))
(defn br-car-addr [(s : I32)] : I32 (car-base s))
(defn br-ball-addr [] : I32 (ball-base))
(defn br-g [(k : I32)] : I32 (gi k))
;; what the renderer reads every frame for ON FIRE's lighting (br_fx.prn; the layout is in br_mem.prn's memory map): the dynamic
;; light table, how many of its sixteen lights are lit, the drama scalar, the goal flash; and the particles
(defn br-lights-addr [] : I32 (lights-base))
(defn br-light-count [] : I32 (light-count))
(defn br-drama [] : F32 (drama-level))
(defn br-flash [] : F32 (loadf32 (lt-flash-addr)))
(defn br-parts-addr [] : I32 (part-base))
(defn br-part-live [] : I32 (gi (g-part-live)))
(defn br-t-place [(s : I32) (x : F32) (y : F32) (z : F32)] : Unit
  (do (set-c-active! s 1) (place-car! s x y z) (set-c-air! s 100.0)))
;; a JS caller that passes only the first nine arguments gets magnet = 0 (wasm fills a missing argument with zero)
(defn br-t-cmd [(s : I32) (thr : F32) (steer : F32) (pitch : F32) (roll : F32) (strafe : F32) (lift : F32) (boost : I32) (fansoff : I32) (magnet : I32)] : Unit
  (do (set-c-in-thr! s thr) (set-c-in-steer! s steer) (set-c-in-pitch! s pitch) (set-c-in-roll! s roll)
      (set-c-in-strafe! s strafe) (set-c-in-lift! s lift) (set-c-in-boost! s boost) (set-c-in-fans-off! s fansoff)
      (set-c-in-magnet! s (b2i (!= magnet 0)))))
;; put the ball somewhere: a placed ball is a free ball
(defn br-t-ball [(x : F32) (y : F32) (z : F32) (vx : F32) (vy : F32) (vz : F32)] : Unit
  (do (free-ball!) (set-b-x! x) (set-b-y! y) (set-b-z! z) (set-b-vx! vx) (set-b-vy! vy) (set-b-vz! vz)))
;; the magnet's hooks: hand car s the ball (a catch, with its credit), and the kickoff / command-byte paths on their own
(defn br-t-give [(s : I32)] : Unit (catch! s))
(defn br-t-kickoff [] : Unit (kickoff! 0))
(defn br-t-end [] : Unit (end-match! -1 4))
(defn br-t-pend-from-cmd [(s : I32)] : Unit (pend-from-cmd! s))
(defn br-t-apply-pend [(s : I32)] : Unit (apply-pend! s))
(defn br-t-pend-byte [(s : I32) (k : I32)] : I32 (load8 (pend-addr s k)))
(defn br-t-setg [(k : I32) (v : I32)] : Unit (gi! k v))
(defn br-t-setgf [(k : I32) (v : F32)] : Unit (gf! k v))
;; the physics on the bench, n ticks (and the cosmetics after each, which never change it)
(defn br-t-step [(n : I32)] : Unit
  (dotimes [i n] (capture-prev!) (physics-tick!) (gi! (g-tick) (+ (gi (g-tick)) 1)) (fx-tick!)))
;; ON FIRE's hooks: a goal into `tower` scored by `who` with `assist` (-1 none) as the last two touches, through the real
;; on-goal!; set car s on fire as if it had just earned it; the cosmetics alone, n ticks
(defn br-t-score [(who : I32) (assist : I32) (tower : I32)] : Unit
  (do (free-ball!) (set-b-touch! who) (set-b-touch2! assist) (set-b-touch-team! (if (>= who 0) (c-team who) -1))
      (on-goal! tower)))
(defn br-t-ignite [(s : I32)] : Unit (ignite! s))
(defn br-t-fx [(n : I32)] : Unit (dotimes [i n] (fx-tick!)))
(defn br-t-free [(x : F32) (y : F32) (z : F32)] : F32 (arena-free x y z))
(defn br-t-road [(x : F32) (z : F32)] : I32 (road-at x z))
;; a whole match on the bench: begin (all bots unless a roster says otherwise) and run
(defn br-t-begin [(seed : I32) (level : I32) (roster : I32)] : Unit
  (do (begin-match! seed level roster) (gi! (g-phase) 1) (gi! (g-countdown) 0)))
(defn br-t-play [(n : I32)] : Unit
  (dotimes [i n] (when (= (gi (g-phase)) 1) (sim-tick!))))
(defn br-t-pred-update [] : Unit (pred-update!))
(defn br-t-plan [(px : F32) (py : F32) (pz : F32) (own : I32) (want : I32) (speed : F32)] : F32
  (do (plan-shot! px py pz own want speed) (gf (pl-score))))
(defn br-t-whatif [(x : F32) (y : F32) (z : F32) (vx : F32) (vy : F32) (vz : F32) (own : I32) (want : I32)] : F32
  (what-if x y z vx vy vz own want))
;; the bots on the bench: re-assign car s a level's genome (to pit levels against each other in one match); the carrier's own
;; trigger (the what-if at the physics' step, n substeps, no lane reading)
(defn br-t-assign [(s : I32) (level : I32)] : Unit (ai-assign! s level))
(defn br-t-whatif-fine [(x : F32) (y : F32) (z : F32) (vx : F32) (vy : F32) (vz : F32) (own : I32) (want : I32) (n : I32)] : F32
  (what-if-fine x y z vx vy vz own want n -1))

;; ---- the page's exports ----------------------------------------------------------------------------------------------------------------
(defn br-frame [(now : F64)] : Unit (frame! now))
(defn br-key [(id : I32) (down : I32)] : Unit (in-key! id down))
(defn br-blur [] : Unit (in-clear-keys!))
(defn br-mouse [(dx : F32) (dy : F32)] : Unit (in-mouse! dx dy))
(defn br-pointer [(x : I32) (y : I32)] : Unit (in-pointer! x y))
(defn br-button [(b : I32) (down : I32)] : Unit (in-button! b down))
(defn br-pad [(slot : I32) (lx : F32) (ly : F32) (rx : F32) (ry : F32) (lt : F32) (rt : F32) (buttons : I32)] : Unit
  (in-pad! slot lx ly rx ry lt rt buttons))
(defn br-pad-gone [(slot : I32)] : Unit (in-pad-gone! slot))
(defn br-lock [(on : I32)] : Unit
  (do (gi! (g-locked) on)
      (when (and (= (gi (g-phase)) 1) (human-playing?)) (gi! (g-paused) (if (= on 0) 1 0)))))
(defn br-sens [(s : F32)] : Unit (gf! (g-sens) s))
(defn br-wants-lock [] : I32 (b2i (and (= (gi (g-phase)) 1) (human-playing?))))
(defn br-phase [] : I32 (gi (g-phase)))
(defn br-fb-addr [] : I32 (fb-base))
(defn br-fb-w [] : I32 640)
(defn br-fb-h [] : I32 360)
(defn br-ticks [] : I32 (gi (g-tick)))
(defn br-mem-bytes [] : I32 8388608)
(defn br-t-start [(roster : I32) (seed : I32)] : Unit
  (do (gi! (g-ticker) seed) (start-match! roster)))
(defn br-t-title [] : Unit (go-title!))
(defn br-t-render [(al : F32)] : Unit (ui-render! al))
(defn br-t-cam [(mode : I32)] : Unit (gi! (g-cam-mode) mode))
;; the page's labels and its focus handling: what the match is doing, and "the tab went away" (a person's match waits for them)
(defn br-pause [] : Unit
  (when (and (= (gi (g-phase)) 1) (human-playing?)) (gi! (g-paused) 1) (clear-cmd!)))
;; 0 title, 1 playing, 2 watching bots, 3 paused, 4 match over
(defn br-status [] : I32
  (let [ph (gi (g-phase))]
    (cond (= ph 0) 0
          (= ph 2) 4
          (= (gi (g-paused)) 1) 3
          (human-playing?) 1
          :else 2)))
