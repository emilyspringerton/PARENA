(defn g-cam-rz [] : I32 61)
(defn g-cam-ux [] : I32 62)
(defn g-cam-uy [] : I32 63)
(defn g-cam-uz [] : I32 64)
(defn g-cam-fx [] : I32 65)
(defn g-cam-fy [] : I32 66)
(defn g-cam-fz [] : I32 67)
