;; stdlib/bedrockracers/web/br_mem.prn -- BEDROCK RACERS web engine: linear-memory map, accessors, math.
;;
;; Founder real-time 2026-10-17: "IMPLEMENT BEDROCK RACERS USE SHANKPIT ARENA LEVEL WITH THE DIRT TRACK AROUND IT ... 4 GOALS 1 GOAL
;; ON EACH CORNER OF THE ARENA AT THE TOP OF IT LIKE QUIDDICH ... PRECISELY CONTROL THEIR CARS LIKE YOU CAN WITH THE AIR WITH THE TESLA
;; ROCKET CAR ... WASM PARENA ESPORTS WOTAN IDUNA IAM STATS ... SET UP LIKE REDGARDEN INCLUDING SOME OF THE EXOTIC AI TECHNOLOGIES ...
;; WE NEED A GAME WITH THE AFFORDANCES OF ROCKET LEAGUE BUT ITS ACTUALLY QUIDDICH ... THE GOALS UPSIDE DOWN ... 4 TEAMS AND THE CARS ARE
;; ALL ROCKET CARS ... DONT WORRY ABOUT VOXEL STUFF FOR v0 FOCUS ON THE SPORT THIS IS AN ESPORT".
;;
;; Same shape as shankpit-460 web / BRAWLPIT web / EMPIRE web: the whole game -- the physics, the bots, the 3D software renderer, the
;; menus, the replay format -- is PARENA compiled to wasm32 (no allocator, no imports, a fixed 8 MB). The page host (br_host.prn,
;; PARENA -> TypeScript) only does what a browser alone can do. The match is a DETERMINISTIC function of (seed, roster, the humans'
;; per-tick commands); that is what lets IDUNA replay a submitted match in the very same wasm and record only what it saw.
;;
;; Memory map (byte addresses; module linked with 8 MB, fixed):
;;   0x020000 CTL      input: key table, mouse, pad slots               (br_input.prn)
;;   0x021000 G        global state words                               (g-* below)
;;   0x022000 CARS     12 x 512 bytes, 128 words each                   (br_fields.prn)
;;   0x024000 BALL     one record
;;   0x025000 PARTS    256 x 64 bytes                                    (dust, plumes, sparks)
;;   0x02A000 NAMES    12 x 32 bytes, NUL-terminated ASCII
;;   0x02B000 NETIN    8 KB   frames from the gateway                    (br_net.prn)
;;   0x02D000 NETOUT   8 KB   frames for the gateway
;;   0x02F000 TOKEN    2 KB   the IDUNA bearer token, written by the page
;;   0x030000 FONT     255 glyphs x 16 rows
;;   0x031000 FEED     8 feed lines x 64 bytes
;;   0x032000 BOARD    scoreboard rows built for the end screen
;;   0x033000 SCR      rasteriser polygon scratch
;;   0x038000 MESH     the arena shell: 6 faces x 12 x 12 vertices      (br_mesh.prn)
;;   0x060000 TEX      256 x 256 RGBA floor texture (the dirt track)
;;   0x0A0000 ROAD     256 x 256 bytes: how road-like each floor cell is
;;   0x100000 FB       640 x 360 RGBA framebuffer
;;   0x200000 ZB       640 x 360 F32 depth buffer
;;   0x300000 SND      sound event ring (page plays them)
;;   0x310000 REPLAY header: seed, roster, results                       (br_replay.prn)
;;   0x400000 LOG      the humans' commands, 8 bytes per human per tick

(module bedrockracers/engine)

;; ---- region bases -----------------------------------------------------------------------
(defn ctl-base [] : I32 131072)
(defn g-base [] : I32 135168)
(defn cars-base [] : I32 139264)
(defn ball-base [] : I32 147456)
(defn part-base [] : I32 151552)
(defn names-base [] : I32 172032)
(defn netin-base [] : I32 176128)
(defn netout-base [] : I32 184320)
(defn token-base [] : I32 192512)
(defn font-base [] : I32 196608)
(defn feed-base [] : I32 200704)
(defn board-base [] : I32 204800)
(defn mesh-base [] : I32 229376)
(defn tex-base [] : I32 393216)
(defn road-base [] : I32 655360)
(defn snd-base [] : I32 3145728)
(defn rep-base [] : I32 3211264)
(defn log-base [] : I32 4194304)
(defn log-cap [] : I32 4128768)
(defn fb-base [] : I32 1048576)
(defn zb-base [] : I32 2097152)

(defn fb-w [] : I32 640)
(defn fb-h [] : I32 360)

(defn max-cars [] : I32 12)
(defn max-parts [] : I32 256)
(defn team-size [] : I32 3)
(defn team-count [] : I32 4)

(defn car-base [(s : I32)] : I32 (+ (cars-base) (* s 512)))
(defn pa-base [(f : I32)] : I32 (+ (part-base) (* f 64)))
(defn name-addr [(p : I32)] : I32 (+ (names-base) (* (clamp-i p 0 11) 32)))

;; generic by-index word access (for helpers that take a field index)
(defn ci [(s : I32) (k : I32)] : I32 (load32 (+ (car-base s) (shl k 2))))
(defn ci! [(s : I32) (k : I32) (v : I32)] : Unit (store32! (+ (car-base s) (shl k 2)) v))
(defn cf [(s : I32) (k : I32)] : F32 (loadf32 (+ (car-base s) (shl k 2))))
(defn cf! [(s : I32) (k : I32) (v : F32)] : Unit (storef32! (+ (car-base s) (shl k 2)) v))

;; ---- global state words ------------------------------------------------------------------
(defn gi [(k : I32)] : I32 (load32 (+ (g-base) (shl k 2))))
(defn gi! [(k : I32) (v : I32)] : Unit (store32! (+ (g-base) (shl k 2)) v))
(defn gf [(k : I32)] : F32 (loadf32 (+ (g-base) (shl k 2))))
(defn gf! [(k : I32) (v : F32)] : Unit (storef32! (+ (g-base) (shl k 2)) v))

;; simulation
(defn g-tick [] : I32 0)           ; sim ticks since the match started
(defn g-rng [] : I32 1)
(defn g-me [] : I32 2)             ; the local human's car slot
(defn g-mode [] : I32 3)           ; 0 practice (local authority), 1 online room (lockstep)
(defn g-match-left [] : I32 4)     ; ticks of match time left
(defn g-match-total [] : I32 5)
(defn g-goal-limit [] : I32 6)
(defn g-winner [] : I32 7)         ; team, or -1
(defn g-end-reason [] : I32 8)     ; 1 goal limit, 2 time, 3 golden goal, 4 closed
(defn g-bot-level [] : I32 9)      ; 1 easy, 2 normal, 3 hard, 4 champion
(defn g-match-no [] : I32 10)      ; matches started this session
(defn g-countdown [] : I32 11)     ; ticks of the kickoff countdown (the sim is frozen)
(defn g-overtime [] : I32 12)      ; 1 = golden goal
(defn g-seed [] : I32 13)          ; the match seed (replay header)
(defn g-roster [] : I32 14)        ; bit s = car s is a human
(defn g-kickoff-t [] : I32 15)     ; ticks since the last kickoff
(defn g-phase [] : I32 16)         ; 0 title, 1 playing, 2 match end
(defn g-frame [] : I32 17)
(defn g-clock-acc [] : I32 18)     ; F32 ms owed to the fixed-step sim
(defn g-ticker [] : I32 19)        ; wall-clock ms as I32 (animation only, never sim)
(defn g-locked [] : I32 20)        ; 1 = pointer is captured
(defn g-paused [] : I32 21)
(defn g-ui-t [] : I32 22)
(defn g-hover [] : I32 23)
(defn g-last-input [] : I32 24)
(defn g-banner-t [] : I32 25)      ; ticks of the big centre banner
(defn g-banner-id [] : I32 26)     ; 1 goal, 2 own goal, 3 kickoff, 4 overtime
(defn g-banner-team [] : I32 27)
(defn g-banner-slot [] : I32 28)
(defn g-score-open [] : I32 29)    ; TAB held
(defn g-goal-t [] : I32 30)        ; ticks of the goal celebration (the sim keeps running, the ball is dead)
(defn g-goal-tower [] : I32 31)
(defn g-score [] : I32 32)         ; 32..35 goals per team
(defn g-conceded [] : I32 36)      ; 36..39 goals against per team
(defn g-syn-tier [] : I32 40)      ; 40..43 synergy tier per team (0 = full cohesion .. 3 = decayed)
(defn g-posture [] : I32 44)       ; 44..47 commander posture per team (0 neutral 1 aggressive 2 patient)
(defn g-gest [] : I32 48)          ; 48..51 noisy-gestalt phase per team (0 Johnny spread, 1 Spike converge)
(defn g-tgt-tower [] : I32 52)     ; 52..55 which tower each team is attacking
(defn g-cam-x [] : I32 56)
(defn g-cam-y [] : I32 57)
(defn g-cam-z [] : I32 58)
