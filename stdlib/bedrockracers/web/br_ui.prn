;; stdlib/bedrockracers/web/br_ui.prn -- the minimal flow: title -> a match -> the end, a restrained placeholder HUD, the frame.
;;
;; This is the FOUNDATION's flow, enough to play and to watch: the HUD and the screens proper are a later stage's (they replace
;; draw-title!, draw-hud!, draw-end! and may take over ui-keys!; G words 448..511 are theirs).
;;   TITLE  (phase 0)  the empty arena turning slowly under its lamps; ENTER / Space / pad A: a match against level-2 bots, you in
;;                     slot 0 (team amber); B / pad X: watch twelve bots play (the spectator camera)
;;   MATCH  (phase 1)  the sim at a fixed 16 ms step (br_sim.prn's tick-ms: the physics' dt is 0.016, so the step is 62.5 Hz
;;                     rather than exactly 60 -- one sim tick per display frame on a 60 Hz screen, with the odd frame that runs
;;                     two); Esc / pad Start pauses (a bot match waits for you), V / pad Y toggles the ball cam
;;   END    (phase 2)  the result over the frozen arena; ENTER / Esc / pad A: back to the title

(defn clock-slot [] : I32 (+ (g-base) 1504))   ; F64 at G words 376..377: the previous br-frame timestamp

;; ---- starting and leaving --------------------------------------------------------------------------------------------------------------
;; roster: bit s = car s is driven by the person at this keyboard (1: slot 0, team 0; 0: bots only)
(defn start-match! [(roster : I32)] : Unit
  (do (begin-match! (+ (gi (g-ticker)) (* 7919 (gi (g-match-no)))) 2 roster)
      (gi! (g-me) 0) (gi! (g-view-slot) 0)
      (gi! (g-phase) 1) (gi! (g-paused) 0) (gi! (g-end-t) 0) (gi! (g-ui-t) 0)
      (clear-cmd!)
      (cam-for-match!)))

(defn go-title! [] : Unit
  (do (gi! (g-phase) 0) (gi! (g-paused) 0) (gi! (g-ui-t) 0) (gi! (g-cam-mode) 3) (clear-cmd!)))

(defn human-playing? [] : Bool (!= (gi (g-roster)) 0))

;; the keys that drive the flow, once per tick
(defn ui-keys! [] : Unit
  (let [ph (gi (g-phase))
        go (or (or (key-hit? (kc-enter)) (key-hit? (kc-space))) (or (any-pad-hit? (pb-a)) (any-pad-hit? (pb-start))))]
    (cond
      (= ph 0) (cond go (start-match! 1)
                     (or (key-hit? (kc-b)) (any-pad-hit? (pb-x))) (start-match! 0)
                     :else unit)
      (= ph 1) (do
                 (when (or (key-hit? (kc-esc)) (any-pad-hit? (pb-start)))
                   (gi! (g-paused) (- 1 (gi (g-paused))))
                   (clear-cmd!))
                 (when (and (human-playing?) (or (key-hit? (kc-v)) (any-pad-hit? (pb-y))))
                   (gi! (g-ball-cam) (- 1 (gi (g-ball-cam))))
                   (gi! (g-cam-mode) (if (= (gi (g-ball-cam)) 1) 1 0))))
      :else (when (and (> (gi (g-end-t)) 30) (or go (key-hit? (kc-esc)))) (go-title!)))))

;; one fixed step: the person's command, the sim, the flow keys, the input edges spent
(defn step-once! [] : Unit
  (do
    (when (and (= (gi (g-phase)) 1) (= (gi (g-paused)) 0))
      (if (human-playing?) (gather-cmd!) (clear-cmd!))
      (sim-tick!))
    (ui-keys!)
    (when (= (gi (g-phase)) 2) (gi! (g-end-t) (+ (gi (g-end-t)) 1)))
    (gi! (g-ui-t) (+ (gi (g-ui-t)) 1))
    (end-input-tick!)))

;; ---- the placeholder HUD ---------------------------------------------------------------------------------------------------------------------
(defn ink [] : I32 (rgb 232 228 218))
(defn ink-dim [] : I32 (rgb 150 150 160))
(defn panel-ink [] : I32 (rgb 14 15 22))

(defn secs-left [] : I32 (/ (+ (* (gi (g-match-left)) 2) 124) 125))

(defn draw-hud! [] : Unit
  (do
    ;; the clock and the four scores, one quiet strip at the top
    (card 236 6 168 22 (panel-ink) 150 (rgb 90 92 110) 60)
    (dotimes [t 4]
      (let [x (+ 244 (* t 26)) c (team-color t)]
        (fill-rect x 11 3 12 c)
        (draw-int (score-of t) (+ x 6) 9 1 (ink))))
    (if (= (gi (g-overtime)) 1)
        (draw-text "OT" 360 9 1 (rgb 236 184 92))
        (draw-clock (secs-left) 352 9 1 (ink)))
    ;; the kickoff count
    (when (> (gi (g-countdown)) 0)
      (draw-int-c (max-i 1 (/ (+ (* (gi (g-countdown)) 2) 124) 125)) 320 130 4 (ink)))
    ;; a goal
    (when (> (gi (g-goal-t)) 0)
      (let [t (gi (g-banner-team))]
        (draw-text-c (if (= (gi (g-banner-id)) 2) "OWN GOAL" "GOAL") 320 120 3 (team-color t))
        (draw-text-c (team-name t) 320 172 1 (ink-dim))))
    (when (= (gi (g-paused)) 1)
      (card 250 150 140 40 (panel-ink) 200 (rgb 120 122 140) 90)
      (draw-text-c "PAUSED" 320 157 2 (ink))
      (draw-text-c "Esc to play on" 320 178 1 (ink-dim)))))

(defn draw-title! [] : Unit
  (do
    (fill-rect-a 0 112 640 120 (panel-ink) 150)
    (draw-text-c "BEDROCK RACERS" 320 128 3 (ink))
    (dotimes [t 4] (fill-rect (+ 262 (* t 30)) 182 26 3 (team-color t)))
    (draw-text-c "ENTER  play the bots          B  watch the bots" 320 198 1 (ink-dim))))

(defn draw-end! [] : Unit
  (let [w (gi (g-winner))]
    (card 200 120 240 84 (panel-ink) 210 (rgb 120 122 140) 90)
    (if (>= w 0)
        (do (draw-text-c (team-name w) 320 134 3 (team-color w))
            (draw-text-c "WIN" 320 166 1 (ink)))
        (draw-text-c "MATCH OVER" 320 140 2 (ink)))
    (draw-text-c "ENTER  back to the title" 320 186 1 (ink-dim))))

;; ---- the frame ------------------------------------------------------------------------------------------------------------------------------
(defn ui-render! [(al : F32)] : Unit
  (let [ph (gi (g-phase))]
    (if (= ph 0)
        (do (gi! (g-cam-mode) 3) (cam-update! al) (render-world! al false) (draw-title!))
        (do (cam-update! al) (render-world! al true) (draw-hud!) (when (= ph 2) (draw-end!))))))

;; advance the sim by however many 16 ms ticks real time owes (at most six: a stalled tab does not fast-forward a minute), then
;; draw. alpha, how far the clock is into the next tick, blends every pose; it is 1 whenever the sim is not running (paused, the
;; title, the end), so nothing twitches between two frozen ticks.
(defn frame! [(now : F64)] : Unit
  (let [(last : F64) (loadf64 (clock-slot))
        (dt : F32) (if (> last 0.0) (f32 (- now last)) 16.0)]
    (storef64! (clock-slot) now)
    (gi! (g-ticker) (i32 now))
    (gi! (g-frame) (+ (gi (g-frame)) 1))
    ;; the camera and the ball's spin run on wall-clock time; a paused match holds its view exactly where it is
    (gf! (g-cam-dt) (if (and (= (gi (g-phase)) 1) (= (gi (g-paused)) 1)) 0.0 (* (clamp-f dt 0.0 50.0) 0.001)))
    (gf! (g-clock-acc) (+ (gf (g-clock-acc)) (clamp-f dt 0.0 100.0)))
    (loop [steps 0]
      (when (and (>= (gf (g-clock-acc)) (tick-ms)) (< steps 6))
        (step-once!)
        (gf! (g-clock-acc) (- (gf (g-clock-acc)) (tick-ms)))
        (recur (+ steps 1))))
    (when (> (gf (g-clock-acc)) (tick-ms)) (gf! (g-clock-acc) (tick-ms)))
    (ui-render! (if (and (= (gi (g-phase)) 1) (= (gi (g-paused)) 0))
                    (clamp-f (/ (gf (g-clock-acc)) (tick-ms)) 0.0 1.0)
                    1.0))))
