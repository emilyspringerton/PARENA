;; stdlib/bedrockracers/web/br_phys.prn -- the rocket car, the ball, and the world they share. 60 Hz (16 ms ticks), two substeps each.
;;
;; THE CAR is modelled on the Tesla Roadster rocket demo (the founder's reference): a low car with FOUR LIFT NOZZLES under it
;; and cold-gas jets on its flanks, plus FANS under the floor that suck it onto the road so it can drive inverted. Everything it
;; spends comes from one tank of compressed AIR (like mana: it refills far faster than boost does in Rocket League).
;;
;;   on a surface  (fans on and a surface within reach)   the car's up axis swings onto the surface normal, gravity is beaten by
;;                 the fans, so floor, wall and ceiling are all "road". W/S throttle, A/D steer. The tyres hold the car up to a
;;                 limit (dirt holds far less than concrete): past it the tail steps out and the car drifts. The fans only
;;                 catch a car belly-down, so a car that lands on its roof scrapes along until it rolls (or tips) back over
;;   in the air    the car is a thruster platform with PRECISE, rate-commanded control on every axis:
;;                    pitch / yaw / roll   angular rates follow the command and STOP when you let go (cold-gas attitude jets)
;;                    lift                 the four nozzles, along the car's up axis
;;                    boost                the rear nozzle, along the car's forward axis
;;                    strafe, fore / aft   the flank jets, along its right / forward axes
;;   the tank      lift 26 /s, boost 22 /s, jets 9 /s, attitude 4 /s of 100; it refills 34 /s once you stop spending (48 /s on a
;;                 surface), plus a team-synergy bonus (br_rules.prn). Empty, the car still turns at a quarter rate -- never helpless.
;;
;; The command a car obeys is nine numbers (thr, steer, pitch, roll, strafe, lift, boost, fans-off, magnet): a person's keys, a
;; bot's brain, or the replay log write the same fields, so a match is a pure function of (seed, roster, the humans' commands).
;;
;; THE MAGNET (founder: "make the ball magnet to the cars ... remember its like quidich ... you can add a control for the magnet ...
;; let the ball be thrown and passed like NBA street vol 2"). The ball is a Quaffle: you catch it, carry it, pass it, throw it.
;;   hold the button  the magnet is on: a free ball near the car's CRADLE (a point just ahead of the nose and a little above it) is
;;                    pulled in -- harder the closer it gets, and the pull damps the ball's speed relative to the car so it
;;                    settles into the cradle instead of orbiting it. A ball that reaches the cradle slowly enough is CAUGHT;
;;                    one that comes in too fast is fumbled and just hits the car, as it always did.
;;   carrying         the ball rides the cradle wherever the car goes (floor, wall, ceiling, air) -- but the tank does not refill,
;;                    the car's top speed is 90%, and after five seconds the ball is thrown for you (no stalling).
;;   let go           the THROW: the car's velocity plus 260 along the nose -- or, with a team-mate in a 28 degree cone ahead that
;;                    is calling for it (its own button held), a PASS led to where that team-mate will be when the ball gets
;;                    there; a team-mate's pass is easier to catch.
;;   tackles          an enemy bumping the carrier (or driving into the carried ball) knocks it loose; a team-mate never does.
;; With the button up nothing here runs, and the car and the ball behave exactly as they did before the magnet existed.
;;
;; ON FIRE (br_fire.prn) reaches in here at the places marked "on fire": a burning car's tank stays full (air-tick!), its throws
;; are 35% faster and leave alight (throw!), its magnet reaches 50% further (magnet-pull!), a burning pass is that much easier
;; for the team-mate to catch (catch-limit), a car that is not burning puts a burning ball out by playing it (credit-touch!),
;; and a steal puts the carrier's fire out (ball-car!, car-car!). The fires' clocks run once a tick in physics-tick!.

(defn tick-dt [] : F32 0.016)
(defn sub-dt [] : F32 0.008)
(defn grav [] : F32 77.0)
(defn rc [] : F32 4.0)              ; car collision sphere radius (two spheres, 3.6 either side of the centre)
(defn sph-off [] : F32 3.6)
(defn rb [] : F32 11.0)             ; the ball
(defn ball-grav [] : F32 66.0)
(defn fan-force [] : F32 130.0)
(defn fan-reach [] : F32 6.0)       ; the fans catch a car whose wheels are this close
(defn fan-hold [] : F32 12.0)       ; ... and keep hold until it is this far
(defn tank-max [] : F32 100.0)

;; ---- basis helpers -----------------------------------------------------------------------------------------
;; right = forward x up  (so right x up = -forward, a normal non-mirrored camera frame)
(defn set-right! [(s : I32)] : Unit
  (let [(fx : F32) (c-fx s) (fy : F32) (c-fy s) (fz : F32) (c-fz s)
        (ux : F32) (c-ux s) (uy : F32) (c-uy s) (uz : F32) (c-uz s)]
    (set-c-rx! s (- (* fy uz) (* fz uy)))
    (set-c-ry! s (- (* fz ux) (* fx uz)))
    (set-c-rz! s (- (* fx uy) (* fy ux)))))

;; Gram-Schmidt: forward stays, up is made perpendicular to it, right follows
(defn fix-basis! [(s : I32)] : Unit
  (let [(fx : F32) (c-fx s) (fy : F32) (c-fy s) (fz : F32) (c-fz s)
        (il : F32) (inv-len3 fx fy fz)
        (gx : F32) (* fx il) (gy : F32) (* fy il) (gz : F32) (* fz il)
        (ux : F32) (c-ux s) (uy : F32) (c-uy s) (uz : F32) (c-uz s)
        (d : F32) (dot3 gx gy gz ux uy uz)
        (px : F32) (- ux (* gx d)) (py : F32) (- uy (* gy d)) (pz : F32) (- uz (* gz d))
        (iu : F32) (inv-len3 px py pz)]
    (set-c-fx! s gx) (set-c-fy! s gy) (set-c-fz! s gz)
    (set-c-ux! s (* px iu)) (set-c-uy! s (* py iu)) (set-c-uz! s (* pz iu))
    (set-right! s)))

;; rotate the vector stored at words (i0, i0+1, i0+2) of car s about the unit axis k by an angle (given as cos, sin)
(defn rot-words! [(s : I32) (i0 : I32) (kx : F32) (ky : F32) (kz : F32) (c : F32) (sn : F32)] : Unit
  (let [(vx : F32) (cf s i0) (vy : F32) (cf s (+ i0 1)) (vz : F32) (cf s (+ i0 2))
        (d : F32) (* (dot3 kx ky kz vx vy vz) (- 1.0 c))
        (cx : F32) (- (* ky vz) (* kz vy))
        (cy : F32) (- (* kz vx) (* kx vz))
        (cz : F32) (- (* kx vy) (* ky vx))]
    (cf! s i0 (+ (+ (* vx c) (* cx sn)) (* kx d)))
    (cf! s (+ i0 1) (+ (+ (* vy c) (* cy sn)) (* ky d)))
    (cf! s (+ i0 2) (+ (+ (* vz c) (* cz sn)) (* kz d)))))

;; spin the car about one of its own axes: axis 0 = right (pitch), 1 = up (yaw), 2 = forward (roll)
(defn spin-car! [(s : I32) (axis : I32) (ang : F32)] : Unit
  (when (> (abs-f ang) 0.000001)
    (let [(c : F32) (cosf ang) (sn : F32) (sinf ang)]
      (cond
        (= axis 0) (let [(kx : F32) (c-rx s) (ky : F32) (c-ry s) (kz : F32) (c-rz s)]
                     (rot-words! s (k-ux) kx ky kz c sn) (rot-words! s (k-fx) kx ky kz c sn))
        (= axis 1) (let [(kx : F32) (c-ux s) (ky : F32) (c-uy s) (kz : F32) (c-uz s)]
                     (rot-words! s (k-fx) kx ky kz c sn))
        :else (let [(kx : F32) (c-fx s) (ky : F32) (c-fy s) (kz : F32) (c-fz s)]
                (rot-words! s (k-ux) kx ky kz c sn)))
      (set-right! s))))

;; ---- placing a car -------------------------------------------------------------------------------------------
;; upright, facing the middle of the arena
(defn place-car! [(s : I32) (x : F32) (y : F32) (z : F32)] : Unit
  (let [(il : F32) (/ 1.0 (fmax2 0.001 (len2 x z)))]
    (set-c-x! s x) (set-c-y! s y) (set-c-z! s z)
    (set-c-vx! s 0.0) (set-c-vy! s 0.0) (set-c-vz! s 0.0)
    (set-c-ux! s 0.0) (set-c-uy! s 1.0) (set-c-uz! s 0.0)
    (set-c-fx! s (* (- 0.0 x) il)) (set-c-fy! s 0.0) (set-c-fz! s (* (- 0.0 z) il))
    (fix-basis! s)
    (set-c-wp! s 0.0) (set-c-wy! s 0.0) (set-c-wr! s 0.0)
    (set-c-attached! s 1)
    (set-c-px! s x) (set-c-py! s y) (set-c-pz! s z)
    (set-c-lift-fx! s 0.0) (set-c-boost-fx! s 0.0) (set-c-strafe-fx! s 0.0) (set-c-slip! s 0.0)
    (set-c-in-thr! s 0.0) (set-c-in-steer! s 0.0) (set-c-in-pitch! s 0.0) (set-c-in-roll! s 0.0) (set-c-in-strafe! s 0.0)
    (set-c-in-lift! s 0.0) (set-c-in-boost! s 0) (set-c-in-fans-off! s 0) (set-c-in-magnet! s 0)
    ;; a car put somewhere new (a kickoff, a respawn) leaves the ball behind
    (when (= (b-holder) s) (free-ball!))))

;; ---- the surface a car stands on --------------------------------------------------------------------------------
;; the smallest free distance of the car's two collision spheres, less their radius: <= 0 means touching
(defn car-gap [(s : I32)] : F32
  (let [(x : F32) (c-x s) (y : F32) (c-y s) (z : F32) (c-z s)
        (fx : F32) (* (c-fx s) (sph-off)) (fy : F32) (* (c-fy s) (sph-off)) (fz : F32) (* (c-fz s) (sph-off))
        (d1 : F32) (arena-free (+ x fx) (+ y fy) (+ z fz))
        (d2 : F32) (arena-free (- x fx) (- y fy) (- z fz))]
    (- (fmin2 d1 d2) (rc))))

;; slide the car out of the walls: both spheres, two passes; velocity into a surface is removed (bounce only with fans off)
(defn resolve-car! [(s : I32)] : Unit
  (dotimes [pass 2]
    (dotimes [e 2]
      (let [(sg : F32) (if (= e 0) 1.0 -1.0)
            (x : F32) (+ (c-x s) (* (* (c-fx s) (sph-off)) sg))
            (y : F32) (+ (c-y s) (* (* (c-fy s) (sph-off)) sg))
            (z : F32) (+ (c-z s) (* (* (c-fz s) (sph-off)) sg))
            (sd : F32) (arena-free x y z)
            (pen : F32) (- (rc) sd)]
        (when (> pen 0.0)
          (arena-normal! x y z)
          (let [(nx : F32) (gf (g-sdx)) (ny : F32) (gf (g-sdy)) (nz : F32) (gf (g-sdz))
                (vn : F32) (dot3 (c-vx s) (c-vy s) (c-vz s) nx ny nz)
                (e1 : F32) (if (= (c-in-fans-off s) 1) 0.35 (if (= (c-attached s) 1) 0.0 0.12))]
            (set-c-x! s (+ (c-x s) (* nx pen)))
            (set-c-y! s (+ (c-y s) (* ny pen)))
            (set-c-z! s (+ (c-z s) (* nz pen)))
            (when (< vn 0.0)
              (let [(j : F32) (* (- 0.0 vn) (+ 1.0 e1))]
                (set-c-vx! s (+ (c-vx s) (* nx j)))
                (set-c-vy! s (+ (c-vy s) (* ny j)))
                (set-c-vz! s (+ (c-vz s) (* nz j)))))))))))

;; ---- one car, one substep ----------------------------------------------------------------------------------------
;; driving: the car is on a surface held by its fans
(defn drive-sub! [(s : I32) (dt : F32)] : Unit
  (let [(x : F32) (c-x s) (y : F32) (c-y s) (z : F32) (c-z s)]
    (arena-normal! x y z)
    (let [(nx : F32) (gf (g-sdx)) (ny : F32) (gf (g-sdy)) (nz : F32) (gf (g-sdz))]
      ;; the up axis swings onto the surface normal; forward is kept in the tangent plane
      (let [(ux : F32) (+ (c-ux s) (* (- nx (c-ux s)) 0.2))
            (uy : F32) (+ (c-uy s) (* (- ny (c-uy s)) 0.2))
            (uz : F32) (+ (c-uz s) (* (- nz (c-uz s)) 0.2))
            (iu : F32) (inv-len3 ux uy uz)]
        (set-c-ux! s (* ux iu)) (set-c-uy! s (* uy iu)) (set-c-uz! s (* uz iu))
        (let [(fd : F32) (dot3 (c-fx s) (c-fy s) (c-fz s) (c-ux s) (c-uy s) (c-uz s))]
          (set-c-fx! s (- (c-fx s) (* (c-ux s) fd)))
          (set-c-fy! s (- (c-fy s) (* (c-uy s) fd)))
          (set-c-fz! s (- (c-fz s) (* (c-uz s) fd)))
          (fix-basis! s)))
      ;; steering first, so the tyres -- not the steering -- decide where the velocity goes. The yaw rate builds up over a few
      ;; substeps (the car has weight), tightens with speed, fades out near a standstill and flips for reverse, like a car.
      (let [(vf0 : F32) (dot3 (c-vx s) (c-vy s) (c-vz s) (c-fx s) (c-fy s) (c-fz s))
            (wmax : F32) (+ 0.55 (/ 2.6 (+ 1.0 (sq (/ (abs-f vf0) 80.0)))))
            (roll : F32) (* (clamp-f (/ (abs-f vf0) 30.0) 0.2 1.0) (if (< vf0 -1.0) -1.0 1.0))
            (want : F32) (* (* (- 0.0 (c-in-steer s)) wmax) roll)]
        (set-c-wy! s (+ (c-wy s) (* (- want (c-wy s)) 0.3)))
        (spin-car! s 1 (* (c-wy s) dt)))
      ;; velocity in the surface's frame
      (let [(vx : F32) (c-vx s) (vy : F32) (c-vy s) (vz : F32) (c-vz s)
            (vn : F32) (dot3 vx vy vz nx ny nz)
            (tx : F32) (- vx (* nx vn)) (ty : F32) (- vy (* ny vn)) (tz : F32) (- vz (* nz vn))
            (vf : F32) (dot3 tx ty tz (c-fx s) (c-fy s) (c-fz s))
            (vl : F32) (dot3 tx ty tz (c-rx s) (c-ry s) (c-rz s))
            ;; gravity splits into a part the surface carries and a part along it
            (gn : F32) (* (- 0.0 (grav)) ny)
            (gtx : F32) (* (- 0.0 nx) gn) (gty : F32) (- (- 0.0 (grav)) (* ny gn)) (gtz : F32) (* (- 0.0 nz) gn)
            (thr : F32) (c-in-thr s)
            (boost : I32) (c-in-boost s)
            (rw : F32) (if (> ny 0.7) (/ (f32 (road-at x z)) 255.0) 0.0)]
        (set! vf (+ vf (* (dot3 gtx gty gtz (c-fx s) (c-fy s) (c-fz s)) dt)))
        (set! vl (+ vl (* (dot3 gtx gty gtz (c-rx s) (c-ry s) (c-rz s)) dt)))
        ;; throttle and brake
        (let [(acc : F32) (cond
                            (> thr 0.01) (* (* thr 175.0) (fmax2 0.0 (- 1.0 (/ vf 190.0))))
                            (< thr -0.01) (if (> vf 4.0) (* thr 340.0) (* (- 0.0 (abs-f thr)) (* 125.0 (fmax2 0.0 (+ 1.0 (/ vf 90.0))))))
                            :else 0.0)
              (bacc : F32) (if (= boost 1) (* 285.0 (fmax2 0.0 (- 1.0 (/ vf 340.0)))) 0.0)]
          (set! vf (+ vf (* (+ acc bacc) dt)))
          ;; idle: the wheels hold -- enough to park on a wall -- and the air drags a little
          (when (and (< (abs-f thr) 0.01) (= boost 0))
            (set! vf (- vf (* (sgn vf) (fmin2 (abs-f vf) (* 90.0 dt))))))
          (set! vf (* vf (- 1.0 (* 0.1 dt)))))
        ;; grip: the tyres pull the sideways slide back toward zero, but only up to what the surface can hold. Below that limit
        ;; the car tracks; above it the tail steps out and the car drifts until the slide is gone. Dirt holds half what the
        ;; concrete does, walls and the ceiling a little less than the floor (the fans, not gravity, press the tyres there).
        ;; A slide past the limit scrubs off some forward speed, so a drift costs a little pace.
        (let [(lim : F32) (if (> ny 0.7) (lerp 320.0 125.0 rw) 280.0)
              (want : F32) (* (abs-f vl) (* 22.0 dt))
              (dv : F32) (fmin2 want (* lim dt))]
          (set-c-slip! s (abs-f vl))
          (set! vl (- vl (* (sgn vl) dv)))
          (when (> want dv)
            (set! vf (- vf (* (sgn vf) (fmin2 (abs-f vf) (* 0.3 dv)))))))
        ;; back to a world velocity; the fans pull the car onto the surface (the collision pass holds it there)
        (let [(nvn : F32) (+ vn (* (- gn (fan-force)) dt))
              (fx : F32) (c-fx s) (fy : F32) (c-fy s) (fz : F32) (c-fz s)
              (rx : F32) (c-rx s) (ry : F32) (c-ry s) (rz : F32) (c-rz s)]
          (set-c-vx! s (+ (+ (* fx vf) (* rx vl)) (* nx nvn)))
          (set-c-vy! s (+ (+ (* fy vf) (* ry vl)) (* ny nvn)))
          (set-c-vz! s (+ (+ (* fz vf) (* rz vl)) (* nz nvn))))))))

;; flying: thrusters and attitude jets on a body in free fall
(defn fly-sub! [(s : I32) (dt : F32)] : Unit
  (let [(full : F32) (if (> (c-air s) 1.0) 1.0 0.25)
        (tp : F32) (* (* (c-in-pitch s) 3.6) full)
        (ty : F32) (* (* (- 0.0 (c-in-steer s)) 2.8) full)
        (tr : F32) (* (* (c-in-roll s) 4.4) full)
        (k : F32) 0.27]
    ;; the angular rate chases the command (and stops when the command does)
    (set-c-wp! s (+ (c-wp s) (* (- tp (c-wp s)) k)))
    (set-c-wy! s (+ (c-wy s) (* (- ty (c-wy s)) k)))
    (set-c-wr! s (+ (c-wr s) (* (- tr (c-wr s)) k)))
    (spin-car! s 0 (* (c-wp s) dt))
    (spin-car! s 1 (* (c-wy s) dt))
    (spin-car! s 2 (* (c-wr s) dt))
    (let [(ax : F32) 0.0 (ay : F32) (- 0.0 (grav)) (az : F32) 0.0
          (lift : F32) (* (c-in-lift s) 215.0)
          (bst : F32) (if (= (c-in-boost s) 1) 270.0 0.0)
          (stf : F32) (* (c-in-strafe s) 105.0)
          (rcs : F32) (* (c-in-thr s) 70.0)]
      (set-c-vx! s (+ (c-vx s) (* (+ (+ (+ ax (* (c-ux s) lift)) (* (c-fx s) (+ bst rcs))) (* (c-rx s) stf)) dt)))
      (set-c-vy! s (+ (c-vy s) (* (+ (+ (+ ay (* (c-uy s) lift)) (* (c-fy s) (+ bst rcs))) (* (c-ry s) stf)) dt)))
      (set-c-vz! s (+ (c-vz s) (* (+ (+ (+ az (* (c-uz s) lift)) (* (c-fz s) (+ bst rcs))) (* (c-rz s) stf)) dt)))
      (let [(dr : F32) (- 1.0 (* 0.05 dt))]
        (set-c-vx! s (* (c-vx s) dr)) (set-c-vy! s (* (c-vy s) dr)) (set-c-vz! s (* (c-vz s) dr))))))

;; weak fans reach out and pull a falling car's belly toward a nearby surface, so a human lands on a wall without a roll command
;; (only from the belly side: fans cannot reach through the roof, so a car coming down upside down has to roll itself over)
(defn assist-landing! [(s : I32)] : Unit
  (let [gap (car-gap s)]
    (when (and (< gap 26.0) (= (c-in-fans-off s) 0))
      (arena-normal! (c-x s) (c-y s) (c-z s))
      (when (> (dot3 (c-ux s) (c-uy s) (c-uz s) (gf (g-sdx)) (gf (g-sdy)) (gf (g-sdz))) -0.2)
      (let [(w : F32) (* 0.045 (clamp-f (/ (- 26.0 gap) 20.0) 0.0 1.0))
            (ux : F32) (+ (c-ux s) (* (- (gf (g-sdx)) (c-ux s)) w))
            (uy : F32) (+ (c-uy s) (* (- (gf (g-sdy)) (c-uy s)) w))
            (uz : F32) (+ (c-uz s) (* (- (gf (g-sdz)) (c-uz s)) w))
            (iu : F32) (inv-len3 ux uy uz)]
        (set-c-ux! s (* ux iu)) (set-c-uy! s (* uy iu)) (set-c-uz! s (* uz iu))
        (let [(fd : F32) (dot3 (c-fx s) (c-fy s) (c-fz s) (c-ux s) (c-uy s) (c-uz s))]
          (set-c-fx! s (- (c-fx s) (* (c-ux s) fd)))
          (set-c-fy! s (- (c-fy s) (* (c-uy s) fd)))
          (set-c-fz! s (- (c-fz s) (* (c-uz s) fd)))
          (fix-basis! s)))))))

;; a car lying on its roof or side: the cold-gas jets tip it back onto its wheels (slowly -- a turtled car is out of the play
;; for a moment, and a player who rolls it over themselves is quicker)
(defn self-right! [(s : I32) (dt : F32)] : Unit
  (do
  (arena-normal! (c-x s) (c-y s) (c-z s))
  (let [(nx : F32) (gf (g-sdx)) (ny : F32) (gf (g-sdy)) (nz : F32) (gf (g-sdz))
        (ux : F32) (c-ux s) (uy : F32) (c-uy s) (uz : F32) (c-uz s)
        (ax : F32) (- (* uy nz) (* uz ny)) (ay : F32) (- (* uz nx) (* ux nz)) (az : F32) (- (* ux ny) (* uy nx))
        (al : F32) (len3 ax ay az)]
    ;; exactly upside down the axis is undefined: tip over the car's own forward axis
    (let [(kx : F32) (if (> al 0.05) (/ ax al) (c-fx s))
          (ky : F32) (if (> al 0.05) (/ ay al) (c-fy s))
          (kz : F32) (if (> al 0.05) (/ az al) (c-fz s))
          (ang : F32) (* 2.4 dt)]
      (rot-words! s (k-ux) kx ky kz (cosf ang) (sinf ang))
      (rot-words! s (k-fx) kx ky kz (cosf ang) (sinf ang))
      (fix-basis! s)))))

(defn car-substep! [(s : I32) (dt : F32)] : Unit
  (let [gap (car-gap s)
        fans (and (= (c-in-fans-off s) 0) (< (c-in-lift s) 0.05))
        near (< gap 40.0)
        (vn : F32) (if near
                       (do (arena-normal! (c-x s) (c-y s) (c-z s))
                           (dot3 (c-vx s) (c-vy s) (c-vz s) (gf (g-sdx)) (gf (g-sdy)) (gf (g-sdz))))
                       0.0)
        ;; how squarely the belly (and so the fans) faces the surface: the fans take hold only belly-down
        (face : F32) (if near (dot3 (c-ux s) (c-uy s) (c-uz s) (gf (g-sdx)) (gf (g-sdy)) (gf (g-sdz))) 1.0)
        att (and fans (< gap (if (= (c-attached s) 1) (fan-hold) (fan-reach))))
        att2 (and att (or (= (c-attached s) 1) (and (< vn 60.0) (> face 0.35))))]
    (set-c-sd! s gap)
    (set-c-attached! s (b2i att2))
    (if att2
        (drive-sub! s dt)
        (do (fly-sub! s dt) (assist-landing! s)
            ;; a car scraping along on its roof or its side (not driving) is slowed by the scrape
            (when (and (< gap 1.5) (< face 0.35))
              (let [(nx : F32) (gf (g-sdx)) (ny : F32) (gf (g-sdy)) (nz : F32) (gf (g-sdz))
                    (wn : F32) (dot3 (c-vx s) (c-vy s) (c-vz s) nx ny nz)
                    (tx : F32) (- (c-vx s) (* nx wn)) (ty : F32) (- (c-vy s) (* ny wn)) (tz : F32) (- (c-vz s) (* nz wn))
                    (tl : F32) (len3 tx ty tz)
                    (k : F32) (if (> tl 0.001) (/ (fmax2 0.0 (- tl (* 150.0 dt))) tl) 0.0)]
                (set-c-vx! s (+ (* nx wn) (* tx k)))
                (set-c-vy! s (+ (* ny wn) (* ty k)))
                (set-c-vz! s (+ (* nz wn) (* tz k)))))
            (when (and (< gap 1.5) (< face 0.35) (< (len3 (c-vx s) (c-vy s) (c-vz s)) 80.0)
                       (< (abs-f (c-in-roll s)) 0.05) (< (abs-f (c-in-pitch s)) 0.05))
              (self-right! s dt))))
    (set-c-x! s (+ (c-x s) (* (c-vx s) dt)))
    (set-c-y! s (+ (c-y s) (* (c-vy s) dt)))
    (set-c-z! s (+ (c-z s) (* (c-vz s) dt)))
    (resolve-car! s)
    ;; top speed bookkeeping and a hard cap (90% of it for the car carrying the ball: the carrier can be caught)
    (let [(sp : F32) (len3 (c-vx s) (c-vy s) (c-vz s))
          (cap : F32) (if (= (b-holder) s) (* 420.0 (carry-speed-frac)) 420.0)]
      (when (> sp cap)
        (let [(k : F32) (/ cap sp)]
          (set-c-vx! s (* (c-vx s) k)) (set-c-vy! s (* (c-vy s) k)) (set-c-vz! s (* (c-vz s) k))))
      (when (> sp (c-top-speed s)) (set-c-top-speed! s sp)))))

;; ---- the ball ------------------------------------------------------------------------------------------------------
(defn ball-substep! [(dt : F32)] : Unit
  (let [(vy : F32) (- (b-vy) (* (ball-grav) dt))]
    (set-b-vy! vy)
    (let [(dr : F32) (- 1.0 (* 0.03 dt))]
      (set-b-vx! (* (b-vx) dr)) (set-b-vy! (* (b-vy) dr)) (set-b-vz! (* (b-vz) dr)))
    (set-b-x! (+ (b-x) (* (b-vx) dt)))
    (set-b-y! (+ (b-y) (* (b-vy) dt)))
    (set-b-z! (+ (b-z) (* (b-vz) dt)))
    (dotimes [pass 2]
      (let [sd (arena-free (b-x) (b-y) (b-z))
            (pen : F32) (- (rb) sd)]
        (when (> pen 0.0)
          (arena-normal! (b-x) (b-y) (b-z))
          (let [(nx : F32) (gf (g-sdx)) (ny : F32) (gf (g-sdy)) (nz : F32) (gf (g-sdz))
                (vn : F32) (dot3 (b-vx) (b-vy) (b-vz) nx ny nz)]
            (set-b-x! (+ (b-x) (* nx pen)))
            (set-b-y! (+ (b-y) (* ny pen)))
            (set-b-z! (+ (b-z) (* nz pen)))
            (when (< vn 0.0)
              ;; bounce: lively when it comes in fast, dead when it is merely rolling
              (let [(e : F32) (* 0.62 (clamp-f (/ (abs-f vn) 36.0) 0.0 1.0))
                    (j : F32) (* (- 0.0 vn) (+ 1.0 e))]
                (set-b-vx! (+ (b-vx) (* nx j)))
                (set-b-vy! (+ (b-vy) (* ny j)))
                (set-b-vz! (+ (b-vz) (* nz j)))
                ;; rolling resistance along the surface (and only along it): a light drag and a small constant loss, so a ball
                ;; rolls a long way and still comes to rest, and one rolled hard into a wall keeps the speed to climb it
                (let [(bvn : F32) (dot3 (b-vx) (b-vy) (b-vz) nx ny nz)
                      (tx : F32) (- (b-vx) (* nx bvn)) (ty : F32) (- (b-vy) (* ny bvn)) (tz : F32) (- (b-vz) (* nz bvn))
                      (tl : F32) (len3 tx ty tz)
                      (k : F32) (if (> tl 0.001) (/ (fmax2 0.0 (- (* tl (- 1.0 (* 0.16 dt))) (* 9.0 dt))) tl) 0.0)]
                  (set-b-vx! (+ (* nx bvn) (* tx k)))
                  (set-b-vy! (+ (* ny bvn) (* ty k)))
                  (set-b-vz! (+ (* nz bvn) (* tz k))))))))))
    (let [(sp : F32) (len3 (b-vx) (b-vy) (b-vz))]
      (when (> sp 520.0)
        (let [(k : F32) (/ 520.0 sp)]
          (set-b-vx! (* (b-vx) k)) (set-b-vy! (* (b-vy) k)) (set-b-vz! (* (b-vz) k)))))))

;; ---- ball vs. car (an oriented box) --------------------------------------------------------------------------------
(defn hit-hw [] : F32 4.4)
(defn hit-hh [] : F32 2.6)
(defn hit-hd [] : F32 7.6)

;; who touched it (for credit); a touch within a few ticks of the last one is the same touch (a dribble, a scrum) -- unless it is
;; FRESH: the ball changing hands through the magnet (a catch by another car, a steal off the carrier) is always a new touch, so
;; the chain of touches (touch2: the assist) follows the ball even when a hand-off pass is caught a tick after it was thrown.
;; An ENEMY's touch breaks up a pass: the pass window closes (a deflection a team-mate picks up is not a completed pass).
(defn credit-touch! [(s : I32) (fresh : Bool)] : Unit
  (do
    (when (or fresh (> (- (gi (g-tick)) (b-touch-t)) 3))
      (when (!= (b-touch) s)
        (set-b-touch2! (b-touch))
        (set-b-touch! s)
        (set-b-touch-team! (c-team s)))
      (set-c-touches! s (+ (c-touches s) 1))
      (set-b-hit-t! 8))
    (set-b-touch-t! (gi (g-tick)))
    (set-b-touch! s)
    (set-b-touch-team! (c-team s))
    (let [pf (b-pass-from)]
      (when (and (>= pf 0) (!= (c-team pf) (c-team s))) (set-b-pass-from! -1) (set-b-pass-t! 0)))
    ;; on fire: a ball alight from a burning car's throw goes out when a car that is not burning plays it
    (when (not (on-fire? s)) (ball-fire! 0))))

;; the contact itself: push the ball out of the car's box and bounce it. true if they touched (the caller credits the touch).
(defn ball-car-hit! [(s : I32)] : Bool
  (let [(dx : F32) (- (b-x) (c-x s)) (dy : F32) (- (b-y) (c-y s)) (dz : F32) (- (b-z) (c-z s))]
    ;; quick reject
    (if (>= (+ (+ (* dx dx) (* dy dy)) (* dz dz)) 400.0)
      false
      (let [(lx : F32) (dot3 dx dy dz (c-rx s) (c-ry s) (c-rz s))
            (ly : F32) (dot3 dx dy dz (c-ux s) (c-uy s) (c-uz s))
            (lz : F32) (dot3 dx dy dz (c-fx s) (c-fy s) (c-fz s))
            (qx : F32) (clamp-f lx (- 0.0 (hit-hw)) (hit-hw))
            (qy : F32) (clamp-f ly (- 0.0 (hit-hh)) (hit-hh))
            (qz : F32) (clamp-f lz (- 0.0 (hit-hd)) (hit-hd))
            (ex : F32) (- lx qx) (ey : F32) (- ly qy) (ez : F32) (- lz qz)
            (d : F32) (len3 ex ey ez)]
        (if (not (and (< d (rb)) (> d 0.0001)))
          false
          (let [(mx : F32) (/ ex d) (my : F32) (/ ey d) (mz : F32) (/ ez d)
                (nx : F32) (+ (+ (* (c-rx s) mx) (* (c-ux s) my)) (* (c-fx s) mz))
                (ny : F32) (+ (+ (* (c-ry s) mx) (* (c-uy s) my)) (* (c-fy s) mz))
                (nz : F32) (+ (+ (* (c-rz s) mx) (* (c-uz s) my)) (* (c-fz s) mz))
                (pen : F32) (- (rb) d)
                (rvx : F32) (- (b-vx) (c-vx s)) (rvy : F32) (- (b-vy) (c-vy s)) (rvz : F32) (- (b-vz) (c-vz s))
                (vn : F32) (dot3 rvx rvy rvz nx ny nz)]
            (set-b-x! (+ (b-x) (* nx pen)))
            (set-b-y! (+ (b-y) (* ny pen)))
            (set-b-z! (+ (b-z) (* nz pen)))
            (when (< vn 0.0)
              ;; the car is four times the ball's mass; a fast approach adds a little drive along the car's heading
              (let [(e : F32) 0.7
                    (jb : F32) (* (* (- 0.0 vn) (+ 1.0 e)) 0.8)
                    (jc : F32) (* (* (- 0.0 vn) (+ 1.0 e)) 0.2)
                    (cs : F32) (fmax2 0.0 (dot3 (c-vx s) (c-vy s) (c-vz s) (c-fx s) (c-fy s) (c-fz s)))
                    (push : F32) (* 0.16 (* cs (fmax2 0.0 mz)))]
                (set-b-vx! (+ (b-vx) (+ (* nx jb) (* (c-fx s) push))))
                (set-b-vy! (+ (b-vy) (+ (* ny jb) (* (c-fy s) push))))
                (set-b-vz! (+ (b-vz) (+ (* nz jb) (* (c-fz s) push))))
                (set-c-vx! s (- (c-vx s) (* nx jc)))
                (set-c-vy! s (- (c-vy s) (* ny jc)))
                (set-c-vz! s (- (c-vz s) (* nz jc)))))
            true))))))

;; a car against the ball. A free ball: the contact above -- and a ball that hits a live magnet faster than it can be caught is
;; too hot to handle: it bounces off as it always did and the car FUMBLES (locked out like a car that just lost the ball), so a
;; hard shot cannot be smothered by catching its slow rebound. A carried ball: the carrier and its team-mates pass through it (the
;; carrier holds it, a team-mate never knocks it loose); an enemy's body that hits it knocks it loose -- the ball goes off with
;; the carrier's velocity (it had it) plus the hit's impulse, and that is a steal (a fresh touch: the ball changed hands).
(defn ball-car! [(s : I32)] : Unit
  (let [h (b-holder)]
    (cond
      (< h 0) (let [hot (and (magnet-ready? s)
                             (> (len3 (- (b-vx) (c-vx s)) (- (b-vy) (c-vy s)) (- (b-vz) (c-vz s))) (catch-limit s)))]
                (when (ball-car-hit! s)
                  (credit-touch! s false)
                  (when hot (set-c-nocatch! s (nocatch-ticks)))))
      (= (c-team h) (c-team s)) unit
      :else (when (ball-car-hit! s)
              (credit-touch! s true)
              (set-c-steals! s (+ (c-steals s) 1))
              (lose-ball! h)
              ;; on fire: losing the ball to a steal puts the carrier's fire out
              (douse! h (fo-stolen))))))

;; ---- car vs. car: soft spheres ------------------------------------------------------------------------------------------
(defn car-car! [(a : I32) (b : I32)] : Unit
  (let [(dx : F32) (- (c-x b) (c-x a)) (dy : F32) (- (c-y b) (c-y a)) (dz : F32) (- (c-z b) (c-z a))
        (d2 : F32) (+ (+ (* dx dx) (* dy dy)) (* dz dz))]
    (when (and (< d2 144.0) (> d2 0.0001))
      (let [(d : F32) (sqrt d2)
            (nx : F32) (/ dx d) (ny : F32) (/ dy d) (nz : F32) (/ dz d)
            (pen : F32) (* 0.5 (- 12.0 d))
            (vn : F32) (dot3 (- (c-vx b) (c-vx a)) (- (c-vy b) (c-vy a)) (- (c-vz b) (c-vz a)) nx ny nz)]
        (set-c-x! a (- (c-x a) (* nx pen))) (set-c-y! a (- (c-y a) (* ny pen))) (set-c-z! a (- (c-z a) (* nz pen)))
        (set-c-x! b (+ (c-x b) (* nx pen))) (set-c-y! b (+ (c-y b) (* ny pen))) (set-c-z! b (+ (c-z b) (* nz pen)))
        (when (< vn 0.0)
          (let [(j : F32) (* (* (- 0.0 vn) 1.35) 0.5)]
            (set-c-vx! a (- (c-vx a) (* nx j))) (set-c-vy! a (- (c-vy a) (* ny j))) (set-c-vz! a (- (c-vz a) (* nz j)))
            (set-c-vx! b (+ (c-vx b) (* nx j))) (set-c-vy! b (+ (c-vy b) (* ny j))) (set-c-vz! b (+ (c-vz b) (* nz j)))
            ;; a TACKLE: an enemy closing on the carrier faster than tackle-speed knocks the ball loose. It leaves with the
            ;; carrier's (new) velocity plus the bump's impulse once more, so it squirts out the way the carrier was shoved.
            (when (> (- 0.0 vn) (tackle-speed))
              (let [h (b-holder)]
                (cond
                  (and (= h a) (!= (c-team a) (c-team b)))
                    (do (set-c-steals! b (+ (c-steals b) 1))
                        (knock-loose! a (* nx (- 0.0 j)) (* ny (- 0.0 j)) (* nz (- 0.0 j)))
                        (douse! a (fo-stolen)))      ; on fire: a steal puts the carrier's fire out
                  (and (= h b) (!= (c-team a) (c-team b)))
                    (do (set-c-steals! a (+ (c-steals a) 1))
                        (knock-loose! b (* nx j) (* ny j) (* nz j))
                        (douse! b (fo-stolen)))
                  :else unit)))))))))

;; ---- the air tank ------------------------------------------------------------------------------------------------------------
;; once per tick: decide what the car can afford this tick, spend it, and refill
(defn air-tick! [(s : I32)] : Unit
  (let [(air : F32) (c-air s)
        (dt : F32) (tick-dt)
        flying (= (c-attached s) 0)
        (mx : F32) (fmax2 (abs-f (c-in-pitch s)) (fmax2 (abs-f (c-in-roll s)) (abs-f (c-in-steer s))))
        ;; a tank under 6 cannot start a burn (it cannot stutter at zero), and the jets cut out at zero
        (lift : F32) (if (and (> (c-in-lift s) 0.02) (> air (if (> (c-lift-fx s) 0.1) 0.5 6.0))) (clamp-f (c-in-lift s) 0.0 1.0) 0.0)
        boost (and (= (c-in-boost s) 1) (> air (if (> (c-boost-fx s) 0.2) 0.5 6.0)))
        (sf : F32) (if (> air 3.0) 1.0 0.0)]
    (set-c-in-lift! s lift)
    (set-c-in-boost! s (b2i boost))
    (set-c-in-strafe! s (* (c-in-strafe s) sf))
    (let [(spend : F32) (+ (+ (+ (* lift 26.0) (if boost 22.0 0.0)) (* (abs-f (c-in-strafe s)) 9.0))
                           (if flying (* mx 4.0) 0.0))]
      (if (> spend 0.0)
          (do (set-c-air! s (fmax2 0.0 (- air (* spend dt))))
              (set-c-air-used! s (+ (c-air-used s) (* spend dt)))
              (set-c-air-wait! s 20))
          (cond
            (> (c-air-wait s) 0) (set-c-air-wait! s (- (c-air-wait s) 1))
            ;; carrying the ball costs you the refill: the tank you had when you caught it is what you have to score with
            (= (b-holder) s) unit
            :else (let [(rate : F32) (* (if (= (c-attached s) 1) 48.0 34.0) (+ 1.0 (c-syn-bonus s)))]
                    (set-c-air! s (fmin2 (tank-max) (+ air (* rate dt))))))))
    ;; on fire: the tank stays full, whatever was spent and even while carrying (the spend is still counted in air-used)
    (when (on-fire? s) (set-c-air! s (tank-max)))
    ;; effect levels the renderer draws (smoothed so a plume swells and fades)
    (set-c-lift-fx! s (+ (c-lift-fx s) (* (- lift (c-lift-fx s)) 0.35)))
    (set-c-boost-fx! s (+ (c-boost-fx s) (* (- (if boost 1.0 0.0) (c-boost-fx s)) 0.35)))
    (set-c-strafe-fx! s (+ (c-strafe-fx s) (* (- (c-in-strafe s) (c-strafe-fx s)) 0.4)))
    (when (= (c-attached s) 1)
      (when (> (c-uy s) 0.7) (set-c-ticks-up! s (+ (c-ticks-up s) 1)))
      (when (< (c-uy s) -0.3) (set-c-ticks-inv! s (+ (c-ticks-inv s) 1))))))

;; ---- the magnet: catch, carry, throw, pass ------------------------------------------------------------------------------------------
;; The CRADLE sits 17 ahead of the car's centre and 9 above it, along the car's own axes: a ball there just clears the car's box
;; (so catching it is not a collision) and rides 13 off whatever surface the car drives on -- floor, wall or ceiling -- so the
;; quarter-pipes only nudge it. The magnet's pull fades linearly from full at the cradle to nothing at magnet-range; its damping
;; of the ball's velocity RELATIVE TO THE CAR fades the same way. Head-on, a ball entering the field at 260 reaches the cradle at
;; about 190 (a team-mate's pass: inside the 260 pass window, caught; anyone else's throw: over the 170 limit, fumbled), one at
;; 450 still comes in above 300 and just hits the car; a slow ball nearby is reeled in and arrives at under 100. A ball
;; that passes off to one side is bent in and slowed even more, so it is the easier catch -- that is the magnet.
;; But the field only HOLDS a ball it could tame: one moving (relative to the car) faster than magnet-grab x the car's catch limit
;; -- 238 for anyone else's ball, 364 for a team-mate's pass -- goes through it untouched. That keeps the head-on numbers above
;; (the field brakes a 238 ball to about the 170 limit by the cradle) and stops a near miss being reeled back in: without it a
;; 400 shot passing 14 off the cradle, or a 500 one passing 10 off, was bent round, braked and caught, so a keeper with the
;; button down caught anything that came close. And the goal line is the goal line: a ball already over it in a shaft is a goal
;; (no magnet pulls or catches it back out), and a cradle up over it holds nothing -- a keeper hovering in its own shaft used to
;; catch a shot just under the line, the catch snapped the ball up into its cradle over the line, and the other team's goal
;; became the keeper's own goal.
(defn cradle-fwd [] : F32 17.0)
(defn cradle-up [] : F32 9.0)
(defn magnet-range [] : F32 34.0)       ; the pull reaches this far from the cradle
(defn magnet-pull [] : F32 1400.0)      ; acceleration toward the cradle at the cradle
(defn magnet-damp [] : F32 14.0)        ; per second, on the ball's velocity relative to the car, at the cradle
(defn magnet-grab [] : F32 1.4)         ; the field holds only a ball slower than this x the catch limit (relative to the car)
(defn catch-r [] : F32 9.0)             ; a ball this close to the cradle ...
(defn catch-speed [] : F32 170.0)       ; ... and slower than this relative to the car is caught
(defn pass-catch-speed [] : F32 260.0)  ; ... or slower than this, inside a team-mate's pass window
(defn throw-speed [] : F32 260.0)       ; a throw leaves at the car's velocity plus this
(defn pass-range [] : F32 280.0)        ; a team-mate this close ...
(defn pass-cone [] : F32 0.883)         ; ... and within 28 degrees of the nose (cos 28) is passed to
(defn pass-lift [] : F32 6.0)           ; a pass is aimed this far above the receiver's cradle, so one from behind clears its roof
(defn tear-dist [] : F32 8.0)           ; a carried ball pushed this far off the cradle (a wall in the way) is dropped
(defn carry-speed-frac [] : F32 0.9)    ; the carrier's hard speed cap, as a fraction of everyone else's
(defn tackle-speed [] : F32 40.0)       ; an enemy closing on the carrier faster than this knocks the ball loose
(defn nocatch-ticks [] : I32 44)        ; 0.7 s: a car that has just thrown or lost the ball cannot catch
(defn hold-ticks [] : I32 313)          ; 5 s: carried this long, the ball is thrown for you
(defn pass-window [] : I32 94)          ; 1.5 s: how long a team-mate's throw stays easier to catch

(defn cradle-x [(s : I32)] : F32 (+ (+ (c-x s) (* (c-fx s) (cradle-fwd))) (* (c-ux s) (cradle-up))))
(defn cradle-y [(s : I32)] : F32 (+ (+ (c-y s) (* (c-fy s) (cradle-fwd))) (* (c-uy s) (cradle-up))))
(defn cradle-z [(s : I32)] : F32 (+ (+ (c-z s) (* (c-fz s) (cradle-fwd))) (* (c-uz s) (cradle-up))))

;; the magnet is live: the button is held and the car is not locked out
(defn magnet-ready? [(s : I32)] : Bool
  (and (!= (c-active s) 0) (= (c-in-magnet s) 1) (= (c-nocatch s) 0)))

;; the ball is free again, at no cost to anyone (a kickoff, a goal, the end, a car leaving the match)
(defn free-ball! [] : Unit (do (set-b-holder! -1) (set-b-hold-t! 0)))

;; the carrier LOSES the ball (dropped against a wall, knocked loose): it is free and the carrier is locked out of catching it
;; straight back; a loose ball is nobody's pass
(defn lose-ball! [(h : I32)] : Unit
  (do (free-ball!)
      (set-c-nocatch! h (nocatch-ticks))
      (set-b-pass-from! -1) (set-b-pass-t! 0)))

;; knocked loose by a bump: it leaves the cradle with the carrier's velocity plus the impulse (ix, iy, iz)
(defn knock-loose! [(h : I32) (ix : F32) (iy : F32) (iz : F32)] : Unit
  (do (set-b-x! (cradle-x h)) (set-b-y! (cradle-y h)) (set-b-z! (cradle-z h))
      (set-b-vx! (+ (c-vx h) ix)) (set-b-vy! (+ (c-vy h) iy)) (set-b-vz! (+ (c-vz h) iz))
      (lose-ball! h)))

;; the ball sits in s's cradle and moves with it
(defn ride-cradle! [(s : I32)] : Unit
  (do (set-b-x! (cradle-x s)) (set-b-y! (cradle-y s)) (set-b-z! (cradle-z s))
      (set-b-vx! (c-vx s)) (set-b-vy! (c-vy s)) (set-b-vz! (c-vz s))))

;; inside the pass window of a throw by one of s's team-mates?
(defn team-pass? [(s : I32)] : Bool
  (let [pf (b-pass-from)]
    (and (> (b-pass-t) 0) (>= pf 0) (!= pf s) (= (c-team (max-i pf 0)) (c-team s)))))

;; on fire: a burning car's pass comes in 35% faster, so while the ball is alight a team-mate's limit rises by the same 35%
(defn catch-limit [(s : I32)] : F32
  (if (team-pass? s) (* (pass-catch-speed) (if (ball-alight?) (fire-throw-mul) 1.0)) (catch-speed)))

;; s CATCHES the ball. A catch is a touch (credit: a pass caught and scored makes the passer the assist, through touch2); a
;; team-mate's throw caught inside its window is a completed pass, credited to the passer.
(defn catch! [(s : I32)] : Unit
  (do
    (when (team-pass? s)
      (let [pf (b-pass-from)] (set-c-passes! pf (+ (c-passes pf) 1))))
    (set-b-pass-from! -1) (set-b-pass-t! 0)
    (set-b-holder! s) (set-b-hold-t! 0)
    (set-c-catches! s (+ (c-catches s) 1))
    ;; a catch by a car that was not the last to touch it is the ball changing hands: always a new touch
    (credit-touch! s (!= (b-touch) s))
    (ride-cradle! s)))

;; the team-mate a throw from s goes to: within pass-range and inside the cone ahead of the nose, the one nearest the middle of
;; the cone; -1 for nobody (the throw then goes straight along the nose). Only a team-mate CALLING for it -- holding its magnet
;; button, the only way it can catch -- is passed to: a throw led to one that cannot catch it would just hijack the thrower's
;; aim (a shot up into a tower with a team-mate floating ahead, every bot today). A team-mate still in its re-catch lockout is
;; passed to all the same: the lockout is usually over by the time the ball gets there (a give-and-go).
(defn pass-mate [(s : I32)] : I32
  (let [(best : I32) -1 (bc : F32) (pass-cone) t (c-team s)]
    (dotimes [m 12]
      (when (and (!= m s) (!= (c-active m) 0) (= (c-team m) t) (= (c-in-magnet m) 1))
        (let [(dx : F32) (- (c-x m) (c-x s)) (dy : F32) (- (c-y m) (c-y s)) (dz : F32) (- (c-z m) (c-z s))
              (d : F32) (len3 dx dy dz)
              (cs : F32) (/ (dot3 dx dy dz (c-fx s) (c-fy s) (c-fz s)) (fmax2 d 0.001))]
          (when (and (< d (pass-range)) (> cs bc)) (set! best m) (set! bc cs)))))
    best))

;; THE THROW, at `speed` on top of the car's own velocity. Along the nose -- or, with a team-mate in the cone, a pass LED to them
;; (NBA Street): aimed at where their cradle will be when the ball gets there, with the drop under gravity added back. The flight
;; time t solves |R(t)| = speed * t, R(t) = (their cradle + lift - the ball) + (their velocity - mine) t + (0, g t^2 / 2, 0),
;; by fixed-point iteration (it converges while the cars are slower than the throw, which they are). On fire: 35% faster, and
;; the ball leaves alight.
(defn throw! [(s : I32) (speed0 : F32)] : Unit
  (let [m (pass-mate s)
        (speed : F32) (* speed0 (throw-mul s))
        (dx : F32) (c-fx s) (dy : F32) (c-fy s) (dz : F32) (c-fz s)]
    (when (>= m 0)
      (let [(ox : F32) (- (cradle-x m) (b-x))
            (oy : F32) (- (+ (cradle-y m) (pass-lift)) (b-y))
            (oz : F32) (- (cradle-z m) (b-z))
            (wx : F32) (- (c-vx m) (c-vx s)) (wy : F32) (- (c-vy m) (c-vy s)) (wz : F32) (- (c-vz m) (c-vz s))
            (hg : F32) (* 0.5 (ball-grav))
            (t : F32) (/ (len3 ox oy oz) speed)]
        (dotimes [it 6]
          (set! t (fmin2 2.5 (/ (len3 (+ ox (* wx t)) (+ (+ oy (* wy t)) (* hg (* t t))) (+ oz (* wz t))) speed))))
        (let [(rx : F32) (+ ox (* wx t)) (ry : F32) (+ (+ oy (* wy t)) (* hg (* t t))) (rz : F32) (+ oz (* wz t))
              (il : F32) (inv-len3 rx ry rz)]
          (set! dx (* rx il)) (set! dy (* ry il)) (set! dz (* rz il)))))
    (set-b-vx! (+ (c-vx s) (* dx speed)))
    (set-b-vy! (+ (c-vy s) (* dy speed)))
    (set-b-vz! (+ (c-vz s) (* dz speed)))
    (free-ball!)
    (set-c-nocatch! s (nocatch-ticks))
    (set-c-throws! s (+ (c-throws s) 1))
    (set-b-pass-from! s) (set-b-pass-t! (pass-window))
    (when (on-fire? s) (ball-fire! (fire-ball-ticks)))
    ;; a throw is a play of the ball (the renderer's flash and the bench's strike counter see it), not a second touch
    (set-b-touch-t! (gi (g-tick)))
    (set-b-hit-t! 8)))

;; once per tick, before the substeps: the lockout and pass-window clocks, and the carrier's choices
(defn magnet-tick! [] : Unit
  (do
    (dotimes [s (max-cars)] (when (> (c-nocatch s) 0) (set-c-nocatch! s (- (c-nocatch s) 1))))
    (when (> (b-pass-t) 0)
      (set-b-pass-t! (- (b-pass-t) 1))
      (when (= (b-pass-t) 0) (set-b-pass-from! -1)))
    (let [h (b-holder)]
      (when (>= h 0)
        (cond
          ;; the carrier has left the match: the ball is simply free
          (= (c-active h) 0) (free-ball!)
          ;; the button let go: throw
          (= (c-in-magnet h) 0) (throw! h (throw-speed))
          ;; five seconds is the limit: the ball is thrown for you, at half pace
          (>= (b-hold-t) (hold-ticks)) (throw! h (* 0.5 (throw-speed)))
          :else (set-b-hold-t! (+ (b-hold-t) 1)))))))

;; one substep of a carried ball: it rides the cradle. A wall in the way (the car driven nose-first into it) pushes it out like a
;; free ball, and a ball torn more than tear-dist off the cradle that way is dropped.
(defn held-ball-step! [] : Unit
  (let [h (b-holder)]
    (ride-cradle! h)
    (dotimes [pass 2]
      (let [sd (arena-free (b-x) (b-y) (b-z))
            (pen : F32) (- (rb) sd)]
        (when (> pen 0.0)
          (arena-normal! (b-x) (b-y) (b-z))
          (set-b-x! (+ (b-x) (* (gf (g-sdx)) pen)))
          (set-b-y! (+ (b-y) (* (gf (g-sdy)) pen)))
          (set-b-z! (+ (b-z) (* (gf (g-sdz)) pen))))))
    (when (> (len3 (- (b-x) (cradle-x h)) (- (b-y) (cradle-y h)) (- (b-z) (cradle-z h))) (tear-dist))
      (lose-ball! h))))

;; the magnets leave a ball alone while it is dead after a goal, or over the line in a shaft (it is a goal at the end of the tick)
(defn ball-magnetic? [] : Bool
  (and (= (gi (g-goal-t)) 0) (< (goal-at (b-x) (b-y) (b-z)) 0)))

;; s's magnet is live AND its cradle is in play: a cradle up over the goal line in a shaft holds nothing (a catch would snap the
;; ball over the line -- a keeper up in its own shaft would turn the other team's shot into its own goal)
(defn magnet-live? [(s : I32)] : Bool
  (and (magnet-ready? s) (< (goal-at (cradle-x s) (cradle-y s) (cradle-z s)) 0)))

;; one substep of the magnets on a free ball: every live magnet in range pulls it toward its cradle and damps its velocity
;; relative to that car (nothing at all happens while no magnet is live -- the ball is exactly the old ball). On fire the field
;; reaches 50% further (magnet-reach), with the same fade from full at the cradle to nothing at its edge. A ball moving too fast
;; relative to the car for the field to hold (magnet-grab) goes through it untouched.
(defn magnet-pull! [(dt : F32)] : Unit
  (when (ball-magnetic?)
    (dotimes [s (max-cars)]
      (when (magnet-live? s)
        (let [(dx : F32) (- (cradle-x s) (b-x)) (dy : F32) (- (cradle-y s) (b-y)) (dz : F32) (- (cradle-z s) (b-z))
              (d : F32) (len3 dx dy dz)
              (reach : F32) (magnet-reach s)
              (rv : F32) (len3 (- (b-vx) (c-vx s)) (- (b-vy) (c-vy s)) (- (b-vz) (c-vz s)))]
          (when (and (< d reach) (> d 0.001) (< rv (* (magnet-grab) (catch-limit s))))
            (let [(w : F32) (- 1.0 (/ d reach))
                  (k : F32) (/ (* (magnet-pull) w) d)
                  (damp : F32) (* (magnet-damp) w)]
              (set-b-vx! (+ (b-vx) (* (- (* dx k) (* (- (b-vx) (c-vx s)) damp)) dt)))
              (set-b-vy! (+ (b-vy) (* (- (* dy k) (* (- (b-vy) (c-vy s)) damp)) dt)))
              (set-b-vz! (+ (b-vz) (* (- (* dz k) (* (- (b-vz) (c-vz s)) damp)) dt))))))))))

;; after a free ball's substep: a live magnet with the ball inside catch-r of its cradle CATCHES it if it came in slower than the
;; catch limit relative to the car (the nearest such cradle, if two qualify). The speed is judged as the ball arrives: one that
;; comes in faster is FUMBLED -- the magnet lets go (the car is locked out, as if it had just lost the ball) and the ball carries
;; on into the car, where ball-car! bounces it as it always did. (Without that, the damping would keep braking a hot ball inside
;; the cradle until it crept under the limit, and the limit would mean nothing.)
(defn magnet-catch! [] : Unit
  (when (and (< (b-holder) 0) (ball-magnetic?))
    (let [(best : I32) -1 (bd : F32) (catch-r)]
      (dotimes [s (max-cars)]
        (when (magnet-live? s)
          (let [(d : F32) (len3 (- (b-x) (cradle-x s)) (- (b-y) (cradle-y s)) (- (b-z) (cradle-z s)))
                (rv : F32) (len3 (- (b-vx) (c-vx s)) (- (b-vy) (c-vy s)) (- (b-vz) (c-vz s)))]
            (when (< d (catch-r))
              (if (< rv (catch-limit s))
                  (when (< d bd) (set! best s) (set! bd d))
                  (set-c-nocatch! s (nocatch-ticks)))))))
      (when (>= best 0) (catch! best)))))

;; ---- the world step ---------------------------------------------------------------------------------------------------------------
(defn capture-prev! [] : Unit
  (do
    (dotimes [s (max-cars)]
      (when (!= (c-active s) 0)
        (set-c-px! s (c-x s)) (set-c-py! s (c-y s)) (set-c-pz! s (c-z s))
        (set-c-prx! s (c-rx s)) (set-c-pry! s (c-ry s)) (set-c-prz! s (c-rz s))
        (set-c-pux! s (c-ux s)) (set-c-puy! s (c-uy s)) (set-c-puz! s (c-uz s))
        (set-c-pfx! s (c-fx s)) (set-c-pfy! s (c-fy s)) (set-c-pfz! s (c-fz s))))
    (set-b-px! (b-x)) (set-b-py! (b-y)) (set-b-pz! (b-z))))

;; the physics of one tick; the goal check is done by the rules (br_rules.prn) after it
(defn physics-tick! [] : Unit
  (do
    (magnet-tick!)
    (fire-tick!)
    (dotimes [s (max-cars)] (when (!= (c-active s) 0) (air-tick! s)))
    (dotimes [sub 2]
      (dotimes [s (max-cars)] (when (!= (c-active s) 0) (car-substep! s (sub-dt))))
      (dotimes [a (max-cars)]
        (when (!= (c-active a) 0)
          (loop [b (+ a 1)]
            (when (< b (max-cars))
              (when (!= (c-active b) 0) (car-car! a b))
              (recur (+ b 1))))))
      ;; a carried ball rides its cradle; a free one feels the magnets, flies, and may be caught (before ball-car! can bounce it)
      (if (>= (b-holder) 0)
          (held-ball-step!)
          (do (magnet-pull! (sub-dt)) (ball-substep! (sub-dt)) (magnet-catch!)))
      (dotimes [s (max-cars)] (when (!= (c-active s) 0) (ball-car! s))))
    (when (> (b-hit-t) 0) (set-b-hit-t! (- (b-hit-t) 1)))))
