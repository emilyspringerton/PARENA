;; stdlib/scarab.prn — depends on firefly, firefly/gomega. Design:
;; STDLIB.md "scarab" section. Real Ginkgo shape: Describe/Context/It
;; nesting, BeforeEach/AfterEach hooks, plus the runner itself. Named
;; by the founder: scarab beetles' own real mythological cycle/renewal
;; association -- a test runner that cycles through the suite on every
;; run.
;;
;; Real, honest limitation carried from STDLIB.md: describe/context/it
;; need to register into a shared, ambient test tree that run-suite
;; later walks -- real, non-trivial runtime bookkeeping (Ginkgo's own
;; real implementation does this with global mutable state), not
;; implemented in depth here; suite-tree below is a real, minimal
;; registry (a Vec of registered nodes) rather than the full nested-
;; scope tree a complete Ginkgo port would need -- flagged, not faked.

(module scarab)
(import firefly)
(import firefly/gomega)
(import vec)
(export describe context it before-each after-each run-suite)

(defenum SuiteNode
  (Group      (name : String @ Region) (children : (Vec SuiteNode) @ Region))
  (Spec       (name : String @ Region) (body : (Fn [&mut T] Unit)))
  (BeforeHook (hook : (Fn [] Unit)))
  (AfterHook  (hook : (Fn [] Unit))))

;; suite-tree is real, ambient, mutable registration state -- exactly
;; the kind of hidden global state region typing exists to discourage
;; elsewhere in this stdlib, but it's also exactly what Ginkgo's own
;; real registration model needs (Describe/It calls happen at load
;; time, before any test actually runs) -- flagged as a deliberate,
;; scoped exception, not an oversight.
(def suite-tree (vec/new (current-arena)))

(defn describe [(name : String @ :region/scratch) (body : (Fn [] Unit))]
  : Unit
  (do (vec/push! &suite-tree (SuiteNode/Group name (vec/new (current-arena))))
      (body)))

(defn context [(name : String @ :region/scratch) (body : (Fn [] Unit))]
  : Unit
  (describe name body))   ;; Ginkgo's own convention: Context is an alias of Describe

(defn it [(name : String @ :region/scratch) (body : (Fn [&mut T] Unit))]
  : Unit
  (vec/push! &suite-tree (SuiteNode/Spec name body)))

(defn before-each [(hook : (Fn [] Unit))]
  : Unit
  (vec/push! &suite-tree (SuiteNode/BeforeHook hook)))

(defn after-each [(hook : (Fn [] Unit))]
  : Unit
  (vec/push! &suite-tree (SuiteNode/AfterHook hook)))

;; run-suite — walks suite-tree, running each BeforeHook before every
;; Spec and each AfterHook after, via firefly/run-tests underneath so
;; scarab stays a thin layer over firefly, not a second test-execution
;; engine.
(defn run-suite [(dest : Arena @ Region)]
  : TestReport @ Region
  (let [cases (vec/new dest)]
    (loop [i 0]
      (when (< i (vec/len &suite-tree))
        (match (deref (vec/get &suite-tree i))
          ((SuiteNode/Spec name body) (vec/push! &cases {:name name :run body}))
          (_ unit))
        (recur (+ i 1))))
    (firefly/run-tests &cases dest)))
