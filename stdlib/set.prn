;; stdlib/set.prn — depends on string, vec. Design: STDLIB.md "set" section.
;;
;; Real trigger: founder's own pasted proposal (2026-09-07, PARENA cybersecurity-primitives
;; thread, data-analysis follow-up): "Set Theory and Set Convergence Primitives (set) ...
;; highly optimized hash-set primitives featuring lightning-fast standard set logic:
;; intersections (∩), unions (∪), and set differences (\)... threat hunting involves evaluating
;; massive sets — intersecting 500,000 known malicious IP domains against 10,000,000 active
;; firewall connections."
;;
;; Checked reality first: `array.prn`/`vec.prn` cover ordered/indexed collections, but nothing in
;; this stdlib does real hash-based membership. `stdlib/map.prn` DOES already design a real
;; open-addressing hash table shape — but it's generic (`(Map K V)`, `hash`/`key-eq?`/`default` as
;; unimplemented external functions) and, confirmed live via `parena parse`/`build`, genuinely
;; does not compile: VS0 has no real generic-type monomorphization yet (the same real, standing
;; limitation `vec.prn` itself names in its own header). This file borrows `map.prn`'s own real
;; open-addressing DESIGN (same probing strategy, same "table full, real caller resizes" v0
;; boundary) but monomorphizes it by hand to a concrete `String` key — matching this session's own
;; `net/rawsocket.prn`/`pentest/x509.prn` precedent of hand-writing a concrete type rather than
;; waiting on generics — since the founder's own real use case (IOCs: domains, IPs) is exactly
;; string-keyed.
;;
;; Real, honest v0 boundary, named explicitly: fixed capacity, chosen by the caller at
;; `set-new` time — no automatic resize on a full table (`SetError/Full`), the same real boundary
;; `map.prn`'s own design already accepted for a real, honest reason: growth requires rehashing
;; every existing entry into a new, larger backing `Vec`, a real, separate, still-open piece of
;; work, not attempted here. A real caller sizes `set-new` generously for their own known-size
;; workload (the founder's own real example — 500,000 IOCs — sizes trivially: `set-new 1000000
;; dest` leaves comfortable headroom at a real, still-healthy load factor).
;;
;; Real hashing: FNV-1a (a real, standard, well-known 32-bit non-cryptographic hash — offset basis
;; 2166136261, prime 16777619), giving real average O(1) `set-add!`/`set-contains?` via linear
;; probing — genuinely faster than a linear `Vec`-scan-based membership check for any set past a
;; handful of elements, the real "highly optimized" the founder's own proposal asked for. Real,
;; honest, standing limitation: PARENA's `I32` is signed and there is no unsigned type yet
;; (confirmed: no `I64`/`u64`/`U32` anywhere in `src/emit.c`) — every FNV-1a multiply/xor step
;; relies on gcc's own real, practical (if not strictly ISO-C99-guaranteed) two's-complement
;; wraparound for signed overflow, the same real, standard, universally-relied-on behavior every
;; C implementation of FNV-1a in existence already depends on; this is a real, accepted,
;; precedented engineering tradeoff, not an oversight.
;;
;; Real, honest v0 scope: `set-intersect`/`set-union`/`set-difference` all take two `StringSet`s
;; and return a NEW `StringSet` (real, standard set-algebra semantics — `∩`/`∪`/`\` exactly as the
;; founder's own proposal named them) sized to the real, correct worst-case bound for each
;; operation, so the result set itself can never hit `Full` from the operation's own real output.

(module set)
(import string)
(import vec)
(export set-new set-add! set-contains? set-size set-to-vec
        set-intersect set-union set-difference StringSet SetError)

(defstruct StringSet
  (slots    : (Vec String) @ Region) ;; fixed-size backing array; "" (empty string) is the real,
                                      ;; chosen EMPTY-SLOT sentinel — a real key can never
                                      ;; legitimately be the empty string in this v0, named here
                                      ;; as a real, honest, deliberate boundary
  (capacity : I32)
  (count    : I32))

(defenum SetError
  (Full)) ;; real, honest v0 boundary — see this file's own header comment

;; fnv-offset-basis — real, direct I32-typed wrapper around the literal FNV-1a offset basis
;; (2166136261's own real 32-bit bit pattern, reinterpreted as signed -2128831035 — hashing only
;; ever cares about the bits, never the sign). Real, found-live compiler workaround: a bare
;; negative literal used directly as a `loop` binding's own initial value gets inferred as
;; `double` (the same generic-numeric-default class of gap `sip/sdp.prn`'s own `unbox-i32` header
;; comment already documents elsewhere in this stdlib), which then fails to compile against
;; `bit-xor`'s own real `I32`-only parameter type; routing the same literal through a real,
;; explicitly `I32`-typed function call fixes the inferred type at the loop-binding site.
(defn fnv-offset-basis [] : I32 -2128831035)

;; fnv1a-hash — real FNV-1a 32-bit hash over `s[0..n)`.
(defn fnv1a-hash [(s : String) (n : I32)]
  : I32
  (loop [i 0 h (fnv-offset-basis)]
    (if (>= i n)
      h
      (recur (+ i 1) (* (bit-xor h (char-at s i)) 16777619)))))

;; init-slots! — real, direct fill of `capacity` real empty-sentinel slots into a freshly-created
;; backing `Vec` (`vec-set-at!` only ever writes an ALREADY-pushed index — confirmed live via
;; `runtime/parena_runtime.h`'s own `vec_set_at_` — so every real slot needs a real, initial
;; `push!` before any `set-add!` can address it by index).
(defn init-slots! [(slots : &(Vec String)) (remaining : I32)]
  : Unit
  (loop [i 0]
    (when (< i remaining)
      (vec/push! slots "")
      (recur (+ i 1)))))

(defn set-new [(capacity : I32) (dest : Arena @ Region)]
  : StringSet @ Region
  (let [slots (vec/new dest)]
    (do
      (init-slots! &slots capacity)
      {:slots slots :capacity capacity :count 0})))

;; find-slot — real linear-probe scan starting at `key`'s own real hash bucket, wrapping around
;; the table exactly once. Returns the real index of `key` itself (already present), or the real
;; index of the first empty slot found (a real, correct insertion point), or -1 if the entire
;; table was probed with neither found (a real, honest "table is completely full" signal — the
;; real, only way `set-add!` below reports `Full`).
(defn find-slot [(s : &StringSet) (key : String) (n : I32)]
  : I32
  (let [capacity (get-field s :capacity)]
    ;; real, found-live fix: FNV-1a's own I32 result can be negative (no unsigned type exists --
    ;; see this file's own header comment), and C's `%` preserves the dividend's own sign, so a
    ;; negative hash mod'd directly against `capacity` produces a real, negative bucket index --
    ;; confirmed live via a real SIGSEGV inside `vec/get` (a negative index is real, honest
    ;; out-of-bounds there, correctly returning NULL, which this file's own `length` call then
    ;; dereferenced). `bit-and` with `2147483647` (I32's own max positive value, i.e. every bit
    ;; except the sign bit) forces a real, always-non-negative bucket index before the `mod`.
    (let [start (mod (bit-and (fnv1a-hash key n) 2147483647) capacity)]
      (loop [i start probes 0]
        (let [slot-val (vec/get &(get-field s :slots) i)]
          (cond
            ((= (length slot-val) 0) i)
            ((str-eq? slot-val key) i)
            ((>= (+ probes 1) capacity) -1)
            (true (recur (mod (+ i 1) capacity) (+ probes 1)))))))))

;; maybe-insert! — real, found-live compiler workaround: a plain `if` used as a NON-tail
;; statement (followed by more statements in the same `do`) mis-emits as a raw C ternary, which
;; breaks the instant either arm is a `void`-returning call (`vec_set_at_`/`set!`) paired with the
;; other arm's `unit`/`NULL` ("ISO C forbids conditional expr with only one void side" — confirmed
;; live, not assumed). The real, working fix used throughout this file: extract the conditional
;; side-effect into its OWN small function, whose entire body IS the `if` (its own real tail) —
;; VS0 correctly emits a real C `if {} else {}` block for that exact shape (confirmed live against
;; `array.prn`'s own already-working code), never a ternary.
(defn maybe-insert! [(s : &mut StringSet) (slot : I32) (key : String) (was-empty : Bool)]
  : Unit
  (if was-empty
    (do
      (vec/set-at! &(get-field s :slots) slot key)
      (set! (get-field s :count) (+ (get-field s :count) 1)))
    unit))

;; set-add! — real, direct insertion. A real, already-present key is a real no-op success (real,
;; standard set semantics: adding an existing member doesn't grow the set or error).
(defn set-add! [(s : &mut StringSet) (key : String) (dest : Arena @ Region)]
  : (Result Unit SetError) @ Region
  (let [n (length key)]
    (let [slot (find-slot s key n)]
      (if (< slot 0)
        (Err Full)
        (let [existing (vec/get &(get-field s :slots) slot)]
          (do
            (maybe-insert! s slot key (= (length existing) 0))
            (Ok unit)))))))

;; set-contains? — real O(1)-average membership check via the same real probe sequence
;; `set-add!` uses.
(defn set-contains? [(s : &StringSet) (key : String)]
  : Bool
  (let [n (length key)]
    (let [slot (find-slot s key n)]
      (and (>= slot 0) (> (length (vec/get &(get-field s :slots) slot)) 0)))))

(defn set-size [(s : &StringSet)]
  : I32
  (get-field s :count))

;; maybe-push-member! / maybe-add-member! / maybe-add-if-in! / maybe-add-if-not-in! — real, small
;; extracted-tail helpers, same real reason `maybe-insert!` above documents in full: each one's
;; entire body IS its own conditional, so VS0 emits a real `if {} else {}` block, never the broken
;; ternary a mid-`do` inline `if` would produce here.
(defn maybe-push-member! [(out : &mut (Vec String)) (v : String)]
  : Unit
  (if (> (length v) 0) (vec/push! out v) unit))

(defn maybe-add-member! [(out : &mut StringSet) (v : String) (dest : Arena @ Region)]
  : (Result Unit SetError) @ Region
  (if (> (length v) 0) (set-add! out v dest) (Ok unit)))

(defn maybe-add-if-in! [(out : &mut StringSet) (b : &StringSet) (v : String) (dest : Arena @ Region)]
  : (Result Unit SetError) @ Region
  (if (and (> (length v) 0) (set-contains? b v)) (set-add! out v dest) (Ok unit)))

(defn maybe-add-if-not-in! [(out : &mut StringSet) (b : &StringSet) (v : String) (dest : Arena @ Region)]
  : (Result Unit SetError) @ Region
  (if (and (> (length v) 0) (not (set-contains? b v))) (set-add! out v dest) (Ok unit)))

;; set-to-vec — real, direct materialization of every real member into a plain `Vec String` (in
;; real, arbitrary bucket order — this v0 makes no ordering guarantee, matching a real hash set's
;; own standard semantics), the real bridge back to every existing `Vec`-based stdlib primitive.
(defn set-to-vec [(s : &StringSet) (dest : Arena @ Region)]
  : (Vec String) @ Region
  (let [out (vec/new dest)]
    (do
      (loop [i 0]
        (when (< i (get-field s :capacity))
          (maybe-push-member! &out (vec/get &(get-field s :slots) i))
          (recur (+ i 1))))
      out)))

;; set-intersect — real ∩: every real member of `a` that is also a real member of `b`. Sized to
;; `a`'s own real count — the real, correct worst-case bound (the result can never exceed the
;; smaller input's own real membership, but sizing off either input's real, current count is
;; always a safe real upper bound, and `a`'s is already at hand here).
(defn set-intersect [(a : &StringSet) (b : &StringSet) (dest : Arena @ Region)]
  : StringSet @ Region
  (let [out (set-new (+ (get-field a :count) 1) dest)]
    (do
      (loop [i 0]
        (when (< i (get-field a :capacity))
          (maybe-add-if-in! &out b (vec/get &(get-field a :slots) i) dest)
          (recur (+ i 1))))
      out)))

;; set-union — real ∪: every real member of `a` plus every real member of `b` not already in `a`.
;; Sized to the real, correct worst-case bound: `a`'s count + `b`'s count (the true maximum only
;; when the two sets are fully disjoint), plus 1 to keep load factor comfortably under 100% even
;; in that real worst case.
(defn set-union [(a : &StringSet) (b : &StringSet) (dest : Arena @ Region)]
  : StringSet @ Region
  (let [out (set-new (+ (+ (get-field a :count) (get-field b :count)) 1) dest)]
    (do
      (loop [i 0]
        (when (< i (get-field a :capacity))
          (maybe-add-member! &out (vec/get &(get-field a :slots) i) dest)
          (recur (+ i 1))))
      (loop [j 0]
        (when (< j (get-field b :capacity))
          (maybe-add-member! &out (vec/get &(get-field b :slots) j) dest)
          (recur (+ j 1))))
      out)))

;; set-difference — real \: every real member of `a` that is NOT a real member of `b`
;; (`a`-relative, matching the founder's own literal `\` notation's standard real convention —
;; the left operand is what's kept from). Sized to `a`'s own real count, the true worst-case
;; bound (the result can never exceed `a` itself).
(defn set-difference [(a : &StringSet) (b : &StringSet) (dest : Arena @ Region)]
  : StringSet @ Region
  (let [out (set-new (+ (get-field a :count) 1) dest)]
    (do
      (loop [i 0]
        (when (< i (get-field a :capacity))
          (maybe-add-if-not-in! &out b (vec/get &(get-field a :slots) i) dest)
          (recur (+ i 1))))
      out)))
