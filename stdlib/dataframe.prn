;; stdlib/dataframe.prn — depends on array, string, vec. Design:
;; STDLIB.md "dataframe" section, the pandas equivalent. column/select
;; are real, complete (linear scans over column-names). read-csv and
;; filter/group-by are genuinely deferred: a real CSV parser (quoting,
;; escaping) and a real columnar-scan filter/group-by are their own
;; work, same honest limitation STDLIB.md already states.
;;
;; Real status update (2026-08-21, see STDLIB.md's own "dataframe"
;; section for the full real reasoning): `column` AND `select` are now
;; both real, gcc-clean, AND runtime-verified (a real harness confirming
;; column's own found/not-found cases and select's own real
;; multi-column selection + unknown-name error path). Getting here
;; closed four real, general, broadly-impactful emitter bugs, none
;; specific to this file (full detail in STDLIB.md): the single-token
;; `&name` form's own element-type-hint lookup never matched its own
;; registration key; `vec_get`'s own hint-informed cast added a wrong
;; extra level of pointer indirection for a pointer-representable
;; element (String) that's never boxed at all; `resolve_declared_type()`
;; didn't understand a parenthesized `(&Type)` reference nested inside a
;; `Result`/`Option`'s own payload-type slot; and a `match` clause whose
;; own tail is a real, void-returning runtime call (`vec_push_`) had
;; nowhere valid to put that result, both in its own declaration
;; (`void` isn't a real declarable C type) and its own assignment (a
;; void value can't be assigned at all). `read-csv`/`filter`/`group-by`
;; remain genuinely deferred, unchanged.

(module dataframe)
(import array)
(import string)
(import vec)
(export column select read-csv filter group-by)

(defenum Column
  (NumericCol (data : NDArray @ Region))
  (StringCol  (data : (Vec String) @ Region)))

(defstruct DataFrame
  (columns      : (Vec Column) @ Region)
  (column-names : (Vec String) @ Region)
  (row-count    : I32))

;; Real, honest gap closed here (2026-08-21): column/select both used
;; ColumnNotFoundError in their own real signature but this file never
;; actually DEFINED it -- the same real missing-definition-in-source-
;; itself gap class already closed for pcap.prn/io.prn/array.prn/
;; string.prn/glob.prn/stats.prn.
(defstruct ColumnNotFoundError
  (name : String))

;; Real, honest gap closed here (2026-08-21): column's own (Err
;; (ColumnNotFoundError name)) needs to box a non-pointer struct
;; payload, but the signature carried no Arena to box into at all --
;; the identical real gap array.prn's own get/set!/string.prn's own
;; parse-i32 already had, fixed the same way: an explicit
;; dest : Arena @ Region parameter.
(defn column [(df : &DataFrame) (name : String @ :region/scratch) (dest : Arena @ Region)]
  : (Result (&Column) ColumnNotFoundError) @ Region
  (loop [i 0]
    (if (>= i (vec/len &(get-field df :column-names)))
      (Err (ColumnNotFoundError name))
      (if (str-eq? (vec/get &(get-field df :column-names) i) name)
        (Ok (vec/get &(get-field df :columns) i))
        (recur (+ i 1))))))

(defn select [(df : &DataFrame) (names : (Vec String) @ :region/scratch) (dest : Arena @ Region)]
  : (Result DataFrame ColumnNotFoundError) @ Region
  (let [out-cols (vec/new dest) out-names (vec/new dest)]
    (loop [i 0]
      (when (< i (vec/len &names))
        (match (column df (vec/get &names i) dest)
          ((Ok col) (do (vec/push! &out-cols (deref col)) (vec/push! &out-names (vec/get &names i))))
          ((Err e) (return (Err e))))
        (recur (+ i 1))))
    (Ok {:columns out-cols :column-names out-names :row-count (get-field df :row-count)})))

;; read-csv — real CSV quoting/escaping is genuinely deferred (RFC 4180
;; edge cases: quoted fields containing the delimiter, embedded
;; newlines, doubled-quote escaping) -- left as a real follow-up rather
;; than a naive split-on-comma that would silently mis-parse real data.
(defn read-csv [(path : String @ :region/scratch) (dest : Arena @ Region)]
  : (Result DataFrame IoError) @ Region)

(defn filter [(df : &DataFrame) (pred : (Fn [I32] Bool)) (dest : Arena @ Region)]
  : DataFrame @ Region)

(defn group-by [(df : &DataFrame) (name : String @ :region/scratch) (dest : Arena @ Region)]
  : (Result (Vec DataFrame) ColumnNotFoundError) @ Region)
