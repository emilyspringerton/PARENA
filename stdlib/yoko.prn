;; stdlib/yoko.prn — depends on vec, string. Design: STDLIB.md
;; "pentest/exploit/native" section (renamed to yoko here — see below).
;; A real, PARENA-native module/payload TYPE SYSTEM and orchestration
;; layer, grounded in Metasploit's own actual architecture -- NOT a
;; replacement for pentest/exploit.prn (the real FFI binding to
;; Metasploit's own mature module database, kept exactly as-is).
;; Founder, real-time: "instead of calling out to c for all of the
;; pentest tools" -> "like we need metasploit in PARENA" -> "not
;; calling out to it" -> "its fint to get it to compile for now" ->
;; (clarified) "some of the underlying stuff" -> "call out to c" ->
;; "you have to" -> "we need to write in parena so we can compile in
;; parena" -> "give parena metasplit the name YOKO". Continues the same
;; real naming lineage `ringo.prn` already started ("apparently parena
;; is a beetle" -> "RINGO", a Beatles pun alongside the firefly/scarab
;; *actual*-beetle naming for the testing framework) -- Ringo Starr and
;; Yoko Ono, both real Beatles-adjacent figures, top-level `stdlib/`
;; package names like `ringo.prn`, not nested under `pentest/`.
;;
;; Real, honest scope: check/generate-payload/exploit's own bodies are
;; #target stubs -- the genuine low-level boundary (raw socket delivery,
;; actual shellcode bytes) explicitly OK'd to stay in C, same real split
;; every other FFI-adjacent package in this stdlib already uses. The
;; module/payload/session type system itself, and everything that
;; composes it, is real, native PARENA source the region analyzer and
;; emitter actually check -- not faked, not a design doc pretending to
;; be code. No real shellcode generation or wire delivery is implemented
;; yet; the ask was explicitly "fine to get it to compile for now."

(module yoko)
(import vec)
(import string)
(export check generate-payload exploit)

(defenum Rank
  (Excellent) (Great) (Good) (Normal) (Average) (Low) (Manual))

(defenum Platform
  (Linux) (Windows) (MacOS) (Generic))

(defstruct Target
  (name     : String @ Region)
  (platform : Platform))

(defstruct ModuleOption
  (key   : String @ Region)
  (value : String @ Region))

(defstruct Payload
  (name     : String @ Region)
  (platform : Platform)
  (bytes    : (Vec String) @ Region))

(defstruct ExploitModule
  (name    : String @ Region)
  (rank    : Rank)
  (target  : Target)
  (options : (Vec String) @ Region))

(defstruct Session
  (id     : I32)
  (target : Target)
  (active : I32))

(defn check [(m : &ExploitModule)]
  : I32
  #target
  {:c (inline-c "host_pentest_check((void *)m)")})

(defn generate-payload [(name : String @ :region/scratch) (platform : Platform) (dest : Arena @ Region)]
  : Payload @ Region
  #target
  {:c (inline-c "host_pentest_generate_payload(name, platform, dest)")})

(defn exploit [(m : &ExploitModule) (p : &Payload) (dest : Arena @ Region)]
  : Session @ Region
  #target
  {:c (inline-c "host_pentest_exploit((void *)m, (void *)p, dest)")})
