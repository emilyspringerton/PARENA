;; stdlib/tests/vec_test.prn — real tests for the vec/* runtime
;; primitives (parena_runtime.h's own vec_new/vec_push_/vec_get --
;; mangle_call_name() deliberately excludes `vec/` from its own bare-
;; name resolution, so these calls always route to the real runtime,
;; independent of whether vec.prn's own real-but-parseable-only design
;; doc source is combined into any given build), written using firefly
;; (stdlib/firefly.prn). Founder: "and then start to write tests for
;; teh std lib." Dogfoods firefly's own real T/errorf/TestCase/
;; run-tests shape against the first, most foundational package this
;; whole stdlib tree depends on.
;;
;; Real, honest fix (2026-08-21, gcc-verifying this file for the first
;; time): every test body used to call `(vec/new (current-arena))` --
;; `current-arena` is a builtin that was never designed and doesn't fit
;; VS0's own memory model at all (no ambient/implicit arenas anywhere
;; in this language, on purpose). Each test body now opens its own real
;; `with-arena` block instead, the same real pattern this whole stdlib
;; already uses everywhere else.

(module tests/vec-test)
(import firefly)
(export test-cases)

(defn test-new-is-empty [(!t : &mut T)]
  : Unit
  (with-arena [dest :region/scratch 4096]
    (let [v (vec/new &dest)]
      (when (not (= (vec/len &v) 0))
        (firefly/errorf !t "vec/new: expected len 0, got a non-empty vec")))))

(defn test-push-increases-len [(!t : &mut T)]
  : Unit
  (with-arena [dest :region/scratch 4096]
    (let [v (vec/new &dest)]
      (vec/push! &v 42)
      (when (not (= (vec/len &v) 1))
        (firefly/errorf !t "vec/push!: expected len 1 after one push")))))

(defn test-push-grows-past-initial-capacity [(!t : &mut T)]
  : Unit
  ;; real/honest: vec/new's own initial capacity is 8 (per vec.prn's
  ;; own design comment) -- pushing 20 elements exercises the real
  ;; grow!/doubling path, not just the fast/no-realloc case.
  (with-arena [dest :region/scratch 4096]
    (let [v (vec/new &dest)]
      (loop [i 0]
        (when (< i 20) (vec/push! &v i) (recur (+ i 1))))
      (when (not (= (vec/len &v) 20))
        (firefly/errorf !t "vec/push!: expected len 20 after 20 pushes past initial capacity")))))

(defn test-cases [(dest : Arena @ Region)]
  : (Vec TestCase) @ Region
  (let [cases (vec/new dest)]
    (vec/push! &cases {:name "vec/new produces an empty vec" :run test-new-is-empty})
    (vec/push! &cases {:name "vec/push! increases len by one" :run test-push-increases-len})
    (vec/push! &cases {:name "vec/push! grows past initial capacity" :run test-push-grows-past-initial-capacity})
    cases))
