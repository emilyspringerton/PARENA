;; stdlib/tests/vec_test.prn — real tests for stdlib/vec.prn, written
;; using firefly (stdlib/firefly.prn). Founder: "and then start to
;; write tests for teh std lib." Dogfoods firefly's own real T/errorf/
;; TestCase/run-tests shape against the first, most foundational
;; package this whole stdlib tree depends on.

(module tests/vec-test)
(import vec)
(import firefly)
(export test-cases)

(defn test-new-is-empty [(!t : &mut T)]
  : Unit
  (let [v (vec/new (current-arena))]
    (when (not (= (vec/len &v) 0))
      (firefly/errorf !t "vec/new: expected len 0, got a non-empty vec"))))

(defn test-push-increases-len [(!t : &mut T)]
  : Unit
  (let [v (vec/new (current-arena))]
    (vec/push! &v 42)
    (when (not (= (vec/len &v) 1))
      (firefly/errorf !t "vec/push!: expected len 1 after one push"))))

(defn test-get-returns-pushed-value [(!t : &mut T)]
  : Unit
  (let [v (vec/new (current-arena))]
    (vec/push! &v 7)
    (match (vec/get &v 0)
      ((Some val) (when (not (= (deref val) 7))
                    (firefly/errorf !t "vec/get: expected 7 at index 0")))
      (None (firefly/errorf !t "vec/get: expected Some, got None for a valid index")))))

(defn test-get-out-of-bounds-is-none [(!t : &mut T)]
  : Unit
  (let [v (vec/new (current-arena))]
    (match (vec/get &v 5)
      ((Some _) (firefly/errorf !t "vec/get: expected None for an out-of-bounds index"))
      (None unit))))

(defn test-push-grows-past-initial-capacity [(!t : &mut T)]
  : Unit
  ;; real/honest: vec/new's own initial capacity is 8 (per vec.prn's
  ;; own design comment) -- pushing 20 elements exercises the real
  ;; grow!/doubling path, not just the fast/no-realloc case.
  (let [v (vec/new (current-arena))]
    (loop [i 0]
      (when (< i 20) (vec/push! &v i) (recur (+ i 1))))
    (when (not (= (vec/len &v) 20))
      (firefly/errorf !t "vec/push!: expected len 20 after 20 pushes past initial capacity"))))

(defn test-cases [(dest : Arena @ Region)]
  : (Vec TestCase) @ Region
  (let [cases (vec/new dest)]
    (vec/push! &cases {:name "vec/new produces an empty vec" :run test-new-is-empty})
    (vec/push! &cases {:name "vec/push! increases len by one" :run test-push-increases-len})
    (vec/push! &cases {:name "vec/get returns the pushed value" :run test-get-returns-pushed-value})
    (vec/push! &cases {:name "vec/get is None past the end" :run test-get-out-of-bounds-is-none})
    (vec/push! &cases {:name "vec/push! grows past initial capacity" :run test-push-grows-past-initial-capacity})
    cases))
