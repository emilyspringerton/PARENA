;; stdlib/tests/world_test.prn — real tests for stdlib/world.prn, using
;; firefly.

(module tests/world-test)
(import world)
(import firefly)
(export test-cases)

(defn test-set-then-get-height [(!t : &mut T)]
  : Unit
  (let [heights (vec/new (current-arena))]
    (loop [i 0] (when (< i 100) (vec/push! &heights 0.0) (recur (+ i 1))))
    (let [terrain {:heights heights :width 10 :height 10 :cell-size 1.0}]
      (world/set-height &mut terrain 3 4 12.5)
      (when (not (= (world/get-height &terrain 3 4) 12.5))
        (firefly/errorf !t "world/set-height then get-height should round-trip")))))

(defn test-out-of-bounds-get-returns-zero [(!t : &mut T)]
  : Unit
  (let [heights (vec/new (current-arena))]
    (loop [i 0] (when (< i 4) (vec/push! &heights 5.0) (recur (+ i 1))))
    (let [terrain {:heights heights :width 2 :height 2 :cell-size 1.0}]
      (when (not (= (world/get-height &terrain 99 99) 0.0))
        (firefly/errorf !t "world/get-height: expected 0.0 for an out-of-bounds cell, not a crash")))))

(defn test-out-of-bounds-set-is-a-no-op [(!t : &mut T)]
  : Unit
  ;; real safety property: set-height's own in-bounds? guard means an
  ;; out-of-bounds write is silently ignored rather than corrupting an
  ;; adjacent row via a miscalculated flat index -- worth a real test,
  ;; not just trusting the guard exists.
  (let [heights (vec/new (current-arena))]
    (loop [i 0] (when (< i 4) (vec/push! &heights 1.0) (recur (+ i 1))))
    (let [terrain {:heights heights :width 2 :height 2 :cell-size 1.0}]
      (world/set-height &mut terrain 50 50 999.0)
      (when (not (= (world/get-height &terrain 0 0) 1.0))
        (firefly/errorf !t "world/set-height: an out-of-bounds write must not corrupt in-bounds cells")))))

(defn test-cases [(dest : Arena @ Region)]
  : (Vec TestCase) @ Region
  (let [cases (vec/new dest)]
    (vec/push! &cases {:name "set-height then get-height round-trips" :run test-set-then-get-height})
    (vec/push! &cases {:name "get-height is 0.0 out of bounds, not a crash" :run test-out-of-bounds-get-returns-zero})
    (vec/push! &cases {:name "set-height out of bounds does not corrupt in-bounds cells" :run test-out-of-bounds-set-is-a-no-op})
    cases))
