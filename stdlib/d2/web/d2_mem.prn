(defn g-sim-shat [] : I32 (+ 129 (sel-off)))      ; Back-EMF meltdowns so far

;; more ship state (per ship, like the sim words above)
(defn g-sim-hull [] : I32 (+ 141 (sel-off)))
(defn g-sim-dmg [] : I32 (+ 144 (sel-off)))
(defn g-sim-budget [] : I32 (+ 150 (sel-off)))     ; hand-offs left this tick (the walk stops at 4096, as the C core does)
