(defn g-m-id [] : I32 30) (defn g-m-seed [] : I32 31) (defn g-m-seat [] : I32 32) (defn g-m-oppkind [] : I32 33)
(defn g-m-packms [] : I32 34) (defn g-m-found-t [] : I32 35)
