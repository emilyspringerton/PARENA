;; stdlib/d2/web/d2_mem.prn -- D2 (DEADWEIGHT_2) web client: linear-memory map, accessors, globals, small math.
;;
;; Founder real-time 2026-10-17: "now DEADWEIGHT_2 same affordances WOTAN ESPORTS WASM TS PARENA" -- after Red Garden web (a wasm CLIENT of the
;; real C server, guests + IDUNA SSO, full match and player tracking, the existing bot infrastructure). D2's match is dw2_server's (C,
;; authoritative: the 120 s packing clock, the 30-tick fight, the round-break mini-game); this module is its client, compiled to wasm32.
;; It speaks dw2_server's own frames through IDUNA's WebSocket gateway (d2_net.prn), holds the player's ship while they pack it, runs the
;; ship's wiring exactly as core/combat.c does (so the energy the player sees is the energy the server fights with), animates everything the server
;; says happened each second (its EVENTS frame), and draws all of it.
;;
;; Ruleset 2 (2026-10-17, "iterate so the game is more playable and fun"): every part has a cost, a weight and HP; a ship has a credit and a weight budget;
;; shots fly down lanes (columns); parts are destroyed. See DEADWEIGHT_2/core/combat.h for the rules; this client mirrors the parts it needs.
;;
;; NO MALLOC: no allocator, no imports, memory never grows (8 MB, fixed). Every record has a fixed address.
;;   0x020000 CTL      input tables                                         (d2_input.prn)
;;   0x021000 G        global state words                                   (g-* below)
;;   0x022000 NETIN    2 KB   one frame from the gateway
;;   0x024000 NETOUT   8 KB   frames for the gateway
;;   0x026000 TOKEN    2 KB   the IDUNA bearer token, written by the page
;;   0x026800 NAME     64 B   the player's display name, written by the page
;;   0x026840 OPP      32 B   the opponent's name
;;   0x027000 SCRATCH  1 KB
;;   0x029000 ERR      256 B  the last error text from the gateway
;;   0x02A800 SHAPE    16 x 16 B  a shape being placed (row, col, port, role per cell)
;;   0x02B000 STAGE    36 x 8 B per ship (1 KB each)   the ship being packed: item, row, col, rot, (unused), ok;  ship 1 at 0x02B400 is the opponent's, shown in the fight
;;   0x02C000 MODEL    2 KB per ship: the grid the stage makes (36 x 8 B: owner, role, port, ruined, dead, powered, -, depth|in), then per-cell HP and effect times
;;   0x02D000 ROUNDS   8 x 16 B   what happened at each round break
;;   0x02D800 LOG      16 x 16 B  what just happened in the fight
;;   0x02DC00 SIM      2 KB per ship: weapon charge, power per cell, stored charge (capacitors, batteries, delayers), gates, loop tracker
;; Two ships share one set of functions: g-ship (0 you, 1 the opponent) picks which STAGE / MODEL / SIM / ship globals they read and write.
;;   0x030000 FONT     255 glyphs x 16 rows
;;   0x040000 ITEMS    24 x 128 B the item catalog (d2_rules.prn)
;;   0x041000 EXAMPLES 12 x 160 B the ships the EXAMPLE button lays down (d2_examples.prn)
;;   0x042000 FX       96 x 32 B  the fight's animations in flight: shots, hits, numbers, sparks
;;   0x100000 FB       960 x 540 RGBA framebuffer

(module d2/web)

(defn ctl-base [] : I32 131072)
(defn g-base [] : I32 135168)
(defn netin-base [] : I32 139264)
(defn netout-base [] : I32 147456)
(defn token-base [] : I32 155648)
(defn name-base [] : I32 157696)
(defn opp-base [] : I32 157760)
(defn scratch-base [] : I32 159744)
(defn err-base [] : I32 167936)
(defn items-base [] : I32 262144)
(defn shape-base [] : I32 174080)
(defn rounds-base [] : I32 184320)
(defn log-base [] : I32 186368)
(defn fx-base [] : I32 270336)
(defn font-base [] : I32 196608)
(defn fb-base [] : I32 1048576)

(defn fb-w [] : I32 960)
(defn fb-h [] : I32 540)

;; ---- byte-level readers (the wasm has only 8/32-bit loads) -----------------------------------------------------------------
(defn ld16 [(a : I32)] : I32 (+ (load8 a) (shl (load8 (+ a 1)) 8)))
(defn lds8 [(a : I32)] : I32 (let [v (load8 a)] (if (> v 127) (- v 256) v)))
(defn st16! [(a : I32) (v : I32)] : Unit (do (store8! a (bit-and v 255)) (store8! (+ a 1) (bit-and (shr v 8) 255))))

;; ---- global state words -----------------------------------------------------------------------------------------------------
(defn gi [(k : I32)] : I32 (load32 (+ (g-base) (shl k 2))))
(defn gi! [(k : I32) (v : I32)] : Unit (store32! (+ (g-base) (shl k 2)) v))
(defn gf [(k : I32)] : F32 (loadf32 (+ (g-base) (shl k 2))))
(defn gf! [(k : I32) (v : F32)] : Unit (storef32! (+ (g-base) (shl k 2)) v))

;; which ship the rules functions work on: 0 the player's, 1 the opponent's (shown in the fight)
(defn g-ship [] : I32 132)
(defn sel-off [] : I32 (* (gi (g-ship)) 200))
(defn stage-base [] : I32 (+ 176128 (* (gi (g-ship)) 1024)))
(defn model-base [] : I32 (+ 180224 (* (gi (g-ship)) 2048)))
(defn sim-base [] : I32 (+ 187392 (* (gi (g-ship)) 2048)))

;; screens: 0 title, 1 searching, 2 packing, 3 combat, 4 match over, 5 error
(defn g-screen [] : I32 0)
(defn g-frame [] : I32 1)
(defn g-ticker [] : I32 2)          ; wall-clock ms as I32 (animation and timing only)
(defn g-ui-t [] : I32 3)            ; frames on the current screen
(defn g-net-state [] : I32 4)       ; 0 off, 1 connecting, 2 open, 3 closed
(defn g-want-queue [] : I32 5)
(defn g-token-len [] : I32 6)
(defn g-name-len [] : I32 7)
(defn g-in-len [] : I32 8)
(defn g-out-len [] : I32 9)
(defn g-auth-sent [] : I32 10)
(defn g-welcomed [] : I32 11)       ; the match server's WELCOME arrived
(defn g-guest [] : I32 12)
(defn g-ident-ok [] : I32 13)       ; the gateway accepted the token
(defn g-queued-sent [] : I32 14)
(defn g-q-waiting [] : I32 15)
