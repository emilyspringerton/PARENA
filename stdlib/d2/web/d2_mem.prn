(defn g-hull-you [] : I32 40) (defn g-hull-opp [] : I32 41)
(defn g-armor-you [] : I32 42) (defn g-armor-opp [] : I32 43)
(defn g-shat-you [] : I32 44) (defn g-shat-opp [] : I32 45)
(defn g-cargo-you [] : I32 46) (defn g-cargo-opp [] : I32 47)
(defn g-tick-t [] : I32 48)         ; ticker ms the last TICK arrived
(defn g-combat-t [] : I32 49)       ; ticker ms combat started
(defn g-hull0-you [] : I32 50) (defn g-armor0-you [] : I32 51) (defn g-armor0-opp [] : I32 52)

;; the round break
(defn g-rb-on [] : I32 55) (defn g-rb-no [] : I32 56) (defn g-rb-behind [] : I32 57) (defn g-rb-target [] : I32 58)
(defn g-rb-budget [] : I32 59) (defn g-rb-t0 [] : I32 60)
(defn g-rb-call [] : I32 61)        ; 0 none yet, 1 overcharge, 2 brace
(defn g-rb-call-t [] : I32 62)
(defn g-rr-show [] : I32 63)        ; ticker ms the latest ROUND_RESULT arrived (0 none)
(defn g-rr-ycall [] : I32 64) (defn g-rr-ygrade [] : I32 65) (defn g-rr-yfx [] : I32 66)
(defn g-rr-ocall [] : I32 67) (defn g-rr-ograde [] : I32 68) (defn g-rr-ofx [] : I32 69)
(defn g-rb-count [] : I32 70)       ; round breaks seen this match

;; the result
(defn g-res-result [] : I32 72) (defn g-res-reason [] : I32 73) (defn g-res-ticks [] : I32 74)
(defn g-have-result [] : I32 75)
(defn g-rec-got [] : I32 76) (defn g-rec-counted [] : I32 77) (defn g-rec-bot [] : I32 78)
(defn g-rec-rating [] : I32 79) (defn g-rec-delta [] : I32 80)
(defn g-over-t [] : I32 81)

;; packing
(defn g-stage-n [] : I32 90) (defn g-sel-item [] : I32 91) (defn g-sel-rot [] : I32 92)
(defn g-hov-row [] : I32 93) (defn g-hov-col [] : I32 94) (defn g-hov-pl [] : I32 95)
(defn g-ready [] : I32 96)          ; READY was sent
(defn g-committed [] : I32 97)      ; the placements were sent to the server
(defn g-toast-t [] : I32 99) (defn g-toast-id [] : I32 100)
