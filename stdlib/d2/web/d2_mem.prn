(defn g-preview-weapons [] : I32 121) (defn g-preview-powered [] : I32 122) (defn g-preview-loops [] : I32 123)
(defn g-preview-armor [] : I32 124) (defn g-preview-cargo [] : I32 125) (defn g-preview-cells [] : I32 126)
(defn g-rng [] : I32 127)
