;; stdlib/d2/web/d2_view.prn -- drawing a ship: cells, wires, damage, the parts bin, bars. Pure drawing; no game decisions.
;;
;; In the fight the two ships face each other bow to bow (row 0 is the bow): yours below, the opponent's above, so a lane (a column) is one vertical track that a
;; shot travels down. The opponent's ship is therefore drawn MIRRORED top to bottom (g-vflip = 1): its row 0 is at the bottom of its grid. Every drawing function
;; here takes the cell's original (row, col) and works out where it lands; art is given the mirrored ports and rotation, so arrows and barrels still point the way
;; the part really works.

(defn g-vflip [] : I32 432)
(defn vflip? [] : Bool (= (gi (g-vflip)) 1))
;; port bits, mirrored top to bottom: north and south swap
(defn vport [(p : I32)] : I32
  (if (vflip?) (bit-or (bit-and p 5) (bit-or (shr (bit-and p 8) 2) (shl (bit-and p 2) 2))) p))
(defn vrot [(r : I32)] : I32 (if (vflip?) (mod (- 4 r) 4) r))
;; a compass index (0 N, 1 E, 2 S, 3 W) as it lands on the screen
(defn vdir [(d : I32)] : I32 (if (vflip?) (cond (= d 0) 2 (= d 2) 0 :else d) d))
(defn vrow [(r : I32)] : I32 (if (vflip?) (- 5 r) r))
;; the compass index of the bow on the screen: up for you, down for the mirrored opponent
(defn bow-dir [] : I32 (if (vflip?) 2 0))

;; ---- one cell ---------------------------------------------------------------------------------------------------------------------
(defn opposite-port [(p : I32)] : I32
  (cond (!= (bit-and p 8) 0) 2 (!= (bit-and p 4) 0) 1 (!= (bit-and p 2) 0) 8 :else 4))

(defn draw-ports! [(x : I32) (y : I32) (s : I32) (port : I32) (c : I32) (a : I32)] : Unit
  (let [h (/ s 2) w (max-i 2 (/ s 12))]
    (when (!= (bit-and port 8) 0) (fill-rect-a (- (+ x h) w) y (* w 2) (+ h w) c a))
    (when (!= (bit-and port 4) 0) (fill-rect-a (- (+ x h) w) (- (+ y h) w) (+ h w) (* w 2) c a))
    (when (!= (bit-and port 2) 0) (fill-rect-a (- (+ x h) w) (- (+ y h) w) (* w 2) (+ h w) c a))
    (when (!= (bit-and port 1) 0) (fill-rect-a x (- (+ y h) w) (+ h w) (* w 2) c a))))

;; ---- direction affordances: which way energy goes in and out of a part ----------------------------------------------------------------
;; port bit -> compass index (0 N, 1 E, 2 S, 3 W)
(defn port-dir [(b : I32)] : I32 (cond (= b 8) 0 (= b 4) 1 (= b 2) 2 :else 3))
(defn dir-dx [(d : I32)] : I32 (case d 1 1 3 -1 0))
(defn dir-dy [(d : I32)] : I32 (case d 0 -1 2 1 0))

;; what one open side of a part does: 1 power comes IN here, 2 power goes OUT here, 3 it is a through wire (either way), 4 a transistor's GATE, 0 nothing.
;; A Capacitor / Battery / Delayer / Transistor is directed by its rotation: in on the west side turned `rot` times, out on the east side turned the same.
(defn port-flow [(role : I32) (port : I32) (b : I32) (rot : I32)] : I32
  (cond (= role (r-gen)) 2
        (= role (r-split)) (if (= (bit-and port (opposite-port b)) 0) 1 2)
        (or (= role (r-weapon)) (or (= role (r-mender)) (= role (r-aegis)))) 1
        (or (= role (r-cond)) (or (= role (r-amp)) (= role (r-res)))) 3
        (or (= role (r-cap)) (or (= role (r-bat)) (or (= role (r-delay)) (= role (r-trans)))))
          (cond (= b (rot-port (p-w) rot)) 1
                (= b (rot-port (p-e) rot)) 2
                (and (= role (r-trans)) (= b (rot-port (p-n) rot))) 4
                :else 0)
        :else 0))

;; a chevron whose tip is at (px, py) pointing along compass direction d
(defn chevron! [(px : I32) (py : I32) (d : I32) (k : I32) (c : I32) (a : I32)] : Unit
  (let [dx (dir-dx d) dy (dir-dy d)]
    ;; the two arms trail back from the tip and open sideways
    (line-a px py (- (- px (* dx k)) (* dy k)) (- (- py (* dy k)) (* dx k)) c a)
    (line-a px py (+ (- px (* dx k)) (* dy k)) (+ (- py (* dy k)) (* dx k)) c a)
    (line-a (+ px dy) (+ py dx) (- (- (+ px dy) (* dx k)) (* dy k)) (- (- (+ py dx) (* dy k)) (* dx k)) c (/ a 2))
    (line-a (+ px dy) (+ py dx) (+ (- (+ px dy) (* dx k)) (* dy k)) (+ (- (+ py dx) (* dy k)) (* dx k)) c (/ a 2))))

(defn c-in [] : I32 (rgb 110 196 214))      ; energy coming in
(defn c-out [] : I32 (rgb 238 196 104))     ; energy going out
(defn c-gate [] : I32 (rgb 190 150 240))    ; a transistor's gate
(defn c-shield [] : I32 (rgb 96 170 255))   ; a Brace shield
(defn c-heat [] : I32 (rgb 255 128 64))     ; heat
(defn c-cool [] : I32 (rgb 96 208 255))     ; a Cryo-Vent's cooling
(defn c-grow [] : I32 (rgb 130 220 120))    ; Xeno-Biomass
(defn c-steel [] : I32 (rgb 188 200 220))
(defn c-ore [] : I32 (rgb 160 132 255))

;; arrows on every open side of a part: teal points IN, gold points OUT, so a rotation can be read at a glance
(defn draw-port-arrows! [(x : I32) (y : I32) (s : I32) (role : I32) (port : I32) (rot : I32)] : Unit
  (when (>= s 22)
    (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) k (max-i 4 (/ s 8))]
      (dotimes [i 4]
        (let [b (shl 1 i)]
          (when (!= (bit-and port b) 0)
            (let [f (port-flow role port b rot) d (port-dir b)
                  ex (+ cx (* (dir-dx d) (- (/ s 2) 8))) ey (+ cy (* (dir-dy d) (- (/ s 2) 8)))]
              (cond
                (= f 1) (chevron! (- ex (* (dir-dx d) (+ k 2))) (- ey (* (dir-dy d) (+ k 2))) (mod (+ d 2) 4) k (c-in) 240)
                (= f 2) (chevron! (+ ex (* (dir-dx d) 1)) (+ ey (* (dir-dy d) 1)) d k (c-out) 245)
                (= f 4) (do (chevron! (- ex (* (dir-dx d) (+ k 2))) (- ey (* (dir-dy d) (+ k 2))) (mod (+ d 2) 4) k (c-gate) 245)
                            (when (>= s 40) (draw-text-c "G" (+ cx (* (dir-dx d) (- (/ s 2) 16))) (- (+ cy (* (dir-dy d) (- (/ s 2) 16))) 4) 1 (c-gate))))
                :else unit))))))))

;; ---- part art ----------------------------------------------------------------------------------------------------------------------------
;; a line `w` pixels thick (offset across its short axis)
(defn lnw [(x0 : I32) (y0 : I32) (x1 : I32) (y1 : I32) (w : I32) (c : I32) (a : I32)] : Unit
  (let [horiz (>= (abs-i (- x1 x0)) (abs-i (- y1 y0)))]
    (dotimes [k w]
      (let [o (- k (/ w 2))]
        (if horiz (line-a x0 (+ y0 o) x1 (+ y1 o) c a) (line-a (+ x0 o) y0 (+ x1 o) y1 c a))))))

;; each weapon has its own colour and shape: a railgun is two rails, a laser a lens, a cannon a bore and a barrel. All of them fire toward the BOW.
(defn weapon-color [(item : I32)] : I32 (case item 3 (rgb 140 205 255) 7 (rgb 255 92 132) (rgb 255 152 72)))

(defn art-railgun! [(x : I32) (y : I32) (s : I32) (port : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) bd (bow-dir)
        dx (dir-dx bd) dy (dir-dy bd) px (- 0 dy) py dx
        o (max-i 3 (/ s 9)) len (/ s 2) col (weapon-color 3)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 120)
    (draw-ports! x y s port (c-ink) 200)
    ;; two rails running out to the muzzle, with coils across them
    (lnw (+ cx (* px o)) (+ cy (* py o)) (+ (+ cx (* dx (- len 2))) (* px o)) (+ (+ cy (* dy (- len 2))) (* py o)) 2 col 255)
    (lnw (- cx (* px o)) (- cy (* py o)) (+ (- cx (* px o)) (* dx (- len 2))) (+ (- cy (* py o)) (* dy (- len 2))) 2 col 255)
    (dotimes [k 2]
      (let [t (* (+ k 1) (/ s 6))]
        (line-a (+ (+ cx (* dx t)) (* px (+ o 3))) (+ (+ cy (* dy t)) (* py (+ o 3)))
                (- (+ cx (* dx t)) (* px (+ o 3))) (- (+ cy (* dy t)) (* py (+ o 3))) col 190)))
    (disc (f32 (+ cx (* dx (- len 3)))) (f32 (+ cy (* dy (- len 3)))) (/ (f32 s) 13.0) (c-ink) 255)
    (disc (f32 cx) (f32 cy) (* (f32 s) 0.15) (c-bg) 255)
    (ring (f32 cx) (f32 cy) (* (f32 s) 0.15) 2.0 col 255)))

(defn art-laser! [(x : I32) (y : I32) (s : I32) (port : I32) (kc : I32) (pulse : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) bd (bow-dir)
        dx (dir-dx bd) dy (dir-dy bd)
        r (max-i 5 (i32 (* (f32 s) 0.27))) col (weapon-color 7)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 110)
    (draw-ports! x y s port (c-ink) 200)
    ;; a thin red beam stub out of the lens and a diamond lens
    (lnw cx cy (+ cx (* dx (- (/ s 2) 2))) (+ cy (* dy (- (/ s 2) 2))) 2 col 210)
    (line-a cx (- cy r) (+ cx r) cy col 255) (line-a (+ cx r) cy cx (+ cy r) col 255)
    (line-a cx (+ cy r) (- cx r) cy col 255) (line-a (- cx r) cy cx (- cy r) col 255)
    (disc (f32 cx) (f32 cy) (* (f32 r) 0.5) col (+ 190 (/ pulse 3)))
    (disc (f32 cx) (f32 cy) (* (f32 r) 0.22) (c-ink) 255)))

(defn art-cannon-breech! [(x : I32) (y : I32) (s : I32) (port : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) col (weapon-color 8)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 130)
    (draw-ports! x y s port (c-ink) 200)
    (disc (f32 cx) (f32 cy) (* (f32 s) 0.33) (c-bg) 255)
    (ring (f32 cx) (f32 cy) (* (f32 s) 0.33) 4.0 col 255)
    (disc (f32 cx) (f32 cy) (* (f32 s) 0.14) col 255)))

;; the second cell of a Siege Cannon: the barrel, running from the breech to a flared muzzle
(defn art-cannon-barrel! [(x : I32) (y : I32) (s : I32) (rot : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) col (weapon-color 8) th (max-i 6 (i32 (* (f32 s) 0.42)))
        ed (port-dir (rot-port (p-e) rot)) dx (dir-dx ed) dy (dir-dy ed)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 80)
    (if (!= dx 0)
        (do (fill-rect-a x (- cy (/ th 2)) s th (c-steel) 220)
            (fill-rect-a x (- cy (/ th 2)) s 2 col 255) (fill-rect-a x (+ (- cy (/ th 2)) (- th 2)) s 2 col 255)
            (fill-rect-a (if (> dx 0) (- (+ x s) 7) x) (- cy (+ (/ th 2) 3)) 7 (+ th 6) col 255))
        (do (fill-rect-a (- cx (/ th 2)) y th s (c-steel) 220)
            (fill-rect-a (- cx (/ th 2)) y 2 s col 255) (fill-rect-a (+ (- cx (/ th 2)) (- th 2)) y 2 s col 255)
            (fill-rect-a (- cx (+ (/ th 2) 3)) (if (> dy 0) (- (+ y s) 7) y) (+ th 6) 7 col 255)))))

;; a Titanium Beam / Shard: a steel bar along its axis, with chevrons that say "boosts the guns beside it"
(defn art-beam! [(x : I32) (y : I32) (s : I32) (rot : I32) (item : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) th (max-i 6 (i32 (* (f32 s) 0.46))) horiz (= (mod rot 2) 0)
        a (if (= item 22) 215 235)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 60)
    (if horiz
        (do (fill-rect-a x (- cy (/ th 2)) s th (c-steel) a)
            (fill-rect-a x (- cy (/ th 2)) s 2 (c-ink) a) (fill-rect-a x (+ (- cy (/ th 2)) (- th 2)) s 2 (c-faint) a)
            (when (>= s 24) (dotimes [k 2] (chevron! (+ x (+ 12 (* k (/ s 3)))) cy 1 (max-i 3 (/ s 10)) (c-gold) (/ a 2)))))
        (do (fill-rect-a (- cx (/ th 2)) y th s (c-steel) a)
            (fill-rect-a (- cx (/ th 2)) y 2 s (c-ink) a) (fill-rect-a (+ (- cx (/ th 2)) (- th 2)) y 2 s (c-faint) a)
            (when (>= s 24) (dotimes [k 2] (chevron! cx (+ y (+ 12 (* k (/ s 3)))) 2 (max-i 3 (/ s 10)) (c-gold) (/ a 2))))))))

;; Aether Ore / an Ore Chip: a crystal that scatters beams
(defn art-ore! [(x : I32) (y : I32) (s : I32) (item : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) r (i32 (* (f32 s) (if (= item 23) 0.3 0.4)))]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 60)
    (line-a cx (- cy r) (+ cx r) cy (c-ore) 255) (line-a (+ cx r) cy cx (+ cy r) (c-ore) 255)
    (line-a cx (+ cy r) (- cx r) cy (c-ore) 255) (line-a (- cx r) cy cx (- cy r) (c-ore) 255)
    (line-a cx (- cy r) cx (+ cy r) (c-ore) 120) (line-a (- cx r) cy (+ cx r) cy (c-ore) 120)
    (disc (f32 cx) (f32 cy) (* (f32 r) 0.3) (c-ore) 255)))

(defn art-plate! [(x : I32) (y : I32) (s : I32) (kc : I32)] : Unit
  (let [m 4 k (max-i 2 (/ s 16))]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 150)
    (fill-rect-a (+ x m) (+ y m) (- s (* m 2)) (- s (* m 2)) (c-kind-def) 130)
    (rect-outline-a (+ x m) (+ y m) (- s (* m 2)) (- s (* m 2)) (c-ink) 190)
    (line-a (+ x (+ m 2)) (- (+ y s) (+ m 3)) (- (+ x s) (+ m 3)) (+ y (+ m 2)) (c-ink) 70)
    (disc (f32 (+ x (+ m 4))) (f32 (+ y (+ m 4))) (f32 k) (c-ink) 200) (disc (f32 (- (+ x s) (+ m 4))) (f32 (+ y (+ m 4))) (f32 k) (c-ink) 200)
    (disc (f32 (+ x (+ m 4))) (f32 (- (+ y s) (+ m 4))) (f32 k) (c-ink) 200) (disc (f32 (- (+ x s) (+ m 4))) (f32 (- (+ y s) (+ m 4))) (f32 k) (c-ink) 200)))

(defn art-resistor! [(x : I32) (y : I32) (s : I32) (item : I32) (port : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) horiz (!= (bit-and port 5) 0) amp (max-i 3 (/ s 7))
        col (mix (c-ink) (c-rose) (* (- item 11) 70))]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 46)
    (dotimes [k 6]
      (let [t0 (+ 3 (/ (* k (- s 6)) 6)) t1 (+ 3 (/ (* (+ k 1) (- s 6)) 6))
            o0 (if (or (= k 0) (= k 5)) 0 (if (= (mod k 2) 1) amp (- 0 amp)))
            o1 (if (or (= (+ k 1) 6) (= (+ k 1) 0)) 0 (if (= (mod (+ k 1) 2) 1) amp (- 0 amp)))]
        (if horiz
            (lnw (+ x t0) (+ cy o0) (+ x t1) (+ cy o1) 2 col 255)
            (lnw (+ cx o0) (+ y t0) (+ cx o1) (+ y t1) 2 col 255))))
    (when (>= s 30)
      (draw-text-c (case item 12 "1R" 13 "2R" "4R") cx (+ cy (if horiz (+ amp 3) 3)) 1 col))))

(defn art-capacitor! [(x : I32) (y : I32) (s : I32) (rot : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) horiz (= (mod rot 2) 0) g (max-i 3 (/ s 10)) h (/ s 3)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 80)
    (if horiz
        (do (line-a x cy (- cx g) cy (c-ink) 230) (line-a (+ cx g) cy (+ x s) cy (c-ink) 230)
            (fill-rect (- cx (+ g 2)) (- cy h) 3 (* h 2) (c-gold)) (fill-rect (+ cx g) (- cy h) 3 (* h 2) (c-gold)))
        (do (line-a cx y cx (- cy g) (c-ink) 230) (line-a cx (+ cy g) cx (+ y s) (c-ink) 230)
            (fill-rect (- cx h) (- cy (+ g 2)) (* h 2) 3 (c-gold)) (fill-rect (- cx h) (+ cy g) (* h 2) 3 (c-gold))))))

(defn art-battery! [(x : I32) (y : I32) (s : I32) (rot : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) horiz (= (mod rot 2) 0) w (i32 (* (f32 s) 0.62)) h (i32 (* (f32 s) 0.44))
        ed (port-dir (rot-port (p-e) rot)) dx (dir-dx ed) dy (dir-dy ed)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 80)
    (if horiz
        (do (rect-outline-a (- cx (/ w 2)) (- cy (/ h 2)) w h (c-ink) 230)
            (fill-rect (if (> dx 0) (+ (- cx (/ w 2)) w) (- (- cx (/ w 2)) 3)) (- cy (/ h 4)) 3 (/ h 2) (c-ink)))
        (do (rect-outline-a (- cx (/ h 2)) (- cy (/ w 2)) h w (c-ink) 230)
            (fill-rect (- cx (/ h 4)) (if (> dy 0) (+ (- cy (/ w 2)) w) (- (- cy (/ w 2)) 3)) (/ h 2) 3 (c-ink))))))

(defn art-transistor! [(x : I32) (y : I32) (s : I32) (rot : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) r (max-i 5 (i32 (* (f32 s) 0.2)))
        ind (port-dir (rot-port (p-w) rot)) od (port-dir (rot-port (p-e) rot)) gd (port-dir (rot-port (p-n) rot))]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 80)
    (lnw cx cy (+ cx (* (dir-dx ind) (/ s 2))) (+ cy (* (dir-dy ind) (/ s 2))) 2 (c-ink) 230)
    (lnw cx cy (+ cx (* (dir-dx od) (/ s 2))) (+ cy (* (dir-dy od) (/ s 2))) 2 (c-ink) 230)
    (lnw cx cy (+ cx (* (dir-dx gd) (/ s 2))) (+ cy (* (dir-dy gd) (/ s 2))) 2 (c-gate) 240)
    (disc (f32 cx) (f32 cy) (f32 r) (c-bg) 255)
    (ring (f32 cx) (f32 cy) (f32 r) 2.0 (c-ink) 255)))

(defn art-delayer! [(x : I32) (y : I32) (s : I32) (port : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2)) r (max-i 6 (i32 (* (f32 s) 0.3)))]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 80)
    (draw-ports! x y s port (c-ink) 200)
    (disc (f32 cx) (f32 cy) (f32 r) (c-bg) 255)
    (ring (f32 cx) (f32 cy) (f32 r) 2.0 (c-ink) 255)
    (line-a cx cy cx (- cy (- r 2)) (c-gold) 255) (line-a cx cy (+ cx (- r 3)) cy (c-gold) 255)
    (when (>= s 30) (draw-text-c "2" cx (+ cy (+ r 2)) 1 (c-gold)))))

;; one cell of a Quantum Core: a reactor window with a hot orb. The four together read as one glowing block.
(defn art-core-cell! [(x : I32) (y : I32) (s : I32) (port : I32) (kc : I32) (pulse : I32)] : Unit
  (let [(cx : F32) (+ (f32 x) (/ (f32 s) 2.0)) (cy : F32) (+ (f32 y) (/ (f32 s) 2.0)) (fs : F32) (f32 s)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 150)
    (draw-ports! x y s port (c-ink) 210)
    (disc cx cy (* fs 0.34) (c-heat) (+ 70 (/ pulse 2)))
    (disc cx cy (* fs 0.24) (rgb 255 214 140) 235)
    (disc cx cy (* fs 0.12) (rgb 255 255 235) 255)
    (ring cx cy (* fs 0.36) 2.0 (c-heat) (+ 110 pulse))))

;; a Cryo-Vent cell: frost-blue fins
(defn art-vent! [(x : I32) (y : I32) (s : I32) (kc : I32)] : Unit
  (let [cx (+ x (/ s 2)) cy (+ y (/ s 2))]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 60)
    (fill-rect-a (+ x 4) (+ y 4) (- s 8) (- s 8) (c-cool) 90)
    (dotimes [k 4]
      (let [o (+ 7 (* k (/ (- s 14) 3)))]
        (fill-rect-a (+ x 6) (+ y o) (- s 12) 2 (c-ink) 200)))
    (line-a cx (+ y 6) cx (- (+ y s) 7) (c-cool) 255)
    (rect-outline-a (+ x 4) (+ y 4) (- s 8) (- s 8) (c-cool) 230)))

;; a Xeno-Biomass cell: living blobs
(defn art-biomass! [(x : I32) (y : I32) (s : I32) (kc : I32) (pulse : I32)] : Unit
  (let [(cx : F32) (+ (f32 x) (/ (f32 s) 2.0)) (cy : F32) (+ (f32 y) (/ (f32 s) 2.0)) (fs : F32) (f32 s)]
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 60)
    (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) (c-grow) 55)
    (disc (- cx (* fs 0.14)) (+ cy (* fs 0.08)) (* fs 0.2) (c-grow) 210)
    (disc (+ cx (* fs 0.16)) (- cy (* fs 0.12)) (* fs 0.17) (c-grow) 200)
    (disc (+ cx (* fs 0.04)) (+ cy (* fs 0.2)) (* fs 0.12) (c-grow) 190)
    (disc (- cx (* fs 0.1)) (- cy (* fs 0.16)) (+ (* fs 0.07) (/ (f32 pulse) 900.0)) (rgb 220 255 200) 230)
    (line-a (i32 (- cx (* fs 0.14))) (i32 (+ cy (* fs 0.08))) (i32 (+ cx (* fs 0.16))) (i32 (- cy (* fs 0.12))) (rgb 40 90 40) 160)))

;; role art on a cell of side s at (x, y). item says which part, kind colours it (0 offense, 1 operations, 2 defense), rot is the placement's rotation
;; (already mirrored if the ship is drawn flipped), port the cell's (likewise).
(defn draw-role! [(x : I32) (y : I32) (s : I32) (item : I32) (role : I32) (port : I32) (kind : I32) (pulse : I32) (rot : I32)] : Unit
  (let [kc (c-kind kind)
        (cx : F32) (+ (f32 x) (/ (f32 s) 2.0))
        (cy : F32) (+ (f32 y) (/ (f32 s) 2.0))
        (fs : F32) (f32 s)]
    (cond
      (= role (r-none))
        (cond (or (= item 5) (= item 22)) (art-beam! x y s rot item kc)
              (or (= item 6) (= item 23)) (art-ore! x y s item kc)
              (= item 8) (art-cannon-barrel! x y s rot kc)
              :else (do (fill-rect-a (+ x 3) (+ y 3) (- s 6) (- s 6) kc 120)
                        (fill-rect-a (+ x 6) (+ y 6) (- s 12) 2 (c-ink) 50)))
      (= role (r-gen))
        (if (= item 19)
            (art-core-cell! x y s port kc pulse)
            (do (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 120)
                (draw-ports! x y s port (c-ink) 210)
                (disc cx cy (* fs 0.24) (c-ink) 235)
                (ring cx cy (* fs 0.31) 2.0 (c-ink) (+ 90 pulse))
                (when (>= s 30) (draw-text-c "10W" (i32 cx) (- (i32 cy) 4) 1 (c-bg)))))
      (= role (r-cond))
        (do (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 46)
            (draw-ports! x y s port (c-ink) (+ 150 (/ pulse 2)))
            (disc cx cy (* fs 0.1) (c-ink) 220))
      (= role (r-split))
        (do (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 70)
            (draw-ports! x y s port (c-ink) (+ 150 (/ pulse 2)))
            (disc cx cy (* fs 0.18) (c-ink) 235)
            (disc cx cy (* fs 0.08) (c-bg) 255)
            (when (>= s 40) (draw-text-c "/2" (i32 cx) (+ (i32 cy) 8) 1 (c-dim))))
      (= role (r-amp))
        (do (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 96)
            (draw-ports! x y s port (c-ink) (+ 170 (/ pulse 2)))
            (disc cx cy (* fs 0.27) (c-bg) 255)
            (ring cx cy (* fs 0.27) 2.0 (c-gold) 240)
            (when (>= s 24) (draw-text-c "x1.5" (i32 cx) (- (i32 cy) 4) 1 (c-gold))))
      (= role (r-mender))
        (do (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 100)
            (draw-ports! x y s port (c-ink) 200)
            (let [(h : F32) (* fs 0.22) (t : F32) (fmax2 2.0 (* fs 0.07))]
              (fill-rect (i32 (- cx t)) (i32 (- cy h)) (i32 (* t 2.0)) (i32 (* h 2.0)) (c-good))
              (fill-rect (i32 (- cx h)) (i32 (- cy t)) (i32 (* h 2.0)) (i32 (* t 2.0)) (c-good))))
      (= role (r-aegis))
        (do (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) kc 120)
            (draw-ports! x y s port (c-ink) 200)
            (ring cx cy (* fs 0.3) 3.0 (c-kind-def) 255)
            (ring cx cy (* fs 0.17) 2.0 (c-ink) 200)
            (disc cx cy (* fs 0.07) (c-ink) 230))
      (= role (r-weapon))
        (cond (= item 7) (art-laser! x y s port kc pulse)
              (= item 8) (art-cannon-breech! x y s port kc)
              :else (art-railgun! x y s port kc))
      (= role (r-armor)) (art-plate! x y s kc)
      (= role (r-res))
        (art-resistor! x y s item port kc)
      (= role (r-cap)) (do (art-capacitor! x y s rot kc) (draw-ports! x y s port (c-ink) 120))
      (= role (r-bat)) (do (art-battery! x y s rot kc) (draw-ports! x y s port (c-ink) 120))
      (= role (r-trans)) (do (art-transistor! x y s rot kc))
      (= role (r-delay)) (art-delayer! x y s port kc)
      (= role (r-cool)) (art-vent! x y s kc)
      (= role (r-bio)) (art-biomass! x y s kc pulse)
      :else (fill-rect-a (+ x 3) (+ y 3) (- s 6) (- s 6) kc 90))
    (draw-port-arrows! x y s role port rot)))

;; ---- energy pulses: the circuit working ------------------------------------------------------------------------------------------------
;; g-pulse is the ms since energy last left the generators (a fight: since the last tick; packing: a free-running loop), -1 when nothing flows.
;; A packet crosses one cell per hop; a cell d wires from its source sees it d hops late, so the whole circuit visibly fills from the source.
(defn pulse-hop [] : I32 (if (= (gi (g-screen)) 3) 70 95))

(defn edge-x [(x : I32) (s : I32) (b : I32)] : F32 (case b 4 (f32 (+ x s)) 1 (f32 x) (+ (f32 x) (/ (f32 s) 2.0))))
(defn edge-y [(y : I32) (s : I32) (b : I32)] : F32 (case b 2 (f32 (+ y s)) 8 (f32 y) (+ (f32 y) (/ (f32 s) 2.0))))

(defn gain-color [(lvl : I32)] : I32 (case lvl 0 (rgb 255 234 160) 1 (rgb 255 168 72) (rgb 255 96 80)))

(defn packet-dot! [(px : F32) (py : F32) (rr : F32) (c : I32) (a : I32)] : Unit
  (do (disc px py (* rr 2.4) c (/ a 6)) (disc px py rr c a)))

;; one packet at progress u (0..0.5 from the side it came in by to the middle, 0.5..1 from the middle out of every open output)
(defn draw-pt! [(x : I32) (y : I32) (s : I32) (inb : I32) (outs : I32) (u : F32) (c : I32) (a : I32) (rr : F32)] : Unit
  (let [(cx : F32) (+ (f32 x) (/ (f32 s) 2.0)) (cy : F32) (+ (f32 y) (/ (f32 s) 2.0))]
    (if (< u 0.5)
        (when (!= inb 0)
          (let [(t : F32) (* u 2.0)]
            (packet-dot! (lerp (edge-x x s inb) cx t) (lerp (edge-y y s inb) cy t) rr c a)))
        (let [(t : F32) (* (- u 0.5) 2.0)]
          (dotimes [i 4]
            (let [b (shl 1 i)]
              (when (!= (bit-and outs b) 0)
                (packet-dot! (lerp cx (edge-x x s b) t) (lerp cy (edge-y y s b) t) rr c a))))))))

(defn flow-thru? [(role : I32)] : Bool
  (or (= role (r-cond)) (or (= role (r-split)) (or (= role (r-amp)) (or (= role (r-res)) (= role (r-trans)))))))

(defn draw-cell-flow! [(r : I32) (c : I32) (x : I32) (y : I32) (s : I32)] : Unit
  (let [pulse (gi (g-pulse)) cell (+ (* r 6) c)
        (em : F32) (cell-em r c)
        role (cell-role r c)]
    (when (and (>= pulse 0) (or (= (cell-power r c) 1) (> em 0.0)))
      (let [hop (pulse-hop) d (cell-depth r c) lvl (cell-gain r c)
            col (gain-color lvl) port (cell-port r c)
            src (or (= role (r-gen)) (> em 0.0))
            inb (if src 0 (cell-in-port r c))
            open-gate (and (= role (r-trans)) (= (cell-gate-open r c) 1))
            outs (cond (= role (r-gen)) port
                       (> em 0.0) (out-port-of cell)
                       (= role (r-trans)) (if (and open-gate (= inb (in-port-of cell))) (bit-and port (bit-xor (bit-or inb (gate-port-of cell)) 15)) 0)
                       (flow-thru? role) (bit-and port (bit-xor inb 15))
                       :else 0)
            (t : F32) (- (f32 pulse) (f32 (* d hop)))
            (u : F32) (if src (+ 0.5 (/ t (* 2.0 (f32 hop)))) (/ t (f32 hop)))
            (pw : F32) (if src em (cell-pin r c))
            (rr : F32) (* (fmax2 2.5 (/ (f32 s) 11.0)) (clamp-f (+ 0.7 (/ pw 28.0)) 0.7 2.2))
            vin (vport inb) vouts (vport outs)]
        (when (and (>= u 0.0) (< u 1.7))
          (do
            (when (< u 1.0)
              (dotimes [k 3]
                (let [(uu : F32) (- u (* 0.13 (f32 k)))]
                  (when (and (>= uu 0.0) (or (not src) (>= uu 0.5)))
                    (draw-pt! x y s vin vouts uu col (- 255 (* k 85)) (- rr (* 0.4 (f32 k))))))))
            ;; a part that takes the power answers when it lands: weapons spark, a Mender raises a cross, an Aegis Emitter rings, a store fills
            (when (and (= outs 0) (not src) (>= u 0.5))
              (let [(q : F32) (clamp-f (/ (- u 0.5) 1.2) 0.0 1.0)
                    (cx : F32) (+ (f32 x) (/ (f32 s) 2.0)) (cy : F32) (+ (f32 y) (/ (f32 s) 2.0))
                    al (i32 (* 220.0 (- 1.0 q)))
                    (rad : F32) (* (f32 s) (+ 0.14 (* 0.3 q)))]
                (cond
                  (= role (r-mender))
                    (do (line-a (i32 cx) (i32 (- cy rad)) (i32 cx) (i32 (+ cy rad)) (c-good) al)
                        (line-a (i32 (- cx rad)) (i32 cy) (i32 (+ cx rad)) (i32 cy) (c-good) al))
                  (= role (r-aegis)) (ring cx cy rad 2.0 (c-kind-def) al)
                  (= role (r-weapon)) (ring cx cy rad 2.0 (weapon-color (st-item (- (cell-owner r c) 1))) al)
                  (or (= role (r-cap)) (or (= role (r-bat)) (= role (r-delay)))) (ring cx cy (* rad 0.8) 2.0 (c-gold) al)
                  (= role (r-trans)) (ring cx cy (* rad 0.8) 2.0 (c-gate) al)
                  :else unit)))))))))

;; ---- position is rules: what touches what ---------------------------------------------------------------------------------------------------
;; does placement p own a cell next to `cell`?
(defn pl-touches-cell? [(p : I32) (cell : I32)] : Bool
  (let [(f : Bool) false]
    (dotimes [d 4]
      (let [nb (nb-cell cell d)]
        (when (and (>= nb 0) (= (cell-owner (/ nb 6) (mod nb 6)) (+ p 1))) (set! f true))))
    f))

;; the kind of tie between the cell and placement p, for lighting up partners when the pointer rests on a part:
;;   1 a Titanium part boosts a gun (either direction)   2 Aether boosts an Aegis   3 Biomass heals a neighbour   4 a Core heats a neighbour (cooled or not)
;;   5 a Vent cools a neighbour of a Core
(defn tie-kind [(cell : I32) (p : I32)] : I32
  (let [o (cell-owner (/ cell 6) (mod cell 6))]
    (if (or (= o 0) (= o (+ p 1))) 0
        (if (not (pl-touches-cell? p cell)) 0
            (let [it (st-item p) oi (st-item (- o 1))
                  fi (item-family it) fo (item-family oi)]
              (cond (and (= fi 1) (> (weapon-kind oi) 0)) 1
                    (and (= fo 1) (> (weapon-kind it) 0)) 1
                    (and (= fi 2) (= oi 11)) 2
                    (and (= fo 2) (= it 11)) 2
                    (= it 21) 3
                    (= oi 21) 3
                    (> (item-heat it) 0) 4
                    (> (item-heat oi) 0) 4
                    (= it 20) (if (cell-core-adjacent? cell) 5 0)
                    (= oi 20) 5
                    :else 0))))))

(defn tie-color [(k : I32)] : I32 (case k 1 (c-gold) 2 (c-ore) 3 (c-grow) 4 (c-heat) (c-cool)))

;; does the Titanium / Aether placement p tie to anything right now?
(defn booster-active? [(p : I32)] : Bool
  (loop [i 0] (if (>= i 36) false (if (> (tie-kind i p) 0) true (recur (+ i 1))))))

;; 1 = a gun boosted by a Titanium part, 2 = an Aegis Emitter boosted by Aether, 0 none
(defn boost-kind [(r : I32) (c : I32)] : I32
  (let [role (cell-role r c) cell (+ (* r 6) c) o (cell-owner r c)]
    (cond (= o 0) 0
          (and (= role (r-weapon)) (> (weapon-boost-pct (- o 1)) 100)) 1
          (and (= role (r-aegis)) (> (aegis-boost-pct cell) 100)) 2
          :else 0)))

;; a weld across each shared edge between a boosted part and the part that boosts it, and a badge on the part
(defn draw-weld! [(r : I32) (c : I32) (x : I32) (y : I32) (s : I32) (family : I32) (col : I32) (a : I32)] : Unit
  (let [cell (+ (* r 6) c) o (cell-owner r c)]
    (dotimes [d 4]
      (let [nb (nb-cell cell d)]
        (when (>= nb 0)
          (let [o2 (cell-owner (/ nb 6) (mod nb 6))]
            (when (and (!= o2 0) (and (!= o2 o) (and (alive-i? nb) (= (item-family (st-item (- o2 1))) family))))
              (let [sd (vdir d)]
                (cond (= sd 0) (fill-rect-a (+ x 4) (- y 2) (- s 8) 5 col a)
                      (= sd 1) (fill-rect-a (- (+ x s) 3) (+ y 4) 5 (- s 8) col a)
                      (= sd 2) (fill-rect-a (+ x 4) (- (+ y s) 3) (- s 8) 5 col a)
                      :else (fill-rect-a (- x 2) (+ y 4) 5 (- s 8) col a))))))))))

(defn draw-badge! [(x : I32) (y : I32) (s : I32) (txt : String) (col : I32)] : Unit
  (let [w (+ 8 (text-width txt 1))]
    (card (- (+ x s) (+ w 2)) (+ y 2) w 13 (c-bg) 235 col 255)
    (draw-text txt (- (+ x s) (- w 2)) (+ y 4) 1 col)))

;; ---- a cell, its damage, and what the fight is doing to it -------------------------------------------------------------------------------
;; destroyed AND the shot that did it has landed (a destroyed part stays whole on screen until its killing blow arrives)
(defn cell-wrecked? [(r : I32) (c : I32)] : Bool
  (and (!= (cell-dead r c) 0) (>= (gi (g-ticker)) (load32 (dead-t-addr (+ (* r 6) c))))))

(defn hp-color [(frac : F32)] : I32
  (if (> frac 0.6) (c-good) (if (> frac 0.3) (c-gold) (c-rose))))

;; the glide of every drawn HP toward its truth, once the shot that changes it has landed
(defn hp-glide! [] : Unit
  (let [now (gi (g-ticker))]
    (dotimes [cell 36]
      (when (>= now (load32 (chg-t-addr cell)))
        (let [(t : F32) (loadf32 (hp-addr cell)) (d : F32) (loadf32 (hpd-addr cell))]
          (storef32! (hpd-addr cell) (if (< (fabs (- t d)) 0.4) t (+ d (* (- t d) 0.2)))))))))

;; cracks across a hurt part: more of them the less HP it has
(defn draw-cracks! [(x : I32) (y : I32) (s : I32) (frac : F32)] : Unit
  (when (< frac 0.7)
    (do (line-a (+ x (/ s 5)) (+ y 2) (+ x (/ s 3)) (+ y (/ s 2)) (c-shadow) 210)
        (line-a (+ x (/ s 3)) (+ y (/ s 2)) (+ x (/ s 6)) (- (+ y s) 3) (c-shadow) 210)
        (when (< frac 0.45)
          (do (line-a (- (+ x s) (/ s 4)) (+ y 3) (- (+ x s) (/ s 3)) (+ y (/ s 2)) (c-shadow) 210)
              (line-a (- (+ x s) (/ s 3)) (+ y (/ s 2)) (- (+ x s) 3) (+ y (+ (/ s 2) (/ s 6))) (c-shadow) 210)))
        (when (< frac 0.25)
          (do (line-a (+ x 2) (+ y (/ s 2)) (- (+ x s) 3) (+ y (- (/ s 2) 4)) (c-shadow) 230)
              (fill-rect-a (+ x 2) (+ y 2) (- s 4) (- s 4) (c-rose) 40))))))

;; the cell at original grid (r, c) drawn at (x, y), side s: art, piece outline, the circuit's glow and packets, damage
(defn draw-grid-cell! [(r : I32) (c : I32) (x : I32) (y : I32) (s : I32) (live : Bool)] : Unit
  (let [o (cell-owner r c)
        cell (+ (* r 6) c)
        now (gi (g-ticker))
        (t : F32) (f32 now)
        ph (i32 (* 60.0 (sinf (- (* t 0.008) (f32 (* (+ r c) 2))))))
        since (if (= (gi (g-screen)) 3) (- now (gi (g-tick-t))) 100000)]
    (fill-rect x y s s (if (= (mod (+ r c) 2) 0) (c-ground) (c-ground2)))
    (when (!= o 0)
      (let [item (st-item (- o 1))
            kind (item-kind item)
            rot (vrot (st-rot (- o 1)))
            role (cell-role r c) port (vport (cell-port r c))
            pw (cell-power r c)
            wrecked (cell-wrecked? r c)
            consumer (or (= role (r-weapon)) (or (= role (r-mender)) (= role (r-aegis))))
            (hpm : F32) (cell-hpmax r c)
            (frac : F32) (if (> hpm 0.0) (clamp-f (/ (cell-hpd r c) hpm) 0.0 1.0) 1.0)]
        (draw-role! x y s item role port kind (if (= pw 1) (+ 100 (/ ph 3)) 0) rot)
        (when wrecked
          (do (fill-rect-a x y s s (c-shadow) 215)
              (dotimes [k (/ s 6)] (line-a (+ x 3) (+ y (* k 6) 8) (+ x (+ (* k 6) 8) 0) (+ y 3) (c-faint) 70))
              (line-a (+ x 5) (+ y 5) (- (+ x s) 6) (- (+ y s) 6) (c-rose) 230)
              (line-a (- (+ x s) 6) (+ y 5) (+ x 5) (- (+ y s) 6) (c-rose) 230)))
        ;; the piece's outline: a line wherever the neighbour is a different piece
        (let [w 2]
          (dotimes [d 4]
            (let [nb (nb-cell cell d)]
              (when (or (< nb 0) (!= (cell-owner (/ nb 6) (mod nb 6)) o))
                (let [sd (vdir d)]
                  (cond (= sd 0) (fill-rect-a x y s w (c-ink) 120)
                        (= sd 2) (fill-rect-a x (- (+ y s) w) s w (c-ink) 120)
                        (= sd 3) (fill-rect-a x y w s (c-ink) 120)
                        :else (fill-rect-a (- (+ x s) w) y w s (c-ink) 120)))))))
        (when (and (= pw 1) (not wrecked)) (fill-rect-a x y s s (c-gold) 22))
        (when (and (= pw 2) (not wrecked)) (fill-rect-a x y s s (c-rose) (+ 70 (abs-i ph))))
        ;; a part that needs power and gets none says so
        (when (and consumer (not wrecked) (and (= pw 0) (and (= (cell-fed-any r c) 0) (or (= (gi (g-screen)) 2) (>= (gi (g-tick)) 8)))))
          (do (rect-outline-a (+ x 1) (+ y 1) (- s 2) (- s 2) (c-rose) (+ 120 (abs-i ph)))
              (rect-outline-a (+ x 2) (+ y 2) (- s 4) (- s 4) (c-rose) (/ (+ 120 (abs-i ph)) 2))
              (when (>= s 30) (draw-text-c "UNFED" (+ x (/ s 2)) (+ y (- s 14)) 1 (c-rose)))))
        (when (not wrecked) (draw-cell-flow! r c x y s))
        ;; a laser that holds fire for want of a clear lane, or a weapon with a broken piece, says so
        (when (and (= role (r-weapon)) (not wrecked))
          (let [bl (weapon-block (- o 1))]
            (when (> bl 0)
              (do (fill-rect-a x y s s (c-shadow) 120)
                  (rect-outline-a (+ x 2) (+ y 2) (- s 4) (- s 4) (c-gold) (+ 150 (abs-i ph)))
                  (when (>= s 30) (draw-text-c (if (= bl 1) "BLOCKED" "BROKEN") (+ x (/ s 2)) (+ y (- (/ s 2) 4)) 1 (c-gold)))))))
        ;; a weapon that fired this second flashes in its own colour
        (when (and live (and (= role (r-weapon)) (> (load8 (sim-fired-addr (- o 1))) 0) (< since 380)))
          (fill-rect-a x y s s (weapon-color item) (- 150 (/ (* since 150) 380))))
        (when (and live (and (= role (r-weapon)) (not wrecked)))
          (let [(ch : F32) (loadf32 (sim-charge-addr (- o 1)))
                (thr : F32) (fmax2 1.0 (weapon-thr item))]
            (fill-rect-a (+ x 4) (- (+ y s) 7) (- s 8) 3 (c-shadow) 200)
            (fill-rect (+ x 4) (- (+ y s) 7) (i32 (* (f32 (- s 8)) (clamp-f (/ ch thr) 0.0 1.0))) 3 (weapon-color item))))
        ;; what a store of power holds: a Battery its charge, a Capacitor how near it is to dumping, a Delayer the two ticks in flight, a Transistor its gate
        (when (not wrecked)
          (do
            (when (= role (r-bat))
              (do (fill-rect-a (+ x 4) (- (+ y s) 7) (- s 8) 3 (c-shadow) 200)
                  (fill-rect (+ x 4) (- (+ y s) 7) (i32 (* (f32 (- s 8)) (clamp-f (/ (cell-q r c) 90.0) 0.0 1.0))) 3 (c-good))))
            (when (= role (r-cap))
              (do (fill-rect-a (+ x 4) (- (+ y s) 7) (- s 8) 3 (c-shadow) 200)
                  (fill-rect (+ x 4) (- (+ y s) 7) (i32 (* (f32 (- s 8)) (clamp-f (/ (cell-q r c) 30.0) 0.0 1.0))) 3 (c-gold))))
            (when (= role (r-delay))
              (do (disc (f32 (+ x (- (/ s 2) 6))) (f32 (- (+ y s) 7)) 3.0 (if (> (cell-q2 r c) 0.0) (c-gold) (c-line)) 255)
                  (disc (f32 (+ x (+ (/ s 2) 6))) (f32 (- (+ y s) 7)) 3.0 (if (> (cell-q r c) 0.0) (c-gold) (c-line)) 255)))
            (when (= role (r-trans))
              (let [gd (vdir (port-dir (rot-port (p-n) (st-rot (- o 1)))))]
                (disc (f32 (+ (+ x (/ s 2)) (* (dir-dx gd) (- (/ s 2) 8)))) (f32 (+ (+ y (/ s 2)) (* (dir-dy gd) (- (/ s 2) 8))))
                      4.0 (if (= (cell-gate-open r c) 1) (c-good) (c-line)) 255)))))
        ;; a store that let go this second
        (when (and live (and (not wrecked) (and (= (cell-ev r c) 1) (< since 500))))
          (do (fill-rect-a x y s s (c-gold) (- 150 (/ (* since 150) 500)))
              (ring (+ (f32 x) (/ (f32 s) 2.0)) (+ (f32 y) (/ (f32 s) 2.0)) (+ 4.0 (/ (f32 since) 14.0)) 3.0 (c-gold) (- 255 (/ (* since 255) 500)))))
        ;; heat: a part a Quantum Core is cooking glows and shimmers; one a Cryo-Vent saves wears a frost corner
        (when (not wrecked)
          (let [hh (cell-heat-at cell)]
            (cond
              (> hh 0)
                (do (fill-rect-a x y s s (c-heat) (+ 36 (/ (abs-i ph) 3)))
                    (dotimes [k 3]
                      (let [fx (+ x (+ 6 (* k (/ (- s 12) 2))))
                            fh (+ 3 (mod (+ (/ now 90) (* k 5)) 6))]
                        (line-a fx (- (+ y s) 3) (+ fx 1) (- (- (+ y s) 3) fh) (c-heat) 190)))
                    (when (>= s 38) (draw-text "-2/s" (+ x 3) (+ y 3) 1 (c-heat))))
              (and (cell-cooled? cell) (cell-core-adjacent? cell))
                (do (fill-rect-a x y (/ s 3) 3 (c-cool) 255) (fill-rect-a x y 3 (/ s 3) (c-cool) 255)
                    (fill-rect-a x y s s (c-cool) 18))
              :else unit)))
        ;; damage: cracks, and the HP bar once the part is hurt
        (when (and (not wrecked) (< frac 0.999))
          (do (draw-cracks! x y s frac)
              (fill-rect-a (+ x 2) (- (+ y s) 5) (- s 4) 4 (c-shadow) 220)
              (fill-rect (+ x 3) (- (+ y s) 4) (i32 (* (f32 (- s 6)) frac)) 2 (hp-color frac))))
        ;; a hit lands: a white flash that dies away, its colour the weapon's; a repair: a green one
        (let [ht (load32 (hit-t-addr cell)) age (- now ht)]
          (when (and (> ht 0) (and (>= age 0) (< age 360)))
            (fill-rect-a x y s s (c-ink) (- 170 (/ (* age 170) 360)))))
        (let [ht (load32 (heal-t-addr cell)) age (- now ht)]
          (when (and (> ht 0) (and (>= age 0) (< age 520)))
            (do (fill-rect-a x y s s (c-grow) (- 110 (/ (* age 110) 520)))
                (rect-outline-a x y s s (c-grow) (- 230 (/ (* age 230) 520))))))))
    (rect-outline-a x y s s (c-line) 90)))

(defn boost-text [(pct : I32)] : String (if (>= pct 150) "x1.5" "x1.25"))

;; what the position of each part earns it, drawn over the grid: a weld across every shared edge between a boosted gun and the Titanium part that boosts it (gold),
;; between an Aegis Emitter and its Aether (violet); a badge with the multiplier; and, with the pointer resting on a part, every part it is tied to lights up in the
;; colour of the tie (gold boost, violet boost, green growth, orange heat, blue cooling).
(defn draw-grid-overlay! [(x : I32) (y : I32) (s : I32)] : Unit
  (let [(t : F32) (f32 (gi (g-ticker)))
        ph (i32 (* 50.0 (sinf (* t 0.006))))
        hl (if (= (gi (g-hl-ship)) (gi (g-ship))) (gi (g-hl-p)) -1)]
    (dotimes [r 6]
      (dotimes [c 6]
        (let [cx (+ x (* c s)) cy (+ y (* (vrow r) s)) o (cell-owner r c) cell (+ (* r 6) c)
              bk (boost-kind r c)]
          (when (and (> bk 0) (not (cell-wrecked? r c)))
            (do (draw-weld! r c cx cy s bk (if (= bk 1) (c-gold) (c-ore)) (+ 190 ph))
                (when (>= s 40)
                  (draw-badge! cx cy s (boost-text (if (= bk 1) (weapon-boost-pct (- o 1)) (aegis-boost-pct cell))) (if (= bk 1) (c-gold) (c-ore))))))
          ;; a Titanium or Aether part that is boosting something glows; one that boosts nothing does not
          (when (and (!= o 0) (and (> (item-family (st-item (- o 1))) 0) (and (booster-active? (- o 1)) (not (cell-wrecked? r c)))))
            (rect-outline-a (+ cx 1) (+ cy 1) (- s 2) (- s 2) (if (= (item-family (st-item (- o 1))) 1) (c-gold) (c-ore)) (+ 110 ph)))
          (when (and (>= hl 0) (!= o 0))
            (if (= o (+ hl 1))
                (do (rect-outline-a cx cy s s (c-ink) 255) (rect-outline-a (+ cx 1) (+ cy 1) (- s 2) (- s 2) (c-ink) 160))
                (let [k (tie-kind cell hl)]
                  (when (> k 0)
                    (do (fill-rect-a cx cy s s (tie-color k) 46)
                        (rect-outline-a cx cy s s (tie-color k) 255)
                        (rect-outline-a (+ cx 2) (+ cy 2) (- s 4) (- s 4) (tie-color k) 170)))))))))))

(defn draw-grid! [(x : I32) (y : I32) (s : I32) (live : Bool)] : Unit
  (do (card (- x 8) (- y 8) (+ (* s 6) 16) (+ (* s 6) 16) (c-panel) 235 (c-line) 255)
      (dotimes [r 6] (dotimes [c 6] (draw-grid-cell! r c (+ x (* c s)) (+ y (* (vrow r) s)) s live)))
      (draw-grid-overlay! x y s)))

;; the player's grid (ship 0) or the opponent's (ship 1, mirrored) -- the rules functions read whichever g-ship names
(defn draw-ship-grid! [(ship : I32) (x : I32) (y : I32) (s : I32) (live : Bool)] : Unit
  (do (gi! (g-ship) ship)
      (gi! (g-vflip) (if (= ship 1) 1 0))
      (draw-grid! x y s live)
      (gi! (g-vflip) 0)
      (gi! (g-ship) 0)))

;; an item's shape (base cells, rotation rot) as a small icon with its top-left at (x, y), cell side s
(defn draw-item-icon! [(item : I32) (rot : I32) (x : I32) (y : I32) (s : I32) (alpha : I32)] : Unit
  (let [n (shape! item 0 rot 0 0)
        kind (item-kind item)]
    (dotimes [i n]
      (let [cx (+ x (* (sh-col i) s)) cy (+ y (* (sh-row i) s))]
        (fill-rect-a cx cy s s (c-ground) alpha)
        (draw-role! cx cy s item (sh-role i) (sh-port i) kind 0 rot)
        (rect-outline-a cx cy s s (c-line) 140)))))

;; width and height (in cells) of an item's shape at a rotation
(defn shape-w [(item : I32) (rot : I32)] : I32
  (let [n (shape! item 0 rot 0 0) (m : I32) 0]
    (dotimes [i n] (when (> (sh-col i) m) (set! m (sh-col i))))
    (+ m 1)))
(defn shape-h [(item : I32) (rot : I32)] : I32
  (let [n (shape! item 0 rot 0 0) (m : I32) 0]
    (dotimes [i n] (when (> (sh-row i) m) (set! m (sh-row i))))
    (+ m 1)))

;; ---- small widgets ----------------------------------------------------------------------------------------------------------------
(defn button [(x : I32) (y : I32) (w : I32) (h : I32) (label : String) (primary : Bool) (enabled : Bool)] : Unit
  (let [hover (and enabled (in-rect? x y w h))]
    (card x y w h (if primary (c-gold) (c-panel)) (if enabled (if primary (if hover 255 225) 235) 120)
          (if primary (c-gold) (c-line)) (if hover 255 (if enabled 200 100)))
    (draw-text-c label (+ x (/ w 2)) (+ y (/ (- h 16) 2)) 1 (if primary (if enabled (c-bg) (c-faint)) (if enabled (c-ink) (c-faint))))))

(defn meter [(x : I32) (y : I32) (w : I32) (h : I32) (frac : F32) (c : I32)] : Unit
  (do (fill-rect-a x y w h (c-shadow) 200)
      (fill-rect (+ x 1) (+ y 1) (i32 (* (f32 (- w 2)) (clamp-f frac 0.0 1.0))) (- h 2) c)
      (rect-outline-a x y w h (c-line) 160)))

(defn label [(s : String) (x : I32) (y : I32)] : Unit (draw-text s x y 1 (c-faint)))
(defn heading [(s : String) (x : I32) (y : I32)] : Unit (draw-text-s s x y 2 (c-ink)))

;; small caps style section title with a hairline under it
(defn section [(s : String) (x : I32) (y : I32) (w : I32)] : Unit
  (do (draw-text s x y 1 (c-dim))
      (fill-rect-a x (+ y 19) w 1 (c-line) 255)))

(defn draw-backdrop! [] : Unit
  (let [(t : F32) (f32 (gi (g-ticker)))]
    (fill-rect 0 0 960 540 (c-bg))
    (dotimes [k 25] (fill-rect-a (* k 40) 0 1 540 (c-ground2) 120))
    (dotimes [k 14] (fill-rect-a 0 (* k 40) 960 1 (c-ground2) 120))
    ;; one slow sweep, so the page is alive without being busy
    (let [(sx : F32) (+ 480.0 (* 520.0 (sinf (* t 0.00017))))]
      (fill-rect-a (i32 sx) 0 2 540 (c-gold) 12))))
