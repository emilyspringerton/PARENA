;; stdlib/d2/web/d2_ui.prn -- the screens (title, searching, the fight, the result, errors) and what the player's clicks mean. (The pack screen is d2_pack.prn.)
;;
;; The flow: PLAY -> "looking for an opponent" (the match server pairs you with a waiting bot, or another person) -> PACK: two minutes to build a ship on a 6x6
;; grid inside a credit and a weight budget -> the pieces and READY go to the server in one go -> the FIGHT: thirty one-second ticks, and every five a round
;; break where a timing press decides a bonus -> the result, recorded to the account.
;;
;; The fight screen (ruleset 2) shows the two ships bow to bow in the middle, yours below and the opponent's above, so that a lane is one vertical track. Each
;; second's events play out across the second: a shot leaves its gun, runs down its lane, lands, and only then does the part flash, lose HP and send up a
;; number; the hull is the stern wall of each ship and slides down when hit, leaving a pale ghost of what it had. Down the sides: both ships' vitals, a roster of
;; every gun and what it is waiting for, and a running log that says in words who hit what with which weapon for how much.

;; ---- title ----------------------------------------------------------------------------------------------------------------------------
(defn play-bx [] : I32 390) (defn play-by [] : I32 336) (defn play-bw [] : I32 180) (defn play-bh [] : I32 44)

(defn draw-parts-strip! [(y : I32)] : Unit
  (dotimes [k 24]
    (let [it (bin-item k)
          cx (+ 66 (* (mod k 12) 71))
          cy (+ y (* (/ k 12) 52))
          w (shape-w it 0) h (shape-h it 0)]
      (draw-item-icon! it 0 (- cx (/ (* w 16) 2)) (- (+ cy 8) (/ (* h 16) 2)) 16 255)
      (draw-text-c (item-short it) cx (+ cy 28) 1 (c-faint)))))

(defn render-title! [] : Unit
  (do
    (draw-backdrop!)
    (draw-text-c "D E A D W E I G H T" 480 70 3 (c-ink))
    (draw-text-c "HOLD BATTLES" 480 110 1 (c-faint))
    (fill-rect-a 440 134 80 1 (c-gold) 200)
    (draw-text-c "Pack a ship. Wire it. Fight with the ship you built." 480 154 1 (c-dim))
    (draw-text-c "Two minutes, 1000 credits and 40 tons to fill a 6x6 hold. Every part has a price, a weight and HP." 480 176 1 (c-faint))
    (draw-text-c "Shots fly down lanes. Where a part sits decides what it protects, what feeds it, and what it boosts." 480 192 1 (c-faint))
    (draw-text-c "Then thirty seconds of fight, both ships on show, and every five a timing duel." 480 208 1 (c-faint))
    (draw-parts-strip! 232)
    (button (play-bx) (play-by) (play-bw) (play-bh) "PLAY" true true)
    (if (> (gi (g-name-len)) 0)
        (let [w (+ 70 (text-width-at (name-base) 1))
              x0 (- 480 (/ w 2))]
          (draw-text "playing as" x0 396 1 (c-faint))
          (draw-text-at (name-base) (+ x0 77) 396 1 (if (= (gi (g-guest)) 1) (c-dim) (c-gold))))
        (draw-text-c "getting your account ready..." 480 396 1 (c-faint)))
    (draw-text-c (if (= (gi (g-guest)) 1)
                     "guest: your matches count and stay with this browser. sign in with IDUNA to keep them anywhere."
                     "your matches count toward your WOTAN profile.")
                 480 420 1 (c-faint))
    (draw-text-c "you will be matched with a bot, or with another person if one is waiting" 480 496 1 (c-faint))))

(defn title-update! [] : Unit
  (when (or (and (left-clicked?) (in-rect? (play-bx) (play-by) (play-bw) (play-bh))) (key-hit? (kc-enter)))
    (when (> (gi (g-name-len)) 0) (begin-search!))))

;; ---- searching -----------------------------------------------------------------------------------------------------------------------------
(defn render-search! [] : Unit
  (let [(t : F32) (f32 (gi (g-ticker)))
        secs (/ (- (gi (g-ticker)) (gi (g-q-since))) 1000)]
    (draw-backdrop!)
    (panel 270 158 420 236)
    (dotimes [k 8]
      (let [(a : F32) (+ (* t 0.004) (* (f32 k) 0.7853982))
            (px : F32) (+ 480.0 (* 24.0 (sinf a)))
            (py : F32) (+ 222.0 (* 24.0 (- 0.0 (cosf a))))]
        (disc px py (+ 2.0 (* 0.4 (f32 k))) (c-gold) (+ 40 (* k 26)))))
    (draw-text-c "LOOKING FOR AN OPPONENT" 480 268 2 (c-ink))
    (draw-text-c "a bot is usually ready at once" 480 304 1 (c-dim))
    (draw-text "waited" 438 332 1 (c-faint))
    (draw-int-s secs 494 332 1 (c-ink))
    (draw-text "s" (+ 494 (num-width secs 1)) 332 1 (c-faint))
    (button 420 356 120 28 "CANCEL" false true)))

(defn search-update! [] : Unit
  (when (or (and (left-clicked?) (in-rect? 420 356 120 28)) (key-hit? (kc-esc)))
    (cancel-search!)))

;; ---- the fight -------------------------------------------------------------------------------------------------------------------------
(defn rb-label-x [] : I32 250) (defn rb-w [] : I32 460)
(defn rb-track-x [] : I32 300) (defn rb-track-y [] : I32 300) (defn rb-track-w [] : I32 360)

;; ms after the break the line sits at, in the player's own clock: the server counts from when IT sent the break, and our press travels back
(defn rb-line-ms [] : I32 (max-i 40 (- (gi (g-rb-target)) (gi (g-rtt)))))
(defn rb-local-ms [] : I32 (- (gi (g-ticker)) (gi (g-rb-t0))))

;; the fight cell under the pointer: ship 0 (yours) or 1 (theirs), cell index; -1 for none
(defn fight-hover! [] : Unit
  (let [px (pointer-x) py (pointer-y) s (fl-s)]
    (gi! (g-fh-ship) -1) (gi! (g-fh-cell) -1) (gi! (g-lane-hl) -1)
    (when (and (>= px (fl-x)) (< px (+ (fl-x) (* 6 s))))
      (when (and (>= py (- (fl-y1) 14)) (< py (+ (fl-y0) (+ (* 6 s) 14))))
        (gi! (g-lane-hl) (/ (- px (fl-x)) s))))
    (when (and (>= px (fl-x)) (< px (+ (fl-x) (* 6 s))) (>= py (fl-y0)) (< py (+ (fl-y0) (* 6 s))))
      (do (gi! (g-fh-ship) 0) (gi! (g-fh-cell) (+ (* 6 (/ (- py (fl-y0)) s)) (/ (- px (fl-x)) s)))))
    (when (and (= (gi (g-opp-known)) 1) (>= px (fl-x)) (< px (+ (fl-x) (* 6 s))) (>= py (fl-y1)) (< py (+ (fl-y1) (* 6 s))))
      (do (gi! (g-fh-ship) 1) (gi! (g-fh-cell) (+ (* 6 (- 5 (/ (- py (fl-y1)) s))) (/ (- px (fl-x)) s)))))))

(defn fight-update! [] : Unit
  (do
    (fight-hover!)
    ;; the part under the pointer lights up the parts it is tied to
    (gi! (g-hl-ship) (gi (g-fh-ship)))
    (gi! (g-hl-p) -1)
    (when (>= (gi (g-fh-ship)) 0)
      (let [(saved : I32) (gi (g-ship))]
        (gi! (g-ship) (gi (g-fh-ship)))
        (let [cell (gi (g-fh-cell))]
          (gi! (g-hl-p) (- (cell-owner (/ cell 6) (mod cell 6)) 1)))
        (gi! (g-ship) saved)))
    (when (and (= (gi (g-rb-on)) 1) (= (gi (g-rb-call)) 0))
      (let [over (or (key-hit? (kc-o)) (and (left-clicked?) (in-rect? 300 340 170 36)))
            brace (or (key-hit? (kc-b)) (and (left-clicked?) (in-rect? 490 340 170 36)))]
        (when over (do (send-call! 0) (gi! (g-rb-call) 1) (gi! (g-rb-call-t) (rb-local-ms))))
        (when (and brace (not over)) (do (send-call! 1) (gi! (g-rb-call) 2) (gi! (g-rb-call-t) (rb-local-ms))))))
    ;; forfeiting takes two clicks
    (when (and (left-clicked?) (in-rect? 14 508 (if (= (gi (g-leave-ask)) 1) 150 100) 24))
      (if (= (gi (g-leave-ask)) 0)
          (gi! (g-leave-ask) 1)
          (do (net-leave!) (gi! (g-leave-ask) 0))))
    (when (and (key-hit? (kc-esc)) (= (gi (g-leave-ask)) 1)) (gi! (g-leave-ask) 0))))

(defn grade-name [(g : I32)] : String (case g 3 "PERFECT" 2 "GOOD" 1 "MISS" "NO CALL"))
(defn grade-color [(g : I32)] : I32 (case g 3 (c-gold) 2 (c-good) 1 (c-rose) (c-faint)))
(defn call-name [(c : I32)] : String (case c 0 "OVERCHARGE" 1 "BRACE" "NONE"))

;; "x1.50", "+25", "-8 hull" for one side of a round result
(defn draw-fx! [(call : I32) (grade : I32) (fx : I32) (cx : I32) (y : I32)] : Unit
  (cond
    (= call 2) (draw-text-c "nothing happens" cx y 1 (c-faint))
    (= call 0)
      (if (= grade 1)
          (do (draw-text-c "backfire" cx y 1 (c-rose)) (draw-text-c "-" (- cx 20) (+ y 18) 1 (c-rose)) (draw-int fx (- cx 12) (+ y 18) 1 (c-rose)) (draw-text " hull" (+ (- cx 12) (num-width fx 1)) (+ y 18) 1 (c-rose)))
          (let [h (if (= (* fx 2) 126) 125 (* fx 2))]
            (draw-text-c "damage" cx y 1 (c-dim))
            (draw-text "x" (- cx 24) (+ y 18) 1 (c-ink))
            (draw-int (/ h 100) (- cx 16) (+ y 18) 1 (c-ink))
            (draw-text "." (- cx 8) (+ y 18) 1 (c-ink))
            (draw-int2 (mod h 100) (- cx 1) (+ y 18) 1 (c-ink))))
    :else
      (do (draw-text-c "shield" cx y 1 (c-dim))
          (draw-text "+" (- cx 10) (+ y 18) 1 (c-shield))
          (draw-int fx (- cx 2) (+ y 18) 1 (c-shield)))))

(defn tenths-text [(t : I32) (x : I32) (y : I32) (c : I32)] : Unit (draw-f1 (/ (f32 t) 10.0) x y 1 c))

;; the catch-up lever, in numbers: how much a win is worth and what a miss costs, for the standing (0 level, 1 behind, 2 ahead)
(defn kwin100 [(st : I32)] : I32 (case st 2 40 1 160 100))
(defn kmiss100 [(st : I32)] : I32 (case st 2 160 1 140 100))

(defn render-roundbreak! [] : Unit
  (let [lm (rb-local-ms)
        budget (gi (g-rb-budget))
        line (rb-line-ms)
        called (!= (gi (g-rb-call)) 0)
        tx (rb-track-x) ty (rb-track-y) tw (rb-track-w)
        st (gi (g-rb-behind))
        kw (kwin100 st) km (kmiss100 st)
        pos (if called (gi (g-rb-call-t)) (min-i lm budget))]
    (fill-rect-a 0 0 960 540 (c-bg) 150)
    (panel 250 160 460 248)
    (draw-text-c "ROUND BREAK" 480 174 1 (c-faint))
    (draw-text-c "SURGE TIMING" 480 192 2 (c-ink))
    (draw-text-c (case st 2 "YOU LEAD: a win pays only 40%, a miss costs 60% more" 1 "YOU TRAIL: a win pays 60% more, a miss costs 40% more" "LEVEL: wins and misses pay in full")
                 480 220 1 (case st 2 (c-rose) 1 (c-gold) (c-dim)))
    (draw-text-c "(hull + shield + structure/8, yours against theirs)" 480 234 1 (c-faint))
    ;; what each call is worth right now
    (draw-text "OVERCHARGE" 262 252 1 (c-kind-off))
    (draw-text "perfect x" 346 252 1 (c-faint)) (draw-f1 (/ (f32 (+ 100 (/ (* 50 kw) 100))) 100.0) 410 252 1 (c-ink))
    (draw-text "good x" 470 252 1 (c-faint)) (draw-f1 (/ (f32 (+ 100 (/ (* 25 kw) 100))) 100.0) 512 252 1 (c-ink))
    (draw-text "miss -" 556 252 1 (c-faint)) (tenths-text (/ (* 80 km) 100) 598 252 (c-rose)) (draw-text "hull" 634 252 1 (c-faint))
    (draw-text "BRACE" 262 267 1 (c-shield))
    (draw-text "perfect +" 346 267 1 (c-faint)) (tenths-text (/ (* 250 kw) 100) 410 267 (c-ink))
    (draw-text "good +" 470 267 1 (c-faint)) (tenths-text (/ (* 120 kw) 100) 512 267 (c-ink))
    (draw-text "miss: nothing" 556 267 1 (c-faint))
    ;; the track
    (fill-rect-a tx ty tw 8 (c-shadow) 230)
    (rect-outline-a tx ty tw 8 (c-line) 255)
    (let [lx (+ tx (/ (* tw line) budget))]
      (fill-rect-a (- lx 14) (- ty 4) 28 16 (c-good) 40)
      (fill-rect (- lx 1) (- ty 8) 3 24 (c-gold)))
    (let [mx (+ tx (/ (* tw pos) budget))]
      (fill-rect (- mx 2) (- ty 6) 5 20 (if called (c-dim) (c-ink)))
      (disc (f32 mx) (f32 (+ ty 4)) 5.0 (if called (c-dim) (c-ink)) 255))
    (draw-text-c "press when the marker meets the gold line" 480 (+ ty 20) 1 (c-faint))
    (if called
        (let [off (- (gi (g-rb-call-t)) line)]
          (draw-text-c (if (= (gi (g-rb-call)) 1) "OVERCHARGE LOCKED" "BRACE LOCKED") 480 346 1 (c-ink))
          (draw-text-c (if (< (abs-i off) 36) "right on the line" (if (< off 0) "a little early" "a little late")) 480 364 1 (c-dim))
          (draw-text-c "waiting for your opponent" 480 382 1 (c-faint)))
        (do (button 300 340 170 36 "OVERCHARGE  O" true true)
            (button 490 340 170 36 "BRACE  B" false true)
            (draw-text-c "overcharge: harder shots, or a backfire. brace: a shield." 480 386 1 (c-faint))))))

(defn render-roundresult! [] : Unit
  (let [age (- (gi (g-ticker)) (gi (g-rr-show)))]
    (when (and (> (gi (g-rr-show)) 0) (< age 2600))
      (do
        (panel 250 168 460 190)
        (draw-text-c "ROUND RESULT" 480 184 1 (c-faint))
        (draw-text-c "YOU" 365 214 1 (c-dim)) (draw-text-c "OPPONENT" 595 214 1 (c-dim))
        (fill-rect-a 479 208 1 128 (c-line) 255)
        (draw-text-c (call-name (gi (g-rr-ycall))) 365 238 1 (c-ink))
        (draw-text-c (grade-name (gi (g-rr-ygrade))) 365 264 2 (grade-color (gi (g-rr-ygrade))))
        (draw-fx! (gi (g-rr-ycall)) (gi (g-rr-ygrade)) (gi (g-rr-yfx)) 365 306)
        (draw-text-c (call-name (gi (g-rr-ocall))) 595 238 1 (c-ink))
        (draw-text-c (grade-name (gi (g-rr-ograde))) 595 264 2 (grade-color (gi (g-rr-ograde))))
        (draw-fx! (gi (g-rr-ocall)) (gi (g-rr-ograde)) (gi (g-rr-ofx)) 595 306)))))

(defn hull-color [(h : I32)] : I32 (if (> h 50) (c-good) (if (> h 25) (c-gold) (c-rose))))

;; ---- vitals --------------------------------------------------------------------------------------------------------------------------
;; the hull bar: the drawn hull, and behind it the pale ghost of what the ship had a moment ago
(defn draw-hull-bar! [(x : I32) (y : I32) (w : I32) (h : I32) (hull : F32) (ghost : F32)] : Unit
  (let [hc (hull-color (i32 hull))]
    (fill-rect-a x y w h (c-shadow) 210)
    (fill-rect (+ x 1) (+ y 1) (i32 (* (f32 (- w 2)) (clamp-f (/ (fmax2 ghost hull) 100.0) 0.0 1.0))) (- h 2) (mix (c-bg) (c-rose) 150))
    (fill-rect (+ x 1) (+ y 1) (i32 (* (f32 (- w 2)) (clamp-f (/ hull 100.0) 0.0 1.0))) (- h 2) hc)
    (dotimes [k 3] (fill-rect-a (+ x (/ (* (+ k 1) w) 4)) (+ y 1) 1 (- h 2) (c-bg) 140))
    (rect-outline-a x y w h (c-line) 200)))

;; both ships' numbers: hull, structure (the HP of every standing part), the Brace shield, the dodge chance
(defn draw-vitals! [(x : I32) (y : I32) (w : I32) (side : I32)] : Unit
  (let [hull (if (= side 0) (gi (g-hull-you)) (gi (g-hull-opp)))
        (hd : F32) (gf (if (= side 0) (g-hulld-you) (g-hulld-opp)))
        (gh : F32) (gf (if (= side 0) (g-ghost-you) (g-ghost-opp)))
        st (if (= side 0) (gi (g-struct-you)) (gi (g-struct-opp)))
        st0 (max-i 1 (if (= side 0) (gi (g-struct0-you)) (gi (g-struct0-opp))))
        sh (if (= side 0) (gi (g-armor-you)) (gi (g-armor-opp)))]
    (draw-text "HULL" x y 1 (c-faint))
    (draw-int-r (i32 (+ hd 0.5)) (+ x w) y 1 (hull-color (i32 hd)))
    (draw-hull-bar! x (+ y 14) w 14 hd gh)
    (draw-text "PARTS" x (+ y 34) 1 (c-faint))
    (draw-int-r st (- (+ x w) (+ 11 (num-width st0 1))) (+ y 34) 1 (c-good))
    (draw-text-r "/" (- (+ x w) (+ 4 (num-width st0 1))) (+ y 34) 1 (c-faint))
    (draw-int-r st0 (+ x w) (+ y 34) 1 (c-faint))
    (draw-text "HP standing" (+ x 42) (+ y 34) 1 (c-faint))
    (meter x (+ y 48) w 8 (/ (f32 st) (f32 st0)) (c-kind-def))
    (when (> sh 0)
      (do (draw-text "SHIELD" x (+ y 62) 1 (c-shield)) (draw-int-r sh (+ x w) (+ y 62) 1 (c-shield))
          (meter x (+ y 76) w 6 (/ (f32 sh) 40.0) (c-shield))))))

;; ---- the guns: what each is waiting for ------------------------------------------------------------------------------------------------
(defn kill-secs [(need : F32) (rate : F32)] : I32
  (if (<= rate 0.01) 99 (i32 (floor (+ (/ need rate) 0.999)))))

(defn draw-roster! [(side : I32) (x : I32) (y : I32) (w : I32) (maxrows : I32)] : Unit
  (let [(saved : I32) (gi (g-ship)) (row : I32) 0 (total : I32) 0]
    (gi! (g-ship) side)
    (dotimes [p (gi (g-stage-n))]
      (when (and (= (st-ok p) 1) (weapon-item? (st-item p))) (set! total (+ total 1))))
    (dotimes [p (gi (g-stage-n))]
      (when (and (= (st-ok p) 1) (weapon-item? (st-item p)))
        (when (< row maxrows)
          (let [it (st-item p) wc (weapon-cell p) lane (mod wc 6)
                ly (+ y (* row 17))
                bl (weapon-block p)
                (ch : F32) (loadf32 (sim-charge-addr p))
                (thr : F32) (weapon-thr it)
                (pw : F32) (loadf32 (sim-pin-addr wc))
                col (weapon-color it)
                fed (or (> pw 0.0) (= (cell-fed-any (/ wc 6) (mod wc 6)) 1))
                hl (= (gi (g-lane-hl)) lane)]
            (set! row (+ row 1))
            (when hl (fill-rect-a (- x 3) (- ly 1) (+ w 6) 16 (c-ink) 22))
            (card x ly 22 14 (c-ground2) 255 col 255)
            (draw-text-c "L" (+ x 7) (- ly 1) 1 col)
            (draw-int (+ lane 1) (+ x 12) (- ly 1) 1 (c-ink))
            (draw-text (item-short it) (+ x 28) (- ly 1) 1 (if (= bl 2) (c-faint) (c-dim)))
            (cond
              (= bl 2) (draw-text "BROKEN" (+ x 100) (- ly 1) 1 (c-rose))
              (= bl 1) (draw-text "BLOCKED by a part in front" (+ x 100) (- ly 1) 1 (c-gold))
              (not fed) (draw-text "NOT FED" (+ x 100) (- ly 1) 1 (c-rose))
              :else
                (do (meter (+ x 100) (+ ly 2) 84 8 (/ ch thr) col)
                    (let [left (kill-secs (- thr ch) pw)]
                      (draw-text (if (<= left 0) "ready" (if (>= left 99) "starved" "in")) (+ x 190) (- ly 1) 1 (if (<= left 0) (c-good) (c-faint)))
                      (when (and (> left 0) (< left 99))
                        (do (draw-int left (+ x 211) (- ly 1) 1 (c-ink)) (draw-text "s" (+ x (+ 211 (num-width left 1))) (- ly 1) 1 (c-faint)))))))))))
    (when (> total maxrows) (draw-text "+ more" x (+ y (* maxrows 17)) 1 (c-faint)))
    (when (= total 0) (draw-text "no guns" x y 1 (c-faint)))
    (gi! (g-ship) saved)))

;; ---- the log: who hit what, with what, for how much ---------------------------------------------------------------------------------------
(defn dt [(s : String) (x : I32) (y : I32) (c : I32)] : I32
  (do (draw-text s x y 1 c) (+ x (text-width s 1))))
(defn di [(n : I32) (x : I32) (y : I32) (c : I32)] : I32
  (do (draw-int n x y 1 c) (+ x (num-width n 1))))

;; the short name of the part at a cell of a ship (the model keeps the owner of a destroyed cell, so the name outlives the part)
(defn part-name-at [(side : I32) (cell : I32)] : String
  (let [(saved : I32) (gi (g-ship))]
    (gi! (g-ship) side)
    (let [o (cell-owner (/ cell 6) (mod cell 6))
          s (if (= o 0) "part" (item-short (st-item (- o 1))))]
      (do (gi! (g-ship) saved) s))))

(defn weapon-word [(item : I32)] : String (case item 3 "rail" 7 "laser" 8 "cannon" "shot"))

(defn ign [(v : I32)] : Unit unit)

(defn render-log! [(x : I32) (y : I32) (w : I32) (rows : I32)] : Unit
  (let [n (gi (g-log-n))]
    (section "WHAT JUST HAPPENED" x y w)
    (when (= n 0) (draw-text "nothing yet: the first second" x (+ y 28) 1 (c-faint)))
    (dotimes [k rows]
      (when (and (< k n) (< k 16))
        (let [ad (log-addr (- (- n 1) k))
              kind (load8 (+ ad 1)) sec (load8 (+ ad 2)) side (load8 (+ ad 3))
              a (load8 (+ ad 4)) b (load8 (+ ad 5)) c (load8 (+ ad 6)) d (load8 (+ ad 7)) e (load8 (+ ad 8))
              ly (+ y (+ 26 (* k 16)))
              ;; kinds 1, 2, 4 and 3 are things done TO the ship `side`; the rest are things that ship did or had done for it
              to-side (or (= kind 1) (or (= kind 2) (or (= kind 4) (= kind 3))))
              ;; "you" is the actor in the line: for a hit on THEM it is you; for circuit events it is the ship that made them
              you-act (cond (>= kind 10) (< kind 20) to-side (= side 1) :else (= side 0))
              hurt-you (and to-side (= side 0))]
          (draw-int sec x ly 1 (c-faint))
          (let [x1 (dt (if you-act "YOU" "THEY") (+ x 20) ly (if you-act (c-gold) (c-rose)))
                vx (+ x 60)]
            (cond
              (= kind 1)
                ;; a shot hit a part: "rail > Conductor -30 BROKEN"
                (let [x2 (dt (weapon-word e) vx ly (weapon-color e))
                      x3 (dt " > " x2 ly (c-faint))
                      x4 (dt (part-name-at side a) x3 ly (c-ink))
                      x5 (dt " -" (+ x4 3) ly (if hurt-you (c-rose) (c-gold)))
                      x6 (di b x5 ly (if hurt-you (c-rose) (c-gold)))]
                  (if (= (bit-and d 1) 1)
                      (ign (dt " BROKEN" x6 ly (c-rose)))
                      (if (!= (bit-and d 4) 0)
                          (ign (dt " weak" x6 ly (c-gold)))
                          (if (!= (bit-and d 2) 0)
                              (ign (dt " resisted" x6 ly (c-dim)))
                              (let [x7 (dt " (" x6 ly (c-faint)) x8 (di c x7 ly (c-faint))]
                                (ign (dt " left)" x8 ly (c-faint))))))))
              (= kind 2)
                ;; the hull
                (let [x2 (dt (weapon-word c) vx ly (weapon-color c))
                      x3 (dt " > HULL -" x2 ly (c-faint))
                      x4 (di a x3 ly (if hurt-you (c-rose) (c-gold)))
                      x5 (dt " (" (+ x4 4) ly (c-faint))
                      x6 (di b x5 ly (c-faint))]
                  (ign (dt " left)" x6 ly (c-faint))))
              (= kind 3)
                (let [x2 (dt "dodged a" vx ly (c-teal))
                      x3 (dt (weapon-word b) (+ x2 7) ly (weapon-color b))]
                  (ign (dt "!" x3 ly (c-teal))))
              (= kind 4)
                (let [x2 (dt "shield soaked" vx ly (c-shield))]
                  (ign (di a (+ x2 7) ly (c-shield))))
              (= kind 5)
                (let [x2 (dt "mended hull +" vx ly (c-good))]
                  (draw-f1 (/ (f32 a) 10.0) x2 ly 1 (c-good)))
              (= kind 6)
                (let [x2 (dt (if (= e 1) "grew back " "repaired ") vx ly (c-good))
                      x3 (dt (part-name-at side a) x2 ly (c-ink))
                      x4 (dt " +" (+ x3 3) ly (c-good))]
                  (ign (di b x4 ly (c-good))))
              (= kind 7)
                (let [x2 (dt "heat > " vx ly (c-heat))
                      x3 (dt (part-name-at side a) x2 ly (c-ink))
                      x4 (dt " -" (+ x3 3) ly (c-heat))
                      x5 (di b x4 ly (c-heat))]
                  (if (= d 1) (ign (dt " BROKEN" x5 ly (c-rose))) unit))
              (= kind 8)
                (ign (dt "Back-EMF burnt out a wire" vx ly (c-rose)))
              (= (mod kind 10) 1) (let [x2 (dt "capacitor dumped " vx ly (c-gold)) x3 (di a x2 ly (c-gold))] (ign (dt "W" x3 ly (c-faint))))
              (= (mod kind 10) 2) (ign (dt "battery ran dry" vx ly (c-rose)))
              (= (mod kind 10) 3) (ign (dt "gate opened" vx ly (c-gate)))
              (= (mod kind 10) 4) (ign (dt "gate shut" vx ly (c-faint)))
              :else unit)))))))

;; ---- what is under the pointer -----------------------------------------------------------------------------------------------------------
(defn render-inspect! [(x : I32) (y : I32) (w : I32) (h : I32)] : Unit
  (let [sh (gi (g-fh-ship)) cell (gi (g-fh-cell))]
    (card x y w h (c-panel) 245 (c-line) 255)
    (if (< sh 0)
        (do (draw-text "HOVER A PART" (+ x 10) (+ y 10) 1 (c-dim))
            (draw-text "to see its HP, what hurts it,   " (+ x 10) (+ y 28) 1 (c-faint))
            (draw-text "and what it is doing. Hover a" (+ x 10) (+ y 42) 1 (c-faint))
            (draw-text "lane to follow it." (+ x 10) (+ y 56) 1 (c-faint))
            (draw-text "RAIL" (+ x 10) (+ y 82) 1 (weapon-color 3)) (draw-text "punches through, x0.8 a part" (+ x 56) (+ y 82) 1 (c-faint))
            (draw-text "LASER" (+ x 10) (+ y 98) 1 (weapon-color 7)) (draw-text "the first part, clear lane" (+ x 63) (+ y 98) 1 (c-faint))
            (draw-text "CANNON" (+ x 10) (+ y 114) 1 (weapon-color 8)) (draw-text "the deepest part, splash" (+ x 70) (+ y 114) 1 (c-faint)))
        (do
          (gi! (g-ship) sh)
          (let [r (/ cell 6) c (mod cell 6) o (cell-owner r c)
                gy (if (= sh 0) (+ (fl-y0) (* r (fl-s))) (+ (fl-y1) (* (- 5 r) (fl-s))))]
            (rect-outline-a (+ (fl-x) (* c (fl-s))) gy (fl-s) (fl-s) (c-ink) 240)
            (if (= o 0)
                (do (draw-text "an empty cell" (+ x 10) (+ y 10) 1 (c-faint))
                    (draw-text "a shot down this lane passes through" (+ x 10) (+ y 28) 1 (c-faint)))
                (let [item (st-item (- o 1)) role (cell-role r c)
                      (pw : F32) (cell-pin r c)
                      (hp : F32) (cell-hp r c) (hpm : F32) (cell-hpmax r c)
                      dead (!= (cell-dead r c) 0)]
                  (draw-text (item-name item) (+ x 10) (+ y 8) 1 (c-ink))
                  (draw-text-r (if (= sh 0) "yours" "theirs") (+ x (- w 10)) (+ y 8) 1 (c-faint))
                  (draw-text "HP" (+ x 10) (+ y 24) 1 (c-faint))
                  (draw-int (i32 (+ hp 0.5)) (+ x 28) (+ y 24) 1 (if dead (c-rose) (hp-color (/ hp (fmax2 hpm 1.0)))))
                  (draw-text "/" (+ x (+ 28 (num-width (i32 (+ hp 0.5)) 1))) (+ y 24) 1 (c-faint))
                  (draw-int (i32 hpm) (+ x (+ 35 (num-width (i32 (+ hp 0.5)) 1))) (+ y 24) 1 (c-faint))
                  (meter (+ x 100) (+ y 27) (- w 112) 8 (/ hp (fmax2 hpm 1.0)) (hp-color (/ hp (fmax2 hpm 1.0))))
                  (draw-text "takes" (+ x 10) (+ y 42) 1 (c-faint))
                  (draw-text "laser" (+ x 48) (+ y 42) 1 (weapon-color 7)) (draw-pct! (item-x-laser item) (+ x 90) (+ y 42) (pct-color (item-x-laser item)))
                  (draw-text "slug" (+ x 126) (+ y 42) 1 (weapon-color 3)) (draw-pct! (item-x-rail item) (+ x 165) (+ y 42) (pct-color (item-x-rail item)))
                  (draw-text "shell" (+ x 198) (+ y 42) 1 (weapon-color 8)) (draw-pct! (item-x-cannon item) (+ x 239) (+ y 42) (pct-color (item-x-cannon item)))
                  (draw-text (cell-state-text r c) (+ x 10) (+ y 60) 1 (state-color r c))
                  (let [(ly : I32) (+ y 78)]
                    ;; the electrical picture: volts x amps = watts
                    (when (and (> pw 0.0) (not dead))
                      (let [(v : F32) (* 5.0 (gain-f (cell-gain r c))) (am : F32) (/ pw v)]
                        (draw-f1 v (+ x 10) ly 1 (c-gold)) (draw-text "V x" (+ x (+ 12 (f1-width v 1))) ly 1 (c-faint))
                        (let [x2 (+ x (+ 34 (f1-width v 1)))]
                          (draw-f1 am x2 ly 1 (c-gold)) (draw-text "A =" (+ x2 (+ 2 (f1-width am 1))) ly 1 (c-faint))
                          (let [x3 (+ x2 (+ 26 (f1-width am 1)))]
                            (draw-f1 pw x3 ly 1 (c-ink)) (draw-text "W" (+ x3 (+ 2 (f1-width pw 1))) ly 1 (c-faint))))
                        (set! ly (+ ly 16))))
                    (when (and (= role (r-weapon)) (not dead))
                      (let [(ch : F32) (loadf32 (sim-charge-addr (- o 1)))
                            (thr : F32) (weapon-thr item)
                            left (kill-secs (- thr ch) pw)]
                        (draw-text (case (weapon-kind item) 1 "7 dmg to the first part in the lane" 2 "30 dmg, punches through the lane" "45 dmg on the deepest part, splash") (+ x 10) ly 1 (weapon-color item))
                        (meter (+ x 10) (+ ly 16) (- w 20) 8 (/ ch thr) (weapon-color item))
                        (draw-text (if (<= left 0) "fires now" "fires in") (+ x 10) (+ ly 28) 1 (c-faint))
                        (when (and (> left 0) (< left 99))
                          (do (draw-int left (+ x 70) (+ ly 28) 1 (c-ink)) (draw-text "s" (+ x (+ 70 (num-width left 1))) (+ ly 28) 1 (c-faint))))
                        (when (> (weapon-boost-pct (- o 1)) 100) (draw-text "boosted by Titanium" (+ x 110) (+ ly 28) 1 (c-gold)))
                        (set! ly (+ ly 44))))
                    (when (and (= role (r-cap)) (not dead))
                      (let [(q : F32) (cell-q r c) left (kill-secs (- 30.0 q) pw)]
                        (meter (+ x 10) ly (- w 20) 8 (/ q 30.0) (c-gold))
                        (draw-f1 q (+ x 10) (+ ly 12) 1 (c-gold)) (draw-text "of 30 stored" (+ x (+ 6 (f1-width q 1))) (+ ly 12) 1 (c-faint))
                        (draw-text (if (>= q 30.0) "DUMPS next second" "dumps in") (+ x 140) (+ ly 12) 1 (c-faint))
                        (when (and (< q 30.0) (< left 99)) (do (draw-int left (+ x 192) (+ ly 12) 1 (c-ink)) (draw-text "s" (+ x (+ 192 (num-width left 1))) (+ ly 12) 1 (c-faint))))
                        (set! ly (+ ly 28))))
                    (when (and (= role (r-bat)) (not dead))
                      (let [(q : F32) (cell-q r c)]
                        (meter (+ x 10) ly (- w 20) 8 (/ q 90.0) (c-good))
                        (draw-f1 q (+ x 10) (+ ly 12) 1 (c-good)) (draw-text "of 90 stored" (+ x (+ 6 (f1-width q 1))) (+ ly 12) 1 (c-faint))
                        (draw-text "gives up to 15 W" (+ x 140) (+ ly 12) 1 (c-faint))
                        (set! ly (+ ly 28))))
                    (when (and (= role (r-trans)) (not dead))
                      (do (draw-text "gate fed" (+ x 10) ly 1 (c-faint))
                          (draw-f1 (cell-gate-feed r c) (+ x 66) ly 1 (c-gate)) (draw-text "W (needs 2)" (+ x (+ 70 (f1-width (cell-gate-feed r c) 1))) ly 1 (c-faint))
                          (set! ly (+ ly 16))))
                    (when (> (cell-heat-at cell) 0) (do (draw-text "COOKING: 2 HP a second from the Core" (+ x 10) ly 1 (c-heat)) (set! ly (+ ly 16))))
                    (when (and (cell-cooled? cell) (cell-core-adjacent? cell)) (do (draw-text "COOLED by a Cryo-Vent" (+ x 10) ly 1 (c-cool)) (set! ly (+ ly 16))))
                    (when (and (= role (r-aegis)) (> (aegis-boost-pct cell) 100)) (do (draw-text "x1.5 repair from the Aether" (+ x 10) ly 1 (c-ore)) (set! ly (+ ly 16))))
                    (when (and (consumer-role? role) (and (= (cell-power r c) 0) (and (= (cell-fed-any r c) 0) (= (cell-dead r c) 0))))
                      (do (draw-text (unfed-reason r c) (+ x 10) ly 1 (c-rose)) (set! ly (+ ly 16))))
                    (dotimes [k 4] (when (< (+ ly (* k 14)) (+ y (- h 10))) (draw-text (item-info item k) (+ x 10) (+ ly (* k 14)) 1 (if (= k 0) (c-dim) (c-faint)))))))))
          (gi! (g-ship) 0)))))

;; ---- the arena ---------------------------------------------------------------------------------------------------------------------------
;; a shaken ship: a hit rattles the grid for a moment
(defn shake-x [(side : I32)] : I32
  (let [now (gi (g-ticker))
        t (if (= side 0) (gi (g-shake-t)) (gi (g-ohit-t)))
        amt (if (= side 0) (gi (g-shake-amt)) 2)
        age (- now t)]
    (if (and (>= age 0) (< age 260))
        (i32 (* (f32 amt) (* (sinf (* (f32 age) 0.13)) (- 1.0 (/ (f32 age) 260.0)))))
        0)))

;; a lane with nothing standing in it: every shot down it lands on the hull
(defn lane-open? [(side : I32) (c : I32)] : Bool
  (let [(saved : I32) (gi (g-ship))]
    (gi! (g-ship) side)
    (let [n (lane-count c)] (do (gi! (g-ship) saved) (= n 0)))))

;; how many guns of a ship fire down lane c, of weapon kind kd (1 laser, 2 rail, 3 cannon)
(defn guns-in-lane [(side : I32) (c : I32) (kd : I32)] : I32
  (let [(saved : I32) (gi (g-ship)) (n : I32) 0]
    (gi! (g-ship) side)
    (dotimes [p (gi (g-stage-n))]
      (when (and (= (st-ok p) 1) (and (= (weapon-kind (st-item p)) kd) (= (mod (weapon-cell p) 6) c)))
        (set! n (+ n 1))))
    (gi! (g-ship) saved)
    n))

;; the stern wall of a ship: its hull bar, where a shot that finds an empty lane lands. A lane with nothing in it shows red on the wall: a shot down it hurts the hull.
(defn draw-stern-wall! [(side : I32)] : Unit
  (let [y (if (= side 0) (+ (fl-y0) (+ (* 6 (fl-s)) 4)) (- (fl-y1) 13))
        (hd : F32) (gf (if (= side 0) (g-hulld-you) (g-hulld-opp)))
        (gh : F32) (gf (if (= side 0) (g-ghost-you) (g-ghost-opp)))]
    (draw-hull-bar! (fl-x) y (* 6 (fl-s)) 9 hd gh)
    (when (or (= side 0) (= (gi (g-opp-known)) 1))
      (dotimes [c 6]
        (when (lane-open? side c)
          (let [x (+ (fl-x) (* c (fl-s)))]
            (fill-rect-a (+ x 1) y (- (fl-s) 2) 9 (c-rose) 120)
            (dotimes [k 4] (line-a (+ x (+ 4 (* k 9))) (+ y 8) (+ x (+ 10 (* k 9))) (+ y 1) (c-rose) 230))))))
    (draw-text "HULL" (+ (fl-x) (+ (* 6 (fl-s)) 5)) (- y 3) 1 (c-faint))))

(defn draw-lane-guides! [] : Unit
  (let [hl (gi (g-lane-hl))]
    (dotimes [c 6]
      (let [x (+ (fl-x) (* c (fl-s)))]
        (fill-rect-a x (- (fl-y1) 12) (fl-s) (- (+ (fl-y0) (+ (* 6 (fl-s)) 14)) (- (fl-y1) 12)) (c-ink) (if (= c hl) 20 6))
        (fill-rect-a x (fl-y1) 1 (- (+ (fl-y0) (* 6 (fl-s))) (fl-y1)) (c-ink) 14)
        ;; the lane number in the gap between the two bows, and a pip for every gun that fires down it: theirs above the number, yours below
        (draw-int-c (+ c 1) (+ x (/ (fl-s) 2)) (+ (+ (fl-y1) (* 6 (fl-s))) 5) 1 (if (= c hl) (c-ink) (c-faint)))
        (let [(them : I32) 0 (me : I32) 0]
          (dotimes [kd 3]
            (dotimes [j (guns-in-lane 1 c (+ kd 1))]
              (when (< them 6)
                (do (fill-rect (+ x (+ 6 (* them 6))) (+ (+ (fl-y1) (* 6 (fl-s))) 1) 5 4 (weapon-color (case kd 0 7 1 3 8)))
                    (set! them (+ them 1)))))
            (dotimes [j (guns-in-lane 0 c (+ kd 1))]
              (when (< me 6)
                (do (fill-rect (+ x (+ 6 (* me 6))) (+ (+ (fl-y1) (* 6 (fl-s))) 22) 5 4 (weapon-color (case kd 0 7 1 3 8)))
                    (set! me (+ me 1)))))))))
    (draw-text "BOW" (+ (fl-x) (+ (* 6 (fl-s)) 5)) (+ (+ (fl-y1) (* 6 (fl-s))) 5) 1 (c-faint))))

(defn render-fight! [] : Unit
  (let [now (gi (g-ticker))
        t (gi (g-tick))
        (frac : F32) (if (= (gi (g-rb-on)) 1) 0.0 (clamp-f (/ (f32 (- now (gi (g-tick-t)))) 1000.0) 0.0 1.0))]
    (hp-glide-all!)
    (hull-glide! 0)
    (hull-glide! 1)
    (draw-backdrop!)
    (draw-lane-guides!)
    ;; the two ships, bow to bow
    (if (= (gi (g-opp-known)) 1)
        (draw-ship-grid! 1 (+ (fl-x) (shake-x 1)) (fl-y1) (fl-s) true)
        (draw-unseen-hold! (fl-x) (fl-y1) (fl-s)))
    (draw-ship-grid! 0 (+ (fl-x) (shake-x 0)) (fl-y0) (fl-s) true)
    (draw-stern-wall! 1)
    (draw-stern-wall! 0)
    ;; a hit on a ship tints its frame
    (let [sinceHit (- now (gi (g-hit-t))) sinceOHit (- now (gi (g-ohit-t)))]
      (when (and (>= sinceHit 0) (< sinceHit 380))
        (rect-outline-a (- (fl-x) 9) (- (fl-y0) 9) (+ (* 6 (fl-s)) 18) (+ (* 6 (fl-s)) 18) (c-rose) (- 230 (/ (* sinceHit 230) 380))))
      (when (and (>= sinceOHit 0) (< sinceOHit 380))
        (rect-outline-a (- (fl-x) 9) (- (fl-y1) 9) (+ (* 6 (fl-s)) 18) (+ (* 6 (fl-s)) 18) (c-gold) (- 230 (/ (* sinceOHit 230) 380)))))
    (render-fx!)
    ;; ---- left: you
    (draw-text-s "YOUR SHIP" 14 12 1 (c-dim))
    (draw-text-at (name-base) 94 12 1 (c-ink))
    (draw-vitals! 14 28 330 0)
    (draw-text "DODGE" 14 112 1 (c-faint)) (draw-int (/ (gi (g-evade10)) 10) 62 112 1 (c-teal)) (draw-text "%" (+ 62 (num-width (/ (gi (g-evade10)) 10) 1)) 112 1 (c-teal))
    (draw-text "of slugs and shells" (+ 62 (+ 14 (num-width (/ (gi (g-evade10)) 10) 1))) 112 1 (c-faint))
    (section "YOUR GUNS" 14 130 330)
    (draw-roster! 0 14 154 330 4)
    (render-log! 14 232 316 14)
    ;; ---- right: them
    (draw-text-s "OPPONENT" 624 12 1 (c-dim))
    (draw-opp-chip! 694 12)
    (draw-vitals! 624 28 322 1)
    (when (= (gi (g-opp-known)) 1)
      (do (gi! (g-ship) 1)
          (draw-text "DODGE" 624 112 1 (c-faint)) (draw-int (/ (gi (g-evade10)) 10) 672 112 1 (c-teal)) (draw-text "%" (+ 672 (num-width (/ (gi (g-evade10)) 10) 1)) 112 1 (c-teal))
          (gi! (g-ship) 0)))
    (section "THEIR GUNS" 624 130 322)
    (draw-roster! 1 624 154 322 4)
    ;; the clock: thirty seconds, a round break every five
    (section "THE CLOCK" 624 232 322)
    (dotimes [k 30]
      (let [x (+ 624 (* k 11))
            done (< k t)
            cur (= k t)]
        (fill-rect-a x 262 9 10 (if done (c-gold) (c-ground2)) (if done 230 255))
        (when cur (fill-rect-a x 262 (i32 (* 9.0 frac)) 10 (c-gold) 200))
        (when (and (> k 0) (= (mod k 5) 0)) (fill-rect-a (- x 2) 258 1 18 (c-faint) 180))))
    (draw-text "second" 624 280 1 (c-faint)) (draw-int t 676 280 1 (c-ink)) (draw-text "of 30" (+ 676 (+ 6 (num-width t 1))) 280 1 (c-faint))
    (draw-text-r "round" 900 280 1 (c-faint)) (draw-int-r (+ (/ t 5) 1) 930 280 1 (c-ink))
    (render-inspect! 624 298 322 232)
    ;; forfeit
    (if (= (gi (g-leave-ask)) 1)
        (do (button 14 508 150 24 "CONFIRM FORFEIT" true true)
            (draw-text "Esc to stay" 174 512 1 (c-faint)))
        (button 14 508 100 24 "FORFEIT" false true))
    (when (> (gi (g-ack-wait)) 0) (draw-text "..." 880 512 1 (c-faint)))
    (when (= (gi (g-rb-on)) 1) (render-roundbreak!))
    (render-roundresult!)
    (draw-toast!)))

;; the server did not show the opponent's ship (an older match server): an honest placeholder
(defn draw-unseen-hold! [(x : I32) (y : I32) (s : I32)] : Unit
  (do (card (- x 8) (- y 8) (+ (* s 6) 16) (+ (* s 6) 16) (c-panel) 235 (c-line) 255)
      (dotimes [r 6] (dotimes [c 6]
        (let [cx (+ x (* c s)) cy (+ y (* r s))]
          (fill-rect cx cy s s (if (= (mod (+ r c) 2) 0) (c-ground) (c-ground2)))
          (rect-outline-a cx cy s s (c-line) 70))))
      (draw-text-c "THEIR SHIP IS NOT SHOWN" (+ x (* 3 s)) (+ y (- (* 3 s) 8)) 1 (c-faint))))

;; ---- the result -----------------------------------------------------------------------------------------------------------------------------
(defn reason-text [(r : I32)] : String
  (case r 0 "hull destroyed" 1 "30 seconds: more hull wins, then more of the ship left standing" 2 "forfeit" "the match server restarted"))

(defn render-over! [] : Unit
  (let [res (gi (g-res-result))
        win (= res 1)
        tie (= res 2)
        age (- (gi (g-ticker)) (gi (g-over-t)))]
    (draw-backdrop!)
    (panel 190 70 580 400)
    (draw-text-c (if win "VICTORY" (if tie "DRAW" "DEFEAT")) 480 92 4 (if win (c-gold) (if tie (c-ink) (c-rose))))
    (draw-text-c (reason-text (gi (g-res-reason))) 480 166 1 (c-dim))
    ;; the two ships' last numbers
    (draw-text-c "YOU" 340 196 1 (c-faint)) (draw-text-c "OPPONENT" 620 196 1 (c-faint))
    (draw-text-c "HULL" 480 222 1 (c-faint))
    (draw-int-c (gi (g-hull-you)) 340 216 2 (hull-color (gi (g-hull-you))))
    (draw-int-c (gi (g-hull-opp)) 620 216 2 (hull-color (gi (g-hull-opp))))
    (draw-text-c "PARTS LEFT (HP)" 480 254 1 (c-faint))
    (draw-int-c (gi (g-struct-you)) 340 248 2 (c-good))
    (draw-int-c (gi (g-struct-opp)) 620 248 2 (c-good))
    (draw-text-c "YOUR SHOTS" 480 286 1 (c-faint))
    (draw-int-c (gi (g-sim-shots)) 340 280 2 (c-ink))
    ;; the round breaks
    (section "ROUND BREAKS" 214 322 532)
    (let [(shown : I32) 0]
      (dotimes [k 8]
        (let [a (+ (rounds-base) (shl k 4))]
          (when (= (load8 (+ a 7)) 1)
            (let [x (+ 262 (* shown 96))]
              (set! shown (+ shown 1))
              (draw-text "R" x 350 1 (c-faint)) (draw-int (load8 a) (+ x 8) 350 1 (c-faint))
              (draw-text-nc (grade-name (load8 (+ a 2))) (+ x 44) 350 1 (grade-color (load8 (+ a 2))) 7)
              (draw-text-nc (grade-name (load8 (+ a 5))) (+ x 44) 372 1 (c-faint) 7)))))
      (when (= shown 0) (draw-text "none: the fight ended first" 262 350 1 (c-faint))))
    (draw-text "you" 214 350 1 (c-dim)) (draw-text "them" 214 372 1 (c-faint))
    ;; the ladder
    (if (= (gi (g-rec-got)) 1)
        (if (= (gi (g-rec-counted)) 1)
            (do (draw-text-c "RATING" 480 404 1 (c-faint))
                (draw-int-c (gi (g-rec-rating)) 440 422 2 (c-ink))
                (draw-text (if (>= (gi (g-rec-delta)) 0) "+" "-") 500 428 1 (if (>= (gi (g-rec-delta)) 0) (c-good) (c-rose)))
                (draw-int (abs-i (gi (g-rec-delta))) 510 428 1 (if (>= (gi (g-rec-delta)) 0) (c-good) (c-rose))))
            (draw-text-c "this one did not count toward the ladder" 480 412 1 (c-faint)))
        (draw-text-c "recording the match..." 480 412 1 (c-faint)))
    (button 360 474 150 34 "PLAY AGAIN" true (> age 400))
    (button 530 474 110 34 "TITLE" false true)))

(defn over-update! [] : Unit
  (do
    (when (and (> (- (gi (g-ticker)) (gi (g-over-t))) 400) (or (key-hit? (kc-enter)) (and (left-clicked?) (in-rect? 360 474 150 34))))
      (begin-search!))
    (when (and (left-clicked?) (in-rect? 530 474 110 34)) (do (reset-match!) (go-screen! (sc-title))))))

;; ---- errors ---------------------------------------------------------------------------------------------------------------------------
(defn render-error! [] : Unit
  (let [code (gi (g-err-code))]
    (draw-backdrop!)
    (panel 230 170 500 200)
    (draw-text-c "COULD NOT CONTINUE" 480 196 2 (c-rose))
    (if (> (gi (g-err-len)) 0)
        (draw-text-at-c (err-base) 480 246 1 (c-dim))
        (draw-text-c (cond (= code 5) "The connection to the game was lost."
                           (= code 3) "The match server is not answering right now."
                           (= code 2) "You opened D2 in another tab."
                           (= code 1) "Your sign-in was not accepted. Reload the page."
                           :else "The match server stopped the game.")
                     480 246 1 (c-dim)))
    (draw-text-c "Nothing you did was lost; a match in progress counts as played." 480 276 1 (c-faint))
    (button 410 316 140 34 "BACK" true true)))

(defn error-update! [] : Unit
  (when (or (key-hit? (kc-enter)) (and (left-clicked?) (in-rect? 410 316 140 34)))
    (do (reset-match!) (gi! (g-err-code) 0) (go-screen! (sc-title)))))

;; ---- the frame ------------------------------------------------------------------------------------------------------------------------
(defn d2-update! [] : Unit
  (let [sc (gi (g-screen))]
    (cond
      (= sc (sc-title)) (title-update!)
      (= sc (sc-search)) (search-update!)
      (= sc (sc-pack)) (pack-update!)
      (= sc (sc-fight)) (fight-update!)
      (= sc (sc-over)) (over-update!)
      :else (error-update!))))

(defn d2-render! [] : Unit
  (let [sc (gi (g-screen))]
    (cond
      (= sc (sc-title)) (render-title!)
      (= sc (sc-search)) (render-search!)
      (= sc (sc-pack)) (render-pack!)
      (= sc (sc-fight)) (render-fight!)
      (= sc (sc-over)) (render-over!)
      :else (render-error!))))
