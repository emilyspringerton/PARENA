;; stdlib/d2/web/d2_main.prn -- the exports the page calls (and the test hooks).

(defn d2-init [] : Unit
  (do
    (load-font)
    (items-init!)
    (examples-init!)
    (gi! (g-rng) 2460)
    (gi! (g-screen) 0)
    (gi! (g-sel-item) 3)
    (gi! (g-hov-pl) -1)
    (gi! (g-hov-row) -1)
    (gi! (g-hov-col) -1)
    (gi! (g-hull-you) 100)
    (gi! (g-hull-opp) 100)
    (gi! (g-lane-hl) -1)
    (gi! (g-hov-weapon) -1)
    (gi! (g-last-cause) 255)
    (gi! (g-split-i) -1)
    (gi! (g-undo-n) 0)
    (gi! (g-vflip) 0)
    (model-clear!)))

;; how long energy has been travelling: a fight's packets leave the generators when a tick lands and have crossed the ship in under a second; while
;; packing they loop. A round break is a pause: nothing flows, so nothing is drawn moving.
(defn set-pulse! [] : Unit
  (let [sc (gi (g-screen))]
    (gi! (g-pulse)
         (cond (= sc (sc-pack)) (mod (gi (g-ticker)) 1700)
               (and (= sc (sc-fight)) (= (gi (g-rb-on)) 0))
                 (let [el (- (gi (g-ticker)) (gi (g-tick-t)))] (if (< el 1000) el -1))
               :else -1))))

;; one animation frame: act on input, then draw
(defn d2-frame [(now : F64)] : Unit
  (do
    (gi! (g-ticker) (i32 now))
    (gi! (g-frame) (+ (gi (g-frame)) 1))
    (gi! (g-ui-t) (+ (gi (g-ui-t)) 1))
    (net-tick!)
    (d2-update!)
    (set-pulse!)
    (d2-render!)
    (end-input-frame!)))

;; ---- input forwarding ------------------------------------------------------------------------------------------------
(defn d2-key [(id : I32) (down : I32)] : Unit (in-key! id down))
(defn d2-blur [] : Unit (in-clear-keys!))
(defn d2-pointer [(x : I32) (y : I32)] : Unit (in-pointer! x y))
(defn d2-button [(b : I32) (down : I32)] : Unit (in-button! b down))
(defn d2-wheel [(dir : I32)] : Unit (in-wheel! dir))

;; ---- memory the page reads / writes ------------------------------------------------------------------------------------
(defn d2-fb-addr [] : I32 (fb-base))
(defn d2-fb-w [] : I32 960)
(defn d2-fb-h [] : I32 540)
(defn d2-mem-bytes [] : I32 8388608)

(defn d2-token-addr [] : I32 (token-base))
(defn d2-token-set [(n : I32)] : Unit (gi! (g-token-len) n))
(defn d2-name-addr [] : I32 (name-base))
(defn d2-name-set [(n : I32)] : Unit
  (do (gi! (g-name-len) n) (store8! (+ (name-base) (min-i n 62)) 0)))
(defn d2-guest-set [(v : I32)] : Unit (gi! (g-guest) v))

(defn d2-net-in-addr [] : I32 (netin-base))
(defn d2-net-out-addr [] : I32 (netout-base))
(defn d2-net-out-len [] : I32 (gi (g-out-len)))
(defn d2-net-out-clear [] : Unit (gi! (g-out-len) 0))

;; what the page shows around the canvas
(defn d2-screen [] : I32 (gi (g-screen)))
(defn d2-err-addr [] : I32 (err-base))

;; the page could not sign the player in (the guest account could not be made): show the error screen with the text it wrote at d2_err_addr
(defn d2-fail [(n : I32)] : Unit
  (do (gi! (g-err-code) 1)
      (store8! (+ (err-base) (min-i n 200)) 0)
      (gi! (g-err-len) (min-i n 200))
      (gi! (g-want-queue) 0)
      (gi! (g-queued-sent) 0)
      (go-screen! (sc-error))))

;; ---- introspection (page footer + tests) ----------------------------------------------------------------------------------
(defn d2-g [(k : I32)] : I32 (gi k))
(defn d2-stage-n [] : I32 (gi (g-stage-n)))

;; ---- test hooks: stage a ship, rebuild its grid, run the self half of the fight ---------------------------------------------
(defn d2-t-clear [] : Unit (do (gi! (g-stage-n) 0) (model-clear!)))
(defn d2-t-add [(item : I32) (row : I32) (col : I32) (rot : I32)] : Unit
  (do (st-set! (gi (g-stage-n)) item row col rot) (gi! (g-stage-n) (+ (gi (g-stage-n)) 1))))
(defn d2-t-rebuild [] : I32 (let [bad (model-rebuild!)] (do (analyze!) (sim-reset!) bad)))
(defn d2-t-tick [] : I32 (sim-tick!))
(defn d2-t-shat [] : I32 (gi (g-sim-shat)))
;; destroy a cell, as an EVENTS frame would say a shot had
(defn d2-t-kill [(cell : I32)] : Unit (cell-kill! cell 2))
;; masks of cells, low 32 bits then the other 4: burnt out by Back-EMF (1), and destroyed or burnt (any)
(defn d2-t-burn-lo [] : I32
  (let [(v : I32) 0] (dotimes [i 32] (when (= (cell-dead (/ i 6) (mod i 6)) 1) (set! v (bit-or v (shl 1 i))))) v))
(defn d2-t-burn-hi [] : I32
  (let [(v : I32) 0] (dotimes [i 4] (when (= (cell-dead (/ (+ i 32) 6) (mod (+ i 32) 6)) 1) (set! v (bit-or v (shl 1 i))))) v))
(defn d2-t-dead-lo [] : I32
  (let [(v : I32) 0] (dotimes [i 32] (when (!= (cell-dead (/ i 6) (mod i 6)) 0) (set! v (bit-or v (shl 1 i))))) v))
(defn d2-t-dead-hi [] : I32
  (let [(v : I32) 0] (dotimes [i 4] (when (!= (cell-dead (/ (+ i 32) 6) (mod (+ i 32) 6)) 0) (set! v (bit-or v (shl 1 i))))) v))
(defn d2-t-cost [] : I32 (gi (g-bud-cost)))
(defn d2-t-weight [] : I32 (gi (g-bud-weight)))
(defn d2-t-structure [] : I32 (gi (g-structure-max)))
(defn d2-t-evade10 [] : I32 (gi (g-evade10)))
(defn d2-t-heat [(cell : I32)] : I32 (cell-heat-at cell))
(defn d2-t-cooled-lo [] : I32
  (let [(v : I32) 0] (dotimes [i 32] (when (cell-cooled? i) (set! v (bit-or v (shl 1 i))))) v))
(defn d2-t-cooled-hi [] : I32
  (let [(v : I32) 0] (dotimes [i 4] (when (cell-cooled? (+ i 32)) (set! v (bit-or v (shl 1 i))))) v))
(defn d2-t-boost [(p : I32)] : I32 (weapon-boost-pct p))
;; 1 if the laser in placement p has nothing standing in front of it
(defn d2-t-lane-clear [(p : I32)] : I32 (b2i (lane-clear-ahead? (weapon-cell p))))
(defn d2-t-shots-to-open [(lane : I32) (kind : I32)] : I32 (lane-shots-to-open lane kind))
(defn d2-t-split [(i : I32)] : I32 (split-pieces! i))
(defn d2-t-split-get [(k : I32) (q : I32)] : I32 (load32 (+ (scratch-base) (+ (shl k 4) (shl q 2)))))
(defn d2-t-st [(i : I32) (f : I32)] : I32 (load8 (+ (st-addr i) f)))
(defn d2-t-set [(k : I32) (v : I32)] : Unit (gi! k v))

;; stored charge in every capacitor / battery / delayer (hundredths, summed) and the open transistor gates, to compare with the C core each tick
(defn d2-t-qsum [] : I32
  (let [(t : F64) 0.0]
    (dotimes [i 36] (set! t (+ t (f64 (+ (loadf32 (sim-q-addr i)) (loadf32 (sim-q2-addr i)))))))
    (i32 (+ (* t 100.0) 0.5))))
(defn d2-t-gates [] : I32
  (let [(g : I32) 0]
    (dotimes [i 36] (when (= (load8 (sim-gate-addr i)) 1) (set! g (+ g (shl 1 (mod i 20))))))
    g))

;; a position-weighted checksum of n bytes at a: the memory-integrity check in the parity test (nothing the fight writes may land on the catalog, the
;; examples or the font)
(defn d2-t-sum [(a : I32) (n : I32)] : I32
  (let [(t : I32) 0]
    (dotimes [i n] (set! t (+ t (* (load8 (+ a i)) (+ i 1)))))
    t))
