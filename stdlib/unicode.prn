;; stdlib/unicode.prn -- depends on string, bytes, unicode/ucd.prn (generated). Design: STDLIB.md "unicode".
;;
;; Full-Unicode text primitives for PARENA (founder real-time, 2026-10-15: "we need to add full
;; unicode support so we are gonna need to add that to PARENA first" -- PELLEGRINO's browser needs
;; it; core deps are PARENA-first). Strings stay NUL-terminated UTF-8 bytes (that is what `String`
;; is in this language); this module is the layer that makes codepoints, not bytes, the unit.
;;
;;  * Strict RFC 3629 decoding: overlong forms, UTF-16 surrogates (U+D800-DFFF), and anything above
;;    U+10FFFF are rejected, not "mostly decoded". Malformed input never loops and never reads past
;;    the terminating NUL (a NUL byte is never a continuation byte).
;;  * Codepoints are plain I32 values. `char-at` is signed (a UTF-8 byte >= 0x80 comes back
;;    negative) -- everything here goes through `u8-byte-at` (bit-and 255) first.
;;  * Properties/case tables are Unicode 15.1 (see ucd.prn's own header), regenerated by
;;    tools/gen_ucd.py. Case mapping is the SIMPLE 1:1 mapping only (no SpecialCasing, no
;;    Turkish/Lithuanian locale rules); width is East-Asian-Width W/F = 2, combining = 0.
;;  * NOT here yet (named gaps, not silent): normalization (NFC/NFD), grapheme-cluster
;;    segmentation, bidi, full case folding, collation, emoji ZWJ sequences as one unit.
(module unicode)
(import string)
(import bytes)
(import ucd)
(export utf8-decode-at utf8-seq-len utf8-valid? utf8-count utf8-offset utf8-prev
        utf8-encoded-len utf8-encode utf8-width utf8-lower utf8-upper utf8-eq-ci?
        cp-alpha? cp-upper? cp-lower? cp-digit? cp-space? cp-combining? cp-control? cp-punct?
        cp-wide? cp-lower cp-upper cp-width scalar-value?)

(defn u8-byte-at [(s : String @ Region) (i : I32)]
  : I32
  (bit-and (string/char-at s i) 255))

;; continuation byte = 10xxxxxx
(defn u8-cont? [(s : String @ Region) (i : I32)]
  : Bool
  (= (bit-and (u8-byte-at s i) 192) 128))

(defn u8-cont-bits [(s : String @ Region) (i : I32)]
  : I32
  (bit-and (u8-byte-at s i) 63))

(defn scalar-value? [(cp : I32)]
  : Bool
  (and (>= cp 0) (and (< cp 1114112) (not (and (>= cp 55296) (< cp 57344))))))

(defn u8-decode2 [(s : String @ Region) (i : I32) (b0 : I32)]
  : I32
  (if (u8-cont? s (+ i 1))
    (bit-or (shl (bit-and b0 31) 6) (u8-cont-bits s (+ i 1)))
    -1))

(defn u8-decode3 [(s : String @ Region) (i : I32) (b0 : I32)]
  : I32
  (if (and (u8-cont? s (+ i 1)) (u8-cont? s (+ i 2)))
    (u8-decode3-check
      (bit-or (bit-or (shl (bit-and b0 15) 12) (shl (u8-cont-bits s (+ i 1)) 6)) (u8-cont-bits s (+ i 2))))
    -1))

;; reject overlongs (< U+0800) and surrogates
(defn u8-decode3-check [(cp : I32)]
  : I32
  (if (< cp 2048) -1
    (if (scalar-value? cp) cp -1)))

(defn u8-decode4 [(s : String @ Region) (i : I32) (b0 : I32)]
  : I32
  (if (and (u8-cont? s (+ i 1)) (and (u8-cont? s (+ i 2)) (u8-cont? s (+ i 3))))
    (u8-decode4-check
      (bit-or (bit-or (shl (bit-and b0 7) 18) (shl (u8-cont-bits s (+ i 1)) 12))
              (bit-or (shl (u8-cont-bits s (+ i 2)) 6) (u8-cont-bits s (+ i 3)))))
    -1))

;; reject overlongs (< U+10000) and > U+10FFFF
(defn u8-decode4-check [(cp : I32)]
  : I32
  (if (< cp 65536) -1
    (if (scalar-value? cp) cp -1)))

;; utf8-decode-at -- the codepoint starting at byte `i`, or -1 if the bytes there are not a valid,
;; strictly-encoded UTF-8 sequence.
(defn utf8-decode-at [(s : String @ Region) (i : I32)]
  : I32
  (let [b0 (u8-byte-at s i)]
    (if (< b0 128) b0
      (if (< b0 194) -1
        (if (< b0 224) (u8-decode2 s i b0)
          (if (< b0 240) (u8-decode3 s i b0)
            (if (< b0 245) (u8-decode4 s i b0)
              -1)))))))

(defn utf8-encoded-len [(cp : I32)]
  : I32
  (if (< cp 128) 1
    (if (< cp 2048) 2
      (if (< cp 65536) 3 4))))

;; utf8-seq-len -- bytes occupied by the valid sequence at `i`, 0 if malformed.
(defn utf8-seq-len [(s : String @ Region) (i : I32)]
  : I32
  (let [cp (utf8-decode-at s i)]
    (if (< cp 0) 0 (utf8-encoded-len cp))))

;; u8-step: always >= 1, so scans terminate on malformed input (each bad byte counts as one unit)
(defn u8-step [(s : String @ Region) (i : I32)]
  : I32
  (let [n (utf8-seq-len s i)]
    (if (= n 0) 1 n)))

(defn utf8-valid? [(s : String @ Region)]
  : Bool
  (let [n (string/length s)]
    (loop [i 0]
      (if (>= i n) true
        (if (= (utf8-seq-len s i) 0) false
          (recur (+ i (utf8-seq-len s i))))))))

;; utf8-count -- number of codepoints (a malformed byte counts as one)
(defn utf8-count [(s : String @ Region)]
  : I32
  (let [n (string/length s)]
    (loop [i 0 c 0]
      (if (>= i n) c
        (recur (+ i (u8-step s i)) (+ c 1))))))

;; utf8-offset -- byte offset of the n-th (0-based) codepoint; n = count gives the byte length;
;; -1 when n is past the end or negative.
(defn utf8-offset [(s : String @ Region) (n : I32)]
  : I32
  (let [len (string/length s)]
    (if (< n 0) -1
      (loop [i 0 c 0]
        (if (= c n) i
          (if (>= i len) -1
            (recur (+ i (u8-step s i)) (+ c 1))))))))

;; utf8-prev -- byte offset of the codepoint start before `pos` (0 at the start)
(defn utf8-prev [(s : String @ Region) (pos : I32)]
  : I32
  (if (<= pos 0) 0
    (loop [i (- pos 1) k 0]
      (if (or (<= i 0) (or (>= k 3) (not (u8-cont? s i))))
        i
        (recur (- i 1) (+ k 1))))))

;; ---- encoding --------------------------------------------------------------------------------
(defn u8-put-seq [(b : Bytes) (o : I32) (c : I32) (n : I32)]
  : Unit
  (if (= n 1)
    (bytes/bytes-set! b o c)
    (if (= n 2)
      (do (bytes/bytes-set! b o (bit-or 192 (shr c 6)))
          (bytes/bytes-set! b (+ o 1) (bit-or 128 (bit-and c 63))))
      (if (= n 3)
        (do (bytes/bytes-set! b o (bit-or 224 (shr c 12)))
            (bytes/bytes-set! b (+ o 1) (bit-or 128 (bit-and (shr c 6) 63)))
            (bytes/bytes-set! b (+ o 2) (bit-or 128 (bit-and c 63))))
        (do (bytes/bytes-set! b o (bit-or 240 (shr c 18)))
            (bytes/bytes-set! b (+ o 1) (bit-or 128 (bit-and (shr c 12) 63)))
            (bytes/bytes-set! b (+ o 2) (bit-or 128 (bit-and (shr c 6) 63)))
            (bytes/bytes-set! b (+ o 3) (bit-or 128 (bit-and c 63))))))))

;; utf8-encode -- one codepoint as a String. A non-scalar value (surrogate, > U+10FFFF, negative)
;; encodes U+FFFD, never invalid UTF-8. Codepoint 0 yields "" (a String cannot hold a NUL).
(defn utf8-encode [(cp : I32) (dest : Arena @ Region)]
  : String @ Region
  (let [c (if (scalar-value? cp) cp 65533)
        n (utf8-encoded-len c)
        b (bytes/bytes-alloc (+ n 1) dest)]
    (do (u8-put-seq b 0 c n)
        (bytes/bytes-set! b n 0)
        (bytes/bytes-to-string-lossy b dest))))

;; ---- properties ------------------------------------------------------------------------------
(defn cp-prop? [(cp : I32) (bit : I32)]
  : Bool
  (not (= (bit-and (ucd/ucd-props cp) bit) 0)))

(defn cp-alpha? [(cp : I32)] : Bool (cp-prop? cp 1))
(defn cp-upper? [(cp : I32)] : Bool (cp-prop? cp 2))
(defn cp-lower? [(cp : I32)] : Bool (cp-prop? cp 4))
(defn cp-digit? [(cp : I32)] : Bool (cp-prop? cp 8))
(defn cp-space? [(cp : I32)] : Bool (cp-prop? cp 16))
(defn cp-combining? [(cp : I32)] : Bool (cp-prop? cp 32))
(defn cp-wide? [(cp : I32)] : Bool (cp-prop? cp 64))
(defn cp-punct? [(cp : I32)] : Bool (cp-prop? cp 128))
(defn cp-control? [(cp : I32)] : Bool (cp-prop? cp 256))

(defn cp-lower [(cp : I32)] : I32 (+ cp (ucd/ucd-lower-delta cp)))
(defn cp-upper [(cp : I32)] : I32 (+ cp (ucd/ucd-upper-delta cp)))

;; cp-width -- terminal columns: 0 for NUL, controls, combining marks and zero-width format
;; characters (U+200B-200F, U+2060-2064, U+FEFF); 2 for East-Asian Wide/Fullwidth; else 1.
(defn cp-width [(cp : I32)]
  : I32
  (if (or (= cp 0) (or (cp-control? cp) (cp-combining? cp))) 0
    (if (or (and (>= cp 8203) (<= cp 8207)) (or (and (>= cp 8288) (<= cp 8292)) (= cp 65279))) 0
      (if (cp-wide? cp) 2 1))))

(defn utf8-width [(s : String @ Region)]
  : I32
  (let [n (string/length s)]
    (loop [i 0 w 0]
      (if (>= i n) w
        (let [cp (utf8-decode-at s i)]
          (recur (+ i (u8-step s i)) (+ w (if (< cp 0) 1 (cp-width cp)))))))))

;; ---- case ------------------------------------------------------------------------------------
;; mode 0 = lower, 1 = upper. Malformed bytes pass through unchanged (one byte each).
(defn u8-map-cp [(cp : I32) (mode : I32)]
  : I32
  (if (= mode 0) (cp-lower cp) (cp-upper cp)))

(defn u8-map-len [(s : String @ Region) (mode : I32)]
  : I32
  (let [n (string/length s)]
    (loop [i 0 out 0]
      (if (>= i n) out
        (let [cp (utf8-decode-at s i)]
          (recur (+ i (u8-step s i))
                 (+ out (if (< cp 0) 1 (utf8-encoded-len (u8-map-cp cp mode))))))))))

;; fill: write the mapped text into `b`, return the byte length written
(defn u8-map-fill [(s : String @ Region) (mode : I32) (b : Bytes)]
  : I32
  (let [n (string/length s)]
    (loop [i 0 o 0]
      (if (>= i n) o
        (let [cp (utf8-decode-at s i)]
          (if (< cp 0)
            (do (bytes/bytes-set! b o (u8-byte-at s i))
                (recur (+ i 1) (+ o 1)))
            (let [m (u8-map-cp cp mode)
                  k (utf8-encoded-len m)]
              (do (u8-put-seq b o m k)
                  (recur (+ i (utf8-encoded-len cp)) (+ o k))))))))))

(defn u8-map [(s : String @ Region) (mode : I32) (dest : Arena @ Region)]
  : String @ Region
  (let [total (u8-map-len s mode)
        b (bytes/bytes-alloc (+ total 1) dest)]
    (do (u8-map-fill s mode b)
        (bytes/bytes-set! b total 0)
        (bytes/bytes-to-string-lossy b dest))))

(defn utf8-lower [(s : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (u8-map s 0 dest))

(defn utf8-upper [(s : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (u8-map s 1 dest))

;; utf8-eq-ci? -- equal after simple lowercase mapping, codepoint by codepoint (not full case
;; folding: "STRASSE" != "straße", matching the module's stated limit).
(defn utf8-eq-ci? [(a : String @ Region) (b : String @ Region)]
  : Bool
  (let [na (string/length a)
        nb (string/length b)]
    (loop [i 0 j 0]
      (if (and (>= i na) (>= j nb)) true
        (if (or (>= i na) (>= j nb)) false
          (let [ca (utf8-decode-at a i)
                cb (utf8-decode-at b j)]
            (if (and (>= ca 0) (>= cb 0))
              (if (= (cp-lower ca) (cp-lower cb))
                (recur (+ i (u8-step a i)) (+ j (u8-step b j)))
                false)
              (if (= (u8-byte-at a i) (u8-byte-at b j))
                (recur (+ i 1) (+ j 1))
                false))))))))
