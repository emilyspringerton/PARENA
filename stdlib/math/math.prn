;; stdlib/math/math.prn — real `math` stdlib package (founder real-time, 2026-08-30: "start
;; working on the parena ts emitter using MISHRI as proving ground" / "continue rewriting MISHRI
;; using parena using parena mods"). Renamed and grown from an original single-function
;; `random.prn` (still the exact same real, first `math/random` primitive, unchanged) once
;; MISHRI's own real `HumannessLayer.randInt`/`addNoise` needed more of the real `Math` surface --
;; one file per package, matching this stdlib's own established convention elsewhere (`string.prn`,
;; `io.prn`), not one file per function.
;;
;; Real, honest FFI-shaped gap, same class as `net/tcp`/`crypto/hash`/`sdl2` elsewhere in this
;; stdlib: none of these have a pure-PARENA implementation (VS0 has no PRNG/floating-point-math
;; primitives of its own) -- every real function below is a real host call, lowered directly by
;; whichever real backend compiles this file. The TypeScript emitter (src/emit_ts.c,
;; MATH_PRIM_TABLE) recognizes each of these exact, qualified names and lowers them straight to
;; the matching real `Math.*` call/constant; the C emitter has no equivalent mapping registered
;; yet for any of them (a real, separate, unstarted follow-up -- likely libm's own `floor`/`sqrt`/
;; `log`/`cos`/`M_PI` via `parena_runtime.h`, not attempted in this pass).
;;
;; Real signatures chosen to match JavaScript's own `Math.*` contracts exactly, deliberately, so
;; the TypeScript target's own lowering is a direct, honest 1:1 mapping, not an approximation --
;; same real reasoning `random`'s own original doc comment already gave.

(module math/math)
(export random-f64 floor sqrt log cos cos-2t sin-2t cos-3t cos-5t)

;; random-f64 -- C target FIXED 2026-09-07 (founder real-time, PAPERCRAFT Roblox-parity thread:
;; "add apis to papercraft mod surface to make skrips like this work"). Renamed from `random` to
;; `random-f64` in this same pass -- a real, found-live naming collision, not a style choice:
;; the bare mangled C symbol `random` conflicts with glibc's own `long random(void)` (declared
;; whenever `_DEFAULT_SOURCE` is active, which runtime/parena_runtime.h's own pty support
;; already requires) -- `double random(void)` vs. `long random(void)` is a real, hard
;; "conflicting types" gcc error, confirmed live compiling this exact function for the first
;; time the C target ever actually exercised it (every previous C build of a `math/random`
;; caller silently got away with the never-evaluated `0.0` placeholder body instead). The
;; TypeScript emitter's own qualified-name table (src/emit_ts.c's MATH_PRIM_TABLE) is updated in
;; the same commit to match this new name -- it still never evaluates this body, it recognizes
;; the qualified call name and lowers straight to `Math.random()`. #target calls a real, lazily
;; self-seeded runtime function (runtime/parena_runtime.h's own math_random_impl) -- see that
;; function's own doc comment for why self-seeding matters (a real PAPERCRAFT mod using this for
;; NPC spawn positions must not get the identical sequence on every server restart).
(defn random-f64 [] : F64
  #target {:c (inline-c "math_random_impl()")})

(defn floor [(x : F64)] : F64
  0.0) ;; real, honest placeholder body, same reasoning as `random` above.

(defn sqrt [(x : F64)] : F64
  0.0)

(defn log [(x : F64)] : F64
  0.0)

(defn cos [(x : F64)] : F64
  0.0)

;; `pi` is a real, recognized external CONSTANT (a bare symbol reference `math/pi`, not a call --
;; see MATH_PRIM_TABLE's own sibling doc comment in src/emit_ts.c), not a real, callable defn --
;; PARENA's own `core` has no named-constant declaration form yet (a real, separate, unstarted
;; gap), so there is no real `(defn pi ...)` to export here; `math/pi` is recognized purely by the
;; TypeScript emitter's own symbol-lowering logic. Documented here, not silently undiscoverable,
;; since this file is the real, canonical place a modder writing against the `math` package would
;; look for it.

;; Angular harmonics without trig -- real, pure-PARENA (no host call, same result on every target)
;; Chebyshev identities: given c = cos t and s = sin t of some angle t, the multiple-angle
;; cosines/sines are plain polynomials in c and s. Promoted here from SHANKPIT's per-gun bullet-hole
;; textures (stdlib/shankpit/textures/bullet_hole_*.prn, card #446, founder real-time: "look at that
;; texture cos sin cos 1 cos 2 cos 3 whatever add to PARENA math"), where each gun's hole gets its
;; lopsided silhouette from cos 2t / sin 2t / cos 3t / cos 5t of the pixel's angle, computed from
;; (x/r, y/r) so no atan2 (not in the Java-safe math subset) is ever needed.
(defn cos-2t [(c : F64) (s : F64)] : F64 (- (* c c) (* s s)))
(defn sin-2t [(c : F64) (s : F64)] : F64 (* 2.0 (* c s)))
(defn cos-3t [(c : F64)] : F64 (- (* 4.0 (* c (* c c))) (* 3.0 c)))
(defn cos-5t [(c : F64)] : F64
  (+ (- (* 16.0 (* c (* c (* c (* c c))))) (* 20.0 (* c (* c c)))) (* 5.0 c)))
