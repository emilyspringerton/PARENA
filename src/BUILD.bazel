load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")

cc_library(
    name = "arena",
    srcs = ["arena.c"],
    hdrs = ["arena.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ast",
    srcs = ["ast.c"],
    hdrs = ["ast.h"],
    deps = [":arena"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "lexer",
    srcs = ["lexer.c"],
    hdrs = ["lexer.h"],
    deps = [":arena"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "parser",
    srcs = ["parser.c"],
    hdrs = ["parser.h"],
    deps = [
        ":arena",
        ":ast",
        ":lexer",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "region",
    srcs = ["region.c"],
    hdrs = ["region.h"],
    deps = [
        ":arena",
        ":ast",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "emit",
    # ast_sugar.h is a real emitted-code dependency of emit.c (grep: emit.c, emit_llvm.c and
    # emit_ts.c all #include it), and it was only declared on emit_ts/emit_llvm -- so this
    # target could not compile under Bazel at all: `fatal error: ast_sugar.h: No such file or
    # directory` compiling src/emit.c [for tool], which in turn meant NO consumer could build
    # `@parena//src:parena` and therefore no consumer's parena_compile genrule could run.
    # Found live on 2026-11-05 building SHANKPIT's own co-located menu.prn rule.
    srcs = [
        "emit.c",
        "ast_sugar.h",
    ],
    hdrs = ["emit.h"],
    deps = [
        ":arena",
        ":ast",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "emit_ts",
    srcs = ["emit_ts.c", "ast_sugar.h"],
    hdrs = ["emit_ts.h"],
    deps = [
        ":arena",
        ":ast",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "emit_java",
    srcs = ["emit_java.c"],
    hdrs = ["emit_java.h"],
    deps = [
        ":arena",
        ":ast",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "emit_lua",
    srcs = ["emit_lua.c"],
    hdrs = ["emit_lua.h"],
    deps = [
        ":arena",
        ":ast",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "emit_llvm",
    srcs = ["emit_llvm.c", "ast_sugar.h"],
    hdrs = ["emit_llvm.h"],
    deps = [
        ":arena",
        ":ast",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "fmt",
    srcs = ["fmt.c"],
    hdrs = ["fmt.h"],
    deps = [":arena"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "parena",
    srcs = ["main.c"],
    deps = [
        ":arena",
        ":ast",
        ":emit",
        ":emit_java",
        ":emit_llvm",
        ":emit_lua",
        ":emit_ts",
        ":fmt",
        ":parser",
        ":region",
    ],
    visibility = ["//visibility:public"],
)
