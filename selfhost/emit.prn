;; selfhost/emit.prn -- the real fourth domain of PARENA's own self-
;; hosting effort (NORTHSTAR.md's own "Self-hosting" section), directly
;; continuing selfhost/lexer.prn + selfhost/parser.prn + selfhost/
;; region.prn (2026-08-27, founder real-time: "self hosted compiler" ->
;; "continue" (repeated)). VS0's own src/emit.c is the real reference
;; this file PORTS -- but src/emit.c's own CURRENT size (5000+ lines,
;; grown incrementally over many sessions to serve the whole real
;; stdlib: arithmetic, closures, match, loop/recur, Vec/Map generics,
;; every real defenum/defstruct shape) is not this file's own real
;; target. This file deliberately reproduces VS0's own ORIGINAL,
;; narrow domain-3 DoD acceptance bar instead -- src/emit.h's own real,
;; honestly-documented v0 scope: "only understands the exact shape
;; test.prn's own valid function uses (no numeric/boolean literals, no
;; arithmetic, no nested calls beyond alloc, char * is the only
;; inferred type)". Concretely: `with-arena`, `let`+`alloc` (String
;; only), a plain function call's own Arena-typed params, and a bare
;; symbol as a function's own tail (`return`) -- exactly examples/
;; valid_only.prn's own real load-config shape, the actual real DoD
;; acceptance file, verified byte-for-functionally-equivalent against
;; its own real, current `parena build` output (see tests/
;; test_selfhost_emit.c's own real, live compile-and-run verification,
;; not just a text diff -- C whitespace doesn't affect correctness).
;;
;; Same real "one real, faithful, honestly-scoped domain at a time"
;; discipline lexer/parser/region already established -- not a claim
;; of covering everything the current, much-expanded src/emit.c now
;; handles (arithmetic, match, loop, closures, generics, and dozens of
;; real stdlib-driven special cases are real, separate, unstarted
;; follow-up, same honest boundary this whole self-hosting effort has
;; drawn at every domain so far).
;;
;; Real design departures forced by VS0's own confirmed current limits
;; -- same classes already documented in lexer/parser/region's own
;; header comments:
;; 1. Every `match` used as a non-tail VALUE (a cond clause, a let-
;;    binding's own initializer) is extracted into its own small
;;    function instead, whose own body directly IS the match -- see
;;    selfhost/region.prn's own header comment (point/finding 1 in its
;;    own real bug list) for the full real reasoning: a real, confirmed
;;    VS0 emitter gap, not a stylistic choice.
;; 2. No arena-typed "is this a pointer parameter or a local Arena
;;    value" tracking via a real Scope-with-parent chain -- the same
;;    flat-Vec-scope substitute region.prn's own header comment
;;    (point 1) already documents and justifies, reused here for a
;;    DIFFERENT real question (does an arena-typed name need `&` before
;;    it in the emitted C, matching src/emit.c's own real distinction
;;    between a `with-arena`-local `Arena` value and a `defn`-level
;;    `Arena @ Region`-typed parameter, which is already `Arena *`).

(module selfhost/emit)
(import string)
(import selfhost/parser)
(export emit-program)

(defenum ArenaKind (LocalArena) (PointerArena))

(defstruct ArenaBinding
  (name : String @ Region)
  (kind : ArenaKind))

(defn emit-node-kind-code [(k : NodeType)] : I32
  (match k
    ((NList) 0) ((NVec) 1) ((NMap) 2) ((NSymbol) 3) ((NKeyword) 4)
    ((NString) 5) ((NNumber) 6) ((NColon) 7) ((NAt) 8)))

(defn emit-is-symbol? [(n : &Node) (text : String @ Region)] : Bool
  (and (= (emit-node-kind-code (get-field n :kind)) 3)
       (string/str-eq? (get-field n :text) text)))

;; Real, confirmed-live emitter gap this restructuring works around
;; (see selfhost/region.prn's own identically-named function for the
;; full real reasoning): get-field can't be called directly, inline,
;; on a bare `vec/get` result -- an explicit `let` binding first is
;; required.
(defn emit-is-symbol-headed-list? [(n : &Node)] : Bool
  (if (not (= (emit-node-kind-code (get-field n :kind)) 0))
    false
    (if (<= (vec/len &(get-field n :children)) 0)
      false
      (let [first-child (vec/get &(get-field n :children) 0)]
        (= (emit-node-kind-code (get-field first-child :kind)) 3)))))

(defn emit-is-call-named? [(n : &Node) (fn-name : String @ Region)] : Bool
  (and (emit-is-symbol-headed-list? n)
       (emit-is-symbol? (vec/get &(get-field n :children) 0) fn-name)))

;; emit-join-all / join3 -- real, private string-joining helpers, the same
;; small, deliberately-duplicated shape selfhost/region.prn's own
;; identically-named functions already establish (see that file's own
;; header comment for why duplication over a cross-module dependency).
(defn emit-join-all [(parts : &(Vec String)) (dest : Arena @ Region)] : String @ Region
  (loop [i 0 acc ""]
    (if (>= i (vec/len parts))
      acc
      (recur (+ i 1) (string/concat acc (vec/get parts i) dest)))))

(defn join3 [(a : String @ Region) (b : String @ Region) (c : String @ Region) (dest : Arena @ Region)]
  : String @ Region
  (string/concat a (string/concat b c dest) dest))

;; join-with -- joins every element of `parts` with `sep` between them
;; (no trailing separator) -- the real shape a C parameter list's own
;; ", "-separated join needs.
(defn join-with [(parts : &(Vec String)) (sep : String @ Region) (dest : Arena @ Region)] : String @ Region
  (loop [i 0 acc ""]
    (if (>= i (vec/len parts))
      acc
      (recur (+ i 1)
             (if (string/str-eq? acc "")
               (vec/get parts i)
               (join3 acc sep (vec/get parts i) dest))))))

;; mangle -- widened 2026-08-28 (real gap found while verifying
;; get-field/defstruct support: `is-origin?` emitted as the literal,
;; invalid C identifier `is_origin?`) to match src/emit.c's own real,
;; current mangle() exactly: '-', '/', '!', and trailing/mid '?' all
;; become '_' (a real, common Scheme/Lisp/Ruby-style predicate-naming
;; convention this codebase's own real source uses constantly --
;; is-symbol?, is-close-token?, vec-push!, etc -- previously blocked
;; from ever reaching a real gcc compile through the selfhost pipeline
;; specifically), PLUS a real, separate sigil: a LEADING '!' is
;; STRIPPED entirely, not converted (the mutation-marker param
;; convention `(!f : FileHandle @ :region/task)` uses, confirmed
;; directly against the reference's own real mangle()).
(defn mangle-char [(c : I32)] : I32
  (cond
    ((= c 45) 95)  ;; '-' -> '_'
    ((= c 47) 95)  ;; '/' -> '_'
    ((= c 33) 95)  ;; '!' -> '_'
    ((= c 63) 95)  ;; '?' -> '_'
    (true c)))

(defn mangle [(name : String @ Region) (dest : Arena @ Region)] : String @ Region
  (let [start (if (and (> (string/length name) 0) (= (string/char-at name 0) 33)) 1 0)]
    (loop [i start acc ""]
      (if (>= i (string/length name))
        acc
        (recur (+ i 1) (string/concat acc (string/char-from-code (mangle-char (string/char-at name i)) dest) dest))))))

;; ---- arena-kind scope: real, flat-Vec substitute (see this file's
;; own header comment, point 2) for tracking whether an arena-typed
;; name needs `&` before it in emitted C (a with-arena-local real
;; `Arena` value) or not (a defn-level `Arena @ Region` param, already
;; `Arena *`).

(defn arena-scope-lookup [(scope : &(Vec ArenaBinding)) (name : String @ Region) (dest : Arena @ Region)]
  : (Option ArenaBinding) @ Region
  (loop [i (- (vec/len scope) 1)]
    (if (< i 0)
      None
      (let [b (vec/get scope i)]
        (if (string/str-eq? (get-field (deref b) :name) name)
          (Some (deref b))
          (recur (- i 1)))))))

(defn arena-scope-extend [(scope : &(Vec ArenaBinding)) (b : ArenaBinding) (dest : Arena @ Region)]
  : (Vec ArenaBinding) @ Region
  (let [copy (vec/new dest)]
    (do
      (loop [i 0]
        (when (< i (vec/len scope))
          (do (vec/push! &copy (deref (vec/get scope i)))
              (recur (+ i 1)))))
      (vec/push! &copy b)
      copy)))

(defn arena-ref-of [(b : ArenaBinding) (c-name : String @ Region) (dest : Arena @ Region)] : String @ Region
  (match (get-field b :kind)
    ((LocalArena) (string/concat "&" c-name dest))
    ((PointerArena) c-name)))

;; resolve-arena-ref -- real, small extracted helper (a `match` used as
;; a non-tail VALUE -- see this file's own header comment, point 1):
;; the real C text an arena-typed symbol should be referenced by
;; (`&scratch` for a with-arena-local, `buf_arena` bare for a real
;; pointer param).
(defn resolve-arena-ref [(arena-text : String @ Region) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)]
  : String @ Region
  (let [c-name (mangle arena-text dest)]
    (match (arena-scope-lookup scope arena-text dest)
      ((Some b) (arena-ref-of (deref b) c-name dest))
      ((None) c-name))))

;; emit-alloc-call -- real, narrow port of the real, live `(alloc
;; arena-expr String "literal")` shape -> `arena_strdup(arena-ref,
;; "literal", byte-len)`, matching examples/valid_only.prn's own real,
;; already-verified generated output exactly.
;; alloc-call-shaped? -- real shape guard added after a real, live
;; segfault: emit-alloc-call used to be called unconditionally on
;; EVERY let-binding's own expr-node, with no check that the node was
;; actually an `alloc` call at all. vec/get's own real, honest
;; out-of-bounds convention returns NULL rather than crashing (see
;; runtime/parena_runtime.h's own vec_get) -- but emit-alloc-call then
;; unconditionally did `(get-field lit-node :text)` on that NULL,
;; which crashes at the C level (a bare struct-field dereference has
;; no NULL check, unlike vec_get). Confirmed live attempting a real
;; self-compile of selfhost/lexer.prn through this very pipeline: its
;; own real first let-binding, `(let [lx0 (selfhost/lexer/new-lexer
;; src)] ...)`, is a genuine, real, in-scope PARENA shape (a plain
;; function call, not an alloc) that this narrow v0 emitter has never
;; claimed to support (see emit-let-bindings' own header comment
;; below) -- but "unsupported" should mean a clean, honest failure,
;; not a segfault of the compiler process itself.
(defn alloc-call-shaped? [(expr-node : &Node)] : Bool
  (and (emit-is-call-named? expr-node "alloc")
       (>= (vec/len &(get-field expr-node :children)) 4)))

(defn emit-alloc-call [(call : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [arena-node (vec/get &(get-field call :children) 1)
        lit-node (vec/get &(get-field call :children) 3)
        arena-ref (resolve-arena-ref (get-field arena-node :text) scope dest)
        lit-text (get-field lit-node :text)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "arena_strdup(")
      (vec/push! &parts arena-ref)
      (vec/push! &parts ", \"")
      (vec/push! &parts lit-text)
      (vec/push! &parts "\", ")
      (vec/push! &parts (string/i32-to-string (string/length lit-text) dest))
      (vec/push! &parts ")")
      (emit-join-all &parts dest))))

;; emit-tail-symbol -- a bare symbol in tail position is this narrow
;; v0's own only real "return a value" shape (matching real-buf's own
;; real role in examples/valid_only.prn).
(defn emit-tail-symbol [(node : &Node) (dest : Arena @ Region)] : String @ Region
  (let [parts (vec/new dest)]
    (do
      (vec/push! &parts "    return ")
      (vec/push! &parts (mangle (get-field node :text) dest))
      (vec/push! &parts ";\n")
      (emit-join-all &parts dest))))

;; emit-tail-expr -- wraps an already-emitted C EXPRESSION (from
;; emit-alloc-call/emit-plain-call, both real, existing let-binding-
;; value emitters that already return a plain expression string, not a
;; statement) into a real `    return <expr>;\n` -- the same real shape
;; emit-tail-symbol's own body already uses for a bare symbol tail,
;; just generic over WHICH expression string it wraps, so emit-form's
;; own two new tail-position cases below (2026-08-28, real gap found
;; and closed while verifying build-files: a bare `alloc` call or a
;; plain function call as a defn's ENTIRE body previously fell through
;; to emit-tail-symbol, which only correctly handles a bare symbol,
;; silently emitting an empty `return ;` for anything else) don't each
;; need their own copy of this 3-line wrap.
(defn emit-tail-expr [(expr-c : String @ Region) (dest : Arena @ Region)] : String @ Region
  (let [parts (vec/new dest)]
    (do
      (vec/push! &parts "    return ")
      (vec/push! &parts expr-c)
      (vec/push! &parts ";\n")
      (emit-join-all &parts dest))))

;; ---- Real, narrow, TAIL-POSITION-ONLY `cond` support (2026-08-28) ----
;;
;; region.prn's own handle-symbol-headed-call header comment already
;; names the real, deep architectural reason match/cond are hard as a
;; NON-TAIL value (a let-binding's own initializer, a plain sub-
;; expression): their real value production is fundamentally
;; STATEMENT-shaped -- real if/else blocks -- which can't be embedded
;; inside a single C ternary/expression the way a plain call can,
;; without something like GCC's own statement-expression extension
;; (genuinely incompatible with this whole repo's -std=c99 -pedantic
;; discipline). But in TAIL position -- which is exactly what
;; emit-form itself already handles, the ONLY place this dispatches
;; from -- a real if/else-if/else CHAIN is genuinely tractable: every
;; clause's own result is already a real, complete STATEMENT (a
;; `return`, via emit-form itself, recursively) once wrapped, no
;; ternary or expression-position value needed at all.
;;
;; Real, honest, narrow v0 scope: `match` (defenum tag dispatch, needs
;; a real tag registry this emitter doesn't have yet) is NOT attempted
;; here, `cond` only. A test is either a real binary-op-call-shaped?
;; comparison (`(= n 1)`), a bare symbol (a Bool-typed variable,
;; referenced truthily), or the literal `true` -- an `or`/`and`/`not`
;; compound test, or a plain-call-shaped? predicate call, are real,
;; separate, not attempted here (cond-call-shaped? returns false for
;; those, falling back to the existing plain-call/alloc/symbol
;; dispatch, or ultimately emit-tail-symbol's own honest, if wrong-
;; looking, fallback -- never a crash, never a guess). The LAST clause
;; MUST be `(true ...)` -- this codebase's own real, universal cond
;; convention already, and the only way this narrow v0 can guarantee
;; the emitted if/else chain is exhaustive (a real, separate "control
;; reaches end of non-void function" problem otherwise).

;; ---- Real, narrow, RECURSIVE boolean-expression sub-language
;; (2026-08-28) -- used by cond's own test position below, and any
;; other real boolean-context use this file might grow later. A real,
;; separate, additive extension of cond-test's own original scope (a
;; bare comparison or symbol) to also recognize `or`/`and` (binary --
;; this codebase's own real convention, confirmed via is-close-token?'s
;; own real body, nests PAIRS rather than writing a variadic N-ary
;; call) and `not` (unary), each RECURSIVELY composing further
;; bool-expr-supported? sub-expressions. This deliberately does NOT
;; generalize to arbitrary nested calls as arguments (a real, separate,
;; harder gap this file's own header comments elsewhere already flag,
;; since a general nested call needs real box/unbox type-tracking this
;; emitter doesn't have) -- a boolean/test-context expression sidesteps
;; that entirely: it never crosses this file's own char*-boxing
;; boundary at all, a real C `if (...)`/`||`/`&&`/`!` condition just
;; wants a raw int, the same as before.
(defn bool-expr-supported? [(node : &Node) (dest : Arena @ Region)] : Bool
  (cond
    ((emit-is-symbol? node "true") true)
    ((binary-op-call-shaped? node dest) true)
    ((= (emit-node-kind-code (get-field node :kind)) 3) true)
    ((or-and-shaped? node dest) true)
    ((not-shaped? node dest) true)
    ;; Real, additive case (2026-08-28): a plain-call-shaped? predicate
    ;; function call (e.g. `(is-symbol? node "defn")`) as a boolean
    ;; test -- needs NO new unboxing helper, since a Bool-returning
    ;; function's own body already goes through this file's real,
    ;; existing boxing convention on the CALLEE side (a comparison body
    ;; boxes via emit-i32-boxed in emit-form's own binary-op-call-
    ;; shaped? branch, so 0/1 becomes a real NULL/non-NULL char*) --
    ;; and a real C `if (some_char_star_expr)` already treats a
    ;; non-NULL pointer as truthy, exactly right, with zero extra
    ;; casting needed at the CALL site. Recursion through or-and-
    ;; shaped?/not-shaped? above means this also composes for free
    ;; inside `(and (is-foo? x) (is-bar? y))`-shaped tests.
    (true (plain-call-shaped? node dest))))

;; or-and-shaped? -- a real, exactly-2-argument `(or a b)`/`(and a b)`
;; call, both operands themselves real bool-expr-supported?
;; sub-expressions.
(defn or-and-shaped? [(node : &Node) (dest : Arena @ Region)] : Bool
  (if (not (or (emit-is-call-named? node "or") (emit-is-call-named? node "and")))
    false
    (if (not (= (vec/len &(get-field node :children)) 3))
      false
      (and (bool-expr-supported? (vec/get &(get-field node :children) 1) dest)
           (bool-expr-supported? (vec/get &(get-field node :children) 2) dest)))))

;; not-shaped? -- a real, exactly-1-argument `(not a)` call, its own
;; operand itself a real bool-expr-supported? sub-expression.
(defn not-shaped? [(node : &Node) (dest : Arena @ Region)] : Bool
  (if (not (emit-is-call-named? node "not"))
    false
    (if (not (= (vec/len &(get-field node :children)) 2))
      false
      (bool-expr-supported? (vec/get &(get-field node :children) 1) dest))))

;; emit-bool-op -- shared 2-operand emitter for both `(or a b)` ->
;; `(a || b)` and `(and a b)` -> `(a && b)`, op-c naming which real C
;; operator this particular call uses.
(defn emit-bool-op [(node : &Node) (op-c : String @ Region) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [lhs (emit-bool-expr (vec/get &(get-field node :children) 1) scope dest)
        rhs (emit-bool-expr (vec/get &(get-field node :children) 2) scope dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "(")
      (vec/push! &parts lhs)
      (vec/push! &parts " ")
      (vec/push! &parts op-c)
      (vec/push! &parts " ")
      (vec/push! &parts rhs)
      (vec/push! &parts ")")
      (emit-join-all &parts dest))))

(defn emit-not [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [operand-c (emit-bool-expr (vec/get &(get-field node :children) 1) scope dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "(!")
      (vec/push! &parts operand-c)
      (vec/push! &parts ")")
      (emit-join-all &parts dest))))

;; emit-bool-expr -- a real boolean/test-context expression, emitted
;; as a plain C boolean/int expression (needs no boxing at all, unlike
;; a scalar crossing this emitter's own uniform char* value/return
;; boundary elsewhere in this file). `true` maps to the literal `1` --
;; <stdbool.h> is never included, so the bare identifier `true` isn't
;; real C here.
(defn emit-bool-expr [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (cond
    ((emit-is-symbol? node "true") "1")
    ((binary-op-call-shaped? node dest) (emit-binary-op node scope dest))
    ((emit-is-call-named? node "or") (emit-bool-op node "||" scope dest))
    ((emit-is-call-named? node "and") (emit-bool-op node "&&" scope dest))
    ((emit-is-call-named? node "not") (emit-not node scope dest))
    ((plain-call-shaped? node dest) (emit-plain-call node scope dest))
    (true (resolve-arena-ref (get-field node :text) scope dest))))

(defn cond-clause-shaped? [(clause : &Node) (dest : Arena @ Region)] : Bool
  (if (not (= (emit-node-kind-code (get-field clause :kind)) 0))
    false
    (if (not (= (vec/len &(get-field clause :children)) 2))
      false
      (bool-expr-supported? (vec/get &(get-field clause :children) 0) dest))))

(defn all-clauses-shaped? [(node : &Node) (i : I32) (dest : Arena @ Region)] : Bool
  (if (>= i (vec/len &(get-field node :children)))
    true
    (if (cond-clause-shaped? (vec/get &(get-field node :children) i) dest)
      (all-clauses-shaped? node (+ i 1) dest)
      false)))

(defn last-clause-is-true? [(node : &Node)] : Bool
  (let [n (vec/len &(get-field node :children))
        last-clause (vec/get &(get-field node :children) (- n 1))
        test-node (vec/get &(get-field last-clause :children) 0)]
    (emit-is-symbol? test-node "true")))

;; cond-call-shaped? -- a real `(cond (test result) ... (true
;; result))` call this narrow emitter can now support: symbol-headed
;; "cond", at least one real clause, every clause a real 2-child list
;; with a supported test, and the LAST clause's own test literally
;; `true`.
(defn cond-call-shaped? [(node : &Node) (dest : Arena @ Region)] : Bool
  (and (emit-is-call-named? node "cond")
       (and (> (vec/len &(get-field node :children)) 1)
            (and (all-clauses-shaped? node 1 dest)
                 (last-clause-is-true? node)))))

;; emit-cond-clauses -- real, recursive if/else-if/else chain builder.
;; A non-last clause emits `if (test) {\n<result>    } else ` and
;; appends the NEXT clause's own text directly (no extra "else" of its
;; own -- the CALLER'S trailing "else " already supplies it, chaining
;; into either the next `if (...)` or the final bare `{...}` block).
;; The final `(true ...)` clause emits a bare `{\n<result>    }\n`, no
;; `if`/`else` of its own, matching that expectation exactly. Each
;; clause's own RESULT is emitted via emit-form itself, recursively --
;; the same shared entry point every other tail-position case already
;; goes through, so a clause result that's itself a nested with-arena/
;; let/alloc/binary-op/plain-call/cond all just work, for free.
(defn emit-cond-clauses [(node : &Node) (i : I32) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [clause (vec/get &(get-field node :children) i)
        test-node (vec/get &(get-field clause :children) 0)
        result-node (vec/get &(get-field clause :children) 1)
        is-last (= (+ i 1) (vec/len &(get-field node :children)))
        result-c (emit-form result-node scope dest)
        parts (vec/new dest)]
    (if is-last
      (do
        (vec/push! &parts "{\n")
        (vec/push! &parts result-c)
        (vec/push! &parts "    }\n")
        (emit-join-all &parts dest))
      (let [test-c (emit-bool-expr test-node scope dest)
            rest-c (emit-cond-clauses node (+ i 1) scope dest)]
        (do
          (vec/push! &parts "if (")
          (vec/push! &parts test-c)
          (vec/push! &parts ") {\n")
          (vec/push! &parts result-c)
          (vec/push! &parts "    } else ")
          (vec/push! &parts rest-c)
          (emit-join-all &parts dest))))))

(defn emit-cond [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [parts (vec/new dest)]
    (do
      (vec/push! &parts "    ")
      (vec/push! &parts (emit-cond-clauses node 1 scope dest))
      (emit-join-all &parts dest))))

;; ---- Real, narrow, TAIL-POSITION-ONLY Result/Option `match` support
;; (2026-08-28) ----
;;
;; A real, deliberately-narrow first slice of `match` itself (see this
;; file's own earlier header comment above, right before bool-expr-
;; supported?'s own section: "match ... needs a real tag registry this
;; emitter doesn't have yet" -- NOT attempted for cond's own v0).
;; Building a general user-defenum tag registry (tracking every real
;; defenum's own constructor -> tag-number mapping across a whole
;; build, arbitrary payload arity) is real, separate, harder work. This
;; v0 instead hardcodes the ONE real tag mapping essentially every real
;; match in this entire stdlib already relies on without ever
;; declaring it itself -- Result's `Ok`/`Err` and Option's
;; `Some`/`None`, VS0's own two BUILTIN two-variant enums (confirmed
;; live: runtime/parena_runtime.h's own result_ok/result_err/
;; option_some/option_none, tag 1 = Ok/Some, tag 0 = Err/None) --
;; covering the overwhelmingly dominant real match usage across this
;; whole stdlib (json.prn, io.prn, shell.prn, textmate_loader.prn, ...
;; every one of them Result/Option, never a user defenum, this session).
;; A real user-defenum match (this very file's own `emit-node-kind-
;; code` above, matching its own NodeType) is real, separate,
;; not-yet-started follow-up.
;;
;; Same real "no shared result_var, each clause directly `return`s"
;; simplification cond's own v0 already uses and explains (tail-
;; position-only means each branch's own return already fully resolves
;; the enclosing function's own control flow) -- but match adds one
;; real new wrinkle cond never had: the scrutinee's own emitted
;; expression needs evaluating exactly ONCE into a real C local (its
;; `.tag` is tested, its `.value` is read for the bound payload) -- so
;; the whole match ALWAYS wraps itself in a fresh `{ ... }` C block,
;; giving every match its own real, safely-shadowable block scope, so
;; a single fixed local name (`__match_scrutinee`) is genuinely safe
;; even when matches nest (sibling cond clauses, or a match inside a
;; cond clause) -- no gensym/counter infrastructure needed.
;;
;; Real, honest, narrow v0 scope: scrutinee is a bare symbol (an
;; already-bound Result/Option local) or a real plain-call-shaped?
;; call -- exactly the two shapes this file already has an expression-
;; position emitter for. Exactly 2 clauses, covering both tags {0, 1}
;; (never the same tag twice). A clause's own pattern is either a bare
;; `None` (no payload, matching this whole stdlib's own real, confirmed
;; convention: the zero-arg builtin variant is never written `(None)`)
;; or a 2-child list like `(Ok x)`/`(Err e)`/`(Some s)` (payload bound
;; to a real, new, block-scoped `void *` local). A clause's own RESULT
;; is emitted via emit-form itself, recursively -- same shared entry
;; point cond's own clauses already go through, so a nested with-arena/
;; let/alloc/binary-op/plain-call/cond/match result all just work, for
;; free. Using the bound payload itself inside a clause body beyond a
;; bare-symbol tail (e.g. `(get-field (deref x) :foo)`) needs real
;; `deref`-form emission this file doesn't have yet either -- a real,
;; separate, not-yet-started gap, not silently miscompiled here: it
;; falls through to this file's own existing, already-honest final
;; emit-form fallback the exact same way any other unsupported clause-
;; body shape already does.
(defn pattern-tag [(name : String @ Region)] : I32
  (cond
    ((or (string/str-eq? name "Ok") (string/str-eq? name "Some")) 1)
    ((or (string/str-eq? name "Err") (string/str-eq? name "None")) 0)
    (true -1)))

(defn match-pattern-name [(pattern : &Node)] : String @ Region
  (if (= (emit-node-kind-code (get-field pattern :kind)) 3)
    (get-field pattern :text)
    (let [head (vec/get &(get-field pattern :children) 0)]
      (get-field head :text))))

(defn match-pattern-has-payload? [(pattern : &Node)] : Bool
  (= (emit-node-kind-code (get-field pattern :kind)) 0))

(defn match-pattern-payload-name [(pattern : &Node)] : String @ Region
  (let [payload (vec/get &(get-field pattern :children) 1)]
    (get-field payload :text)))

(defn match-clause-shaped? [(clause : &Node)] : Bool
  (if (not (= (emit-node-kind-code (get-field clause :kind)) 0))
    false
    (if (not (= (vec/len &(get-field clause :children)) 2))
      false
      (>= (pattern-tag (match-pattern-name (vec/get &(get-field clause :children) 0))) 0))))

(defn match-scrutinee-supported? [(node : &Node) (dest : Arena @ Region)] : Bool
  (or (= (emit-node-kind-code (get-field node :kind)) 3)
      (plain-call-shaped? node dest)))

;; result-or-option-match-shaped? -- real, exhaustive-over-{0,1} check:
;; symbol-headed "match", a supported scrutinee, EXACTLY 2 clauses,
;; both real match-clause-shaped?, and their own two tags together
;; cover {0, 1} (never the same tag twice -- catches a real mistake
;; like two `Ok` clauses rather than silently mis-compiling it).
(defn result-or-option-match-shaped? [(node : &Node) (dest : Arena @ Region)] : Bool
  (if (not (emit-is-call-named? node "match"))
    false
    (if (not (= (vec/len &(get-field node :children)) 4))
      false
      (if (not (match-scrutinee-supported? (vec/get &(get-field node :children) 1) dest))
        false
        (let [clause-a (vec/get &(get-field node :children) 2)
              clause-b (vec/get &(get-field node :children) 3)]
          (if (not (and (match-clause-shaped? clause-a) (match-clause-shaped? clause-b)))
            false
            (let [tag-a (pattern-tag (match-pattern-name (vec/get &(get-field clause-a :children) 0)))
                  tag-b (pattern-tag (match-pattern-name (vec/get &(get-field clause-b :children) 0)))]
              (not (= tag-a tag-b)))))))))

(defn emit-match-scrutinee [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (if (= (emit-node-kind-code (get-field node :kind)) 3)
    (mangle (get-field node :text) dest)
    (emit-plain-call node scope dest)))

(defn emit-match-clause-body [(clause : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [pattern (vec/get &(get-field clause :children) 0)
        result-node (vec/get &(get-field clause :children) 1)
        result-c (emit-form result-node scope dest)]
    (if (match-pattern-has-payload? pattern)
      (let [payload-name (mangle (match-pattern-payload-name pattern) dest)
            parts (vec/new dest)]
        (do
          (vec/push! &parts "    void *")
          (vec/push! &parts payload-name)
          (vec/push! &parts " __attribute__((unused)) = __match_scrutinee.value;\n")
          (vec/push! &parts result-c)
          (emit-join-all &parts dest)))
      result-c)))

(defn match-uses-result? [(clause : &Node)] : Bool
  (let [name (match-pattern-name (vec/get &(get-field clause :children) 0))]
    (or (string/str-eq? name "Ok") (string/str-eq? name "Err"))))

(defn emit-match [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [scrutinee-node (vec/get &(get-field node :children) 1)
        clause-a (vec/get &(get-field node :children) 2)
        clause-b (vec/get &(get-field node :children) 3)
        tag-a (pattern-tag (match-pattern-name (vec/get &(get-field clause-a :children) 0)))
        ok-clause (if (= tag-a 1) clause-a clause-b)
        err-clause (if (= tag-a 1) clause-b clause-a)
        c-type (if (match-uses-result? clause-a) "Result" "Option")
        scrutinee-c (emit-match-scrutinee scrutinee-node scope dest)
        ok-c (emit-match-clause-body ok-clause scope dest)
        err-c (emit-match-clause-body err-clause scope dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "    {\n")
      (vec/push! &parts "    ")
      (vec/push! &parts c-type)
      (vec/push! &parts " __match_scrutinee = ")
      (vec/push! &parts scrutinee-c)
      (vec/push! &parts ";\n")
      (vec/push! &parts "    if (__match_scrutinee.tag == 1) {\n")
      (vec/push! &parts ok-c)
      (vec/push! &parts "    } else {\n")
      (vec/push! &parts err-c)
      (vec/push! &parts "    }\n")
      (vec/push! &parts "    }\n")
      (emit-join-all &parts dest))))

;; ---- Real, narrow Result/Option CONSTRUCTION support (2026-08-28) ----
;;
;; The real, direct complement to match support above -- closes the
;; "constructing an Ok/Err/Some/None value from PARENA itself" gap
;; NORTHSTAR.md's own Self-hosting section flagged the moment match
;; landed (also named explicitly in driver_match.c's own header
;; comment). Together they complete a real round trip: a function can
;; now both PRODUCE and CONSUME a Result/Option entirely within this
;; emitter's own real domain, not just consume one already constructed
;; in hand-written C.
;;
;; Mirrors src/emit.c's own real Ok/Err/Some handling (is_call_named on
;; each of the 3 names, `result_ok(inner)`/`result_err(inner)`/
;; `option_some(inner)`) and bare `None` -> `option_none()` -- but
;; narrower: src/emit.c boxes a non-pointer payload into a real,
;; per-type heap cell via a generated `_box` helper (ensure_box_helper)
;; whenever the payload's own C type isn't already pointer-shaped; this
;; file has no such helper-generation infrastructure yet. Real, honest
;; v0 scope: the payload must ALREADY be pointer-shaped -- a bare
;; symbol, a get-field-shaped? struct-field read, or a plain-call-
;; shaped? function call, the exact same 3 shapes this file's own
;; uniform char*-typed convention already makes pointer-shaped with no
;; boxing needed. An I32 payload is deliberately NOT supported here --
;; this file's own emit-i32-boxed reinterprets a raw int as a real
;; pointer VALUE via `(char *)(intptr_t)n`, a technique that only stays
;; safe for THIS file's own uniform char*-return/let-value convention
;; (every caller unboxes the identical way, `(int)(intptr_t)result`);
;; reusing it here would hand the runtime's own real `result_ok`/
;; `option_some` a bogus, non-dereferenceable "pointer" that a later
;; real `deref` (this stdlib's own real, established convention for
;; reading a boxed scalar Result/Option payload) would crash
;; dereferencing -- a real, separate, harder gap (needs a genuine
;; per-type heap box, the same real infrastructure src/emit.c's own
;; ensure_box_helper provides and this file doesn't have yet), not
;; attempted here.
(defn result-option-payload-supported? [(node : &Node) (dest : Arena @ Region)] : Bool
  (or (= (emit-node-kind-code (get-field node :kind)) 3)
      (or (get-field-shaped? node) (plain-call-shaped? node dest))))

(defn emit-result-option-payload [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (cond
    ((get-field-shaped? node) (emit-get-field node scope dest))
    ((plain-call-shaped? node dest) (emit-plain-call node scope dest))
    (true (resolve-arena-ref (get-field node :text) scope dest))))

;; result-option-ctor-shaped? -- a real `(Ok expr)`/`(Err expr)`/
;; `(Some expr)` call: exactly 2 children, a supported payload (see
;; above). Checked and dispatched BEFORE plain-call-shaped? everywhere
;; both are wired in (emit-form/emit-let-value below) -- `Ok`/`Err`/
;; `Some` would otherwise also satisfy plain-call-shaped?'s own shape
;; guard (nothing in that check excludes these 3 names), which would
;; silently emit a call to a real, never-defined C function literally
;; named `Ok`/`Err`/`Some` instead of the real runtime constructor.
(defn result-option-ctor-shaped? [(node : &Node) (dest : Arena @ Region)] : Bool
  (if (not (emit-is-symbol-headed-list? node))
    false
    (let [fn-node (vec/get &(get-field node :children) 0)
          fn-text (get-field fn-node :text)]
      (if (not (or (string/str-eq? fn-text "Ok")
                   (or (string/str-eq? fn-text "Err") (string/str-eq? fn-text "Some"))))
        false
        (if (not (= (vec/len &(get-field node :children)) 2))
          false
          (result-option-payload-supported? (vec/get &(get-field node :children) 1) dest))))))

(defn result-option-ctor-runtime-fn [(fn-text : String @ Region)] : String @ Region
  (cond
    ((string/str-eq? fn-text "Ok") "result_ok")
    ((string/str-eq? fn-text "Err") "result_err")
    (true "option_some")))

(defn emit-result-option-ctor [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [fn-node (vec/get &(get-field node :children) 0)
        fn-text (get-field fn-node :text)
        runtime-fn (result-option-ctor-runtime-fn fn-text)
        payload-c (emit-result-option-payload (vec/get &(get-field node :children) 1) scope dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts runtime-fn)
      (vec/push! &parts "(")
      (vec/push! &parts payload-c)
      (vec/push! &parts ")")
      (emit-join-all &parts dest))))

;; none-shaped? -- a bare `None` symbol, the real zero-arg builtin
;; Option variant (never written `(None)`, same real, confirmed
;; convention pattern-tag's own header comment above already
;; documents).
(defn none-shaped? [(node : &Node)] : Bool
  (emit-is-symbol? node "None"))

(defn emit-form [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (cond
    ((emit-is-call-named? node "with-arena") (emit-with-arena node scope dest))
    ((emit-is-call-named? node "let") (emit-let node scope dest))
    ;; Real, additive tail-position cases (2026-08-28): a bare `alloc`
    ;; call, a bare binary-op expression, a real cond-call-shaped?
    ;; `cond`, or a plain-call-shaped function call as the WHOLE body
    ;; (not wrapped in with-arena/let) now emits real C instead of
    ;; silently falling through to emit-tail-symbol's own bare-symbol-
    ;; only shape. Same real dispatch order emit-let-value already
    ;; establishes for the alloc/binary-op/plain-call shapes in a
    ;; let-binding's own value position (alloc checked first as the
    ;; narrowest, most specific check); cond is tail-position-ONLY (see
    ;; its own header comment above), so it's never wired into
    ;; emit-let-value at all.
    ((alloc-call-shaped? node) (emit-tail-expr (emit-alloc-call node scope dest) dest))
    ((binary-op-call-shaped? node dest) (emit-tail-expr (emit-i32-boxed (emit-binary-op node scope dest) dest) dest))
    ((cond-call-shaped? node dest) (emit-cond node scope dest))
    ;; Real, additive tail-position case (2026-08-28): a real, narrow
    ;; Result/Option `match` (see its own section header comment
    ;; above, right before pattern-tag, for the full real scope).
    ((result-or-option-match-shaped? node dest) (emit-match node scope dest))
    ;; Real, additive tail-position cases (2026-08-28, the direct
    ;; complement to match support above): a real `(Ok expr)`/
    ;; `(Err expr)`/`(Some expr)` construction, or a bare `None` --
    ;; checked BEFORE plain-call-shaped? below (result-option-ctor-
    ;; shaped?'s own header comment explains why order matters here).
    ((result-option-ctor-shaped? node dest) (emit-tail-expr (emit-result-option-ctor node scope dest) dest))
    ((none-shaped? node) (emit-tail-expr "option_none()" dest))
    ;; Real, additive case (2026-08-28, closing a gap flagged the same
    ;; day while building the cond/get-field work above): a bare
    ;; `or`/`and`/`not` expression as the WHOLE body (not inside a
    ;; cond's own test position -- bool-expr-supported?/emit-bool-expr
    ;; were only ever reached from THAT dispatch until now) -- e.g.
    ;; `(defn is-origin? [(p : Point)] : Bool (and (= (get-field p :x)
    ;; 0) (= (get-field p :y) 0)))`, a real, natural predicate-function
    ;; shape found not working while verifying defstruct/get-field.
    ;; Boxed via emit-i32-boxed, same real reason binary-op-call-
    ;; shaped?'s own comparison results already are -- or/and/not
    ;; always produce a real, raw C int (0/1), never a String.
    ((or-and-shaped? node dest) (emit-tail-expr (emit-i32-boxed (emit-bool-expr node scope dest) dest) dest))
    ((not-shaped? node dest) (emit-tail-expr (emit-i32-boxed (emit-bool-expr node scope dest) dest) dest))
    ;; Real, additive case (2026-08-28, struct field-read support): a
    ;; bare `(get-field p :x)` as the WHOLE body -- a real struct
    ;; accessor function's own natural shape. Boxed via emit-i32-boxed
    ;; the same way a bare binary-op/number-literal result already is
    ;; -- real, honest, narrow v0: this assumes an I32/Bool-shaped
    ;; field (this file's own only real, exercised defstruct field
    ;; types so far, see that section's own header comment); a
    ;; String/F64/Arena-typed field accessed this way would be WRONGLY
    ;; boxed here -- a real, separate, narrower-still gap, not
    ;; attempted (get-field as a CALL-ARGUMENT, this feature's own
    ;; primary, already-verified use via emit-call-arg, is correct
    ;; regardless of the field's real type, since that position never
    ;; boxes at all).
    ((get-field-shaped? node) (emit-tail-expr (emit-i32-boxed (emit-get-field node scope dest) dest) dest))
    ((plain-call-shaped? node dest) (emit-tail-expr (emit-plain-call node scope dest) dest))
    ;; Real, separate gap found and closed 2026-08-28 while verifying
    ;; cond support: a bare NUMBER literal as a tail-position result
    ;; (a real cond clause's own `10`, or any defn whose whole body is
    ;; just a literal) fell through to emit-tail-symbol, which emits
    ;; the literal's own raw text verbatim -- a real, unboxed C `int`
    ;; returned from a `char *`-declared function, the identical real
    ;; -Wint-conversion this file's own emit-i32-boxed already exists
    ;; to fix for binary-op results. Boxed the same way here.
    ((= (emit-node-kind-code (get-field node :kind)) 6) (emit-tail-expr (emit-i32-boxed (get-field node :text) dest) dest))
    (true (emit-tail-symbol node dest))))

;; is-vec-call? -- the one real exclusion plain-call-shaped? makes,
;; the same real reason src/emit.c's own mangle_call_name excludes
;; `vec/`-qualified calls from its own bare-name resolution: `vec` is
;; a real, hardcoded RUNTIME pseudo-module (parena_runtime.h's own
;; comment -- its function names were deliberately chosen to already
;; match `mangle`'s own full-text output), not a real, registered
;; `.prn` module this narrow emitter could ever disambiguate from a
;; real user-defined bare name the way the C reference's own
;; find_defn_return_type registry does. Left unsupported here rather
;; than risk emitting a wrong call.
(defn is-vec-call? [(fn-text : String @ Region) (dest : Arena @ Region)] : Bool
  (and (>= (string/length fn-text) 4)
       (string/str-eq? (string/substring fn-text 0 4 dest) "vec/")))

;; every-call-arg-symbol-or-number? -- widened 2026-08-28 (real gap
;; named but not fixed in this file's own header comment history, and
;; in NORTHSTAR.md's own Self-hosting section: "no nested calls, no
;; literals"). A real NUMBER literal argument (kind NNumber, code 6)
;; needs no special handling at emission time -- emit-call-arg already
;; just reads the node's own real :text and mangles it (a no-op for
;; digits, no hyphens to replace), the exact same path a bare symbol
;; already goes through -- so widening the SHAPE GUARD here is the
;; whole real fix; emit-call-arg itself is untouched.
;; get-field-shaped? / emit-get-field -- real, narrow struct
;; field-read support (2026-08-28, the other real half of top-level
;; defstruct support, see that section's own header comment): a real
;; `(get-field target :field)` call -- exactly 3 children, target
;; itself a bare symbol (this narrow v0's own real scope; get-field on
;; a NESTED expression, e.g. `(get-field (get-other) :x)`, is a real,
;; separate, harder case, not attempted here). `:field`'s own real
;; node text carries the leading colon (confirmed directly: kind
;; NKeyword, text literally ":x") -- stripped before mangling.
;; Deliberately emits a RAW C expression (`(p).x`), matching the
;; reference compiler's own real, confirmed generated shape exactly --
;; never boxed here, since a call-argument position (this function's
;; own real, primary use, via emit-call-arg below) never crosses this
;; emitter's own char*-boxing boundary at all (a param already carries
;; its own real, correctly-inferred C type, same reasoning
;; binary-op-call-shaped?'s own bare-symbol/number arguments already
;; rely on). Used in a return/let-value position DOES still need
;; boxing -- handled at THOSE call sites instead (emit-form/
;; emit-let-value), not here, so this one function stays correct for
;; every real position it's used from.
(defn get-field-shaped? [(node : &Node)] : Bool
  (if (not (emit-is-call-named? node "get-field"))
    false
    (if (not (= (vec/len &(get-field node :children)) 3))
      false
      (let [target-node (vec/get &(get-field node :children) 1)]
        (= (emit-node-kind-code (get-field target-node :kind)) 3)))))

(defn emit-get-field [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [target-node (vec/get &(get-field node :children) 1)
        field-node (vec/get &(get-field node :children) 2)
        target-c (resolve-arena-ref (get-field target-node :text) scope dest)
        field-text (get-field field-node :text)
        field-name (string/substring field-text 1 (string/length field-text) dest)
        field-c (mangle field-name dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "(")
      (vec/push! &parts target-c)
      (vec/push! &parts ").")
      (vec/push! &parts field-c)
      (emit-join-all &parts dest))))

;; every-call-arg-symbol-or-number? -- widened again 2026-08-28 (real
;; struct-field-read support): a real get-field-shaped? call
;; (`(get-field p :x)`) is now also a valid call argument -- emit-
;; call-arg below already knows how to emit it as a raw, correctly-
;; typed C expression, no boxing needed at this position (see
;; get-field-shaped?'s own header comment for the full real reasoning).
;;
;; Widened a THIRD time, same day: a NESTED CALL as an argument
;; (`(f (g x))`) -- real, honest, repeatedly-named-but-not-fixed gap
;; (NORTHSTAR.md's own Self-hosting section, this function's own prior
;; two header-comment entries above) -- closes now. A nested argument
;; is accepted when it's itself plain-call-shaped? (`(g x)`, emitted
;; via emit-plain-call as a real `mangled_g(x)` call expression) or
;; binary-op-call-shaped? (`(+ a b)`, emitted via emit-binary-op as a
;; real `(a + b)` expression) -- both real, existing expression
;; emitters this file already trusts for a WHOLE function body/let-
;; value; the only real, new part is calling them from a CALL-ARGUMENT
;; position too. Neither needs boxing here: a nested plain-call's own
;; real return type is whatever the callee's OWN real, declared C type
;; is (matching this position's own pre-existing "the outer callee's
;; declared param type governs, this emitter doesn't box arguments"
;; rule bare-symbol/number arguments already rely on); a nested
;; binary-op's own raw C int is likewise passed as-is, correct exactly
;; when the outer callee's own param is itself I32-typed (`int `) --
;; the same real, honest, no-cross-function-type-checking limitation
;; this whole narrow emitter already has everywhere else. This makes
;; every-call-arg-symbol-or-number?, plain-call-shaped?, and binary-
;; op-call-shaped? real, mutual recursion (a nested call's own
;; arguments get the identical real check, recursively, all the way
;; down) -- safe and terminating since a real, parsed Node tree is
;; always finite.
;;
;; Widened a FOURTH time, same day: a nested `alloc` call as an
;; argument (`(f (alloc dest String "lit"))`) -- the ONE real
;; exclusion the prior widening's own header comment named as still
;; open (`alloc` needs its own real, distinguished Arena-destination
;; argument, unlike an ordinary function call). Turns out that's not
;; actually a real obstacle here: `alloc-call-shaped?`/
;; `emit-alloc-call` already take the exact same `scope`/`dest`
;; every other expression emitter in this file does, and the Arena to
;; allocate into is always named EXPLICITLY in the `alloc` call's own
;; syntax (`(alloc arena-expr String "lit")`) -- nothing about being
;; called from a call-ARGUMENT position instead of a let-value/tail
;; position changes what Arena it targets. `emit-alloc-call`'s own
;; real return (`arena_strdup(...)`) is always pointer-shaped
;; (`char *`), so -- like get-field/plain-call, unlike binary-op --
;; there is no boxing ambiguity to worry about at this position
;; either.
(defn every-call-arg-symbol-or-number? [(call : &Node) (i : I32) (dest : Arena @ Region)] : Bool
  (if (>= i (vec/len &(get-field call :children)))
    true
    (let [arg-node (vec/get &(get-field call :children) i)
          k (emit-node-kind-code (get-field arg-node :kind))]
      (if (or (or (or (or (= k 3) (= k 6)) (get-field-shaped? arg-node))
                  (or (plain-call-shaped? arg-node dest) (binary-op-call-shaped? arg-node dest)))
              (alloc-call-shaped? arg-node))
        (every-call-arg-symbol-or-number? call (+ i 1) dest)
        false))))

;; binary-op-symbol? / c-operator-text -- the real, narrow list of
;; arithmetic/comparison operators this emitter can now emit as real C
;; infix syntax (2026-08-28, closing the other real half of the same
;; "no literals" gap): `+`/`-`/`*`/`/` and the 4 real comparisons
;; already used pervasively throughout this very codebase's own real
;; source (region.prn/emit.prn's own many `(>= i n)`/`(= a b)`
;; checks). `=` is PARENA's own equality symbol but real C equality is
;; `==` -- every other operator already matches its own real C
;; spelling verbatim, so only that one needs translating.
(defn binary-op-symbol? [(sym : String @ Region)] : Bool
  (or (string/str-eq? sym "+")
      (or (string/str-eq? sym "-")
          (or (string/str-eq? sym "*")
              (or (string/str-eq? sym "/")
                  (or (string/str-eq? sym "=")
                      (or (string/str-eq? sym ">=")
                          (or (string/str-eq? sym "<=")
                              (or (string/str-eq? sym ">")
                                  (string/str-eq? sym "<"))))))))))

(defn c-operator-text [(sym : String @ Region)] : String @ Region
  (if (string/str-eq? sym "=") "==" sym))

;; binary-op-call-shaped? -- a real, narrow 2-argument call to one of
;; the real operators above, every argument a bare symbol or number
;; literal (every-call-arg-symbol-or-number?'s own widened shape guard
;; -- `(+ n 10)` is exactly the real, motivating case). Real, honest,
;; narrower than the C reference: no unary `-`, no >2-argument chains
;; (`(+ a b c)`), not attempted here.
(defn binary-op-call-shaped? [(expr-node : &Node) (dest : Arena @ Region)] : Bool
  (if (not (emit-is-symbol-headed-list? expr-node))
    false
    (let [fn-node (vec/get &(get-field expr-node :children) 0)
          fn-text (get-field fn-node :text)]
      (and (binary-op-symbol? fn-text)
           (and (= (vec/len &(get-field expr-node :children)) 3)
                (every-call-arg-symbol-or-number? expr-node 1 dest))))))

(defn emit-binary-op [(call : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [fn-node (vec/get &(get-field call :children) 0)
        op-c (c-operator-text (get-field fn-node :text))
        lhs (emit-call-arg (vec/get &(get-field call :children) 1) scope dest)
        rhs (emit-call-arg (vec/get &(get-field call :children) 2) scope dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "(")
      (vec/push! &parts lhs)
      (vec/push! &parts " ")
      (vec/push! &parts op-c)
      (vec/push! &parts " ")
      (vec/push! &parts rhs)
      (vec/push! &parts ")")
      (emit-join-all &parts dest))))

;; emit-i32-boxed -- a real, plain C expression (`(int-expr)`) forced
;; into this emitter's own uniform char*-return/let-value convention
;; via a real `(char *)(intptr_t)` reinterpretation, not a heap
;; allocation -- `int_box`-style arena boxing (the C reference's own
;; real, per-file-generated helper, see src/emit.c's own g_box_helpers)
;; is a genuinely separate, larger undertaking, not attempted here.
;; intptr_t is guaranteed round-trippable with any real pointer value
;; on any real platform (<stdint.h>, already unconditionally included
;; by program-header) -- a real, valid, if narrow, technique: any
;; caller that needs the real I32 back out casts `(int)(intptr_t)
;; result`, the same real "this file's own uniform scalar-as-pointer
;; erasure" shape emit-defn's own hard-coded `char *` return already
;; commits every function to. Needed because emit-binary-op's own raw
;; C expression (`(n + 10)`) is a real, unboxed `int` -- assigning or
;; returning it directly into a `char *` slot is a real, confirmed
;; `-Wint-conversion` warning (a hard -Werror failure under this whole
;; repo's own real DoD bar) without this wrapper.
(defn emit-i32-boxed [(expr-c : String @ Region) (dest : Arena @ Region)] : String @ Region
  (let [parts (vec/new dest)]
    (do
      (vec/push! &parts "(char *)(intptr_t)")
      (vec/push! &parts expr-c)
      (emit-join-all &parts dest))))

;; plain-call-shaped? -- a real, user-defined function call this
;; narrow emitter can now support: a symbol-headed list, not `alloc`,
;; not a `vec/` runtime call (is-vec-call?'s own header comment
;; explains why), not a binary-op-call-shaped? operator call (those
;; need real C infix syntax, not `mangled_name(args)` call syntax --
;; emit-binary-op handles them separately), every real argument itself
;; a supported shape (every-call-arg-symbol-or-number?'s own header
;; comment -- now including a nested plain-call/binary-op argument,
;; not just a bare symbol/number/get-field).
(defn plain-call-shaped? [(expr-node : &Node) (dest : Arena @ Region)] : Bool
  (if (not (emit-is-symbol-headed-list? expr-node))
    false
    (let [fn-node (vec/get &(get-field expr-node :children) 0)
          fn-text (get-field fn-node :text)]
      (and (not (string/str-eq? fn-text "alloc"))
           (and (not (is-vec-call? fn-text dest))
                (and (not (binary-op-symbol? fn-text))
                     (every-call-arg-symbol-or-number? expr-node 1 dest)))))))

;; mangle-call-name -- real, narrow port of src/emit.c's own
;; mangle_call_name for the one real shape this narrow emitter
;; supports: strip a `/`-qualified call name (`selfhost/lexer/
;; new-lexer`) down to its own real final segment (`new-lexer`),
;; matching how the full C compiler's own generated top-level defn
;; names are never module-prefixed in the emitted C (confirmed live:
;; grepping the real generated C for `new_lexer` finds a bare
;; `char * new_lexer(...)`, not `selfhost_lexer_new_lexer`), then runs
;; the normal hyphen-only `mangle` on that segment. Real, honest,
;; narrower than the C reference: no find_defn_return_type-backed
;; disambiguation (this narrow emitter has no such registry) -- safe
;; here because plain-call-shaped? already excludes the one real
;; collision risk (`vec/`) the C reference itself guards against.
(defn mangle-call-name [(fn-text : String @ Region) (dest : Arena @ Region)] : String @ Region
  (let [parts (string/split fn-text "/" dest)
        n (vec/len &parts)]
    (if (<= n 1)
      (mangle fn-text dest)
      (mangle (vec/get &parts (- n 1)) dest))))

;; emit-call-arg -- widened 2026-08-28 alongside every-call-arg-
;; symbol-or-number?'s own nested-call widening above: a real nested
;; plain-call-shaped?/binary-op-call-shaped?/alloc-call-shaped?
;; argument now emits through the SAME real emit-plain-call/emit-
;; binary-op/emit-alloc-call this file already uses for a whole
;; function body -- checked in this order (get-field, plain-call,
;; binary-op, alloc, bare-symbol/number fallback) since a NAME could
;; theoretically satisfy more than one shape guard and only one is
;; ever correct for a given real node (get-field/alloc are each their
;; own distinct call-named shape, never ambiguous with the other two
;; or each other; plain-call-shaped? itself already excludes both
;; `alloc` and binary-op-symbol? names, so plain-call vs. binary-op
;; vs. alloc can never all match the same node either -- this ordering
;; is for defensiveness, not resolving a real ambiguity).
(defn emit-call-arg [(arg-node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (cond
    ((get-field-shaped? arg-node) (emit-get-field arg-node scope dest))
    ((plain-call-shaped? arg-node dest) (emit-plain-call arg-node scope dest))
    ((binary-op-call-shaped? arg-node dest) (emit-binary-op arg-node scope dest))
    ((alloc-call-shaped? arg-node) (emit-alloc-call arg-node scope dest))
    (true (resolve-arena-ref (get-field arg-node :text) scope dest))))

(defn emit-call-args [(call : &Node) (i : I32) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)]
  : String @ Region
  (loop [j i pieces (vec/new dest)]
    (if (>= j (vec/len &(get-field call :children)))
      (join-with &pieces ", " dest)
      (let [arg-node (vec/get &(get-field call :children) j)]
        (do
          (vec/push! &pieces (emit-call-arg arg-node scope dest))
          (recur (+ j 1) pieces))))))

;; emit-plain-call -- `(fn-name arg1 arg2 ...)` -> real
;; `mangled_fn_name(arg1_c, arg2_c, ...)`, each argument resolved via
;; the same real resolve-arena-ref every arena-typed reference already
;; goes through elsewhere in this file (correctly falls back to a bare
;; mangled name for a non-arena-scoped symbol -- exactly right for a
;; String/I32 argument).
(defn emit-plain-call [(call : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [fn-node (vec/get &(get-field call :children) 0)
        fn-name (mangle-call-name (get-field fn-node :text) dest)
        args-c (emit-call-args call 1 scope dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts fn-name)
      (vec/push! &parts "(")
      (vec/push! &parts args-c)
      (vec/push! &parts ")")
      (emit-join-all &parts dest))))

;; emit-let-value / let-value-error-prefix -- the real 3-way dispatch
;; a let-binding's own expr-node now gets: a real `alloc` call, a real
;; plain function call, or (still) a real, clean #error for anything
;; else this narrow v0 doesn't support.
;; let-value-is-bool-expr? -- shared by emit-let-value and
;; let-value-error-prefix below (2026-08-28, the same real "or/and/not
;; at top-level tail position" gap closed in emit-form above, extended
;; here for symmetry to a let-binding's own value position -- a plain
;; boolean expression as a let-value is the ordinary, already-tractable
;; case emit-i32-boxed already covers, NOT the genuinely hard
;; non-tail-cond case cond-call-shaped?'s own header comment
;; documents).
(defn let-value-is-bool-expr? [(expr-node : &Node) (dest : Arena @ Region)] : Bool
  (or (or-and-shaped? expr-node dest) (not-shaped? expr-node dest)))

(defn emit-let-value [(expr-node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (cond
    ((alloc-call-shaped? expr-node) (emit-alloc-call expr-node scope dest))
    ((binary-op-call-shaped? expr-node dest) (emit-i32-boxed (emit-binary-op expr-node scope dest) dest))
    ((let-value-is-bool-expr? expr-node dest) (emit-i32-boxed (emit-bool-expr expr-node scope dest) dest))
    ;; Real, additive cases (2026-08-28, same Ok/Err/Some/None
    ;; construction support as emit-form above, extended here for
    ;; symmetry to a let-binding's own value position -- checked BEFORE
    ;; plain-call-shaped? for the identical real reason (result-option-
    ;; ctor-shaped?'s own header comment).
    ((result-option-ctor-shaped? expr-node dest) (emit-result-option-ctor expr-node scope dest))
    ((none-shaped? expr-node) "option_none()")
    ((plain-call-shaped? expr-node dest) (emit-plain-call expr-node scope dest))
    (true "0 /* see #error above */")))

(defn let-value-error-prefix [(expr-node : &Node) (dest : Arena @ Region)] : String @ Region
  (if (or (alloc-call-shaped? expr-node)
          (or (binary-op-call-shaped? expr-node dest)
              (or (let-value-is-bool-expr? expr-node dest)
                  (or (result-option-ctor-shaped? expr-node dest)
                      (or (none-shaped? expr-node) (plain-call-shaped? expr-node dest))))))
    ""
    "#error selfhost/emit.prn: unsupported let-binding shape (narrow v0 only supports alloc calls, binary ops, or/and/not, Ok/Err/Some/None construction, and plain function calls with symbol/number args)\n"))

(defn emit-body-forms [(node : &Node) (start : I32) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)]
  : String @ Region
  (loop [i start acc ""]
    (if (>= i (vec/len &(get-field node :children)))
      acc
      (recur (+ i 1) (string/concat acc (emit-form (vec/get &(get-field node :children) i) scope dest) dest)))))

;; emit-let-bindings -- each binding pair becomes a real
;; `char *name __attribute__((unused)) = ...;` line, matching
;; examples/valid_only.prn's own real generated output for the
;; `alloc`-shaped case. Real, honest, narrow v0: emit-let-value's own
;; header comment names the real 3-way dispatch (alloc call / plain
;; function call / #error) -- src/emit.c's own real, current version
;; handles far more arbitrary let-binding exprs; not attempted here.
(defn emit-let-bindings [(bindings : &Node) (i : I32) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)]
  : String @ Region
  (if (>= (+ i 1) (vec/len &(get-field bindings :children)))
    ""
    (let [name-node (vec/get &(get-field bindings :children) i)
          expr-node (vec/get &(get-field bindings :children) (+ i 1))
          c-name (mangle (get-field name-node :text) dest)
          expr-c (emit-let-value expr-node scope dest)
          error-prefix (let-value-error-prefix expr-node dest)
          rest-c (emit-let-bindings bindings (+ i 2) scope dest)
          parts (vec/new dest)]
      (do
        (vec/push! &parts error-prefix)
        (vec/push! &parts "    char *")
        (vec/push! &parts c-name)
        (vec/push! &parts " __attribute__((unused)) = ")
        (vec/push! &parts expr-c)
        (vec/push! &parts ";\n")
        (vec/push! &parts rest-c)
        (emit-join-all &parts dest)))))

(defn emit-let [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [bindings (vec/get &(get-field node :children) 1)
        bindings-c (emit-let-bindings bindings 0 scope dest)
        body-c (emit-body-forms node 2 scope dest)]
    (string/concat bindings-c body-c dest)))

;; emit-with-arena -- `(with-arena [name region-kw size] body...)` ->
;; a real C block declaring a real, cleanup-attributed local `Arena`
;; value, matching examples/valid_only.prn's own real generated output
;; exactly (the exact real `__attribute__((cleanup(arena_free_all)))`
;; + `arena_init(&name)` pair NORTHSTAR.md's own "Memory model" section
;; requires). Real, honest, narrow v0: the real `size` argument in the
;; binding vector is parsed but not emitted anywhere (VS0's own real,
;; current with-arena emission doesn't use it either -- arena_init's
;; own real signature takes no size, growing on demand).
(defn emit-with-arena [(node : &Node) (scope : &(Vec ArenaBinding)) (dest : Arena @ Region)] : String @ Region
  (let [binding-vec (vec/get &(get-field node :children) 1)
        name-node (vec/get &(get-field binding-vec :children) 0)
        pname (get-field name-node :text)
        c-name (mangle pname dest)
        new-binding {:name pname :kind LocalArena}
        child-scope (arena-scope-extend scope new-binding dest)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "    {\n")
      (vec/push! &parts "        Arena ")
      (vec/push! &parts c-name)
      (vec/push! &parts " __attribute__((cleanup(arena_free_all)));\n")
      (vec/push! &parts "        arena_init(&")
      (vec/push! &parts c-name)
      (vec/push! &parts ");\n")
      (vec/push! &parts (emit-body-forms node 2 &child-scope dest))
      (vec/push! &parts "    }\n")
      (emit-join-all &parts dest))))

(defstruct ParamInfo
  (text  : String @ Region)
  (scope : (Vec ArenaBinding) @ Region))

;; param-type-name -- real, direct read of a param's own type-name
;; symbol: `(name : Type @ ...)` parses as an NList with children
;; [NSymbol name, NColon, NSymbol Type, NAt, ...] -- confirmed live via
;; a real AST dump of `(src : String @ Region)`, index 2 is always the
;; type-name symbol regardless of whether a region annotation follows.
;; Real, honest fallback: a param with fewer than 3 children (should
;; never happen for a real, parsed param -- the parser itself requires
;; `name : Type` at minimum) reports "Arena" rather than crashing on a
;; missing index, preserving this file's own prior narrow behavior.
(defn param-type-name [(param : &Node)] : String @ Region
  (if (< (vec/len &(get-field param :children)) 3)
    "Arena"
    (let [type-node (vec/get &(get-field param :children) 2)]
      (get-field type-node :text))))

;; param-c-type -- real, narrow type-name -> C type-prefix mapping,
;; each already carrying its own real trailing punctuation the way the
;; original hard-coded "Arena *" literal did (so `join3 prefix c-name
;; " __attribute__((unused))" dest` stays correct for every case).
;; Real, honest, narrow v0: String/I32, plus (2026-08-28) a real
;; registered defstruct name -- a struct-typed param passes BY VALUE
;; (`Point p`, not `Point *p`), matching the reference compiler's own
;; real, confirmed generated shape exactly (checked directly: `int
;; get_x(Point);` / `int get_x(Point p) {...}`). Anything else (`&Type`
;; references, Bool, F64 params) still falls back to "Arena *", this
;; file's own prior universal behavior.
(defn param-c-type [(type-name : String @ Region) (known-structs : &(Vec String)) (dest : Arena @ Region)] : String @ Region
  (cond
    ((string/str-eq? type-name "String") "char *")
    ((string/str-eq? type-name "I32") "int ")
    ;; Real, narrow, additive case (2026-08-28, added alongside real
    ;; match support above): a Result/Option-typed param -- the real,
    ;; natural way a match's own scrutinee shows up as a bare symbol
    ;; (this feature's own primary supported scrutinee shape besides a
    ;; plain call) in a real function signature. Both are real,
    ;; runtime-builtin C struct types (parena_runtime.h), passed BY
    ;; VALUE, same convention a registered defstruct param already
    ;; uses just below.
    ((string/str-eq? type-name "Result") "Result ")
    ((string/str-eq? type-name "Option") "Option ")
    ((vec-contains-string? known-structs type-name 0) (string/concat type-name " " dest))
    (true "Arena *")))

;; emit-params -- real, narrow v0: every param's own real declared C
;; type is now read from its own type annotation (Arena/String/I32/a
;; registered struct name; param-c-type's own header comment explains
;; the real, narrow fallback for anything else). Only an Arena-typed
;; param is added to the real ArenaBinding scope (the &-vs-bare
;; distinction resolve-arena-ref needs only ever applies to
;; arena-typed names) -- resolve-arena-ref's own real `None` case
;; already falls back to a bare mangled name for anything not found in
;; scope, which is exactly the correct real behavior for a
;; String/I32/struct param referenced elsewhere.
(defn emit-params [(params : &Node) (known-structs : &(Vec String)) (dest : Arena @ Region)] : ParamInfo @ Region
  (loop [i 0 pieces (vec/new dest) scope (vec/new dest)]
    (if (>= i (vec/len &(get-field params :children)))
      {:text (join-with &pieces ", " dest) :scope scope}
      (let [param (vec/get &(get-field params :children) i)
            name-node (vec/get &(get-field param :children) 0)
            pname (get-field name-node :text)
            c-name (mangle pname dest)
            type-name (param-type-name param)
            c-type (param-c-type type-name known-structs dest)
            piece (join3 c-type c-name " __attribute__((unused))" dest)
            next-scope (if (string/str-eq? type-name "Arena")
                         (arena-scope-extend &scope {:name pname :kind PointerArena} dest)
                         scope)]
        (do
          (vec/push! &pieces piece)
          (recur (+ i 1) pieces next-scope))))))

;; emit-defn -- real, narrow port of a top-level `(defn name [params]
;; body-start-index -- real, narrow detection and skip of an explicit
;; `: ReturnType` (optionally `@ region`-suffixed) annotation on a defn
;; (2026-08-28, real gap found and closed while verifying binary-op
;; support): emit-body-forms always started its own body walk at index
;; 3 UNCONDITIONALLY, so a defn WITH an explicit return-type annotation
;; -- `] : I32`, the exact same shape kind-code/is-close-token?/etc
;; (this very codebase's own real source) all already use, or the even
;; more common `] : String @ Region` -- had its own colon/type(/at/
;; region) children wrongly walked as 2-4 extra, bogus body statements,
;; each emitting its own spurious `return ...;` BEFORE the real body's
;; own real return (confirmed via direct instrumentation: `] : I32`
;; produced a stray `return ;` then `return I32;`; `] : String @
;; Region` produced FOUR stray lines). Real, honest, narrow v0: the
;; return type itself is still never USED for anything (this emitter's
;; own uniform char*-boxed-return convention doesn't need it) -- this
;; only detects and SKIPS the annotation, the same "consumed by
;; omission" treatment an optional trailing `@ region` already gets
;; everywhere else in this file. The type node itself (child at colon+1)
;; is always exactly ONE child regardless of whether it's a bare symbol
;; (`I32`) or a compound list (`(Result Unit String)`) -- Node.children
;; nests, it doesn't flatten -- so this doesn't need to distinguish the
;; two shapes at all.
(defn body-start-index [(defn-node : &Node)] : I32
  (if (< (vec/len &(get-field defn-node :children)) 4)
    3
    (let [maybe-colon (vec/get &(get-field defn-node :children) 3)]
      (if (not (= (emit-node-kind-code (get-field maybe-colon :kind)) 7))
        3
        (let [after-type (+ 3 2)]
          (if (< (vec/len &(get-field defn-node :children)) (+ after-type 1))
            after-type
            (let [maybe-at (vec/get &(get-field defn-node :children) after-type)]
              (if (= (emit-node-kind-code (get-field maybe-at :kind)) 8)
                (+ after-type 2)
                after-type))))))))

;; body...)`. Real, honest, narrow v0: return type defaults to hard-
;; coded `char *` (matching src/emit.h's own real, documented "char *
;; is the only inferred type" v0 scope exactly -- not a real general
;; type-inference pass), EXCEPT a real, narrow `Result`/`Option`
;; annotation (defn-c-return-type's own header comment above, 2026-08-
;; 28) now recognized concretely -- the real function body is assumed
;; to be exactly ONE top-level form (examples/valid_only.prn's own real
;; shape: one with-arena).
(defn emit-defn [(defn-node : &Node) (known-structs : &(Vec String)) (dest : Arena @ Region)] : String @ Region
  (let [name-node (vec/get &(get-field defn-node :children) 1)
        params (vec/get &(get-field defn-node :children) 2)
        fn-name (mangle (get-field name-node :text) dest)
        param-info (emit-params params known-structs dest)
        body-c (emit-body-forms defn-node (body-start-index defn-node) &(get-field param-info :scope) dest)
        return-type-c (defn-c-return-type defn-node)
        parts (vec/new dest)]
    (do
      (vec/push! &parts return-type-c)
      (vec/push! &parts fn-name)
      (vec/push! &parts "(")
      (vec/push! &parts (get-field param-info :text))
      (vec/push! &parts ") {\n")
      (vec/push! &parts body-c)
      (vec/push! &parts "}\n")
      (emit-join-all &parts dest))))

;; defn-declared-return-type-name -- real, narrow read of a defn's own
;; explicit `: ReturnType` annotation's NAME text, when present (child
;; index 4, right after the `:` colon node body-start-index already
;; detects at index 3) -- "" when no such annotation exists at all
;; (this file's own pre-existing default, unchanged by this addition).
(defn defn-declared-return-type-name [(defn-node : &Node)] : String @ Region
  (if (< (vec/len &(get-field defn-node :children)) 5)
    ""
    (let [maybe-colon (vec/get &(get-field defn-node :children) 3)]
      (if (not (= (emit-node-kind-code (get-field maybe-colon :kind)) 7))
        ""
        (let [type-node (vec/get &(get-field defn-node :children) 4)]
          (get-field type-node :text))))))

;; defn-c-return-type -- real, narrow return-type recognition (2026-08-
;; 28, added alongside real Ok/Err/Some/None CONSTRUCTION support
;; below): a `Result`/`Option` return-type annotation now names the
;; real, concrete runtime C struct type instead of this file's own
;; pre-existing hardcoded `char *` default -- needed because a real
;; constructor function's own body (`(Ok s)` etc.) produces an actual
;; `Result`/`Option` C struct value (`result_ok(s)`, a real
;; parena_runtime.h struct, not a pointer), which cannot be `return`ed
;; from a function declared to return `char *` without a genuine,
;; confirmed C type-mismatch compile error. Same real by-value
;; recognition param-c-type already established for these two names
;; (added for match's own scrutinee param) -- this is its return-
;; position counterpart. Every other declared return type (including
;; none at all) keeps this file's own pre-existing, uniform `char *`
;; default completely unchanged -- still real, honest, narrow v0, not
;; a real type-inference pass.
(defn defn-c-return-type [(defn-node : &Node)] : String @ Region
  (let [name (defn-declared-return-type-name defn-node)]
    (cond
      ((string/str-eq? name "Result") "Result ")
      ((string/str-eq? name "Option") "Option ")
      (true "char * "))))

;; program-header -- the same real prelude (`#include
;; "parena_runtime.h"` + the 4 standard headers) VS0's own real,
;; current emitter still emits verbatim.
(defn program-header [(dest : Arena @ Region)] : String @ Region
  (let [parts (vec/new dest)]
    (do
      (vec/push! &parts "/* Generated by parena build -- VS0 domain 3, do not edit by hand. */\n")
      (vec/push! &parts "#include \"parena_runtime.h\"\n")
      (vec/push! &parts "#include <string.h>\n")
      (vec/push! &parts "#include <stdint.h>\n")
      (vec/push! &parts "#include <stdlib.h>\n")
      (vec/push! &parts "#include <math.h>\n")
      (vec/push! &parts "\n\n")
      (emit-join-all &parts dest))))

;; ---- Real, narrow top-level `defstruct` support (2026-08-28) ----
;;
;; Real, honest v0 scope: only scalar field types (I32, Bool, F64,
;; String, Arena) -- a field typed as ANOTHER registered struct, a
;; Vec, or an enum is a real, separate, larger undertaking (needs the
;; C reference's own much larger real field-type/Vec-elem-hint
;; tracking, process_defstruct's own real scope in src/emit.c), not
;; attempted here; a defstruct with any such field is simply not
;; treated as defstruct-shaped? at all (falls back to the pre-existing
;; honest "skipped, no typedef emitted" behavior every unsupported
;; top-level form already gets, never a wrong guess). No struct-
;; literal construction (`{:field val}`) either -- this pass only lets
;; an ALREADY-CONSTRUCTED struct value (a real param, matching this
;; codebase's own real by-value struct-param convention confirmed
;; directly against the reference compiler's own output) be READ via
;; get-field, not built.

(defn struct-field-c-type [(type-name : String @ Region)] : String @ Region
  (cond
    ((string/str-eq? type-name "String") "char *")
    ((string/str-eq? type-name "I32") "int")
    ((string/str-eq? type-name "Bool") "int")
    ((string/str-eq? type-name "F64") "double")
    ((string/str-eq? type-name "Arena") "Arena *")
    (true "")))

(defn struct-field-supported? [(type-name : String @ Region)] : Bool
  (not (string/str-eq? (struct-field-c-type type-name) "")))

;; struct-field-shaped? -- a real `(name : Type)` field list -- exactly
;; 3 children (name, colon, type), the type itself one of the real,
;; supported scalar types above.
(defn struct-field-shaped? [(field : &Node)] : Bool
  (if (not (= (emit-node-kind-code (get-field field :kind)) 0))
    false
    (if (not (= (vec/len &(get-field field :children)) 3))
      false
      (let [type-node (vec/get &(get-field field :children) 2)]
        (struct-field-supported? (get-field type-node :text))))))

(defn all-struct-fields-shaped? [(node : &Node) (i : I32)] : Bool
  (if (>= i (vec/len &(get-field node :children)))
    true
    (if (struct-field-shaped? (vec/get &(get-field node :children) i))
      (all-struct-fields-shaped? node (+ i 1))
      false)))

;; defstruct-shaped? -- a real top-level `(defstruct Name (f : T)
;; ...)` this narrow v0 can support: at least one real field (an empty
;; struct is real, valid PARENA but not exercised anywhere in this
;; codebase's own real source, not attempted here), every field a
;; supported scalar type.
(defn defstruct-shaped? [(node : &Node)] : Bool
  (and (emit-is-call-named? node "defstruct")
       (and (> (vec/len &(get-field node :children)) 2)
            (all-struct-fields-shaped? node 2))))

(defn emit-struct-field [(field : &Node) (dest : Arena @ Region)] : String @ Region
  (let [name-node (vec/get &(get-field field :children) 0)
        type-node (vec/get &(get-field field :children) 2)
        c-name (mangle (get-field name-node :text) dest)
        c-type (struct-field-c-type (get-field type-node :text))
        parts (vec/new dest)]
    (do
      (vec/push! &parts "    ")
      (vec/push! &parts c-type)
      (vec/push! &parts " ")
      (vec/push! &parts c-name)
      (vec/push! &parts ";\n")
      (emit-join-all &parts dest))))

(defn emit-struct-fields [(node : &Node) (i : I32) (dest : Arena @ Region)] : String @ Region
  (if (>= i (vec/len &(get-field node :children)))
    ""
    (string/concat (emit-struct-field (vec/get &(get-field node :children) i) dest)
                    (emit-struct-fields node (+ i 1) dest) dest)))

;; emit-defstruct -- `(defstruct Point (x : I32) (y : I32))` -> real
;; `typedef struct {\n    int x;\n    int y;\n} Point;\n`, matching
;; the reference compiler's own real generated typedef shape exactly
;; (confirmed directly). No positional `_new` constructor (the
;; reference emits one, `Point_new(int x, int y)`) -- this pass only
;; supports reading an already-constructed struct via get-field, not
;; building one, see this section's own header comment.
(defn emit-defstruct [(node : &Node) (dest : Arena @ Region)] : String @ Region
  (let [name-node (vec/get &(get-field node :children) 1)
        struct-name (get-field name-node :text)
        parts (vec/new dest)]
    (do
      (vec/push! &parts "typedef struct {\n")
      (vec/push! &parts (emit-struct-fields node 2 dest))
      (vec/push! &parts "} ")
      (vec/push! &parts struct-name)
      (vec/push! &parts ";\n")
      (emit-join-all &parts dest))))

;; vec-contains-string? -- real, plain linear-scan membership check,
;; used by param-c-type below to recognize a registered struct name.
(defn vec-contains-string? [(v : &(Vec String)) (target : String @ Region) (i : I32)] : Bool
  (if (>= i (vec/len v))
    false
    (if (string/str-eq? (vec/get v i) target)
      true
      (vec-contains-string? v target (+ i 1)))))

;; struct-prepass -- walks every top-level form ONCE, in real, natural
;; source order, accumulating (a) the real, combined typedef text for
;; every real defstruct-shaped? form, and (b) each such form's own
;; struct name into known-structs -- matching src/emit.c's own real
;; "process every defstruct before any defn, in source order" DoD
;; behavior (a struct-typed param needs its own type already known by
;; the time param-c-type looks it up). Non-defstruct forms are simply
;; skipped here (defn is handled by emit-program's own separate pass).
(defn struct-prepass [(program : &Node) (i : I32) (known-structs : &(Vec String)) (dest : Arena @ Region)] : String @ Region
  (if (>= i (vec/len &(get-field program :children)))
    ""
    (let [form (vec/get &(get-field program :children) i)]
      (if (defstruct-shaped? form)
        (let [name-node (vec/get &(get-field form :children) 1)]
          (do
            (vec/push! known-structs (get-field name-node :text))
            (string/concat (emit-defstruct form dest) (struct-prepass program (+ i 1) known-structs dest) dest)))
        (struct-prepass program (+ i 1) known-structs dest)))))

;; emit-program -- real, narrow port of src/emit.c's own top-level
;; driver: the real prelude, then every real defstruct's own typedef
;; (struct-prepass, in source order, before any defn -- see that
;; function's own header comment), then every top-level `(defn ...)`
;; form's own real emitted C, in source order.
(defn emit-program [(program : &Node) (dest : Arena @ Region)] : String @ Region
  (let [header (program-header dest)
        known-structs (vec/new dest)
        structs-c (struct-prepass program 0 &known-structs dest)]
    (loop [i 0 acc (string/concat header structs-c dest)]
      (if (>= i (vec/len &(get-field program :children)))
        acc
        (let [form (vec/get &(get-field program :children) i)]
          (if (emit-is-call-named? form "defn")
            (recur (+ i 1) (string/concat acc (emit-defn form &known-structs dest) dest))
            (recur (+ i 1) acc)))))))
