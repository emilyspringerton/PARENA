load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "test_lexer_parser",
    srcs = ["test_lexer_parser.c"],
    deps = [
        "//src:arena",
        "//src:ast",
        "//src:parser",
    ],
    # Matches gcc's own -Wall -Wextra -pedantic bar the Makefile/CI already
    # hold this codebase to (NORTHSTAR.md's own VS0 DoD names this exact
    # flag set for the C emitter's output; applying it to the compiler's
    # own source is the same discipline, not a new one).
    copts = [
        "-std=c99",
        "-Wall",
        "-Wextra",
        "-pedantic",
    ],
)

cc_test(
    name = "test_region",
    srcs = ["test_region.c"],
    deps = [
        "//src:arena",
        "//src:ast",
        "//src:parser",
        "//src:region",
    ],
    copts = [
        "-std=c99",
        "-Wall",
        "-Wextra",
        "-pedantic",
    ],
)
