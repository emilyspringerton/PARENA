;; tests/netkit/gfd_spec.prn -- SCARAB/LADYBUG suite for stdlib/netkit/nk_gfd.prn, the SHANKPHONE's GoblinFoxDragon client. Every
;; fixture is text the live MUD sent (play.okemily.com:2323, 2026-11-26), CR LF and all.
;; Run: scripts/scarab_wasm.sh tests/netkit/gfd_spec.prn --modules stdlib/netkit/MODULES

(defn gf-feed! [(s : String)] : I32 (nk-gfd-feed (sc-put! (nk-gfd-in-addr) s)))
(defn gf-room-is [(s : String)] : I32 (lb-same? (nk-gfd-room-addr) (str-addr s) (+ (sc-strlen (str-addr s)) 1)))
(defn gf-log-has [(s : String)] : I32
  (let [a (nk-gfd-log-addr) n (nk-gfd-log-len) p (str-addr s) m (sc-strlen (str-addr s))]
    (loop [i 0] (cond (> (+ i m) n) 0 (= (lb-same? (+ a i) p m) 1) 1 :else (recur (+ i 1))))))

(defn scarab-main [] : I32
  (do (sc-describe! "nk_gfd")
        (sc-describe! "the guest welcome")
          (nk-gfd-reset)
          (gf-feed! "Welcome to DragonsNShit MUD.\r\nThis is a GUEST connection: no login, no persistence.\r\nEnter your character name: ")
          (sc-it! "the name prompt is seen even without a newline") (lb-equal (nk-gfd-state) 2)
          (sc-it! "it is logged as the name prompt (kind 9)") (lb-equal (gf-log-has "9Enter your character name:") 1)
          (sc-it! "no room yet, no buttons yet") (lb-equal (load8 (nk-gfd-room-addr)) 0) (lb-equal (nk-gfd-btn-enabled 1) 0)
        (sc-end!)
        (sc-describe! "arriving in the Meadow")
          (nk-gfd-log-clear)
          (gf-feed! "Welcome, Look510!\r\nType HELP for commands.\r\n\r\n=== Meadow ===\r\nA wide grassy meadow. The air smells of earth and dew.\r\nExits: west, up, north, south, east\r\nCreatures here:\r\n  [worm-meadow-0] worm  HP:90/90 (burrowed)\r\n  [worm-meadow-0-variant-elder-worm] Elder Worm  HP:144/144 (burrowed)\r\n  [worm-meadow-1] worm  HP:90/90\r\n\r\n[ Lv.1  HP:90/90  MP:0/0  TP:0  Haste:0%  Zone:Meadow  Overcast ]\r\n> \r\n")
          (sc-it! "playing once welcomed") (lb-equal (nk-gfd-state) 3)
          (sc-it! "the room is the heading before the exits") (lb-equal (gf-room-is "Meadow") 1) (lb-equal (nk-gfd-room-seq) 1)
          (sc-it! "exits: n s e w up (no down)") (lb-equal (nk-gfd-exits) (+ 1 (+ 2 (+ 4 (+ 8 16)))))
          (sc-it! "N S E W Up are enabled, Down is not")
          (lb-equal (nk-gfd-btn-enabled 1) 1) (lb-equal (nk-gfd-btn-enabled 2) 1) (lb-equal (nk-gfd-btn-enabled 3) 1)
          (lb-equal (nk-gfd-btn-enabled 4) 1) (lb-equal (nk-gfd-btn-enabled 5) 1) (lb-equal (nk-gfd-btn-enabled 6) 0)
          (sc-it! "three creatures, with ids, names and hit points") (lb-equal (nk-gfd-creatures) 3)
          (lb-str-equal (nk-gfd-cr-id-addr 1) "worm-meadow-0-variant-elder-worm") (lb-str-equal (nk-gfd-cr-name-addr 1) "Elder Worm")
          (lb-equal (nk-gfd-cr-hp 1) 144) (lb-equal (nk-gfd-cr-hpmax 1) 144) (lb-equal (nk-gfd-cr-burrowed 0) 1) (lb-equal (nk-gfd-cr-burrowed 2) 0)
          (sc-it! "vitals: level, HP, MP, TP, zone (the weather is not the zone)")
          (lb-equal (nk-gfd-vital 0) 1) (lb-equal (nk-gfd-vital 1) 90) (lb-equal (nk-gfd-vital 2) 90) (lb-equal (nk-gfd-vital 5) 0)
          (lb-str-equal (nk-gfd-zone-addr) "Meadow") (lb-equal (nk-gfd-bar 0) 1000)
          (sc-it! "the vitals line and the prompt are hidden from the log; the room is styled")
          (lb-equal (nk-gfd-kind-style 4) 0) (lb-equal (nk-gfd-kind-style 5) 0) (lb-equal (nk-gfd-kind-style 1) 2)
          (sc-it! "attack goes to the first creature when none is picked") (lb-equal (nk-gfd-cmd 12) 20)
          (lb-str-equal (nk-gfd-cmd-addr) "attack worm-meadow-0")
          (sc-it! "picking a creature aims the attack at it") (nk-gfd-select 1) (lb-equal (nk-gfd-selected) 1)
          (lb-equal (nk-gfd-cmd 12) (+ 7 32)) (lb-str-equal (nk-gfd-cmd-addr) "attack worm-meadow-0-variant-elder-worm")
          (sc-it! "movement and actions are plain commands") (nk-gfd-cmd 1) (lb-str-equal (nk-gfd-cmd-addr) "n")
          (nk-gfd-cmd 6) (lb-str-equal (nk-gfd-cmd-addr) "go down") (nk-gfd-cmd 9) (lb-str-equal (nk-gfd-cmd-addr) "inv")
          (sc-it! "no weapon skill below 100 TP; stop only while fighting") (lb-equal (nk-gfd-btn-enabled 14) 0) (lb-equal (nk-gfd-btn-enabled 13) 0)
        (sc-end!)
        (sc-describe! "a fight")
          (nk-gfd-log-clear)
          (gf-feed! "You close the distance to worm-meadow-0-variant-elder-worm.\r\nYou target worm-meadow-0-variant-elder-worm (Elder Worm). Auto-attacking.\r\n\r\n[ Lv.1  HP:90/90  MP:0/0  TP:0  Haste:0%  Zone:Meadow ]\r\n> \r\n\r\nYou hit for 43 damage. (TP: 38 [+38])\r\n\r\n[ Lv.1  HP:90/90  MP:0/0  TP:138  Haste:0%  Zone:Meadow ]\r\n> \r\n\r\n[!] worm-meadow-0-variant-elder-worm hits you for 8 damage! HP: 82/90\r\n")
          (sc-it! "targeting starts the fight; Stop is enabled") (lb-equal (nk-gfd-fighting) 1) (lb-equal (nk-gfd-btn-enabled 13) 1)
          (sc-it! "a hit on you updates HP at once") (lb-equal (nk-gfd-vital 1) 82)
          (sc-it! "TP 138 enables the weapon skill") (lb-equal (nk-gfd-vital 5) 138) (lb-equal (nk-gfd-btn-enabled 14) 1)
          (sc-it! "your hits and hits on you are told apart") (lb-equal (gf-log-has "6You hit for 43") 1) (lb-equal (gf-log-has "7[!] worm") 1)
          (sc-it! "a vitals line is not a creature row, even during a list") (lb-equal (nk-gfd-creatures) 3)
        (sc-end!)
        (sc-describe! "headings that are not rooms, and the next room")
          (gf-feed! "\r\n=== Inventory (Flow: 0) ===\r\n  (empty)\r\n\r\n")
          (sc-it! "an inventory heading does not become the room") (lb-equal (gf-room-is "Meadow") 1)
          (gf-feed! "\r\n=== Hills ===\r\nRolling green hills stretch to the horizon.\r\nExits: north, south\r\nCreatures here:\r\n  [rabbit-hills-4] rabbit  HP:45/45\r\n")
          (sc-it! "walking north: a new room, its own exits, its own creatures")
          (lb-equal (gf-room-is "Hills") 1) (lb-equal (nk-gfd-room-seq) 2) (lb-equal (nk-gfd-exits) 3) (lb-equal (nk-gfd-creatures) 1)
          (sc-it! "the old pick is gone") (lb-equal (nk-gfd-selected) -1)
          (sc-it! "exits written with destinations still parse: south (Detroit School), east (Osaka)")
          (gf-feed! "=== Detroit Apartment ===\r\nExits: south (Detroit School), east (Osaka), down (Cairngorms).\r\n")
          (lb-equal (nk-gfd-exits) (+ 2 (+ 4 32)))
        (sc-end!)
        (sc-describe! "a signed-in account's first visit")
          (nk-gfd-reset)
          (gf-feed! "No character is bound to this IDUNA account yet.\r\nChoose a permanent character name (2-20 letters/digits) -- this IDUNA account will be bound to it for good.\r\nName: ")
          (sc-it! "the claim prompt asks for a name too (state 2, a prompt line)") (lb-equal (nk-gfd-state) 2) (lb-equal (gf-log-has "9Name:") 1)
        (sc-end!)
        (sc-describe! "colour and line ends")
          (nk-gfd-log-clear)
          (gf-feed! "\u{1b}[1;33mGold text\u{1b}[0m\r\n")
          (sc-it! "ANSI codes are dropped") (lb-equal (gf-log-has "0Gold text\n") 1)
        (sc-end!)
        (sc-describe! "the button set")
          (sc-it! "twenty buttons, each labelled") (lb-equal (nk-gfd-buttons) 20) (lb-str-equal (nk-gfd-btn-label-addr 1) "N")
          (lb-str-equal (nk-gfd-btn-label-addr 12) "Attack") (lb-equal (load8 (nk-gfd-btn-label-addr 21)) 0)
          (sc-it! "unknown buttons send nothing") (lb-equal (nk-gfd-cmd 99) 0)
          (sc-it! "closed: nothing is enabled") (nk-gfd-closed) (lb-equal (nk-gfd-btn-enabled 7) 0)
        (sc-end!)
      (sc-end!)
      (sc-finish!)))
