;; tests/netkit/oui_gen_spec.prn -- SCARAB/LADYBUG suite for stdlib/netkit/nk_oui_gen.prn, the maker-table generator.
;; Replaces tests/netkit/test_oui_gen.py. A small hand-written registry in Wireshark's manuf layout covers every rule kind and
;; every error; then the checked-in TSV is packed here and compared byte for byte with the oui.bin the page build made through
;; scripts/build_netkit_oui.sh (the real host path), so both routes agree.
;; (On the real 3 MB registry the PARENA curate reproduced the first Python generator's 14,052 lines exactly; not checked in.)
;;
;; Run: scripts/scarab_wasm.sh tests/netkit/oui_gen_spec.prn --module stdlib/netkit/nk_oui_gen.prn
;;        --file stdlib/netkit/data/oui_brands.tsv --file <oui.bin from scripts/build_netkit_oui.sh>

(defn og-in! [(s : String)] : I32 (sc-put! (nk-oui-gen-in-addr) s))
(defn og-out [] : I32 (nk-oui-gen-out-addr))
;; the first line of OUT[0, n) that is not a "#" comment (curate writes a header first)
(defn og-body [(n : I32)] : I32
  (loop [p 0]
    (if (and (< p n) (= (load8 (+ (og-out) p)) 35))
        (recur (loop [j p] (if (or (>= j n) (= (load8 (+ (og-out) j)) 10)) (+ j 1) (recur (+ j 1)))))
        p)))
;; a hex digit pair for v (0..255), lower case, at a
(defn og-hex2! [(a : I32) (v : I32)] : Unit (do (store8! a (sc-hexdig (shr v 4))) (store8! (+ a 1) (sc-hexdig (bit-and v 15)))))
;; "00:xx:yy\tMn\n" for n = 0..255: 256 distinct makers (one too many); returns the length
(defn og-many-makers! [] : I32
  (loop [i 0 p (nk-oui-gen-in-addr)]
    (if (= i 256) (- p (nk-oui-gen-in-addr))
        (do (store8! p 48) (store8! (+ p 1) 48) (store8! (+ p 2) 58) (og-hex2! (+ p 3) (shr i 8)) (store8! (+ p 5) 58)
            (og-hex2! (+ p 6) (bit-and i 255)) (store8! (+ p 8) 9) (store8! (+ p 9) 77)
            (let [q (+ p 10)]
              (if (< i 10) (do (store8! q (+ 48 i)) (store8! (+ q 1) 10) (recur (+ i 1) (+ q 2)))
                  (if (< i 100) (do (store8! q (+ 48 (/ i 10))) (store8! (+ q 1) (+ 48 (mod i 10))) (store8! (+ q 2) 10) (recur (+ i 1) (+ q 3)))
                      (do (store8! q (+ 48 (/ i 100))) (store8! (+ q 1) (+ 48 (mod (/ i 10) 10))) (store8! (+ q 2) (+ 48 (mod i 10)))
                          (store8! (+ q 3) 10) (recur (+ i 1) (+ q 4))))))))))
;; 16380 prefixes, all maker "A": more than the scanner's 64 KB region holds
(defn og-too-big! [] : I32
  (loop [i 0 p (nk-oui-gen-in-addr)]
    (if (= i 16380) (- p (nk-oui-gen-in-addr))
        (do (og-hex2! p (shr i 16)) (store8! (+ p 2) 58) (og-hex2! (+ p 3) (bit-and (shr i 8) 255)) (store8! (+ p 5) 58)
            (og-hex2! (+ p 6) (bit-and i 255)) (store8! (+ p 8) 9) (store8! (+ p 9) 65) (store8! (+ p 10) 10)
            (recur (+ i 1) (+ p 11))))))

(defn og-refuses [(r : I32) (code : I32) (line : I32)] : Unit
  (do (lb-equal r code) (lb-equal (nk-oui-gen-err-line) line)))

(defn og-curate! [] : Unit
  (do (sc-describe! "curate (Wireshark manuf -> the branded TSV)")
        (let [n (nk-oui-curate (og-in! "# This file was generated by TShark ...\n#\n00:00:00      58895\n00:00:0C\tCisco\tCisco Systems, Inc\n00:00:0D\tFibronic\tFibronics Ltd.\n00:18:0A\tCiscoMeraki\tCisco Meraki\n00:1B:21\tIntel\t  Intel Corporate  \n08:00:09\tHP\tHewlett Packard\n08:00:0A\tHPE\tHewlett Packard Enterprise\n0C:8B:FD\tIntel\tIntel Corporate\n14:A7:8B\tZhejiang\tZhejiang Dahua Technology Co., Ltd.\n1C:1B:0D\tGiga-Byt\tGIGA-BYTE\n28:CD:C1\tRaspberryPiT\n3A:35:41\tRaspberryPi \tRaspberry Pi (Trading) Ltd\n8C:1F:64:34:A0/36\tRaspberryPi \tRaspberry Pi (Trading) Ltd\nB8:27:EB\tRaspberryPiF\tRaspberry Pi Foundation\ndc:a6:32\tRaspberryPiT\tRaspberry Pi Trading Ltd\n"))]
          (do (sc-it! "runs") (lb-be-> n 0)
              (sc-it! "keeps exactly the branded 24-bit blocks: first rule wins (Meraki before Cisco), names trimmed, HP exact, a contains rule, 36-bit blocks and unbranded lines dropped, hex lower-cased")
              (let [b (og-body n)]
                (lb-text-equal (+ (og-out) b) (- n b) "00:00:0c\tCisco\n00:18:0a\tMeraki\n00:1b:21\tIntel\n08:00:09\tHP\n08:00:0a\tAruba / HPE\n0c:8b:fd\tIntel\n14:a7:8b\tDahua (camera)\n3a:35:41\tRaspberry Pi\nb8:27:eb\tRaspberry Pi\ndc:a6:32\tRaspberry Pi\n"))
              (sc-it! "the TSV says PARENA made it") (lb-text-have-prefix (og-out) n "# Netkit manufacturer table -- generated by PARENA")))
        (sc-it! "refuses a registry out of order, naming line 2")
        (og-refuses (nk-oui-curate (og-in! "B8:27:EB\tx\tRaspberry Pi Foundation\n28:CD:C1\tx\tRaspberry Pi Trading Ltd\n")) -2 2)
        (sc-it! "refuses a malformed prefix (line 1)") (og-refuses (nk-oui-curate (og-in! "ZZ:27:EB\tx\tApple, Inc.\n")) -1 1)
      (sc-end!)))

(defn og-pack! [] : Unit
  (do (sc-describe! "pack (TSV -> oui.bin)")
        (let [n (nk-oui-pack (og-in! "# c\n\n00:1b:21\tIntel\n08:00:09\tHP\nb8:27:eb\tRaspberry Pi\ndc:a6:32\tRaspberry Pi\n")) o (og-out)]
          (do (sc-it! "writes the header: NKOU, 4 prefixes, 3 makers + the empty one, names at 32")
              (lb-text-equal o 4 "NKOU") (lb-equal (load32 (+ o 4)) 4) (lb-equal (load32 (+ o 8)) 4) (lb-equal (load32 (+ o 12)) 32)
              (sc-it! "maker names are sorted bytewise after the empty maker 0")
              (lb-str-equal (+ o 32) "") (lb-str-equal (+ o 56) "HP") (lb-str-equal (+ o 80) "Intel") (lb-str-equal (+ o 104) "Raspberry Pi")
              (sc-it! "entries are prefix | maker << 24, in prefix order")
              (lb-equal (load32 (+ o 16)) 33561377) (lb-equal (load32 (+ o 20)) 17301513)
              (lb-equal (load32 (+ o 24)) 62400491) (lb-equal (load32 (+ o 28)) 64792114)
              (sc-it! "nothing after the name table (16 + 4 x 4 + 24 x 4 bytes)") (lb-equal n 128)))
        (sc-it! "refuses prefixes out of order (line 2)") (og-refuses (nk-oui-pack (og-in! "b8:27:eb\tA\n00:1b:21\tB\n")) -2 2)
        (sc-it! "refuses a duplicate prefix (line 2)") (og-refuses (nk-oui-pack (og-in! "b8:27:eb\tA\nb8:27:eb\tB\n")) -2 2)
        (sc-it! "refuses a maker name over 23 bytes (line 1)")
        (og-refuses (nk-oui-pack (og-in! "b8:27:eb\txxxxxxxxxxxxxxxxxxxxxxxx\n")) -3 1)
        (sc-it! "refuses a line with no tab (line 1)") (og-refuses (nk-oui-pack (og-in! "b8:27:eb Raspberry Pi\n")) -1 1)
        (sc-it! "refuses more than 255 makers (line 256)") (og-refuses (nk-oui-pack (og-many-makers!)) -4 256)
        (sc-it! "refuses a table that would not fit the scanner's 64 KB region") (lb-equal (nk-oui-pack (og-too-big!)) -5)
      (sc-end!)))

(defn og-checked-in! [] : Unit
  (do (sc-describe! "the checked-in table (file 0: oui_brands.tsv, file 1: the page build's oui.bin)")
        (sc-it! "the checked-in TSV was made by PARENA")
        (lb-text-have-prefix (sc-file-addr 0) (sc-file-len 0) "# Netkit manufacturer table -- generated by PARENA")
        (dotimes [k (sc-file-len 0)] (store8! (+ (nk-oui-gen-in-addr) k) (load8 (+ (sc-file-addr 0) k))))
        (let [n (nk-oui-pack (sc-file-len 0))]
          (do (sc-it! "it packs") (lb-text-equal (og-out) 4 "NKOU")
              (sc-it! "byte for byte the oui.bin scripts/build_netkit_oui.sh wrote (the node host path)")
              (lb-equal n (sc-file-len 1)) (lb-bytes-equal (og-out) (sc-file-addr 1) n)))
      (sc-end!)))

(defn scarab-main [] : I32
  (do (sc-describe! "nk_oui_gen")
        (og-curate!) (og-pack!) (og-checked-in!)
      (sc-end!)
      (sc-finish!)))
