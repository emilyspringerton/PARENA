;; tests/netkit/edit_spec.prn -- SCARAB/LADYBUG suite for stdlib/netkit/nk_edit.prn (the Drive editor's document) and nk_kit.prn
;; (the VNC kit written to a USB drive). Run: scripts/scarab_wasm.sh tests/netkit/edit_spec.prn --modules stdlib/netkit/MODULES

(defn et-load! [(s : String)] : I32 (nk-ed-load (sc-put! (ed-buf) s)))
(defn et-type! [(s : String)] : I32 (nk-ed-insert (sc-put! (txt-base) s)))
(defn et-doc [(s : String)] : Unit (lb-text-equal (ed-buf) (nk-ed-len) s))
(defn et-exp [(s : String)] : Unit (lb-text-equal (ed-exp) (nk-ed-export) s))
(defn et-key! [(k : I32) (m : I32)] : I32 (nk-ed-key k m))
(defn et-pw [(s : String)] : I32 (nk-kit-pw-check (sc-put! (txt-base) s)))
(defn et-name [(s : String)] : I32 (nk-ed-eol-for-name (sc-put! (txt-base) s)))
(defn et-find! [(s : String)] : I32 (nk-ed-find (sc-put! (txt-base) s)))
;; does the n bytes at a contain the literal s?
(defn et-has? [(a : I32) (n : I32) (s : String)] : Bool
  (let [p (str-addr s) m (sc-strlen p)]
    (loop [i 0]
      (if (> (+ i m) n) false
          (if (loop [j 0] (if (>= j m) true (if (= (load8 (+ a (+ i j))) (load8 (+ p j))) (recur (+ j 1)) false))) true (recur (+ i 1)))))))

(defn scarab-main [] : I32
  (do (sc-describe! "nk_edit")
        (sc-describe! "loading a file")
          (sc-it! "keeps a Unix file as it is and saves it unchanged")
          (et-load! "one\ntwo\n") (et-doc "one\ntwo\n") (lb-equal (nk-ed-eol) 0) (lb-equal (nk-ed-lines) 3) (et-exp "one\ntwo\n")
          (sc-it! "holds a Windows file as LF and saves it with CRLF again, byte for byte")
          (et-load! "@echo off\r\nrem hi\r\n") (et-doc "@echo off\nrem hi\n") (lb-equal (nk-ed-eol) 1) (et-exp "@echo off\r\nrem hi\r\n")
          (sc-it! "keeps a UTF-8 byte-order mark out of the text and puts it back on save")
          (et-load! "\xef\xbb\xbfhi") (et-doc "hi") (lb-equal (nk-ed-export) 5) (lb-hex-equal (ed-exp) 5 "efbbbf6869")
          (sc-it! "turns a lone CR (old Mac) into a line break")
          (et-load! "a\rb") (et-doc "a\nb") (lb-equal (nk-ed-lines) 2)
          (sc-it! "flags a file with zero bytes in it as not text")
          (lb-equal (nk-ed-load (sc-hex! (ed-buf) "4d5a0000")) 4) (lb-equal (nk-ed-binary) 1) (lb-equal (nk-ed-msg) 3)
          (sc-it! "cuts a file bigger than 1 MB and says so")
          (do (sc-fill! (ed-buf) 65 (+ (nk-ed-cap) 10)) (lb-equal (nk-ed-load (+ (nk-ed-cap) 10)) (nk-ed-cap)))
          (lb-equal (nk-ed-cut) 1) (lb-equal (nk-ed-msg) 4)
          (sc-it! "starts clean: cursor at 0, nothing to undo, not dirty")
          (et-load! "x") (lb-equal (nk-ed-cursor) 0) (lb-equal (nk-ed-can-undo) 0) (lb-equal (nk-ed-dirty) 0)
        (sc-end!)
        (sc-describe! "typing")
          (sc-it! "inserts at the cursor and moves past it")
          (et-load! "ac") (et-key! 2 0) (et-type! "b") (et-doc "abc") (lb-equal (nk-ed-cursor) 2) (lb-equal (nk-ed-dirty) 1)
          (sc-it! "a pasted CRLF block goes in as LF")
          (et-load! "") (et-type! "x\r\ny\r\n") (et-doc "x\ny\n") (lb-equal (nk-ed-cursor) 4)
          (sc-it! "typing over a selection replaces it")
          (et-load! "hello world") (et-key! 16 1) (lb-equal (nk-ed-has-sel) 1) (nk-ed-click 0 6 0) (et-key! 16 1)
          (et-type! "there") (et-doc "hello there") (lb-equal (nk-ed-has-sel) 0)
          (sc-it! "Backspace deletes one whole UTF-8 character")
          (et-load! "a\xc3\xa9") (et-key! 16 0) (et-key! 7 0) (et-doc "a") (lb-equal (nk-ed-cursor) 1)
          (sc-it! "Delete removes the character after the cursor, and nothing at the end")
          (et-load! "ab") (et-key! 8 0) (et-doc "b") (et-key! 16 0) (lb-equal (et-key! 8 0) 1) (et-doc "b")
          (sc-it! "Ctrl+Backspace deletes the word before the cursor")
          (et-load! "set VNC_PORT") (et-key! 16 0) (et-key! 7 2) (et-doc "set ")
          (sc-it! "Enter keeps the line's indent")
          (et-load! "  if x") (et-key! 16 0) (et-key! 9 0) (et-type! "y") (et-doc "  if x\n  y")
          (sc-it! "Tab inserts a tab")
          (et-load! "") (et-key! 10 0) (et-doc "\t")
          (sc-it! "refuses an insert that would pass 1 MB and leaves the text alone")
          (do (sc-fill! (ed-buf) 66 (- (nk-ed-cap) 1)) (nk-ed-load (- (nk-ed-cap) 1)))
          (lb-equal (et-type! "xy") -1) (lb-equal (nk-ed-len) (- (nk-ed-cap) 1)) (lb-equal (nk-ed-msg) 2)
        (sc-end!)
        (sc-describe! "moving")
          (sc-it! "Up and Down keep the column you started from across a short line")
          (et-load! "abcdef\nab\nabcdef") (nk-ed-click 0 5 0) (et-key! 4 0) (lb-equal (nk-ed-cursor) 9) (et-key! 4 0)
          (lb-equal (nk-ed-row) 2) (lb-equal (nk-ed-vcol) 5)
          (sc-it! "Up on the first line goes to the start, Down on the last to the end")
          (et-load! "ab\ncd") (nk-ed-click 0 1 0) (et-key! 3 0) (lb-equal (nk-ed-cursor) 0)
          (nk-ed-click 1 1 0) (et-key! 4 0) (lb-equal (nk-ed-cursor) 5)
          (sc-it! "Home goes to the first non-blank, then to the line start")
          (et-load! "   rem") (et-key! 6 0) (et-key! 5 0) (lb-equal (nk-ed-cursor) 3) (et-key! 5 0) (lb-equal (nk-ed-cursor) 0)
          (sc-it! "Left with a selection collapses it to its start")
          (et-load! "abcd") (nk-ed-click 0 1 0) (et-key! 2 1) (et-key! 2 1) (lb-equal (nk-ed-sel-start) 1) (lb-equal (nk-ed-sel-end) 3)
          (et-key! 1 0) (lb-equal (nk-ed-cursor) 1) (lb-equal (nk-ed-has-sel) 0)
          (sc-it! "Ctrl+Right jumps over a word")
          (et-load! "netsh advfirewall") (et-key! 2 2) (lb-equal (nk-ed-cursor) 5)
          (sc-it! "a tab counts to the next multiple of 4 columns, and a tap lands accordingly")
          (et-load! "\tx") (et-key! 16 0) (lb-equal (nk-ed-vcol) 5) (nk-ed-click 0 4 0) (lb-equal (nk-ed-cursor) 1)
          (sc-it! "a tap past the end of a line lands at its end; past the last line, on the last line")
          (et-load! "ab\ncd") (nk-ed-click 0 40 0) (lb-equal (nk-ed-cursor) 2) (nk-ed-click 9 0 0) (lb-equal (nk-ed-cursor) 3)
          (sc-it! "Page Down moves the page height set by the page")
          (et-load! "0\n1\n2\n3\n4\n5") (nk-ed-set-page 3) (et-key! 12 0) (lb-equal (nk-ed-row) 3)
          (sc-it! "Select All, then typing, replaces everything")
          (et-load! "old\ntext") (et-key! 13 0) (et-type! "new") (et-doc "new")
        (sc-end!)
        (sc-describe! "undo")
          (sc-it! "undoes a typed word in one step and restores the cursor")
          (et-load! "x") (et-key! 16 0) (et-type! "a") (et-type! "b") (et-type! "c") (lb-equal (nk-ed-undo) 1) (et-doc "x")
          (lb-equal (nk-ed-cursor) 1) (lb-equal (nk-ed-dirty) 0) (lb-equal (nk-ed-can-undo) 0)
          (sc-it! "a space starts a new undo step")
          (et-load! "") (et-type! "a") (et-type! " ") (et-type! "b") (nk-ed-undo) (et-doc "a ") (nk-ed-undo) (et-doc "a")
          (sc-it! "undoes a deleted selection")
          (et-load! "keep this") (et-key! 13 0) (et-key! 7 0) (et-doc "") (nk-ed-undo) (et-doc "keep this")
          (sc-it! "undo back to the saved point clears dirty; past it sets it again")
          (et-load! "") (et-type! "a") (et-type! " ") (nk-ed-saved) (et-type! "b") (lb-equal (nk-ed-dirty) 1)
          (nk-ed-undo) (lb-equal (nk-ed-dirty) 0) (nk-ed-undo) (lb-equal (nk-ed-dirty) 1)
          (sc-it! "moving the cursor ends the typing step")
          (et-load! "") (et-type! "a") (et-key! 1 0) (et-type! "b") (nk-ed-undo) (et-doc "a")
          (sc-it! "Ctrl+Z (key 14) is undo")
          (et-load! "") (et-type! "q") (lb-equal (et-key! 14 2) 1) (et-doc "")
        (sc-end!)
        (sc-describe! "find, line ends, new files")
          (sc-it! "finds case-insensitively after the selection and wraps")
          (et-load! "VNC vnc Vnc") (lb-equal (et-find! "vnc") 1) (lb-equal (nk-ed-sel-start) 0) (lb-equal (et-find! "vnc") 1)
          (lb-equal (nk-ed-sel-start) 4) (et-find! "vnc") (et-find! "vnc") (lb-equal (nk-ed-sel-start) 0)
          (sc-it! "says Not found")
          (lb-equal (et-find! "zzz") 0) (lb-equal (nk-ed-msg) 5) (lb-str-equal (nk-ed-msg-text-addr 5) "Not found")
          (sc-it! "switching a file to CRLF marks it changed and saves CRLF")
          (et-load! "a\nb") (nk-ed-set-eol 1) (lb-equal (nk-ed-dirty) 1) (et-exp "a\r\nb")
          (lb-str-equal (nk-ed-eol-text-addr) "Windows (CRLF)")
          (sc-it! "a new .bat, .cmd, .ps1, .txt or .conf gets Windows line ends; .sh and no extension do not")
          (lb-equal (et-name "run.bat") 1) (lb-equal (et-name "X.CMD") 1) (lb-equal (et-name "a.ps1") 1) (lb-equal (et-name "NETKIT.TXT") 1)
          (lb-equal (et-name "setup.conf") 1) (lb-equal (et-name "go.sh") 0) (lb-equal (et-name "README") 0)
          (sc-it! "a new document is empty with the asked-for line ends")
          (nk-ed-new 1) (lb-equal (nk-ed-len) 0) (lb-equal (nk-ed-lines) 1) (et-type! "a\nb") (et-exp "a\r\nb")
        (sc-end!)
      (sc-end!)
      (sc-describe! "nk_kit")
        (sc-it! "accepts a 6-8 character password")
        (lb-equal (et-pw "s3cret!x") 0) (lb-equal (et-pw "abc%^&") 0)
        (sc-it! "refuses empty, over 8, a double quote, a trailing backslash, a space at the ends, non-ASCII")
        (lb-equal (et-pw "") 1) (lb-equal (et-pw "123456789") 2) (lb-equal (et-pw "ab\"cdef") 3) (lb-equal (et-pw "abcdef\\") 4)
        (lb-equal (et-pw " abcdef") 3) (lb-equal (et-pw "abc\xc3\xa9ef") 3)
        (sc-it! "warns under 6")
        (lb-equal (et-pw "abc") 6) (lb-str-equal (nk-kit-pw-text-addr 6) "OK, but 6 to 8 characters is safer")
        (sc-it! "writes setup.conf with the password, speech on, no pause, CRLF")
        (let [n (nk-kit-conf (sc-put! (txt-base) "pa55word") 0)]
          (do (lb-be-true (et-has? (ed-exp) n "\r\nVNC_PASSWORD=pa55word\r\n")) (lb-be-true (et-has? (ed-exp) n "\r\nSPEAK=1\r\n"))
              (lb-be-true (et-has? (ed-exp) n "\r\nNOPAUSE=1\r\n")) (lb-be-true (et-has? (ed-exp) n "NETWORK_PRIVATE=0\r\n"))
              (lb-be-false (et-has? (ed-exp) n "pa55word\n"))))
        (sc-it! "the Private-network option")
        (let [n (nk-kit-conf (sc-put! (txt-base) "pa55word") 1)] (lb-be-true (et-has? (ed-exp) n "NETWORK_PRIVATE=1\r\n")))
        (sc-it! "NETKIT.TXT carries the exact launcher line and the steps")
        (let [n (nk-kit-readme)]
          (do (lb-be-true (et-has? (ed-exp) n "Get-PSDrive -PSProvider FileSystem|%{if(Test-Path($_.Root+'NETKIT.TXT')){& ($_.Root+'setup.bat') /nopause}}"))
              (lb-be-true (et-has? (ed-exp) n "Ctrl+Shift+Enter")) (lb-be-true (et-has? (ed-exp) n "Alt+Y"))
              (lb-be-false (et-has? (ed-exp) n "\n\n"))))
        (sc-it! "the launcher line looks for the marker this kit writes")
        (lb-be-true (et-has? (nk-kit-run-line-addr) 200 "NETKIT.TXT"))
      (sc-end!)
      (sc-finish!)))
