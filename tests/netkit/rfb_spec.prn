;; tests/netkit/rfb_spec.prn -- SCARAB/LADYBUG suite for stdlib/netkit/nk_rfb.prn (the VNC viewer) against a scripted fake server.
;; Replaces tests/netkit/test_rfb.py. Every scenario that matters is also run with the server's bytes fed one at a time and in random
;; chunks: the parser is a sans-IO state machine that must not care how TCP slices the stream. The Hextile expectations come from an
;; INDEPENDENT encoder written here from the RFB text (RFC 6143 7.7.4); CopyRect from a snapshot reference; the VNC-auth answer from
;; the spec's own key bit-reversal over the DES block (DES itself is checked against pycryptodome in des_spec.prn).
;; Run: scripts/scarab_wasm.sh tests/netkit/rfb_spec.prn --modules stdlib/netkit/MODULES

;; ---- memory the spec uses ------------------------------------------------------------------------------------------------------
;;   scratch + 0       spec words (64): 0 PRNG state, 1 built length, 2 sent length, 3 hextile bg, 4 hextile fg,
;;                     5 one-colour subrect tiles encoded, 6 of those that reused the foreground
;;   scratch + 0x1000  SENT   everything the client sent since rf-sent-reset! (60 KB)
;;   scratch + 0x20000 EXP    the expected framebuffer (w x h x 4)
;;   scratch + 0x60000 BASE   a snapshot of the painted image (CopyRect)
;;   scratch + 0x80000 IMG    a hextile image as palette indices (1 word per pixel)
;;   file area         BUILD  the server's bytes being built (this suite loads no files; up to 24 MB, the 1080p frame needs 8.3)
(defn rf-w [(k : I32)] : I32 (load32 (+ (sc-scratch) (* 4 k))))
(defn rf-w! [(k : I32) (v : I32)] : Unit (store32! (+ (sc-scratch) (* 4 k)) v))
(defn rf-sent [] : I32 (+ (sc-scratch) 4096))
(defn rf-exp [] : I32 (+ (sc-scratch) 131072))
(defn rf-base [] : I32 (+ (sc-scratch) 393216))
(defn rf-img [] : I32 (+ (sc-scratch) 524288))
(defn rf-build [] : I32 (sc-file-data))
(defn rf-out-addr [] : I32 524288)       ; OUT (0x80000)
(defn rf-pw [] : I32 204800)             ; PW (0x32000)
(defn rf-name [] : I32 205056)           ; NAME (0x32100)
(defn rf-reason [] : I32 205312)         ; REASON (0x32200)
(defn rf-fb [] : I32 16777216)           ; FB (0x1000000)

;; ---- a deterministic PRNG (xorshift32) for chunk sizes, pixels, challenges ------------------------------------------------------
(defn rf-seed! [(s : I32)] : Unit (rf-w! 0 s))
(defn rf-rand [] : I32
  (let [x0 (rf-w 0) x1 (bit-xor x0 (shl x0 13)) x2 (bit-xor x1 (bit-and (shr x1 17) 32767)) x3 (bit-xor x2 (shl x2 5))]
    (do (rf-w! 0 x3) (bit-and x3 2147483647))))
(defn rf-below [(n : I32)] : I32 (mod (rf-rand) n))

;; ---- building the server's bytes ---------------------------------------------------------------------------------------------
(defn rf-new! [] : Unit (rf-w! 1 0))
(defn rf-len [] : I32 (rf-w 1))
(defn rf-b! [(v : I32)] : Unit (do (store8! (+ (rf-build) (rf-w 1)) (bit-and v 255)) (rf-w! 1 (+ (rf-w 1) 1))))
(defn rf-16! [(v : I32)] : Unit (do (rf-b! (shr v 8)) (rf-b! v)))
(defn rf-32! [(v : I32)] : Unit (do (rf-b! (bit-and (shr v 24) 255)) (rf-b! (shr v 16)) (rf-b! (shr v 8)) (rf-b! v)))
(defn rf-s! [(s : String)] : Unit (rf-w! 1 (+ (rf-w 1) (sc-put! (+ (rf-build) (rf-w 1)) s))))
(defn rf-zeros! [(n : I32)] : Unit (rf-w! 1 (+ (rf-w 1) (sc-fill! (+ (rf-build) (rf-w 1)) 0 n))))
(defn rf-server-init! [(w : I32) (h : I32)] : Unit (do (rf-16! w) (rf-16! h) (rf-zeros! 16) (rf-32! 9) (rf-s! "TEST-IMAC")))
(defn rf-fbu! [(rects : I32)] : Unit (do (rf-b! 0) (rf-b! 0) (rf-16! rects)))
(defn rf-rect! [(x : I32) (y : I32) (w : I32) (h : I32) (enc : I32)] : Unit (do (rf-16! x) (rf-16! y) (rf-16! w) (rf-16! h) (rf-32! enc)))

;; ---- delivering them the way the page host does: reserve, write, feed. mode 0 whole, 1 byte at a time, 2 random chunks 1..97 --
(defn rf-feed-at [(src : I32) (n : I32) (mode : I32)] : Unit
  (loop [i 0]
    (when (< i n)
      (let [want (cond (= mode 0) (- n i) (= mode 1) 1 :else (+ 1 (rf-below 97)))
            k0 (if (< want (- n i)) want (- n i))
            k1 (if (< k0 (nk-in-space)) k0 (nk-in-space))
            k (if (< k1 60000) k1 60000)
            p (nk-in-reserve)]
        (do (dotimes [j k] (store8! (+ p j) (load8 (+ src (+ i j)))))
            (nk-rfb-feed k)
            (recur (+ i k)))))))
(defn rf-send! [(mode : I32)] : Unit (rf-feed-at (rf-build) (rf-len) mode))     ; feed what was built
(defn rf-say! [(s : String) (mode : I32)] : Unit (do (rf-new!) (rf-s! s) (rf-send! mode)))

;; what the client sent: appended to SENT, OUT cleared
(defn rf-sent-reset! [] : Unit (rf-w! 2 0))
(defn rf-out! [] : Unit
  (let [n (nk-out-len) at (rf-w 2)]
    (do (dotimes [i n] (store8! (+ (rf-sent) (+ at i)) (load8 (+ (rf-out-addr) i))))
        (rf-w! 2 (+ at n)) (nk-out-clear))))
(defn rf-sent-len [] : I32 (rf-w 2))

(defn rf-begin! [(pw : String)] : Unit
  (do (sc-fill! (rf-pw) 0 16) (rf-sent-reset!) (nk-rfb-begin (sc-put! (rf-pw) pw))))

;; the VNC-auth answer, computed here: each key byte bit-reversed (RFB's DES quirk), both challenge halves DES-encrypted
(defn rf-rev8 [(b : I32)] : I32 (loop [i 0 r 0] (if (= i 8) r (recur (+ i 1) (bit-or (shl r 1) (bit-and (shr b i) 1))))))
(defn rf-vnc-answer [(chal : I32) (pw : String) (out : I32)] : I32
  (let [key (+ (sc-scratch) 2048) p (str-addr pw) n (sc-strlen p)]
    (do (dotimes [i 8] (store8! (+ key i) (if (< i n) (rf-rev8 (load8 (+ p i))) 0)))
        (nk-des-test key chal out 1) (nk-des-test key (+ chal 8) (+ out 8) 1) out)))

;; the 3.8 + VNC auth handshake with password "secret" and a 64x48 screen; returns where the 16-byte challenge is
(defn rf-chal [] : I32 (+ (sc-scratch) 2560))
(defn rf-handshake! [(mode : I32)] : I32
  (do (rf-begin! "secret")
      (rf-say! "RFB 003.008\n" mode) (rf-out!)
      (rf-new!) (rf-b! 1) (rf-b! 2) (rf-send! mode) (rf-out!)
      (dotimes [i 16] (store8! (+ (rf-chal) i) (rf-below 256)))
      (rf-feed-at (rf-chal) 16 mode) (rf-out!)
      (rf-new!) (rf-32! 0) (rf-send! mode) (rf-out!)
      (rf-new!) (rf-server-init! 64 48) (rf-send! mode) (rf-out!)
      (rf-chal)))

;; 1 when every client message in [a, a+n) is SetPixelFormat (0, 20 bytes), SetEncodings (2, 4 + 4k) or a
;; FramebufferUpdateRequest (3, 10) -- never a key, pointer or clipboard message (4 / 5 / 6), and they tile the bytes exactly
(defn rf-view-only? [(a : I32) (n : I32)] : I32
  (loop [i 0]
    (if (>= i n) (if (= i n) 1 0)
        (let [t (load8 (+ a i))]
          (cond (= t 0) (recur (+ i 20))
                (= t 2) (recur (+ i (+ 4 (* 4 (sc-be16 (+ a (+ i 2)))))))
                (= t 3) (recur (+ i 10))
                :else 0)))))

(defn rf-mode-name [(mode : I32)] : String (cond (= mode 0) "delivered whole" (= mode 1) "delivered a byte at a time" :else "delivered in random chunks"))

(defn rf-handshakes! [] : Unit
  (do (sc-describe! "the 3.8 + VNC auth handshake")
        (dotimes [mode 3]
          (do (sc-context! (rf-mode-name mode))
                (let [chal (rf-handshake! mode) s (rf-sent)]
                  (do (sc-it! "the client greets RFB 003.008 and picks VNC auth (2)") (lb-text-equal s 13 "RFB 003.008\n\x02")
                      (sc-it! "the auth answer is DES(bit-reversed key, challenge), 16 bytes")
                      (lb-bytes-equal (+ s 13) (rf-vnc-answer chal "secret" (+ (sc-scratch) 3072)) 16)
                      (sc-it! "it reaches the running state with the server's 64x48 screen")
                      (lb-equal (nk-rfb-phase) 3) (lb-equal (nk-rfb-width) 64) (lb-equal (nk-rfb-height) 48)
                      (sc-it! "the desktop name is captured") (lb-str-equal (rf-name) "TEST-IMAC")
                      (sc-it! "ClientInit asks for a SHARED session (never kicks the other viewer)") (lb-equal (load8 (+ s 29)) 1)
                      (sc-it! "then exactly SetPixelFormat (32bpp LE true-colour, shifts 0/8/16), SetEncodings (CopyRect, Hextile, Raw, DesktopSize) and a full, non-incremental request")
                      (lb-equal (rf-sent-len) 80)
                      (lb-hex-equal (+ s 30) 20 "00000000 20180001 00ff00ff 00ff0008 10000000")
                      (lb-hex-equal (+ s 50) 20 "02000004 00000001 00000005 00000000 ffffff21")
                      (lb-hex-equal (+ s 70) 10 "03 00 0000 0000 0040 0030")))
              (sc-end!)))
      (sc-end!)))

(defn rf-failures! [] : Unit
  (do (sc-describe! "a wrong password")
        (sc-it! "fails with AUTH_FAILED / 'Wrong password' and keeps the server's own reason")
        (rf-begin! "wrong") (rf-say! "RFB 003.008\n" 0) (rf-out!) (rf-new!) (rf-b! 1) (rf-b! 2) (rf-send! 0) (rf-out!)
        (rf-new!) (rf-zeros! 16) (rf-send! 0) (rf-out!)
        (rf-new!) (rf-32! 1) (rf-32! 21) (rf-s! "Authentication failed") (rf-send! 0)
        (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-kind) 4) (lb-equal (nk-err-msg) 5) (lb-str-equal (rf-reason) "Authentication failed")
        (sc-it! "AUTH_FAILED has the plain-words sentence from PARENA") (lb-str-equal (nk-err-text-addr 4) "Wrong username or password")
        (sc-it! "the same, a byte at a time, with the reason split across feeds")
        (rf-begin! "wrong") (rf-say! "RFB 003.008\n" 1) (rf-out!) (rf-new!) (rf-b! 1) (rf-b! 2) (rf-send! 1) (rf-out!)
        (rf-new!) (rf-zeros! 16) (rf-send! 1) (rf-out!)
        (rf-new!) (rf-32! 1) (rf-32! 21) (rf-s! "Authentication failed") (rf-send! 1)
        (lb-equal (nk-rfb-phase) 9) (lb-str-equal (rf-reason) "Authentication failed")
      (sc-end!)
      (sc-describe! "other versions and security types")
        (sc-it! "3.8 + None offered, no password: picks None (1), then waits for SecurityResult (3.8 sends one even for None), then runs")
        (rf-begin! "") (rf-say! "RFB 003.008\n" 0) (rf-out!) (rf-sent-reset!) (rf-new!) (rf-b! 1) (rf-b! 1) (rf-send! 0) (rf-out!)
        (lb-text-equal (rf-sent) (rf-sent-len) "\x01") (lb-equal (nk-rfb-state) 5)
        (rf-new!) (rf-32! 0) (rf-server-init! 32 32) (rf-send! 0) (rf-out!) (lb-equal (nk-rfb-phase) 3)
        (sc-it! "server 3.7: the client answers 3.7; with None NO SecurityResult follows, straight to ServerInit")
        (rf-begin! "") (rf-say! "RFB 003.007\n" 0) (rf-out!) (lb-text-equal (rf-sent) (rf-sent-len) "RFB 003.007\n")
        (rf-new!) (rf-b! 1) (rf-b! 1) (rf-send! 0) (rf-out!) (lb-equal (nk-rfb-state) 6)
        (rf-new!) (rf-server-init! 16 16) (rf-send! 0) (rf-out!) (lb-equal (nk-rfb-phase) 3)
        (sc-it! "server 3.3: the client answers 3.3; the server dictates VNC auth; the answer is right for a 2-character password")
        (rf-begin! "pw") (rf-say! "RFB 003.003\n" 0) (rf-out!) (lb-text-equal (rf-sent) (rf-sent-len) "RFB 003.003\n")
        (rf-sent-reset!) (rf-new!) (rf-32! 2) (rf-send! 0)
        (dotimes [i 16] (store8! (+ (rf-chal) i) i)) (rf-feed-at (rf-chal) 16 0) (rf-out!)
        (lb-equal (rf-sent-len) 16) (lb-bytes-equal (rf-sent) (rf-vnc-answer (rf-chal) "pw" (+ (sc-scratch) 3072)) 16)
        (rf-new!) (rf-32! 0) (rf-server-init! 16 16) (rf-send! 0) (rf-out!) (lb-equal (nk-rfb-phase) 3)
        (sc-it! "3.3 + None: straight to ServerInit") (rf-begin! "") (rf-say! "RFB 003.003\n" 0) (rf-out!) (rf-new!) (rf-32! 1) (rf-send! 0) (rf-out!) (lb-equal (nk-rfb-state) 6)
        (sc-it! "Apple-style 003.889 is treated as 3.8") (rf-begin! "") (rf-say! "RFB 003.889\n" 0) (rf-out!) (lb-text-equal (rf-sent) (rf-sent-len) "RFB 003.008\n")
        (sc-it! "both None and VNC auth offered, password given: uses VNC auth")
        (rf-begin! "x") (rf-say! "RFB 003.008\n" 0) (rf-out!) (rf-sent-reset!) (rf-new!) (rf-b! 2) (rf-b! 1) (rf-b! 2) (rf-send! 0) (rf-out!)
        (lb-text-equal (rf-sent) (rf-sent-len) "\x02")
        (sc-it! "VNC auth only, no password saved: AUTH_FAILED 'This server needs a password' (no guessing)")
        (rf-begin! "") (rf-say! "RFB 003.008\n" 0) (rf-out!) (rf-new!) (rf-b! 1) (rf-b! 2) (rf-send! 0)
        (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-kind) 4) (lb-equal (nk-err-msg) 4)
        (sc-it! "only MS-Logon / ARD offered: PROTOCOL 'only offers login methods this app doesn't support'")
        (rf-begin! "x") (rf-say! "RFB 003.008\n" 0) (rf-out!) (rf-new!) (rf-b! 2) (rf-b! 30) (rf-b! 33) (rf-send! 0)
        (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-kind) 5) (lb-equal (nk-err-msg) 3)
        (sc-it! "zero security types: the server's reason is surfaced")
        (rf-begin! "") (rf-say! "RFB 003.008\n" 0) (rf-out!) (rf-new!) (rf-b! 0) (rf-32! 14) (rf-s! "Too many users") (rf-send! 0)
        (lb-equal (nk-rfb-phase) 9) (lb-str-equal (rf-reason) "Too many users") (lb-equal (nk-err-msg) 2)
        (sc-it! "an HTTP server (not VNC): PROTOCOL 'Not a VNC server (bad greeting)'")
        (rf-begin! "") (rf-say! "GET / HTTP/1.1\r\n" 0) (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-kind) 5) (lb-equal (nk-err-msg) 1)
        (sc-it! "a truncated greeting just waits") (rf-begin! "") (rf-say! "RFB 003.00" 0) (lb-equal (nk-rfb-phase) 1)
        (nk-rfb-closed)
        (sc-it! "...and the transport closing mid-handshake is a failure") (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-kind) 5)
      (sc-end!)))

;; a running session with no auth (3.8 + None), w x h, the dirty box cleared
(defn rf-running! [(w : I32) (h : I32) (mode : I32)] : Unit
  (do (rf-begin! "") (rf-say! "RFB 003.008\n" mode) (rf-out!) (rf-new!) (rf-b! 1) (rf-b! 1) (rf-send! mode) (rf-out!)
      (rf-new!) (rf-32! 0) (rf-send! mode) (rf-new!) (rf-server-init! w h) (rf-send! mode) (rf-out!)
      (nk-rfb-dirty-clear) (rf-sent-reset!)))
;; the expected image: all opaque black, then pixels set with rf-exp-px!
(defn rf-exp-clear! [(w : I32) (h : I32)] : Unit (dotimes [i (* w h)] (store32! (+ (rf-exp) (* 4 i)) -16777216)))
(defn rf-exp-px! [(w : I32) (x : I32) (y : I32) (r : I32) (g : I32) (b : I32)] : Unit
  (store32! (+ (rf-exp) (* 4 (+ (* y w) x))) (bit-or -16777216 (bit-or (shl b 16) (bit-or (shl g 8) r)))))
(defn rf-fb-matches [(w : I32) (h : I32)] : Unit (lb-bytes-equal (rf-fb) (rf-exp) (* 4 (* w h))))

(defn rf-raw! [] : Unit
  (do (sc-describe! "Raw")
        (dotimes [mode 3]
          (do (sc-context! (rf-mode-name mode))
                (rf-running! 40 30 mode) (rf-exp-clear! 40 30)
                (rf-new!) (rf-fbu! 1) (rf-rect! 5 7 13 9 0)
                (dotimes [j 9]
                  (dotimes [i 13]
                    (let [r (rf-below 256) g (rf-below 256) b (rf-below 256)]
                      (do (rf-exp-px! 40 (+ 5 i) (+ 7 j) r g b) (rf-b! r) (rf-b! g) (rf-b! b) (rf-b! (rf-below 256))))))
                (rf-send! mode)
                (sc-it! "a Raw rect decodes exactly (alpha forced to 255 despite a junk 4th byte)") (rf-fb-matches 40 30)
                (sc-it! "the dirty box is exactly the rect")
                (lb-equal (nk-rfb-dirty) 1) (lb-equal (nk-rfb-dx0) 5) (lb-equal (nk-rfb-dy0) 7) (lb-equal (nk-rfb-dx1) 18) (lb-equal (nk-rfb-dy1) 16)
                (rf-out!)
                (sc-it! "after the update the client asks for the next one, incrementally") (lb-hex-equal (rf-sent) (rf-sent-len) "03 01 0000 0000 0028 001e")
                (sc-it! "the frame counter advanced") (lb-equal (nk-rfb-frames) 1)
              (sc-end!)))
      (sc-end!)))

;; ---- Hextile, encoded independently (RFC 6143 7.7.4). The image is palette indices; tiles are randomly raw / solid / subrects
;; in one colour / coloured subrects, and the background and foreground registers persist across tiles (flags omitted when
;; unchanged), exactly as a real server may send them.
(defn rf-pal-r [(k : I32)] : I32 (cond (= k 0) 255 (= k 1) 0 (= k 2) 0 (= k 3) 10 (= k 4) 200 :else 1))
(defn rf-pal-g [(k : I32)] : I32 (cond (= k 0) 0 (= k 1) 255 (= k 2) 0 (= k 3) 20 (= k 4) 200 :else 2))
(defn rf-pal-b [(k : I32)] : I32 (cond (= k 0) 0 (= k 1) 0 (= k 2) 255 (= k 3) 30 (= k 4) 50 :else 3))
(defn rf-pix! [(k : I32)] : Unit (do (rf-b! (rf-pal-r k)) (rf-b! (rf-pal-g k)) (rf-b! (rf-pal-b k)) (rf-b! 0)))
(defn rf-im [(rw : I32) (i : I32) (j : I32)] : I32 (load32 (+ (rf-img) (* 4 (+ (* j rw) i)))))
;; the most common colour in the tile at (tx, ty), tw x th
(defn rf-count [(rw : I32) (tx : I32) (ty : I32) (tw : I32) (th : I32) (k : I32)] : I32
  (loop [j 0 i 0 n 0]
    (cond (>= j th) n (>= i tw) (recur (+ j 1) 0 n)
          :else (recur j (+ i 1) (+ n (if (= (rf-im rw (+ tx i) (+ ty j)) k) 1 0))))))
(defn rf-most [(rw : I32) (tx : I32) (ty : I32) (tw : I32) (th : I32)] : I32
  (loop [k 0 best 0 bn -1]
    (if (= k 6) best
        (let [n (rf-count rw tx ty tw th k)] (if (> n bn) (recur (+ k 1) k n) (recur (+ k 1) best bn))))))
;; walk the tile's subrects (row runs of one non-background colour, at most 16 wide). what 0: how many; 1: how many distinct
;; colours (1 or more, as 1 / 2); 2: the first colour; 3: emit them (coloured = 1 adds each one's pixel first)
(defn rf-subs [(rw : I32) (tx : I32) (ty : I32) (tw : I32) (th : I32) (bg : I32) (what : I32) (coloured : I32)] : I32
  (loop [j 0 i 0 n 0 first -1 many 0]
    (cond (>= j th) (cond (= what 0) n (= what 1) (if (= many 1) 2 1) :else first)
          (>= i tw) (recur (+ j 1) 0 n first many)
          (= (rf-im rw (+ tx i) (+ ty j)) bg) (recur j (+ i 1) n first many)
          :else (let [c (rf-im rw (+ tx i) (+ ty j))
                      k (loop [k i] (if (and (< k tw) (and (= (rf-im rw (+ tx k) (+ ty j)) c) (< (- k i) 16))) (recur (+ k 1)) k))]
                  (do (when (= what 3)
                        (do (when (= coloured 1) (rf-pix! c))
                            (rf-b! (bit-or (shl i 4) j)) (rf-b! (shl (- (- k i) 1) 4))))
                      (recur j k (+ n 1) (if (< first 0) c first) (if (and (>= first 0) (not (= c first))) 1 many)))))))
(defn rf-tile! [(rw : I32) (tx : I32) (ty : I32) (tw : I32) (th : I32)] : Unit
  (let [kind (rf-below 5)]
    (if (= kind 0)
        (do (rf-b! 1) (dotimes [j th] (dotimes [i tw] (rf-pix! (rf-im rw (+ tx i) (+ ty j))))))
        (let [b (rf-most rw tx ty tw th)
              n (rf-subs rw tx ty tw th b 0 0)
              one (if (and (> n 0) (and (= (rf-subs rw tx ty tw th b 1 0) 1) (< kind 3))) 1 0)
              f (rf-subs rw tx ty tw th b 2 0)
              newbg (if (= b (rf-w 3)) 0 1)
              newfg (if (and (= one 1) (not (= f (rf-w 4)))) 1 0)]
          (do (rf-b! (bit-or (* 2 newbg) (if (> n 0) (if (= one 1) (bit-or 8 (* 4 newfg)) 24) 0)))
              (when (= newbg 1) (do (rf-pix! b) (rf-w! 3 b)))
              (when (> n 0)
                (if (= one 1)
                    (do (rf-w! 5 (+ (rf-w 5) 1)) (when (= newfg 0) (rf-w! 6 (+ (rf-w 6) 1)))
                        (when (= newfg 1) (do (rf-pix! f) (rf-w! 4 f))) (rf-b! n) (rf-subs rw tx ty tw th b 3 0))
                    (do (rf-b! n) (rf-subs rw tx ty tw th b 3 1)))))))))
(defn rf-hextile! [(rw : I32) (rh : I32)] : Unit
  (do (rf-w! 3 -1) (rf-w! 4 -1) (rf-w! 5 0) (rf-w! 6 0)
      (loop [ty 0 tx 0]
        (when (< ty rh)
          (if (>= tx rw) (recur (+ ty 16) 0)
              (do (rf-tile! rw tx ty (if (< (- rw tx) 16) (- rw tx) 16) (if (< (- rh ty) 16) (- rh ty) 16))
                  (recur ty (+ tx 16))))))))

(defn rf-hextile-specs! [] : Unit
  (do (sc-describe! "Hextile (an independent encoder)")
        (dotimes [mode 3]
          (do (sc-context! (rf-mode-name mode))
                (rf-running! 70 50 mode) (rf-exp-clear! 70 50)
                (dotimes [j 37]
                  (dotimes [i 53]
                    (let [k (if (= (mod (+ (/ i 5) (/ j 3)) 3) 0) 0 (if (< (rf-below 10) 8) (mod (+ (/ i 7) (/ j 4)) 6) (rf-below 6)))]
                      (do (store32! (+ (rf-img) (* 4 (+ (* j 53) i))) k)
                          (rf-exp-px! 70 (+ 3 i) (+ 2 j) (rf-pal-r k) (rf-pal-g k) (rf-pal-b k))))))
                (rf-new!) (rf-fbu! 1) (rf-rect! 3 2 53 37 5) (rf-hextile! 53 37) (rf-send! mode)
                (sc-it! "decodes exactly: raw / solid / subrect / coloured tiles, partial edge tiles, bg + fg persistence") (rf-fb-matches 70 50)
                (sc-it! "leaves the session healthy") (lb-equal (nk-rfb-phase) 3)
                ;; a two-colour image (grid lines on a plain ground): most tiles are background + subrects in ONE colour, so the
                ;; foreground register is set once and then reused by later tiles that omit it
                (rf-running! 70 50 mode) (rf-exp-clear! 70 50)
                (dotimes [j 37]
                  (dotimes [i 53]
                    (let [k (if (or (= (mod i 7) 0) (= (mod j 5) 0)) 0 3)]
                      (do (store32! (+ (rf-img) (* 4 (+ (* j 53) i))) k)
                          (rf-exp-px! 70 (+ 3 i) (+ 2 j) (rf-pal-r k) (rf-pal-g k) (rf-pal-b k))))))
                (rf-new!) (rf-fbu! 1) (rf-rect! 3 2 53 37 5) (rf-hextile! 53 37) (rf-send! mode)
                (sc-it! "decodes a two-colour image exactly: one-colour subrects drawn in the foreground, which persists across tiles")
                (rf-fb-matches 70 50) (lb-be-> (rf-w 5) 0) (lb-be-> (rf-w 6) 0)
              (sc-end!)))
      (sc-end!)))

;; ---- CopyRect --------------------------------------------------------------------------------------------------------------------
(defn rf-base-r [(x : I32) (y : I32)] : I32 (mod (* x 8) 256))
(defn rf-base-g [(x : I32) (y : I32)] : I32 (mod (* y 12) 256))
(defn rf-base-b [(x : I32) (y : I32)] : I32 (mod (* x y) 256))
(defn rf-paint! [(mode : I32)] : Unit
  (do (rf-running! 30 20 mode)
      (rf-new!) (rf-fbu! 1) (rf-rect! 0 0 30 20 0)
      (dotimes [y 20] (dotimes [x 30] (do (rf-b! (rf-base-r x y)) (rf-b! (rf-base-g x y)) (rf-b! (rf-base-b x y)) (rf-b! 0))))
      (rf-send! mode) (rf-out!)))
(defn rf-copy-case! [(sx : I32) (sy : I32) (dx : I32) (dy : I32) (w : I32) (h : I32) (mode : I32)] : Unit
  (do (rf-paint! mode)
      (rf-new!) (rf-fbu! 1) (rf-rect! dx dy w h 1) (rf-16! sx) (rf-16! sy) (rf-send! mode)
      (dotimes [y 20] (dotimes [x 30] (rf-exp-px! 30 x y (rf-base-r x y) (rf-base-g x y) (rf-base-b x y))))
      (dotimes [j h] (dotimes [i w] (rf-exp-px! 30 (+ dx i) (+ dy j) (rf-base-r (+ sx i) (+ sy j)) (rf-base-g (+ sx i) (+ sy j)) (rf-base-b (+ sx i) (+ sy j)))))
      (rf-fb-matches 30 20)))
(defn rf-copyrect! [] : Unit
  (do (sc-describe! "CopyRect, every overlap direction, against a snapshot reference")
        (dotimes [m 2]
          (let [mode (* m 2)]
            (do (sc-context! (rf-mode-name mode))
                  (sc-it! "down-right overlap") (rf-copy-case! 2 2 5 4 12 9 mode)
                  (sc-it! "up-left overlap") (rf-copy-case! 5 4 2 2 12 9 mode)
                  (sc-it! "same row, right") (rf-copy-case! 2 3 6 3 14 6 mode)
                  (sc-it! "same row, left") (rf-copy-case! 6 3 2 3 14 6 mode)
                  (sc-it! "straight down overlap") (rf-copy-case! 4 1 4 5 10 10 mode)
                  (sc-it! "straight up overlap") (rf-copy-case! 4 6 4 2 10 10 mode)
                (sc-end!))))
      (sc-end!)))

(defn rf-messages! [] : Unit
  (do (sc-describe! "DesktopSize, Bell, ServerCutText, SetColourMapEntries, several updates")
        (rf-running! 20 10 0)
        (let [gen0 (nk-rfb-gen)]
          (do (rf-new!) (rf-fbu! 1) (rf-rect! 0 0 36 24 -223) (rf-send! 0)
              (sc-it! "DesktopSize resizes the framebuffer and bumps the geometry generation")
              (lb-equal (nk-rfb-width) 36) (lb-equal (nk-rfb-height) 24) (lb-equal (nk-rfb-gen) (+ gen0 1))))
        (rf-out!)
        (sc-it! "after a resize the next request is a FULL one at the new size")
        (lb-be->= (rf-sent-len) 10) (lb-hex-equal (+ (rf-sent) (- (rf-sent-len) 10)) 10 "03 00 0000 0000 0024 0018")
        (rf-new!) (rf-b! 2) (rf-send! 0)                                                        ; Bell
        (rf-new!) (rf-b! 3) (rf-zeros! 3) (rf-32! 11) (rf-s! "hello world") (rf-send! 0)        ; ServerCutText
        (rf-new!) (rf-b! 1) (rf-b! 0) (rf-16! 0) (rf-16! 2) (rf-zeros! 12) (rf-send! 0)         ; SetColourMapEntries, 2 colours
        (sc-it! "Bell, ServerCutText and SetColourMapEntries are consumed harmlessly") (lb-equal (nk-rfb-phase) 3)
        (rf-new!) (rf-fbu! 2) (rf-rect! 0 0 1 1 0) (rf-b! 9) (rf-b! 8) (rf-b! 7) (rf-b! 0) (rf-rect! 1 0 1 1 0) (rf-b! 1) (rf-b! 2) (rf-b! 3) (rf-b! 0)
        (rf-fbu! 1) (rf-rect! 2 0 1 1 0) (rf-b! 4) (rf-b! 5) (rf-b! 6) (rf-b! 0) (rf-send! 2)
        (sc-it! "two updates, three rects, delivered in odd chunks, all land") (lb-hex-equal (rf-fb) 12 "090807ff 010203ff 040506ff")
        (sc-it! "the frame counter counts completed updates") (lb-be->= (nk-rfb-frames) 3)
      (sc-end!)
      (sc-describe! "hostile or confused servers")
        (rf-running! 16 16 0) (rf-new!) (rf-fbu! 1) (rf-rect! 10 10 10 10 0) (rf-zeros! 400) (rf-send! 0)
        (sc-it! "a rect hanging off the screen is refused (PROTOCOL 9)") (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-msg) 9)
        (rf-exp-clear! 16 16)
        (sc-it! "...and the framebuffer is untouched") (rf-fb-matches 16 16)
        (rf-running! 16 16 0) (rf-new!) (rf-fbu! 1) (rf-rect! 0 0 4 4 7) (rf-send! 0)
        (sc-it! "an encoding we never asked for (7 = Tight) fails cleanly") (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-msg) 8)
        (rf-running! 16 16 0) (rf-new!) (rf-b! 77) (rf-send! 0)
        (sc-it! "an unknown message type fails cleanly") (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-msg) 7)
        (sc-it! "bytes after a failure are ignored") (rf-new!) (rf-zeros! 500) (rf-send! 0) (lb-equal (nk-rfb-phase) 9)
        (rf-running! 16 16 0) (rf-new!) (rf-fbu! 1) (rf-rect! 0 0 4 4 1) (rf-16! 14) (rf-16! 14) (rf-send! 0)
        (sc-it! "a CopyRect whose source is off-screen is refused") (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-msg) 9)
        (rf-begin! "") (rf-say! "RFB 003.008\n" 0) (rf-out!) (rf-new!) (rf-b! 1) (rf-b! 1) (rf-send! 0) (rf-out!)
        (rf-new!) (rf-32! 0) (rf-server-init! 60000 60000) (rf-send! 0)
        (sc-it! "a screen bigger than the framebuffer region is refused with a plain message") (lb-equal (nk-rfb-phase) 9) (lb-equal (nk-err-msg) 6)
        (rf-running! 16 16 0) (rf-new!) (rf-b! 3) (rf-zeros! 3) (rf-32! -1) (rf-send! 0)
        (sc-it! "a 4 GB ServerCutText length cannot make the parser spin or skip forever") (lb-equal (nk-rfb-phase) 9)
        (rf-running! 16 16 0) (rf-new!) (rf-fbu! 1) (rf-rect! 0 0 16 16 5) (rf-b! 1) (rf-zeros! 3) (rf-send! 0)
        (sc-it! "a Hextile tile that has only partly arrived just waits") (lb-equal (nk-rfb-phase) 3)
      (sc-end!)))

(defn rf-view-only-spec! [] : Unit
  (do (sc-describe! "view only")
        (let [bad (loop [mode 0 bad 0]
                    (if (= mode 3) bad
                        (do (rf-handshake! mode)
                            (rf-new!) (rf-fbu! 1) (rf-rect! 0 0 4 4 0) (rf-zeros! 64) (rf-send! mode) (rf-out!)
                            (rf-new!) (rf-b! 3) (rf-zeros! 3) (rf-32! 3) (rf-s! "abc") (rf-send! mode) (rf-out!)
                            (recur (+ mode 1) (+ bad (- 1 (rf-view-only? (+ (rf-sent) 30) (- (rf-sent-len) 30))))))))]
          (do (sc-it! "across full sessions (every delivery mode) the client sends only SetPixelFormat / SetEncodings / FramebufferUpdateRequest: never a key, pointer or clipboard message")
              (lb-equal bad 0)))
      (sc-end!)))

(defn rf-big! [] : Unit
  (do (sc-describe! "throughput and close")
        (rf-running! 1920 1080 0)
        (rf-new!) (rf-fbu! 1) (rf-rect! 0 0 1920 1080 0)
        (let [at (rf-len)]
          (do (rf-zeros! (* 4 (* 1920 1080)))
              (loop [i 0] (when (< i (* 4 (* 1920 1080)))
                            (do (store8! (+ (rf-build) (+ at i)) (mod i 251)) (store8! (+ (rf-build) (+ at (+ i 1))) (mod i 241))
                                (store8! (+ (rf-build) (+ at (+ i 2))) (mod i 239)) (recur (+ i 388)))))
              (rf-send! 0)
              (sc-it! "a full 1920x1080 Raw frame (8.3 MB) decodes")
              (lb-hex-equal (rf-fb) 4 "000000ff") (lb-equal (load8 (+ (rf-fb) 388)) (mod 388 251)) (lb-equal (load8 (+ (rf-fb) 389)) (mod 388 241))
              (lb-equal (load8 (+ (rf-fb) 8294399)) 255) (lb-equal (nk-rfb-frames) 1)
              (sc-it! "the dirty box covers the whole frame") (lb-equal (nk-rfb-dx1) 1920) (lb-equal (nk-rfb-dy1) 1080)))
        (rf-running! 16 16 0) (nk-rfb-closed)
        (sc-it! "a close after the session is running is a clean end, not a failure") (lb-equal (nk-rfb-phase) 8) (lb-equal (nk-err-kind) 0)
      (sc-end!)))

(defn scarab-main [] : I32
  (do (rf-seed! 20261124)
      (sc-describe! "nk_rfb")
        (rf-handshakes!) (rf-failures!) (rf-raw!) (rf-hextile-specs!) (rf-copyrect!) (rf-messages!) (rf-view-only-spec!) (rf-big!)
      (sc-end!)
      (sc-finish!)))
