;; tests/netkit/md_spec.prn -- SCARAB/LADYBUG suite for stdlib/netkit/nk_md.prn: MD4, MD5, HMAC-MD5, HMAC-SHA256.
;; Every expected value is a published vector, literal here: RFC 1320 A.5 (MD4), RFC 1321 A.5 (MD5), RFC 2202 (HMAC-MD5),
;; RFC 4231 (HMAC-SHA256), and MS-NLMP 4.2.2 / 4.2.4 (the NT password hash and NTOWFv2 the SMB sign-in is built on).
;; Run: scripts/scarab_wasm.sh tests/netkit/md_spec.prn --modules stdlib/netkit/MODULES

(defn mt-out [] : I32 (+ (sc-scratch) 4096))
(defn mt-in [] : I32 (+ (sc-scratch) 8192))
(defn mt-key [] : I32 (+ (sc-scratch) 16384))

(defn mt-md! [(kind : I32) (s : String) (hex : String)] : Unit
  (let [n (sc-put! (mt-in) s)] (do (md-hash kind (mt-in) n (mt-out)) (lb-hex-equal (mt-out) 16 hex))))
;; an ASCII literal as UTF-16LE at a; returns the byte count
(defn mt-u16! [(a : I32) (s : String)] : I32
  (let [p (str-addr s) n (sc-strlen p)] (do (dotimes [i n] (do (store8! (+ a (* 2 i)) (load8 (+ p i))) (store8! (+ a (+ (* 2 i) 1)) 0))) (* 2 n))))
(defn mt-hmac! [(kind : I32) (kb : I32) (klen : I32) (s : String) (hex : String)] : Unit
  (let [n (sc-put! (mt-in) s)]
    (do (sc-fill! (mt-key) kb klen)
        (lb-equal (hmac kind (mt-key) klen (mt-in) n (mt-out)) 0)
        (lb-hex-equal (mt-out) (hm-dlen kind) hex))))
(defn mt-hmac-key! [(kind : I32) (key : String) (s : String) (hex : String)] : Unit
  (let [n (sc-put! (mt-in) s) kl (sc-put! (mt-key) key)]
    (do (lb-equal (hmac kind (mt-key) kl (mt-in) n (mt-out)) 0) (lb-hex-equal (mt-out) (hm-dlen kind) hex))))

(defn scarab-main [] : I32
  (do (sc-describe! "nk_md")
        (sc-describe! "MD4 (RFC 1320 A.5)")
          (sc-it! "empty") (mt-md! 4 "" "31d6cfe0d16ae931b73c59d7e0c089c0")
          (sc-it! "a") (mt-md! 4 "a" "bde52cb31de33e46245e05fbdbd6fb24")
          (sc-it! "abc") (mt-md! 4 "abc" "a448017aaf21d8525fc10ae87aa6729d")
          (sc-it! "message digest") (mt-md! 4 "message digest" "d9130a8164549fe818874806e1c7014b")
          (sc-it! "a..z") (mt-md! 4 "abcdefghijklmnopqrstuvwxyz" "d79e1c308aa5bbcdeea8ed63df412da9")
          (sc-it! "62 characters (the length spills into a second padding block)")
          (mt-md! 4 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789" "043f8582f241db351ce627e153e7f0e4")
          (sc-it! "80 digits (one full block + tail)")
          (mt-md! 4 "12345678901234567890123456789012345678901234567890123456789012345678901234567890" "e33b4ddc9c38f2199c3e7b164fcc0536")
        (sc-end!)
        (sc-describe! "MD5 (RFC 1321 A.5)")
          (sc-it! "empty") (mt-md! 5 "" "d41d8cd98f00b204e9800998ecf8427e")
          (sc-it! "a") (mt-md! 5 "a" "0cc175b9c0f1b6a831c399e269772661")
          (sc-it! "abc") (mt-md! 5 "abc" "900150983cd24fb0d6963f7d28e17f72")
          (sc-it! "message digest") (mt-md! 5 "message digest" "f96b697d7cb7938d525a2f31aaf161d0")
          (sc-it! "a..z") (mt-md! 5 "abcdefghijklmnopqrstuvwxyz" "c3fcd3d76192e4007dfb496cca67e13b")
          (sc-it! "62 characters") (mt-md! 5 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789" "d174ab98d277d9f5a5611c2c9f419d9f")
          (sc-it! "80 digits")
          (mt-md! 5 "12345678901234567890123456789012345678901234567890123456789012345678901234567890" "57edf4a22be3c955ac49da2e2107b67a")
        (sc-end!)
        (sc-describe! "HMAC-MD5 (RFC 2202)")
          (sc-it! "case 1") (mt-hmac! 5 11 16 "Hi There" "9294727a3638bb1c13f48ef8158bfc9d")
          (sc-it! "case 2") (mt-hmac-key! 5 "Jefe" "what do ya want for nothing?" "750c783e6ab0b503eaa86e310a5db738")
          (sc-it! "case 6: an 80-byte key is hashed first")
          (mt-hmac! 5 170 80 "Test Using Larger Than Block-Size Key - Hash Key First" "6b1ab7fe4bd7bf8f0b62e6ce61b9d0cd")
        (sc-end!)
        (sc-describe! "HMAC-SHA256 (RFC 4231)")
          (sc-it! "case 1") (mt-hmac! 256 11 20 "Hi There" "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
          (sc-it! "case 2") (mt-hmac-key! 256 "Jefe" "what do ya want for nothing?" "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
          (sc-it! "case 6: a 131-byte key")
          (mt-hmac! 256 170 131 "Test Using Larger Than Block-Size Key - Hash Key First" "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
          (sc-it! "refuses a message bigger than its buffer") (lb-equal (hmac 256 (mt-key) 16 (mt-in) 200000 (mt-out)) -1)
        (sc-end!)
        (sc-describe! "the NTLM hashes (MS-NLMP 4.2.2, 4.2.4)")
          (sc-it! "NTOWFv1 = MD4(UTF-16LE(\"Password\"))")
          (let [n (mt-u16! (mt-in) "Password")] (do (nk-md4 (mt-in) n (mt-out)) (lb-hex-equal (mt-out) 16 "a4f49c406510bdcab6824ee7c30fd852")))
          (sc-it! "NTOWFv2 = HMAC-MD5(NTOWFv1, UTF-16LE(\"USER\" + \"Domain\"))")
          (let [n (mt-u16! (mt-in) "USERDomain")]
            (do (lb-equal (hmac 5 (mt-out) 16 (mt-in) n (+ (mt-out) 16)) 0)
                (lb-hex-equal (+ (mt-out) 16) 16 "0c868a403bfd7a93a3001ef22ef02e3f")))
        (sc-end!)
      (sc-end!)
      (sc-finish!)))
